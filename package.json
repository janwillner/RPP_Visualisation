{
  "name": "rpp-visualisation",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev:gateway": "pnpm --filter @rpp/gateway dev",
    "dev:visualisation": "pnpm --filter @rpp/visualisation dev",
    "dev:configurator": "pnpm --filter @rpp/configurator dev",
    "build": "pnpm --filter @rpp/visualisation build && pnpm --filter @rpp/configurator build",
    "start": "pnpm --filter @rpp/gateway start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "build:bridge": "dotnet build apps/ads-bridge -c Release",
    "package": "node scripts/package.mjs",
    "test:e2e": "pnpm --filter @rpp/visualisation test:e2e && pnpm --filter @rpp/configurator test:e2e"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
