<TcPlcObject Version="1.1.0.1">
  <GVL Name="CONFIG_GlobalConst" Id="{07a0700c-e9eb-4e56-b871-6a104e3d29f3}">
    <Declaration><![CDATA[(****************************************************************************************************<br>
