DESCRIPTION:<br>
Global constants of the Syn_Config library.<br>
****************************************************************************************************)
{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	(* Version of the Syn_Config <-> gateway contract (ADR 0017). The gateway writes nothing to a PLC whose config
	   manifest reports another value. Bump together with CONFIG_PROTOCOL_VERSION in the gateway.
	   1: conveyor (pose, origin shift, product types) and Delta (pose, origin shift, zones, working, limit and
	      TCP limit area). *)
	CONFIG_un_PROTOCOL_VERSION			: UINT := 1;
	(* Version of this library (config manifest sLibraryVersion). Bump together with _FC_GetVersionSynConfig and the
	   project version. *)
	CONFIG_str_LIBRARY_VERSION			: STRING(15) := '1.0.0';
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>