<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="CONFIG_GlobalConst_Param" Id="{64ba3dd5-022f-4915-ac5b-7910775dd6fe}">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Library parameters of Syn_Config: array sizes of the interface structures. The lists of a parameter set have the
sizes of Syn_Visu's (VISU_GlobalConst_Param), so every set fits the visualisation it is passed on to.<br>
****************************************************************************************************)
{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	CONFIG_un_MAX_MANIFEST_ENTRIES		: UINT := 32;	// [-] parameter FBs in the config manifest
	CONFIG_un_MAX_RECIPE_FIELDS			: UINT := 64;	// [-] fields of the machine's recipe (_FB_ConfigMachine)
	CONFIG_un_MAX_CHOICES				: UINT := 8;	// [-] named values of a CHOICE recipe field
	CONFIG_un_MAX_TOPOLOGY_KINDS		: UINT := 16;	// [-] kinds of topology node (_FB_ConfigTopology), at most 32
	CONFIG_un_MAX_TOPOLOGY_ROLES		: UINT := 16;	// [-] roles a topology link may have
	CONFIG_un_MAX_TOPOLOGY_NODES		: UINT := 64;	// [-] topology nodes of the full build-out
	CONFIG_un_MAX_TOPOLOGY_LINKS		: UINT := 128;	// [-] links of a topology, its parents included
	CONFIG_un_MAX_NODE_COMPONENTS		: UINT := 4;	// [-] Syn_Visu components one topology node stands for
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>