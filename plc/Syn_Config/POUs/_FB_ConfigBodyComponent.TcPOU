<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_FB_ConfigBodyComponent" Id="{f3d50d8c-cdcb-4ccc-974a-c46ca4f3e9ad}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Base of the parameter FBs of components drawn from their bodies (_FB_ConfigVision, _FB_ConfigSensor,<br>
_FB_ConfigStation, ADR 0017): their pose, origin shift and zones, written by the configurator, taken over when<br>
the application allows it. The bodies are hardware and stay the application's. Typical cycle:<br>
  fb_VisionParam.m_Register(vio_Manifest := GVL_Config.stManifest, vi_udn_Id := fb_Vision.m_Id());<br>
  fb_VisionParam.m_Cycle(vio_Default := VisionDefault, vio_Set := VisionSet, vi_b_ApplyAllowed := b_Stopped);<br>
  fb_Vision.m_Configure(vi_lr_FieldLength := 400, ...);<br>
  fb_VisionParam.m_PassOn(vio_Visu := fb_Vision);<br>
Not used directly.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Config is the contract structure the gateway reads and writes at the path in the config manifest.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Config 1.1.0 ¦ 2026-11-10 ¦ J.Willner ¦ New<br>
Syn_Config 2.3.0 ¦ 2026-11-14 ¦ J.Willner ¦ m_Cycle through m_HandleStaging; m_PassOnBody passes the pose on<br>
****************************************************************************************************)
FUNCTION_BLOCK ABSTRACT _FB_ConfigBodyComponent EXTENDS _FB_ConfigComponent
VAR_OUTPUT
	vo_Config							: ST_ConfigBodyComponent;	// contract structure of the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_Active" Id="{b655cdd7-e426-4d58-8790-211013fd69e9}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
All effective values (zones, ...), for the application's own logic.<br>
****************************************************************************************************)
METHOD m_Active : ST_ConfigBodyComponentParam]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Active := vo_Config.stActive;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Cycle" Id="{e33baa3f-bf63-45e3-a963-1a96167f7621}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Every cycle: handles a staged set or a reset (a set only while vi_b_ApplyAllowed), keeps the active set in<br>
vio_Set and gives the effective values in vo_Config.stActive: the active set while one is valid, else the<br>
program values vio_Default.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE in the cycle a set was taken over or reset.<br>
****************************************************************************************************)
METHOD m_Cycle : BOOL
VAR_IN_OUT CONSTANT
	vio_Default							: ST_ConfigBodyComponentParam;	// the application's program values
END_VAR
VAR_IN_OUT
	vio_Set								: ST_ConfigBodyComponentSet;	// the application's VAR PERSISTENT active set
END_VAR
VAR_INPUT
	vi_b_ApplyAllowed					: BOOL;	// [-] a staged set may be taken over now, e.g. while the machine stands
END_VAR
VAR
	b_TempTakeOver						: BOOL;	// the staged set was taken over: copy it
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Cycle := m_HandleStaging(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vio_b_Valid := vio_Set.bValid,
	vio_udn_Version := vio_Set.nVersion, vio_udn_LastVersion := vio_Set.nLastVersion, vi_b_ApplyAllowed := vi_b_ApplyAllowed,
	vo_b_TakeOver => b_TempTakeOver);
IF b_TempTakeOver THEN
	vio_Set.stParam := vo_Config.stStaged;
END_IF


(****************************************************************************************************
EFFECTIVE VALUES
****************************************************************************************************)
IF vio_Set.bValid THEN
	vo_Config.stActive := vio_Set.stParam;
ELSE
	vo_Config.stActive := vio_Default;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InvalidStaged" Id="{f219360b-fe44-4a32-b4e2-602d21046675}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Why a staged set cannot be taken over; '' when it can: more zones than the list holds or a zone on no conveyor<br>
(id 0).<br>
****************************************************************************************************)
METHOD PROTECTED m_InvalidStaged : STRING(80)]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_InvalidStaged := m_InvalidZones(vio_aZones := vo_Config.stStaged.aZones, vi_un_Count := vo_Config.stStaged.nZoneCount);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOnBody" Id="{cb08f9d6-4dfa-48ea-a028-e28a64f4ad7c}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective pose, origin shift and zones on to the component's Syn_Visu FB; for m_PassOn of the<br>
derived FB, which knows where the visualisation keeps its zone count.<br>
****************************************************************************************************)
METHOD PROTECTED m_PassOnBody : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuBodyComponent;	// the component's Syn_Visu FB
END_VAR
VAR_INPUT
	vi_un_VisuZoneCount					: UINT;	// [-] zones the visualisation has now, its stConfig.nZoneCount
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOnBody := TRUE;
vio_Visu.m_SetPose(vi_Pose := vo_Config.stActive.stPose);
vio_Visu.m_SetOriginShift(vi_lr_X := vo_Config.stActive.stOriginShift.fX, vi_lr_Y := vo_Config.stActive.stOriginShift.fY,
	vi_lr_Z := vo_Config.stActive.stOriginShift.fZ);
m_PassOnZones(vio_Visu := vio_Visu, vio_aZones := vo_Config.stActive.aZones, vi_un_Count := vo_Config.stActive.nZoneCount,
	vi_un_VisuCount := vi_un_VisuZoneCount);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Pose" Id="{46ae1179-8197-4f19-b8c4-48bd3c65cc5f}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Effective pose (MCS), for the application's logic.<br>
****************************************************************************************************)
METHOD m_Pose : SynVisu.ST_VisuPose]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Pose := vo_Config.stActive.stPose;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>