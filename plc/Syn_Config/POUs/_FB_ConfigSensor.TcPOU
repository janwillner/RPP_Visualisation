<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_FB_ConfigSensor" Id="{c686335c-3134-4272-a65c-ccc1c035b18e}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Parameter set of one product sensor (ADR 0017): its pose, origin shift and zones. See _FB_ConfigBodyComponent.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Config 1.1.0 ¦ 2026-11-10 ¦ J.Willner ¦ New<br>
Syn_Config 2.3.0 ¦ 2026-11-14 ¦ J.Willner ¦ m_PassOn passes the pose on<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_ConfigSensor EXTENDS _FB_ConfigBodyComponent]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_ComponentType" Id="{e48d2dec-117c-4118-a6e5-6e83748f72c1}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
A product sensor.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : SynVisu.E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := SynVisu.E_VisuComponentType.SENSOR;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOn" Id="{b73228d4-beb4-49a0-b5c2-ce7f7c2496ce}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective pose, origin shift and zones on to the sensor's Syn_Visu FB; the beam length (hardware)<br>
stays with the application's m_Configure call. Call it after m_Cycle, every cycle.<br>
****************************************************************************************************)
METHOD m_PassOn : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuSensor;	// the sensor's Syn_Visu FB
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOn := m_PassOnBody(vio_Visu := vio_Visu, vi_un_VisuZoneCount := vio_Visu.vo_Visu.stConfig.nZoneCount);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>