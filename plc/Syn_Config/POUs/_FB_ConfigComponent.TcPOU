<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_FB_ConfigComponent" Id="{8144eabf-0414-48cf-a42e-ae33381db23d}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Base of every parameter FB (_FB_ConfigConveyor, _FB_ConfigDelta, _FB_ConfigXtsGantry, ...): the config<br>
manifest entry, what is done with a staging (ADR 0017) and the helpers for zones, fingers, limit areas and<br>
track modules the derived FBs share. Not used directly.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Config 1.0.0 ¦ 2026-11-10 ¦ J.Willner ¦ First version: conveyor and Delta<br>
Syn_Config 1.1.0 ¦ 2026-11-10 ¦ J.Willner ¦ Helpers m_PassOn..., m_Invalid... for every type<br>
Syn_Config 2.0.0 ¦ 2026-11-11 ¦ J.Willner ¦ m_InvalidFingers, m_PassOnFingers (ADR 0018)<br>
Syn_Config 2.3.0 ¦ 2026-11-14 ¦ J.Willner ¦ m_HandleStaging; symbol path from _FC_VisuSymbolPath<br>
****************************************************************************************************)
{attribute 'reflection'}
FUNCTION_BLOCK ABSTRACT _FB_ConfigComponent
VAR
	udn_ComponentId						: UDINT;	// [-] id of the Syn_Visu component, 0 = not registered
	(* Device tree path of this instance, e.g. 'RPP_Visu.Syn_Visu_Demo.P_VisuDemoDelta.fb_InfeedParam', set by TwinCAT
	   at initialisation. *)
	{attribute 'instance-path'}
	{attribute 'noinit'}
	str_InstancePath					: STRING(255);
	str_SymbolPath						: STRING(255);	// symbol path of vo_Config for the manifest, from str_InstancePath
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_ComponentType" Id="{8a3f1799-f713-48d9-9d25-0f2fde3438ec}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Type of the Syn_Visu component this FB parametrises. Overridden by every derived FB.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : SynVisu.E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := SynVisu.E_VisuComponentType.NONE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Handled" Id="{df9c043a-7a5a-4dad-9e20-eb3ec1b9aa9d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reports the staging as handled: taken over (or reset) with an empty vi_str_Rejection, else rejected for that<br>
reason. Clears bStaged and bReset. TRUE when taken over.<br>
****************************************************************************************************)
METHOD PRIVATE m_Handled : BOOL
VAR_IN_OUT
	vio_Staging							: ST_ConfigStaging;	// vo_Config.stStaging
	vio_Status							: ST_ConfigStatus;	// vo_Config.stStatus
END_VAR
VAR_INPUT
	vi_str_Rejection					: STRING(80);	// why the set is not taken over; '' = taken over
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Handled := vi_str_Rejection = '';
vio_Status.nHandledStageId := vio_Staging.nStageId;
IF m_Handled THEN
	vio_Status.eResult := E_ConfigResult.APPLIED;
	vio_Status.sMessage := '';
ELSE
	vio_Status.eResult := E_ConfigResult.REJECTED;
	vio_Status.sMessage := vi_str_Rejection;
END_IF
vio_Staging.bStaged := FALSE;
vio_Staging.bReset := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_HandleStaging" Id="{d4ebcb18-f74c-43a9-91ce-e82b1791c11d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The staging lifecycle of every parameter FB (ADR 0017), for m_Cycle of the derived FB: a reset makes the active<br>
set invalid at once; a staged set waits while the application does not allow a take-over (PENDING), is rejected<br>
when based on another version than the active one or when m_InvalidStaged names a reason, and is taken over<br>
otherwise under a new version that never repeats. Reports the result in vio_Status, also the active version.<br>
The derived FB copies the staged set into its active set when vo_b_TakeOver says so.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE in the cycle a set was taken over or reset.<br>
****************************************************************************************************)
METHOD PROTECTED m_HandleStaging : BOOL
VAR_IN_OUT
	vio_Staging							: ST_ConfigStaging;	// vo_Config.stStaging
	vio_Status							: ST_ConfigStatus;	// vo_Config.stStatus
	vio_b_Valid							: BOOL;	// the active set's bValid
	vio_udn_Version						: UDINT;	// [-] the active set's nVersion
	vio_udn_LastVersion					: UDINT;	// [-] the active set's nLastVersion
END_VAR
VAR_INPUT
	vi_b_ApplyAllowed					: BOOL;	// [-] the application allows taking a set over now
END_VAR
VAR_OUTPUT
	vo_b_TakeOver						: BOOL;	// TRUE: copy the staged set into the active set now
END_VAR
VAR
	udn_TempActiveVersion				: UDINT;	// [-] version of the active set, 0 = program values
	str_TempRejection					: STRING(80);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_HandleStaging := FALSE;
vo_b_TakeOver := FALSE;
udn_TempActiveVersion := SEL(vio_b_Valid, 0, vio_udn_Version);
IF vio_Staging.bReset THEN
	vio_b_Valid := FALSE;
	m_Handled(vio_Staging := vio_Staging, vio_Status := vio_Status, vi_str_Rejection := '');
	m_HandleStaging := TRUE;
ELSIF vio_Staging.bStaged THEN
	IF NOT vi_b_ApplyAllowed THEN
		vio_Status.eResult := E_ConfigResult.PENDING;
	ELSIF vio_Staging.nBaseVersion <> udn_TempActiveVersion THEN
		m_Handled(vio_Staging := vio_Staging, vio_Status := vio_Status,
			vi_str_Rejection := CONCAT(CONCAT('Based on version ', UDINT_TO_STRING(vio_Staging.nBaseVersion)),
				CONCAT(', but version ', CONCAT(UDINT_TO_STRING(udn_TempActiveVersion), ' is active'))));
	ELSE
		str_TempRejection := m_InvalidStaged();
		IF str_TempRejection = '' THEN
			vio_udn_LastVersion := vio_udn_LastVersion + 1;
			vio_udn_Version := vio_udn_LastVersion;
			vio_b_Valid := TRUE;
			vo_b_TakeOver := TRUE;
			m_HandleStaging := TRUE;
		END_IF
		m_Handled(vio_Staging := vio_Staging, vio_Status := vio_Status, vi_str_Rejection := str_TempRejection);
	END_IF
END_IF
vio_Status.nActiveVersion := SEL(vio_b_Valid, 0, vio_udn_Version);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Id" Id="{5c696fcf-6ed9-4c83-b6ae-84f4a80853e6}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Id given to m_Register (the Syn_Visu component's id); 0 while not registered.<br>
****************************************************************************************************)
METHOD m_Id : UDINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Id := udn_ComponentId;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InvalidFingers" Id="{fbdb2a8f-e475-4ae3-b530-8e8b39ae2895}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Why a staged set's gripper fingers cannot be taken over; '' when they can: more fingers than the list holds, or<br>
a finger without a diameter or height.<br>
****************************************************************************************************)
METHOD PROTECTED m_InvalidFingers : STRING(80)
VAR_IN_OUT CONSTANT
	(* staged fingers *)
	vio_aFingers						: ARRAY[0..SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF SynVisu.ST_VisuFinger;
END_VAR
VAR_INPUT
	vi_un_Count							: UINT;	// [-] staged fingers in vio_aFingers
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_InvalidFingers := '';
IF vi_un_Count > SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_FINGERS THEN
	m_InvalidFingers := CONCAT('More than ', CONCAT(UINT_TO_STRING(SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_FINGERS), ' fingers'));
	RETURN;
END_IF
un_TempIndex := 0;
WHILE un_TempIndex < vi_un_Count DO
	IF vio_aFingers[un_TempIndex].fDiameter <= 0 OR vio_aFingers[un_TempIndex].fHeight <= 0 THEN
		m_InvalidFingers := CONCAT('Finger ', CONCAT(UINT_TO_STRING(un_TempIndex + 1), ' has no diameter or height'));
		RETURN;
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InvalidModules" Id="{006addbe-d0b1-4392-b619-6d3005786e21}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Why a staged set's track modules cannot be taken over; '' when they can: more modules than the list holds,<br>
none at all, or a module without a length.<br>
****************************************************************************************************)
METHOD PROTECTED m_InvalidModules : STRING(80)
VAR_IN_OUT CONSTANT
	(* staged modules *)
	vio_aModules						: ARRAY[0..SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_MODULES - 1] OF SynVisu.ST_VisuTrackModule;
END_VAR
VAR_INPUT
	vi_un_Count							: UINT;	// [-] staged modules in vio_aModules
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_InvalidModules := '';
IF vi_un_Count > SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_MODULES THEN
	m_InvalidModules := CONCAT('More than ', CONCAT(UINT_TO_STRING(SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_MODULES), ' track modules'));
	RETURN;
END_IF
IF vi_un_Count = 0 THEN
	m_InvalidModules := 'A track without modules';
	RETURN;
END_IF
un_TempIndex := 0;
WHILE un_TempIndex < vi_un_Count DO
	IF vio_aModules[un_TempIndex].fLength <= 0 THEN
		m_InvalidModules := CONCAT('Track module ', CONCAT(UINT_TO_STRING(un_TempIndex + 1), ' has no length'));
		RETURN;
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InvalidStaged" Id="{2c0a758b-2a6a-46a3-850d-a991aba49856}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Why the set in vo_Config.stStaged cannot be taken over; '' when it can. Each parameter FB names its own checks;<br>
m_HandleStaging asks before a take-over.<br>
****************************************************************************************************)
METHOD PROTECTED ABSTRACT m_InvalidStaged : STRING(80)]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InvalidZones" Id="{c0a85e78-97a7-4995-b034-c219f4ec1d63}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Why a staged set's zones cannot be taken over; '' when they can: more zones than the list holds, or a zone on<br>
no conveyor (id 0).<br>
****************************************************************************************************)
METHOD PROTECTED m_InvalidZones : STRING(80)
VAR_IN_OUT CONSTANT
	(* staged zones *)
	vio_aZones							: ARRAY[0..SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF SynVisu.ST_VisuZone;
END_VAR
VAR_INPUT
	vi_un_Count							: UINT;	// [-] staged zones in vio_aZones
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_InvalidZones := '';
IF vi_un_Count > SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_ZONES THEN
	m_InvalidZones := CONCAT('More than ', CONCAT(UINT_TO_STRING(SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_ZONES), ' zones'));
	RETURN;
END_IF
un_TempIndex := 0;
WHILE un_TempIndex < vi_un_Count DO
	IF vio_aZones[un_TempIndex].nConveyorId = 0 THEN
		m_InvalidZones := CONCAT('Zone ', CONCAT(UINT_TO_STRING(un_TempIndex + 1), ' lies on no conveyor'));
		RETURN;
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOnFingers" Id="{b0316e31-dfb7-4b56-b793-82663f721baf}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective gripper fingers with their flange offsets on to a robot's Syn_Visu FB (ADR 0018). Syn_Visu's<br>
finger count only grows: the fingers are cleared first only when the set has fewer than the visualisation, so<br>
its config version only changes when a value does.<br>
****************************************************************************************************)
METHOD PROTECTED m_PassOnFingers : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuRobot;	// the robot's Syn_Visu FB
END_VAR
VAR_IN_OUT CONSTANT
	(* effective fingers *)
	vio_aFingers						: ARRAY[0..SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF SynVisu.ST_VisuFinger;
END_VAR
VAR_INPUT
	vi_un_Count							: UINT;	// [-] effective fingers in vio_aFingers
	vi_un_VisuCount						: UINT;	// [-] fingers the visualisation has now, its stConfig.nFingerCount
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOnFingers := TRUE;
IF vi_un_VisuCount > vi_un_Count THEN
	vio_Visu.m_ClearFingers();
END_IF
un_TempIndex := 0;
WHILE un_TempIndex < vi_un_Count AND un_TempIndex < SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_FINGERS DO
	vio_Visu.m_SetFinger(vi_un_Finger := un_TempIndex + 1, vi_lr_Diameter := vio_aFingers[un_TempIndex].fDiameter,
		vi_lr_Height := vio_aFingers[un_TempIndex].fHeight);
	vio_Visu.m_SetFingerOffset(vi_un_Finger := un_TempIndex + 1, vi_lr_X := vio_aFingers[un_TempIndex].stOffset.fX,
		vi_lr_Y := vio_aFingers[un_TempIndex].stOffset.fY, vi_lr_Z := vio_aFingers[un_TempIndex].stOffset.fZ,
		vi_lr_Rz := vio_aFingers[un_TempIndex].stOffset.fRz);
	un_TempIndex := un_TempIndex + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOnLimitAreas" Id="{2c578586-9495-4510-a471-c1905a4dbd5d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective limit area and TCP limit area on to a robot's Syn_Visu FB (Delta, XTS gantry, Cartesian);<br>
an area with bActive = FALSE is cleared.<br>
****************************************************************************************************)
METHOD PROTECTED m_PassOnLimitAreas : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuRobot;	// the robot's Syn_Visu FB
END_VAR
VAR_IN_OUT CONSTANT
	vio_LimitArea						: SynVisu.ST_VisuLimitArea;	// effective limit area
	vio_TcpLimitArea					: SynVisu.ST_VisuLimitArea;	// effective TCP limit area
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOnLimitAreas := TRUE;
IF vio_LimitArea.bActive THEN
	vio_Visu.m_SetLimitArea(vi_lr_XMin := vio_LimitArea.fXMin, vi_lr_XMax := vio_LimitArea.fXMax,
		vi_lr_YMin := vio_LimitArea.fYMin, vi_lr_YMax := vio_LimitArea.fYMax,
		vi_lr_ZMin := vio_LimitArea.fZMin, vi_lr_ZMax := vio_LimitArea.fZMax);
ELSE
	vio_Visu.m_ClearLimitArea();
END_IF
IF vio_TcpLimitArea.bActive THEN
	vio_Visu.m_SetTcpLimitArea(vi_lr_XMin := vio_TcpLimitArea.fXMin, vi_lr_XMax := vio_TcpLimitArea.fXMax,
		vi_lr_YMin := vio_TcpLimitArea.fYMin, vi_lr_YMax := vio_TcpLimitArea.fYMax,
		vi_lr_ZMin := vio_TcpLimitArea.fZMin, vi_lr_ZMax := vio_TcpLimitArea.fZMax);
ELSE
	vio_Visu.m_ClearTcpLimitArea();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOnModules" Id="{6f5d6e12-97cd-492a-a124-f5b60318aadb}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective track modules on to an XTS track's Syn_Visu FB (XTS gantry, XTS loop). Syn_Visu's module<br>
count only grows: the modules are cleared first only when the set has fewer than the visualisation, so its<br>
config version only changes when a value does.<br>
****************************************************************************************************)
METHOD PROTECTED m_PassOnModules : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuXtsTrack;	// the track's Syn_Visu FB
END_VAR
VAR_IN_OUT CONSTANT
	(* effective modules *)
	vio_aModules						: ARRAY[0..SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_MODULES - 1] OF SynVisu.ST_VisuTrackModule;
END_VAR
VAR_INPUT
	vi_un_Count							: UINT;	// [-] effective modules in vio_aModules
	vi_un_VisuCount						: UINT;	// [-] modules the visualisation has now, its stConfig.nModuleCount
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOnModules := TRUE;
IF vi_un_VisuCount > vi_un_Count THEN
	vio_Visu.m_ClearModules();
END_IF
un_TempIndex := 0;
WHILE un_TempIndex < vi_un_Count AND un_TempIndex < SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_MODULES DO
	vio_Visu.m_SetModule(vi_un_Module := un_TempIndex + 1, vi_e_Kind := vio_aModules[un_TempIndex].eKind,
		vi_lr_Length := vio_aModules[un_TempIndex].fLength);
	un_TempIndex := un_TempIndex + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOnZones" Id="{5b65158d-64c7-4c68-8043-611d88527c84}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective zones on to a Syn_Visu component with zones (robot, detector, station). Syn_Visu's zone<br>
count only grows: the zones are cleared first only when the set has fewer than the visualisation, so its<br>
config version only changes when a value does.<br>
****************************************************************************************************)
METHOD PROTECTED m_PassOnZones : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuZoneComponent;	// the component's Syn_Visu FB
END_VAR
VAR_IN_OUT CONSTANT
	(* effective zones *)
	vio_aZones							: ARRAY[0..SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF SynVisu.ST_VisuZone;
END_VAR
VAR_INPUT
	vi_un_Count							: UINT;	// [-] effective zones in vio_aZones
	vi_un_VisuCount						: UINT;	// [-] zones the visualisation has now, its stConfig.nZoneCount
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOnZones := TRUE;
IF vi_un_VisuCount > vi_un_Count THEN
	vio_Visu.m_ClearZones();
END_IF
un_TempIndex := 0;
WHILE un_TempIndex < vi_un_Count AND un_TempIndex < SynVisu.VISU_GlobalConst_Param.VISU_un_MAX_ZONES DO
	vio_Visu.m_SetZone(vi_un_Zone := un_TempIndex + 1, vi_udn_ConveyorId := vio_aZones[un_TempIndex].nConveyorId,
		vi_lr_Start := vio_aZones[un_TempIndex].fStart, vi_lr_End := vio_aZones[un_TempIndex].fEnd,
		vi_lr_AllocationOffset := vio_aZones[un_TempIndex].fAllocationOffset,
		vi_lr_CcsOffset := vio_aZones[un_TempIndex].fCcsOffset,
		vi_lr_StartY := vio_aZones[un_TempIndex].fStartY, vi_lr_EndY := vio_aZones[un_TempIndex].fEndY);
	un_TempIndex := un_TempIndex + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Register" Id="{dea46dbd-b229-471e-a63d-532074204272}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Adds this parameter FB to the config manifest under the id of the Syn_Visu component it parametrises.<br>
Idempotent: call it every cycle. The symbol path the gateway reads comes from the instance's own path, as in<br>
Syn_Visu (VISU_un_INSTANCE_PATH_SKIP).<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE for vi_udn_Id = 0 (but for _FB_ConfigMachine, which registers with id 0), an id already used by a<br>
different entry, or a full manifest.<br>
****************************************************************************************************)
METHOD m_Register : BOOL
VAR_IN_OUT
	vio_Manifest						: ST_ConfigManifest;	// GVL_Config.stManifest of the application
END_VAR
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] id of the Syn_Visu component, e.g. fb_Infeed.m_Id()
END_VAR
VAR
	e_TempType							: SynVisu.E_VisuComponentType;
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Register := FALSE;
(* Always report the contract version of the library actually running, also after an online change. *)
vio_Manifest.nProtocolVersion := CONFIG_GlobalConst.CONFIG_un_PROTOCOL_VERSION;
vio_Manifest.sLibraryVersion := CONFIG_GlobalConst.CONFIG_str_LIBRARY_VERSION;
e_TempType := m_ComponentType();
(* Id 0 is the machine FB's, whose type is NONE (_FB_ConfigMachine); every parameter FB has a component's id. *)
IF (vi_udn_Id = 0) <> (e_TempType = SynVisu.E_VisuComponentType.NONE) THEN
	RETURN;
END_IF
IF str_SymbolPath = '' THEN
	str_SymbolPath := SynVisu._FC_VisuSymbolPath(vio_str_InstancePath := str_InstancePath, vi_str_Member := '.vo_Config');
END_IF

(* An existing entry with the same id must match exactly. *)
un_TempIndex := 0;
WHILE un_TempIndex < vio_Manifest.nCount AND un_TempIndex < CONFIG_GlobalConst_Param.CONFIG_un_MAX_MANIFEST_ENTRIES DO
	IF vio_Manifest.aEntries[un_TempIndex].nId = vi_udn_Id THEN
		m_Register := vio_Manifest.aEntries[un_TempIndex].eType = e_TempType
					AND vio_Manifest.aEntries[un_TempIndex].sPath = str_SymbolPath;
		IF m_Register THEN
			udn_ComponentId := vi_udn_Id;
		END_IF
		RETURN;
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE

(* New entry. *)
IF vio_Manifest.nCount >= CONFIG_GlobalConst_Param.CONFIG_un_MAX_MANIFEST_ENTRIES THEN
	RETURN;
END_IF
vio_Manifest.aEntries[vio_Manifest.nCount].nId := vi_udn_Id;
vio_Manifest.aEntries[vio_Manifest.nCount].eType := e_TempType;
vio_Manifest.aEntries[vio_Manifest.nCount].sPath := str_SymbolPath;
vio_Manifest.nCount := vio_Manifest.nCount + 1;
udn_ComponentId := vi_udn_Id;
m_Register := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>