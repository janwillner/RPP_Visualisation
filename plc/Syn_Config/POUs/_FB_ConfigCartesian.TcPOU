<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_FB_ConfigCartesian" Id="{cff617cd-c938-446a-93a1-9ad628851023}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Parameter set of one Cartesian robot (ADR 0017): its pose, origin shift, zones, gripper fingers, limit area and<br>
TCP limit area, written by the configurator, taken over when the application allows it.<br>
Typical cycle:<br>
  fb_CartParam.m_Register(vio_Manifest := GVL_Config.stManifest, vi_udn_Id := fb_Cart.m_Id());<br>
  fb_CartParam.m_Cycle(vio_Default := CartDefault, vio_Set := CartSet, vi_b_ApplyAllowed := b_Stopped);<br>
  fb_Cart.m_Configure(vi_lr_XMin := 0, ...);<br>
  fb_CartParam.m_PassOn(vio_Visu := fb_Cart);<br>
The application's logic takes its zones and limit areas from m_Active, not from its own constants.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Config is the contract structure the gateway reads and writes at the path in the config manifest.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Config 1.1.0 ¦ 2026-11-10 ¦ J.Willner ¦ New<br>
Syn_Config 2.0.0 ¦ 2026-11-11 ¦ J.Willner ¦ Gripper fingers with their offsets, m_Invalid (ADR 0018)<br>
Syn_Config 2.3.0 ¦ 2026-11-14 ¦ J.Willner ¦ m_Cycle through m_HandleStaging; m_PassOn passes the pose on<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_ConfigCartesian EXTENDS _FB_ConfigComponent
VAR_OUTPUT
	vo_Config							: ST_ConfigCartesian;	// contract structure of the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_Active" Id="{12c5cddf-2026-4f4a-9465-e9dfc1501bd2}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
All effective values (zones, limit areas, ...), for the application's own logic.<br>
****************************************************************************************************)
METHOD m_Active : ST_ConfigCartesianParam]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Active := vo_Config.stActive;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ComponentType" Id="{2e46e80d-69b4-42ac-b45e-1ef0b1c7d454}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
A Cartesian robot.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : SynVisu.E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := SynVisu.E_VisuComponentType.CARTESIAN;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Cycle" Id="{8c4e1e74-3d60-4694-8425-83dec0839063}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Every cycle: handles a staged set or a reset (a set only while vi_b_ApplyAllowed), keeps the active set in<br>
vio_Set and gives the effective values in vo_Config.stActive: the active set while one is valid, else the<br>
program values vio_Default.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE in the cycle a set was taken over or reset.<br>
****************************************************************************************************)
METHOD m_Cycle : BOOL
VAR_IN_OUT CONSTANT
	vio_Default							: ST_ConfigCartesianParam;	// the application's program values
END_VAR
VAR_IN_OUT
	vio_Set								: ST_ConfigCartesianSet;	// the application's VAR PERSISTENT active set
END_VAR
VAR_INPUT
	vi_b_ApplyAllowed					: BOOL;	// [-] a staged set may be taken over now, e.g. while the machine stands
END_VAR
VAR
	b_TempTakeOver						: BOOL;	// the staged set was taken over: copy it
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Cycle := m_HandleStaging(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vio_b_Valid := vio_Set.bValid,
	vio_udn_Version := vio_Set.nVersion, vio_udn_LastVersion := vio_Set.nLastVersion, vi_b_ApplyAllowed := vi_b_ApplyAllowed,
	vo_b_TakeOver => b_TempTakeOver);
IF b_TempTakeOver THEN
	vio_Set.stParam := vo_Config.stStaged;
END_IF


(****************************************************************************************************
EFFECTIVE VALUES
****************************************************************************************************)
IF vio_Set.bValid THEN
	vo_Config.stActive := vio_Set.stParam;
ELSE
	vo_Config.stActive := vio_Default;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InvalidStaged" Id="{5411f499-6eea-486b-8377-32da42d28ab8}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Why a staged set cannot be taken over; '' when it can: more zones or fingers than the lists hold, a zone on no<br>
conveyor (id 0), or a finger without a diameter or height.<br>
****************************************************************************************************)
METHOD PROTECTED m_InvalidStaged : STRING(80)]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_InvalidStaged := m_InvalidZones(vio_aZones := vo_Config.stStaged.aZones, vi_un_Count := vo_Config.stStaged.nZoneCount);
IF m_InvalidStaged = '' THEN
	m_InvalidStaged := m_InvalidFingers(vio_aFingers := vo_Config.stStaged.aFingers, vi_un_Count := vo_Config.stStaged.nFingerCount);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOn" Id="{6923112d-18ac-4848-8212-72e3f21b6e6c}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective pose, origin shift, limit areas, zones and fingers on to the robot's Syn_Visu FB, so the<br>
visualisation shows what the machine uses; the strokes and rail height (hardware) stay with the application's<br>
m_Configure call. Call it after m_Cycle, every cycle; Syn_Visu's config version only changes when a value does.<br>
****************************************************************************************************)
METHOD m_PassOn : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuCartesian;	// the robot's Syn_Visu FB
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOn := TRUE;
vio_Visu.m_SetPose(vi_Pose := vo_Config.stActive.stPose);
vio_Visu.m_SetOriginShift(vi_lr_X := vo_Config.stActive.stOriginShift.fX, vi_lr_Y := vo_Config.stActive.stOriginShift.fY,
	vi_lr_Z := vo_Config.stActive.stOriginShift.fZ);
m_PassOnLimitAreas(vio_Visu := vio_Visu, vio_LimitArea := vo_Config.stActive.stLimitArea,
	vio_TcpLimitArea := vo_Config.stActive.stTcpLimitArea);
m_PassOnZones(vio_Visu := vio_Visu, vio_aZones := vo_Config.stActive.aZones, vi_un_Count := vo_Config.stActive.nZoneCount,
	vi_un_VisuCount := vio_Visu.vo_Visu.stConfig.nZoneCount);
m_PassOnFingers(vio_Visu := vio_Visu, vio_aFingers := vo_Config.stActive.aFingers,
	vi_un_Count := vo_Config.stActive.nFingerCount, vi_un_VisuCount := vio_Visu.vo_Visu.stConfig.nFingerCount);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Pose" Id="{8239bb64-4f45-4120-9dfc-c847d99fd5ea}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Effective pose of the axis origin (MCS), for the application's logic.<br>
****************************************************************************************************)
METHOD m_Pose : SynVisu.ST_VisuPose]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Pose := vo_Config.stActive.stPose;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>