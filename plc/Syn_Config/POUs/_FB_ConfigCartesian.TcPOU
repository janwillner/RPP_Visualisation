<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_FB_ConfigCartesian" Id="{cff617cd-c938-446a-93a1-9ad628851023}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Parameter set of one Cartesian robot (ADR 0017): its pose, origin shift, zones, limit area and TCP limit area,<br>
written by the configurator, taken over when the application allows it. Typical cycle:<br>
  fb_CartParam.m_Register(vio_Manifest := GVL_Config.stManifest, vi_udn_Id := fb_Cart.m_Id());<br>
  fb_CartParam.m_Cycle(vio_Default := CartDefault, vio_Set := CartSet, vi_b_ApplyAllowed := b_Stopped);<br>
  fb_Cart.m_Configure(vi_Pose := fb_CartParam.m_Pose(), vi_lr_XMin := 0, ...);<br>
  fb_CartParam.m_PassOn(vio_Visu := fb_Cart);<br>
The application's logic takes its zones and limit areas from m_Active, not from its own constants.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Config is the contract structure the gateway reads and writes at the path in the config manifest.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Config 1.1.0 ¦ 2026-11-10 ¦ J.Willner ¦ New<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_ConfigCartesian EXTENDS _FB_ConfigComponent
VAR_OUTPUT
	vo_Config							: ST_ConfigCartesian;	// contract structure of the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_Active" Id="{12c5cddf-2026-4f4a-9465-e9dfc1501bd2}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
All effective values (zones, limit areas, ...), for the application's own logic.<br>
****************************************************************************************************)
METHOD m_Active : ST_ConfigCartesianParam]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Active := vo_Config.stActive;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ComponentType" Id="{2e46e80d-69b4-42ac-b45e-1ef0b1c7d454}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
A Cartesian robot.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : SynVisu.E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := SynVisu.E_VisuComponentType.CARTESIAN;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Cycle" Id="{8c4e1e74-3d60-4694-8425-83dec0839063}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Every cycle: handles a staged set or a reset (a set only while vi_b_ApplyAllowed), keeps the active set in<br>
vio_Set and gives the effective values in vo_Config.stActive: the active set while one is valid, else the<br>
program values vio_Default.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE in the cycle a set was taken over or reset.<br>
****************************************************************************************************)
METHOD m_Cycle : BOOL
VAR_IN_OUT CONSTANT
	vio_Default							: ST_ConfigCartesianParam;	// the application's program values
END_VAR
VAR_IN_OUT
	vio_Set								: ST_ConfigCartesianSet;	// the application's VAR PERSISTENT active set
END_VAR
VAR_INPUT
	vi_b_ApplyAllowed					: BOOL;	// [-] a staged set may be taken over now, e.g. while the machine stands
END_VAR
VAR
	str_TempRejection					: STRING(80);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Cycle := FALSE;
CASE m_Staging(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vi_b_ApplyAllowed := vi_b_ApplyAllowed,
	vi_udn_ActiveVersion := SEL(vio_Set.bValid, 0, vio_Set.nVersion)) OF
	E_ConfigAction.RESET:
		vio_Set.bValid := FALSE;
		m_Handled(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vi_str_Rejection := '');
		m_Cycle := TRUE;
	E_ConfigAction.TAKE_OVER:
		str_TempRejection := m_InvalidZones(vio_aZones := vo_Config.stStaged.aZones, vi_un_Count := vo_Config.stStaged.nZoneCount);
		IF str_TempRejection = '' THEN
			vio_Set.nLastVersion := vio_Set.nLastVersion + 1;
			vio_Set.nVersion := vio_Set.nLastVersion;
			vio_Set.stParam := vo_Config.stStaged;
			vio_Set.bValid := TRUE;
			m_Cycle := TRUE;
		END_IF
		m_Handled(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vi_str_Rejection := str_TempRejection);
END_CASE


(****************************************************************************************************
EFFECTIVE VALUES
****************************************************************************************************)
IF vio_Set.bValid THEN
	vo_Config.stActive := vio_Set.stParam;
	vo_Config.stStatus.nActiveVersion := vio_Set.nVersion;
ELSE
	vo_Config.stActive := vio_Default;
	vo_Config.stStatus.nActiveVersion := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOn" Id="{6923112d-18ac-4848-8212-72e3f21b6e6c}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective origin shift, limit areas and zones on to the robot's Syn_Visu FB, so the visualisation<br>
shows what the machine uses. The pose goes with the application's own m_Configure call (with the strokes and<br>
rail height, hardware): vi_Pose := m_Pose(). Call it after m_Cycle, every cycle; Syn_Visu's config version only<br>
changes when a value does.<br>
****************************************************************************************************)
METHOD m_PassOn : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuCartesian;	// the robot's Syn_Visu FB
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOn := TRUE;
vio_Visu.m_SetOriginShift(vi_lr_X := vo_Config.stActive.stOriginShift.fX, vi_lr_Y := vo_Config.stActive.stOriginShift.fY,
	vi_lr_Z := vo_Config.stActive.stOriginShift.fZ);
m_PassOnLimitAreas(vio_Visu := vio_Visu, vio_LimitArea := vo_Config.stActive.stLimitArea,
	vio_TcpLimitArea := vo_Config.stActive.stTcpLimitArea);
m_PassOnZones(vio_Visu := vio_Visu, vio_aZones := vo_Config.stActive.aZones, vi_un_Count := vo_Config.stActive.nZoneCount,
	vi_un_VisuCount := vio_Visu.vo_Visu.stConfig.nZoneCount);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Pose" Id="{8239bb64-4f45-4120-9dfc-c847d99fd5ea}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Effective pose of the axis origin (MCS), for the application's logic and its Syn_Visu m_Configure call.<br>
****************************************************************************************************)
METHOD m_Pose : SynVisu.ST_VisuPose]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Pose := vo_Config.stActive.stPose;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>