<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_FB_ConfigXtsGantry" Id="{ed54a77e-dc32-4038-bb44-c05fa4992e93}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Parameter set of one XTS gantry (ADR 0017): its pose, origin shift, track modules, zones, gripper fingers,<br>
limit area and TCP limit area, written by the configurator, taken over when the application allows it.<br>
Typical cycle:<br>
  fb_IdhParam.m_Register(vio_Manifest := GVL_Config.stManifest, vi_udn_Id := fb_Idh.m_Id());<br>
  fb_IdhParam.m_Cycle(vio_Default := IdhDefault, vio_Set := IdhSet, vi_b_ApplyAllowed := b_Stopped);<br>
  fb_Idh.m_Configure(vi_lr_XMin := 0, ...);<br>
  fb_IdhParam.m_PassOn(vio_Visu := fb_Idh);<br>
The application's logic takes its track and zones from m_Active, not from its own constants.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Config is the contract structure the gateway reads and writes at the path in the config manifest.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Config 1.1.0 ¦ 2026-11-10 ¦ J.Willner ¦ New<br>
Syn_Config 2.0.0 ¦ 2026-11-11 ¦ J.Willner ¦ Gripper fingers with their offsets (ADR 0018)<br>
Syn_Config 2.3.0 ¦ 2026-11-14 ¦ J.Willner ¦ m_Cycle through m_HandleStaging; m_PassOn passes the pose on<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_ConfigXtsGantry EXTENDS _FB_ConfigComponent
VAR_OUTPUT
	vo_Config							: ST_ConfigXtsGantry;	// contract structure of the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_Active" Id="{b969d9ad-11e9-433b-8606-9cecdbf91212}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
All effective values (track modules, zones, limit areas, ...), for the application's own logic.<br>
****************************************************************************************************)
METHOD m_Active : ST_ConfigXtsGantryParam]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Active := vo_Config.stActive;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ComponentType" Id="{bcf98c52-1580-4f4d-b9dc-bfcd557ef55f}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
An XTS gantry.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : SynVisu.E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := SynVisu.E_VisuComponentType.XTS_GANTRY;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Cycle" Id="{0be186c6-e192-4d1f-bb7d-56e5587fffda}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Every cycle: handles a staged set or a reset (a set only while vi_b_ApplyAllowed), keeps the active set in<br>
vio_Set and gives the effective values in vo_Config.stActive: the active set while one is valid, else the<br>
program values vio_Default.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE in the cycle a set was taken over or reset.<br>
****************************************************************************************************)
METHOD m_Cycle : BOOL
VAR_IN_OUT CONSTANT
	vio_Default							: ST_ConfigXtsGantryParam;	// the application's program values
END_VAR
VAR_IN_OUT
	vio_Set								: ST_ConfigXtsGantrySet;	// the application's VAR PERSISTENT active set
END_VAR
VAR_INPUT
	vi_b_ApplyAllowed					: BOOL;	// [-] a staged set may be taken over now, e.g. while the machine stands
END_VAR
VAR
	b_TempTakeOver						: BOOL;	// the staged set was taken over: copy it
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Cycle := m_HandleStaging(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vio_b_Valid := vio_Set.bValid,
	vio_udn_Version := vio_Set.nVersion, vio_udn_LastVersion := vio_Set.nLastVersion, vi_b_ApplyAllowed := vi_b_ApplyAllowed,
	vo_b_TakeOver => b_TempTakeOver);
IF b_TempTakeOver THEN
	vio_Set.stParam := vo_Config.stStaged;
END_IF


(****************************************************************************************************
EFFECTIVE VALUES
****************************************************************************************************)
IF vio_Set.bValid THEN
	vo_Config.stActive := vio_Set.stParam;
ELSE
	vo_Config.stActive := vio_Default;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InvalidStaged" Id="{7fb9424c-395e-4b51-a81e-a09cf3dce25c}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Why a staged set cannot be taken over; '' when it can: a track without modules, more modules, zones or fingers<br>
than the lists hold, a module without a length, a zone on no conveyor (id 0), or a finger without a diameter or<br>
height.<br>
****************************************************************************************************)
METHOD PROTECTED m_InvalidStaged : STRING(80)]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_InvalidStaged := m_InvalidModules(vio_aModules := vo_Config.stStaged.aModules, vi_un_Count := vo_Config.stStaged.nModuleCount);
IF m_InvalidStaged = '' THEN
	m_InvalidStaged := m_InvalidZones(vio_aZones := vo_Config.stStaged.aZones, vi_un_Count := vo_Config.stStaged.nZoneCount);
END_IF
IF m_InvalidStaged = '' THEN
	m_InvalidStaged := m_InvalidFingers(vio_aFingers := vo_Config.stStaged.aFingers, vi_un_Count := vo_Config.stStaged.nFingerCount);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOn" Id="{0f708575-b806-464f-82f2-de26420fcafe}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective pose, origin shift, track modules, limit areas, zones and fingers on to the gantry's<br>
Syn_Visu FB, so the visualisation shows what the machine uses; the strokes and tool offsets (hardware) stay with<br>
the application's m_Configure call. Call it after m_Cycle, every cycle; Syn_Visu's config version only changes<br>
when a value does.<br>
****************************************************************************************************)
METHOD m_PassOn : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuXtsGantry;	// the gantry's Syn_Visu FB
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOn := TRUE;
vio_Visu.m_SetPose(vi_Pose := vo_Config.stActive.stPose);
vio_Visu.m_SetOriginShift(vi_lr_X := vo_Config.stActive.stOriginShift.fX, vi_lr_Y := vo_Config.stActive.stOriginShift.fY,
	vi_lr_Z := vo_Config.stActive.stOriginShift.fZ);
m_PassOnModules(vio_Visu := vio_Visu, vio_aModules := vo_Config.stActive.aModules,
	vi_un_Count := vo_Config.stActive.nModuleCount, vi_un_VisuCount := vio_Visu.vo_Visu.stConfig.nModuleCount);
m_PassOnLimitAreas(vio_Visu := vio_Visu, vio_LimitArea := vo_Config.stActive.stLimitArea,
	vio_TcpLimitArea := vo_Config.stActive.stTcpLimitArea);
m_PassOnZones(vio_Visu := vio_Visu, vio_aZones := vo_Config.stActive.aZones, vi_un_Count := vo_Config.stActive.nZoneCount,
	vi_un_VisuCount := vio_Visu.vo_Visu.stConfig.nZoneCount);
m_PassOnFingers(vio_Visu := vio_Visu, vio_aFingers := vo_Config.stActive.aFingers,
	vi_un_Count := vo_Config.stActive.nFingerCount, vi_un_VisuCount := vio_Visu.vo_Visu.stConfig.nFingerCount);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Pose" Id="{4146e2ed-22f3-4949-9982-0ed1fc2ecbb4}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Effective pose of the track start (MCS), for the application's logic.<br>
****************************************************************************************************)
METHOD m_Pose : SynVisu.ST_VisuPose]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Pose := vo_Config.stActive.stPose;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>