<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_FB_ConfigXtsGantry" Id="{ed54a77e-dc32-4038-bb44-c05fa4992e93}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Parameter set of one XTS gantry (ADR 0017): its pose, origin shift, track modules, zones, limit area and TCP<br>
limit area, written by the configurator, taken over when the application allows it. Typical cycle:<br>
  fb_IdhParam.m_Register(vio_Manifest := GVL_Config.stManifest, vi_udn_Id := fb_Idh.m_Id());<br>
  fb_IdhParam.m_Cycle(vio_Default := IdhDefault, vio_Set := IdhSet, vi_b_ApplyAllowed := b_Stopped);<br>
  fb_Idh.m_Configure(vi_Pose := fb_IdhParam.m_Pose(), vi_lr_XMin := 0, ...);<br>
  fb_IdhParam.m_PassOn(vio_Visu := fb_Idh);<br>
The application's logic takes its track and zones from m_Active, not from its own constants.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Config is the contract structure the gateway reads and writes at the path in the config manifest.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Config 1.1.0 ¦ 2026-11-10 ¦ J.Willner ¦ New<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_ConfigXtsGantry EXTENDS _FB_ConfigComponent
VAR_OUTPUT
	vo_Config							: ST_ConfigXtsGantry;	// contract structure of the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_Active" Id="{b969d9ad-11e9-433b-8606-9cecdbf91212}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
All effective values (track modules, zones, limit areas, ...), for the application's own logic.<br>
****************************************************************************************************)
METHOD m_Active : ST_ConfigXtsGantryParam]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Active := vo_Config.stActive;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ComponentType" Id="{bcf98c52-1580-4f4d-b9dc-bfcd557ef55f}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
An XTS gantry.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : SynVisu.E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := SynVisu.E_VisuComponentType.XTS_GANTRY;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Cycle" Id="{0be186c6-e192-4d1f-bb7d-56e5587fffda}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Every cycle: handles a staged set or a reset (a set only while vi_b_ApplyAllowed), keeps the active set in<br>
vio_Set and gives the effective values in vo_Config.stActive: the active set while one is valid, else the<br>
program values vio_Default.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE in the cycle a set was taken over or reset.<br>
****************************************************************************************************)
METHOD m_Cycle : BOOL
VAR_IN_OUT CONSTANT
	vio_Default							: ST_ConfigXtsGantryParam;	// the application's program values
END_VAR
VAR_IN_OUT
	vio_Set								: ST_ConfigXtsGantrySet;	// the application's VAR PERSISTENT active set
END_VAR
VAR_INPUT
	vi_b_ApplyAllowed					: BOOL;	// [-] a staged set may be taken over now, e.g. while the machine stands
END_VAR
VAR
	str_TempRejection					: STRING(80);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Cycle := FALSE;
CASE m_Staging(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vi_b_ApplyAllowed := vi_b_ApplyAllowed,
	vi_udn_ActiveVersion := SEL(vio_Set.bValid, 0, vio_Set.nVersion)) OF
	E_ConfigAction.RESET:
		vio_Set.bValid := FALSE;
		m_Handled(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vi_str_Rejection := '');
		m_Cycle := TRUE;
	E_ConfigAction.TAKE_OVER:
		str_TempRejection := m_Invalid(vio_Param := vo_Config.stStaged);
		IF str_TempRejection = '' THEN
			vio_Set.nLastVersion := vio_Set.nLastVersion + 1;
			vio_Set.nVersion := vio_Set.nLastVersion;
			vio_Set.stParam := vo_Config.stStaged;
			vio_Set.bValid := TRUE;
			m_Cycle := TRUE;
		END_IF
		m_Handled(vio_Staging := vo_Config.stStaging, vio_Status := vo_Config.stStatus, vi_str_Rejection := str_TempRejection);
END_CASE


(****************************************************************************************************
EFFECTIVE VALUES
****************************************************************************************************)
IF vio_Set.bValid THEN
	vo_Config.stActive := vio_Set.stParam;
	vo_Config.stStatus.nActiveVersion := vio_Set.nVersion;
ELSE
	vo_Config.stActive := vio_Default;
	vo_Config.stStatus.nActiveVersion := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Invalid" Id="{7fb9424c-395e-4b51-a81e-a09cf3dce25c}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Why a staged set cannot be taken over; '' when it can: a track without modules, more modules or zones than the<br>
lists hold, a module without a length, or a zone on no conveyor (id 0).<br>
****************************************************************************************************)
METHOD PRIVATE m_Invalid : STRING(80)
VAR_IN_OUT CONSTANT
	vio_Param							: ST_ConfigXtsGantryParam;	// the staged set
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Invalid := m_InvalidModules(vio_aModules := vio_Param.aModules, vi_un_Count := vio_Param.nModuleCount);
IF m_Invalid = '' THEN
	m_Invalid := m_InvalidZones(vio_aZones := vio_Param.aZones, vi_un_Count := vio_Param.nZoneCount);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PassOn" Id="{0f708575-b806-464f-82f2-de26420fcafe}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Passes the effective origin shift, track modules, limit areas and zones on to the gantry's Syn_Visu FB, so the<br>
visualisation shows what the machine uses. The pose goes with the application's own m_Configure call (with the<br>
strokes and tool offsets, hardware): vi_Pose := m_Pose(). Call it after m_Cycle, every cycle; Syn_Visu's config<br>
version only changes when a value does.<br>
****************************************************************************************************)
METHOD m_PassOn : BOOL
VAR_IN_OUT
	vio_Visu							: SynVisu._FB_VisuXtsGantry;	// the gantry's Syn_Visu FB
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_PassOn := TRUE;
vio_Visu.m_SetOriginShift(vi_lr_X := vo_Config.stActive.stOriginShift.fX, vi_lr_Y := vo_Config.stActive.stOriginShift.fY,
	vi_lr_Z := vo_Config.stActive.stOriginShift.fZ);
m_PassOnModules(vio_Visu := vio_Visu, vio_aModules := vo_Config.stActive.aModules,
	vi_un_Count := vo_Config.stActive.nModuleCount, vi_un_VisuCount := vio_Visu.vo_Visu.stConfig.nModuleCount);
m_PassOnLimitAreas(vio_Visu := vio_Visu, vio_LimitArea := vo_Config.stActive.stLimitArea,
	vio_TcpLimitArea := vo_Config.stActive.stTcpLimitArea);
m_PassOnZones(vio_Visu := vio_Visu, vio_aZones := vo_Config.stActive.aZones, vi_un_Count := vo_Config.stActive.nZoneCount,
	vi_un_VisuCount := vio_Visu.vo_Visu.stConfig.nZoneCount);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Pose" Id="{4146e2ed-22f3-4949-9982-0ed1fc2ecbb4}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Effective pose of the track start (MCS), for the application's logic and its Syn_Visu m_Configure call.<br>
****************************************************************************************************)
METHOD m_Pose : SynVisu.ST_VisuPose]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Pose := vo_Config.stActive.stPose;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>