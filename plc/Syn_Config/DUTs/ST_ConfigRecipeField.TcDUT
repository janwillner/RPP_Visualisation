<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ConfigRecipeField" Id="{ef20976f-dffd-4d78-b9b9-8c3342fbdf18}">
    <Declaration><![CDATA[TYPE ST_ConfigRecipeField :
STRUCT
	(* One field of the machine's recipe as the application declares it with _FB_ConfigMachine.m_DeclareField
	   (config protocol 3, ADR 0022), m_SetText and m_SetVisibleWhen (config protocol 4, #49). The gateway reads the
	   declarations once at discovery. *)
	sName : STRING(31); // unique in the recipe, e.g. 'BeltSpeed'
	nGroup : UDINT; // manifest id of the Syn_Visu component the field belongs to, 0 = the whole machine
	eType : E_ConfigFieldType;
	sUnit : STRING(15); // e.g. 'mm/s', '' = none
	fMin : LREAL; // smallest value of a NUMBER or INTEGER field
	fMax : LREAL; // largest value of a NUMBER or INTEGER field
	fProgramValue : LREAL; // the application's own value, which applies while no recipe is active
	nChoiceCount : UINT; // named values of a CHOICE field
	aChoices : ARRAY[0..CONFIG_GlobalConst_Param.CONFIG_un_MAX_CHOICES - 1] OF STRING(31); // their names, from value 0
	sLabel : STRING(40); // what the Simulator calls the field, '' = its name put into words
	sDescription : STRING(160); // what the field is for, shown in its tooltip, '' = none
	nVisibleField : UINT; // the field (from 1) it applies only with, 0 = always
	nVisibleValue : DINT; // the value nVisibleField must have: a SWITCH's 0 / 1, a CHOICE's number, a whole number
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>