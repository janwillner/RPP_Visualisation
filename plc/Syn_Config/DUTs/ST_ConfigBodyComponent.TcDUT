<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ConfigBodyComponent" Id="{3ae01d4b-8c59-4f2c-bf57-96767781d2eb}">
    <Declaration><![CDATA[TYPE ST_ConfigBodyComponent :
STRUCT
	(* vo_Config of _FB_ConfigVision, _FB_ConfigSensor and _FB_ConfigStation: the gateway writes stStaging and
	   stStaged, reads stStatus and stActive. *)
	stStaging : ST_ConfigStaging;
	stStaged : ST_ConfigBodyComponentParam;
	stStatus : ST_ConfigStatus;
	stActive : ST_ConfigBodyComponentParam; // effective values: the active set while one is valid, else the program values
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>