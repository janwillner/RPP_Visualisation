<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ConfigXtsLoopSet" Id="{60f8664d-d423-41b8-8f4a-2464bc470e00}">
    <Declaration><![CDATA[TYPE ST_ConfigXtsLoopSet :
STRUCT
	(* An XTS loop's active parameter set as the application keeps it, in a VAR PERSISTENT variable passed to
	   _FB_ConfigXtsLoop.m_Cycle. *)
	bValid : BOOL; // FALSE: no set active, the program values apply
	nVersion : UDINT; // version of stParam
	nLastVersion : UDINT; // last version handed out; versions never repeat, also after a reset
	stParam : ST_ConfigXtsLoopParam;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>