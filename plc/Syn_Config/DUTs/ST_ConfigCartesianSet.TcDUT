<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ConfigCartesianSet" Id="{2c3bbbb3-8f2e-4b64-928f-f11bbb3d3b25}">
    <Declaration><![CDATA[TYPE ST_ConfigCartesianSet :
STRUCT
	(* A Cartesian robot's active parameter set as the application keeps it, in a VAR PERSISTENT variable passed to
	   _FB_ConfigCartesian.m_Cycle. *)
	bValid : BOOL; // FALSE: no set active, the program values apply
	nVersion : UDINT; // version of stParam
	nLastVersion : UDINT; // last version handed out; versions never repeat, also after a reset
	stParam : ST_ConfigCartesianParam;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>