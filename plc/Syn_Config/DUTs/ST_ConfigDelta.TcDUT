<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ConfigDelta" Id="{b2a07101-f68b-40f7-ac95-3c9f87e825ce}">
    <Declaration><![CDATA[TYPE ST_ConfigDelta :
STRUCT
	(* vo_Config of _FB_ConfigDelta: the gateway writes stStaging and stStaged, reads stStatus and stActive. *)
	stStaging : ST_ConfigStaging;
	stStaged : ST_ConfigDeltaParam;
	stStatus : ST_ConfigStatus;
	stActive : ST_ConfigDeltaParam; // effective values: the active set while one is valid, else the program values
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>