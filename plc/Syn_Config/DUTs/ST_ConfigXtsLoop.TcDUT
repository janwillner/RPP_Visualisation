  <DUT Name="ST_ConfigXtsLoop" Id="{eb5169c6-4b3f-4ab4-8c69-147e8b10381a}">
    <Declaration><![CDATA[TYPE ST_ConfigXtsLoop :
STRUCT
	(* vo_Config of _FB_ConfigXtsLoop: the gateway writes stStaging and stStaged, reads stStatus and stActive. *)
