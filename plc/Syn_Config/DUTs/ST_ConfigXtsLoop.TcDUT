	stStaged : ST_ConfigXtsLoopParam;
	stStatus : ST_ConfigStatus;
	stActive : ST_ConfigXtsLoopParam; // effective values: the active set while one is valid, else the program values
END_STRUCT
END_TYPE]]></Declaration>
