<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_ConfigCommandResult" Id="{7a6dbec0-c5d4-4d37-acf1-895c02c8ec20}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_ConfigCommandResult :
(
	(* What the application made of the last machine command. Values are part of the gateway contract: append, never
	   renumber. *)
	NONE := 0,		// nothing asked since the PLC started
	ACCEPTED := 1,
	REJECTED := 2	// ST_ConfigCommandStatus.sMessage says why
) UINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>