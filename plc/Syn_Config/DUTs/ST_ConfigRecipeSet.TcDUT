<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ConfigRecipeSet" Id="{e30f7198-8e49-4b62-b64d-31f3d00916e3}">
    <Declaration><![CDATA[TYPE ST_ConfigRecipeSet :
STRUCT
	(* The machine's active recipe as the application keeps it, in a VAR PERSISTENT variable passed to
	   _FB_ConfigMachine.m_Cycle. Values by field index: keep the fields' order, add new ones at the end. *)
	bValid : BOOL; // FALSE: no recipe active, the program values apply
	nVersion : UDINT; // version of aValues
	nLastVersion : UDINT; // last version handed out; versions never repeat, also after a reset
	aValues : ARRAY[0..CONFIG_GlobalConst_Param.CONFIG_un_MAX_RECIPE_FIELDS - 1] OF LREAL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>