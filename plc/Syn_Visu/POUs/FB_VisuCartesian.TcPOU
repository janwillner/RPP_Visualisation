<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_VisuCartesian" Id="{9fe9841a-c288-4098-b60d-62e20af6fee3}" SpecialFunc="None">
    <Declaration><![CDATA[(* One visualised Cartesian robot: linear X, Y, Z axes ending at a gripper flange.
   Typical cycle:
     fbCartesian.Register(GVL_Visu.stManifest, 40, 'Cartesian', 'MAIN.fbCartesian.stVisu');
     fbCartesian.Configure(stPose, fXMin := 0, fXMax := 1200, fYMin := 0, fYMax := 1000, fZMin := -600, fZMax := 0,
         fRailHeight := 1200);
     fbCartesian.SetFinger(nFinger := 1, fDiameter := 40, fHeight := 40);
     fbCartesian.SetZone(nConveyorId := 7, eKind := E_VisuZoneKind.PICK, fStart := 1000, fEnd := 2000);
     fbCartesian.SetAxes(fX := ..., fY := ..., fZ := ...);
     fbCartesian.SetFingerState(nFinger := 1, stPose := stCupPose, bActive := bVacuum);
   Only actual values are reported; tool rotations (e.g. C and A) show only through the finger poses, absolute in
   the MCS. The config methods may be called every cycle; the config version only changes
   when a value does. The gateway reads stVisu at the path given to Register. *)
FUNCTION_BLOCK FB_VisuCartesian EXTENDS FB_VisuComponent
VAR
	stVisu : ST_VisuCartesian; // contract structure read by the gateway; do not write directly
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ApplyConfig" Id="{66d1d924-3eb7-4ac5-b3ce-821a28e4d34c}">
      <Declaration><![CDATA[(* Takes over stNew and increments the config version if it differs from the current config. TRUE if changed. *)
METHOD PRIVATE ApplyConfig : BOOL
VAR_IN_OUT
	stNew : ST_VisuCartesianConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ApplyConfig := Tc2_System.MEMCMP(ADR(stNew), ADR(stVisu.stConfig), SIZEOF(stNew)) <> 0;
IF ApplyConfig THEN
	stVisu.stConfig := stNew;
	NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearFingers" Id="{4f29dbaa-c011-4c75-be33-2d41fec6472d}">
      <Declaration><![CDATA[(* Removes the gripper definition. TRUE if there was one. *)
METHOD ClearFingers : BOOL
VAR
	stNew : ST_VisuCartesianConfig;
	stEmpty : ST_VisuFinger;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stNew := stVisu.stConfig;
FOR nIndex := 0 TO GVL_VisuParam.nMaxFingers - 1 DO
	stNew.aFingers[nIndex] := stEmpty;
END_FOR
stNew.nFingerCount := 0;
ClearFingers := ApplyConfig(stNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearZones" Id="{73f29c14-bc77-4e48-b2ed-48ea01db9c2b}">
      <Declaration><![CDATA[(* Removes all pick and place zones. TRUE if there were any. *)
METHOD ClearZones : BOOL
VAR
	stNew : ST_VisuCartesianConfig;
	stEmpty : ST_VisuZone;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stNew := stVisu.stConfig;
FOR nIndex := 0 TO GVL_VisuParam.nMaxZones - 1 DO
	stNew.aZones[nIndex] := stEmpty;
END_FOR
stNew.nZoneCount := 0;
ClearZones := ApplyConfig(stNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ComponentType" Id="{e07419cf-3f2c-4d03-8d98-2bdbfe9f69f0}">
      <Declaration><![CDATA[METHOD PROTECTED ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComponentType := E_VisuComponentType.CARTESIAN;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{037f6f17-ed59-4182-aba6-cc78218dd5eb}">
      <Declaration><![CDATA[(* Sets pose, strokes and rail height. TRUE if anything changed. *)
METHOD Configure : BOOL
VAR_INPUT
	stPose : ST_VisuPose; // MCS, axis origin X = Y = 0 with Z up
	fXMin : LREAL; // mm
	fXMax : LREAL; // mm
	fYMin : LREAL; // mm
	fYMax : LREAL; // mm
	fZMin : LREAL; // mm
	fZMax : LREAL; // mm
	fRailHeight : LREAL; // mm, top of the rails above the local origin
END_VAR
VAR
	stNew : ST_VisuCartesianConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stNew := stVisu.stConfig;
stNew.stPose := stPose;
stNew.fXMin := fXMin;
stNew.fXMax := fXMax;
stNew.fYMin := fYMin;
stNew.fYMax := fYMax;
stNew.fZMin := fZMin;
stNew.fZMax := fZMax;
stNew.fRailHeight := fRailHeight;
Configure := ApplyConfig(stNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAxes" Id="{38bc9b44-0eb3-4b11-ad7d-22f4053b9b0e}">
      <Declaration><![CDATA[(* Reports the axes' actual values and the gripper. Call once per cycle; it also stamps the state with the cycle's
   DC time. *)
METHOD SetAxes : BOOL
VAR_INPUT
	fX : LREAL; // mm
	fY : LREAL; // mm
	fZ : LREAL; // mm
	bGripperActive : BOOL := FALSE; // used only when no fingers are configured
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stVisu.stState.fX := fX;
stVisu.stState.fY := fY;
stVisu.stState.fZ := fZ;
stVisu.stState.bGripperActive := bGripperActive;
stVisu.stState.nTimestamp := DcTime();
SetAxes := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetFinger" Id="{076cf92a-8594-49fd-99ed-7160f2717ff5}">
      <Declaration><![CDATA[(* Defines gripper finger nFinger (1-based): a cylinder hanging from the finger's pose along its local -Z. The finger
   count grows to nFinger. FALSE outside 1..GVL_VisuParam.nMaxFingers. *)
METHOD SetFinger : BOOL
VAR_INPUT
	nFinger : UINT; // 1-based, as a product's nFingerId
	fDiameter : LREAL; // mm
	fHeight : LREAL; // mm, along the finger's local -Z
END_VAR
VAR
	stNew : ST_VisuCartesianConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetFinger := FALSE;
IF nFinger = 0 OR nFinger > GVL_VisuParam.nMaxFingers THEN
	RETURN;
END_IF
stNew := stVisu.stConfig;
stNew.aFingers[nFinger - 1].fDiameter := fDiameter;
stNew.aFingers[nFinger - 1].fHeight := fHeight;
stNew.nFingerCount := MAX(stNew.nFingerCount, nFinger);
ApplyConfig(stNew);
SetFinger := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetFingerState" Id="{7be2b3a6-d0ab-4b98-b468-b8c10296c8cb}">
      <Declaration><![CDATA[(* Reports finger nFinger (1-based): the pose of its frame (centre of its top face), absolute in the MCS, and whether it
   grips. Call once per cycle per configured finger. FALSE outside 1..GVL_VisuParam.nMaxFingers. *)
METHOD SetFingerState : BOOL
VAR_INPUT
	nFinger : UINT; // 1-based
	stPose : ST_VisuPose; // MCS
	bActive : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetFingerState := nFinger > 0 AND nFinger <= GVL_VisuParam.nMaxFingers;
IF SetFingerState THEN
	stVisu.stState.aFingerStates[nFinger - 1].stPose := stPose;
	stVisu.stState.aFingerStates[nFinger - 1].bActive := bActive;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetZone" Id="{8ac94b18-81ff-4dab-a603-d70635561648}">
      <Declaration><![CDATA[(* Adds a pick or place zone, or updates the one for the same conveyor and kind.
   FALSE for nConveyorId = 0 or a full list. *)
METHOD SetZone : BOOL
VAR_INPUT
	nConveyorId : UDINT; // manifest id of the conveyor
	eKind : E_VisuZoneKind;
	fStart : LREAL; // mm along the conveyor from its start (belt coordinates, not MCS)
	fEnd : LREAL; // mm along the conveyor from its start
	fAllocationOffset : LREAL := 0; // mm before fEnd up to which products may be allocated; 0 = no limit
END_VAR
VAR
	stNew : ST_VisuCartesianConfig;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetZone := FALSE;
IF nConveyorId = 0 THEN
	RETURN;
END_IF
stNew := stVisu.stConfig;
nIndex := 0;
// ST evaluates both operands of AND: test the index before reading the array.
WHILE nIndex < stNew.nZoneCount DO
	IF stNew.aZones[nIndex].nConveyorId = nConveyorId AND stNew.aZones[nIndex].eKind = eKind THEN
		EXIT;
	END_IF
	nIndex := nIndex + 1;
END_WHILE
IF nIndex >= GVL_VisuParam.nMaxZones THEN
	RETURN;
END_IF
IF nIndex = stNew.nZoneCount THEN
	stNew.nZoneCount := stNew.nZoneCount + 1;
END_IF
stNew.aZones[nIndex].nConveyorId := nConveyorId;
stNew.aZones[nIndex].eKind := eKind;
stNew.aZones[nIndex].fStart := fStart;
stNew.aZones[nIndex].fEnd := fEnd;
stNew.aZones[nIndex].fAllocationOffset := fAllocationOffset;
ApplyConfig(stNew);
SetZone := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>