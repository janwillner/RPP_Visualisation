<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="_FB_VisuCartesian" Id="{9130695c-9c08-45bf-a068-d9980c11bb84}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
One visualised Cartesian robot: linear X, Y, Z axes ending at a gripper flange; m_SetKinematics leaves out the<br>
Y axis (XZ, a fixed beam) or the Z axis (XY). Typical cycle:<br>
  fb_Cartesian.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 40, vi_str_Name := 'Cartesian');<br>
  fb_Cartesian.m_Configure(vi_Pose := RobotPose, vi_lr_XMin := 0, vi_lr_XMax := 1200, vi_lr_YMin := 0,<br>
      vi_lr_YMax := 1000, vi_lr_ZMin := -600, vi_lr_ZMax := 0, vi_lr_RailHeight := 1200);<br>
  fb_Cartesian.m_SetFinger(vi_un_Finger := 1, vi_lr_Diameter := 40, vi_lr_Height := 40);<br>
  fb_Cartesian.m_SetZone(vi_un_Zone := 1, vi_udn_ConveyorId := 7, vi_lr_Start := 1000, vi_lr_End := 2000,<br>
      vi_lr_AllocationOffset := 0, vi_lr_CcsOffset := 1000, vi_lr_StartY := 0, vi_lr_EndY := 0);<br>
  fb_Cartesian.m_SetAxes(vi_lr_X := ..., vi_lr_Y := ..., vi_lr_Z := ..., vi_b_GripperActive := ...);<br>
  fb_Cartesian.m_SetFingerState(vi_un_Finger := 1, vi_Pose := CupPose, vi_b_Active := b_Vacuum);<br>
Only actual values are reported; tool rotations (e.g. C and A) show only through the finger poses, absolute in<br>
the MCS. The config methods may be called every cycle; the config version only changes when a value does.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Visu is the contract structure the gateway reads at the path given to m_Register. Do not write it.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Visu 3.0.0  ¦ 2026-10-31 ¦ J.Willner ¦ Naming and layout after the TCAT programming guideline<br>
Syn_Visu 4.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ Zones and fingers from _FB_VisuRobot; m_SetZone by index, no kind<br>
Syn_Visu 9.2.0  ¦ 2026-11-07 ¦ J.Willner ¦ m_SetKinematics: without Y axis (XZ) or Z axis (XY)<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_VisuCartesian EXTENDS _FB_VisuRobot
VAR_OUTPUT
	vo_Visu								: ST_VisuCartesian;	// contract structure read by the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_ApplyConfig" Id="{66d1d924-3eb7-4ac5-b3ce-821a28e4d34c}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Takes over vio_New and increments the config version if it differs from the current config. TRUE if changed.<br>
****************************************************************************************************)
METHOD PRIVATE m_ApplyConfig : BOOL
VAR_IN_OUT
	vio_New								: ST_VisuCartesianConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ApplyConfig := Tc2_System.MEMCMP(ADR(vio_New), ADR(vo_Visu.stConfig), SIZEOF(vio_New)) <> 0;
IF m_ApplyConfig THEN
	vo_Visu.stConfig := vio_New;
	m_NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ComponentType" Id="{e07419cf-3f2c-4d03-8d98-2bdbfe9f69f0}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Manifest type: Cartesian robot.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := E_VisuComponentType.CARTESIAN;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Configure" Id="{037f6f17-ed59-4182-aba6-cc78218dd5eb}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets pose, strokes and rail height. TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_Configure : BOOL
VAR_INPUT
	vi_Pose								: ST_VisuPose;	// MCS, axis origin X = Y = 0 with Z up
	vi_lr_XMin							: LREAL;	// [mm]
	vi_lr_XMax							: LREAL;	// [mm]
	vi_lr_YMin							: LREAL;	// [mm]
	vi_lr_YMax							: LREAL;	// [mm]
	vi_lr_ZMin							: LREAL;	// [mm]
	vi_lr_ZMax							: LREAL;	// [mm]
	vi_lr_RailHeight					: LREAL;	// [mm] top of the rails above the local origin
END_VAR
VAR
	TempNew								: ST_VisuCartesianConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.stPose := vi_Pose;
TempNew.fXMin := vi_lr_XMin;
TempNew.fXMax := vi_lr_XMax;
TempNew.fYMin := vi_lr_YMin;
TempNew.fYMax := vi_lr_YMax;
TempNew.fZMin := vi_lr_ZMin;
TempNew.fZMax := vi_lr_ZMax;
TempNew.fRailHeight := vi_lr_RailHeight;
m_Configure := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Fingers" Id="{d004f390-06c2-4247-8666-c1909a7d713b}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The robot's gripper fingers for _FB_VisuRobot.m_SetFinger and m_ClearFingers.<br>
****************************************************************************************************)
METHOD PROTECTED m_Fingers : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Fingers						: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Count := ADR(vo_Visu.stConfig.nFingerCount);
vo_p_Fingers := ADR(vo_Visu.stConfig.aFingers);
m_Fingers := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_LimitArea" Id="{54d93c21-e5cb-44d9-8f91-ad37310e7114}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The robot's limit area and TCP limit area for _FB_VisuRobot.m_SetLimitArea, m_ClearLimitArea,<br>
m_SetTcpLimitArea and m_ClearTcpLimitArea.<br>
****************************************************************************************************)
METHOD PROTECTED m_LimitArea : BOOL
VAR_OUTPUT
	vo_p_LimitArea						: POINTER TO ST_VisuLimitArea;
	vo_p_TcpLimitArea					: POINTER TO ST_VisuLimitArea;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_LimitArea := ADR(vo_Visu.stConfig.stLimitArea);
vo_p_TcpLimitArea := ADR(vo_Visu.stConfig.stTcpLimitArea);
m_LimitArea := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetAxes" Id="{38bc9b44-0eb3-4b11-ad7d-22f4053b9b0e}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reports the axes' actual values and the gripper. Call once per cycle; it also stamps the state with the<br>
cycle's DC time.<br>
****************************************************************************************************)
METHOD m_SetAxes : BOOL
VAR_INPUT
	vi_lr_X								: LREAL;	// [mm]
	vi_lr_Y								: LREAL;	// [mm]
	vi_lr_Z								: LREAL;	// [mm]
	vi_b_GripperActive					: BOOL;	// used only when no fingers are configured, else FALSE
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_Visu.stState.fX := vi_lr_X;
vo_Visu.stState.fY := vi_lr_Y;
vo_Visu.stState.fZ := vi_lr_Z;
vo_Visu.stState.bGripperActive := vi_b_GripperActive;
vo_Visu.stState.nTimestamp := m_DcTime();
m_SetAxes := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetFault" Id="{db4178ba-2f09-4d70-9b7c-c0ea99001b41}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets or clears the fault of the robot: drawn red with the message while active. The fault stays until it<br>
is cleared with m_SetFault(vi_b_Active := FALSE, vi_str_Message := ''). TRUE.<br>
****************************************************************************************************)
METHOD m_SetFault : BOOL
VAR_INPUT
	vi_b_Active							: BOOL;	// TRUE: fault active
	vi_str_Message						: STRING(80);	// shown to the operator; empty shows 'Fault'
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_Visu.stState.stFault.bActive := vi_b_Active;
vo_Visu.stState.stFault.sMessage := vi_str_Message;
m_SetFault := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetFingerState" Id="{7be2b3a6-d0ab-4b98-b468-b8c10296c8cb}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reports finger vi_un_Finger (1-based): the pose of its frame (centre of its top face), absolute in the MCS,<br>
and whether it grips. Call once per cycle per configured finger.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE outside 1..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS.<br>
****************************************************************************************************)
METHOD m_SetFingerState : BOOL
VAR_INPUT
	vi_un_Finger						: UINT;	// [-] 1-based
	vi_Pose								: ST_VisuPose;	// MCS
	vi_b_Active							: BOOL;	// TRUE while the finger grips
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetFingerState := vi_un_Finger > 0 AND vi_un_Finger <= VISU_GlobalConst_Param.VISU_un_MAX_FINGERS;
IF m_SetFingerState THEN
	vo_Visu.stState.aFingerStates[vi_un_Finger - 1].stPose := vi_Pose;
	vo_Visu.stState.aFingerStates[vi_un_Finger - 1].bActive := vi_b_Active;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetKinematics" Id="{fa63ce61-9921-45ce-89ef-cbe5bd7900c7}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets which axes the robot has. XYZ (default): rails, bridge, carriage and column. XZ: no Y axis, a fixed beam<br>
along the local X at the rail height; the Y stroke and m_SetAxes vi_lr_Y are ignored. XY: no Z axis, the column<br>
has a fixed length and the flange stays at vi_lr_ZMin; vi_lr_ZMax and m_SetAxes vi_lr_Z are ignored.<br>
TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_SetKinematics : BOOL
VAR_INPUT
	vi_e_Axes							: E_VisuCartesianAxes;	// axes of the robot
END_VAR
VAR
	TempNew								: ST_VisuCartesianConfig;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.eAxes := vi_e_Axes;
m_SetKinematics := m_ApplyConfig(TempNew);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetOriginShift" Id="{2501dad8-487e-45df-9e39-a5b44ee2c6b7}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves the robot's shown coordinate system (origin triad, local measuring coordinates) away from axis zero<br>
(stPose), in the robot's local frame. Geometry and axis values stay relative to stPose. TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_SetOriginShift : BOOL
VAR_INPUT
	vi_lr_X								: LREAL;	// [mm] along the robot's local X
	vi_lr_Y								: LREAL;	// [mm] along the robot's local Y, 0 = none
	vi_lr_Z								: LREAL;	// [mm] along the robot's local Z, 0 = none
END_VAR
VAR
	TempNew								: ST_VisuCartesianConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.stOriginShift.fX := vi_lr_X;
TempNew.stOriginShift.fY := vi_lr_Y;
TempNew.stOriginShift.fZ := vi_lr_Z;
m_SetOriginShift := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Zones" Id="{8983adbf-7808-469c-b4e7-b089762645e9}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The robot's zones for _FB_VisuZoneComponent.m_SetZone and m_ClearZones.<br>
****************************************************************************************************)
METHOD PROTECTED m_Zones : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Zones							: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Count := ADR(vo_Visu.stConfig.nZoneCount);
vo_p_Zones := ADR(vo_Visu.stConfig.aZones);
m_Zones := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>