<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="F_VisuAddComponent" Id="{8087d312-3eb3-465d-8135-729f8adaa04d}" SpecialFunc="None">
    <Declaration><![CDATA[(* Registers a component in the manifest and increments nConfigVersion so the gateway rediscovers.
   Idempotent: registering an identical entry again returns TRUE without changing anything, so it is
   safe to call every cycle. Returns FALSE for nId = 0, type NONE, an id already used by a different
   entry, or a full manifest. *)
FUNCTION F_VisuAddComponent : BOOL
VAR_IN_OUT
	stManifest : ST_VisuManifest;
END_VAR
VAR_INPUT
	nId : UDINT; // unique, > 0
	eType : E_VisuComponentType;
	sName : STRING(80); // display name
	sPath : STRING(255); // symbol path of the ST_VisuConveyor / ST_VisuDelta instance, e.g. 'MAIN.stInfeed'
END_VAR
VAR
	nIndex : UINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_VisuAddComponent := FALSE;
IF nId = 0 OR eType = E_VisuComponentType.NONE THEN
	RETURN;
END_IF

nIndex := 0;
WHILE nIndex < stManifest.nCount AND nIndex < GVL_VisuParam.nMaxManifestEntries DO
	IF stManifest.aEntries[nIndex].nId = nId THEN
		F_VisuAddComponent := stManifest.aEntries[nIndex].eType = eType
			AND stManifest.aEntries[nIndex].sName = sName
			AND stManifest.aEntries[nIndex].sPath = sPath;
		RETURN;
	END_IF
	nIndex := nIndex + 1;
END_WHILE

IF stManifest.nCount >= GVL_VisuParam.nMaxManifestEntries THEN
	RETURN;
END_IF

stManifest.aEntries[stManifest.nCount].nId := nId;
stManifest.aEntries[stManifest.nCount].eType := eType;
stManifest.aEntries[stManifest.nCount].sName := sName;
stManifest.aEntries[stManifest.nCount].sPath := sPath;
stManifest.nCount := stManifest.nCount + 1;
stManifest.nConfigVersion := stManifest.nConfigVersion + 1;
F_VisuAddComponent := TRUE;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>