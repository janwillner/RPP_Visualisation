<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="F_VisuDcTime" Id="{9d0c41fc-bfa6-4bd0-80b6-56be2d3971a4}" SpecialFunc="None">
    <Declaration><![CDATA[(* Distributed-clock time of the calling task's current cycle in ns since 2000-01-01.
   Use it for the nTimestamp of every state structure written in that cycle.
   Returns 0 if the task index cannot be determined. *)
FUNCTION F_VisuDcTime : ULINT
VAR
	nTaskIndex : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[nTaskIndex := Tc2_System.GETCURTASKINDEXEX();
IF nTaskIndex > 0 THEN
	F_VisuDcTime := LINT_TO_ULINT(TwinCAT_SystemInfoVarList._TaskInfo[nTaskIndex].DcTaskTime);
ELSE
	F_VisuDcTime := 0;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>