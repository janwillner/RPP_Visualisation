<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_VisuXtsLoop" Id="{cf61fa8f-94a3-41d7-a3df-57398db0ff2a}" SpecialFunc="None">
    <Declaration><![CDATA[(* One visualised XTS loop (e.g. Fxx): movers circulating on a closed track of two straights and two 180 deg curves.
   Typical cycle:
     fbFxx.Register(GVL_Visu.stManifest, 20, 'Fxx', 'MAIN.fbFxx.stVisu');
     fbFxx.Configure(stPose, fStraightLength := 2400, fCurveRadius := 250, fToolOffset := 120,
         fMoverLength := 100, fMoverWidth := 60);
     fbFxx.SetZone(nConveyorId := 2, eKind := E_VisuZoneKind.PICK, fStart := 2200, fEnd := 2800);
     fbFxx.SetMoverCount(12);
     fbFxx.SetMover(nIndex := 0, nId := 1, fPosition := ...);
   Positions run along the loop from the start of the lower straight in the conveying direction (0..Perimeter()).
   The config methods may be called every cycle; the config version only changes when a value does.
   The gateway reads stVisu at the path given to Register. *)
FUNCTION_BLOCK FB_VisuXtsLoop EXTENDS FB_VisuComponent
VAR
	stVisu : ST_VisuXtsLoop; // contract structure read by the gateway; do not write directly
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ApplyConfig" Id="{0eaf0fcc-18b0-450e-beb2-2866f78d070b}">
      <Declaration><![CDATA[(* Takes over stNew and increments the config version if it differs from the current config. TRUE if changed. *)
METHOD PRIVATE ApplyConfig : BOOL
VAR_IN_OUT
	stNew : ST_VisuXtsLoopConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ApplyConfig := Tc2_System.MEMCMP(ADR(stNew), ADR(stVisu.stConfig), SIZEOF(stNew)) <> 0;
IF ApplyConfig THEN
	stVisu.stConfig := stNew;
	NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearZones" Id="{e4de1b0e-501d-40c8-8730-86fc423ce419}">
      <Declaration><![CDATA[(* Removes all pick and place zones. TRUE if there were any. *)
METHOD ClearZones : BOOL
VAR
	stNew : ST_VisuXtsLoopConfig;
	stEmpty : ST_VisuZone;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stNew := stVisu.stConfig;
FOR nIndex := 0 TO GVL_VisuParam.nMaxZones - 1 DO
	stNew.aZones[nIndex] := stEmpty;
END_FOR
stNew.nZoneCount := 0;
ClearZones := ApplyConfig(stNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ComponentType" Id="{93a82f2c-2c5f-4fac-95f8-4e7c57ac596a}">
      <Declaration><![CDATA[METHOD PROTECTED ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComponentType := E_VisuComponentType.XTS_LOOP;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{492b73d6-3330-4ccc-9ad1-ab0b078c4e12}">
      <Declaration><![CDATA[(* Sets pose, track geometry, tool offset and mover size. TRUE if anything changed. *)
METHOD Configure : BOOL
VAR_INPUT
	stPose : ST_VisuPose; // MCS, start of the lower straight; the loop stands in the local X-Z plane
	fStraightLength : LREAL; // mm
	fCurveRadius : LREAL; // mm
	fToolOffset : LREAL; // mm, tool point outwards from the track
	fMoverLength : LREAL; // mm, along the track
	fMoverWidth : LREAL; // mm
END_VAR
VAR
	stNew : ST_VisuXtsLoopConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stNew := stVisu.stConfig;
stNew.stPose := stPose;
stNew.fStraightLength := fStraightLength;
stNew.fCurveRadius := fCurveRadius;
stNew.fToolOffset := fToolOffset;
stNew.fMoverLength := fMoverLength;
stNew.fMoverWidth := fMoverWidth;
Configure := ApplyConfig(stNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Perimeter" Id="{3738bf5c-d889-4d83-85b1-93a2f8148d45}">
      <Declaration><![CDATA[(* Length of the loop as the visualisation computes it (curves as semicircles), mm. *)
METHOD Perimeter : LREAL]]></Declaration>
      <Implementation>
        <ST><![CDATA[Perimeter := 2.0 * stVisu.stConfig.fStraightLength + 2.0 * 3.141592653589793 * stVisu.stConfig.fCurveRadius;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMover" Id="{ef974285-e6df-4745-8924-8568b5647a44}">
      <Declaration><![CDATA[(* Reports one mover at entry nIndex and marks it valid. Call once per cycle per mover.
   FALSE if nIndex is outside the mover count set by SetMoverCount. *)
METHOD SetMover : BOOL
VAR_INPUT
	nIndex : UINT; // 0..SetMoverCount - 1
	nId : UDINT; // unique within the loop, > 0
	fPosition : LREAL; // mm along the loop from the start of the lower straight (0..Perimeter())
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMover := nIndex < stVisu.stState.nMoverCount;
IF SetMover THEN
	stVisu.stState.aMovers[nIndex].nId := nId;
	stVisu.stState.aMovers[nIndex].bValid := TRUE;
	stVisu.stState.aMovers[nIndex].fPosition := fPosition;
	stVisu.stState.nTimestamp := DcTime();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMoverCount" Id="{8509edf4-e085-4c6d-b439-ba49ee0e47f9}">
      <Declaration><![CDATA[(* Sets how many mover entries are evaluated (limited to GVL_VisuParam.nMaxMovers); entries beyond are invalidated.
   TRUE if nCount fitted. *)
METHOD SetMoverCount : BOOL
VAR_INPUT
	nCount : UINT;
END_VAR
VAR
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMoverCount := nCount <= GVL_VisuParam.nMaxMovers;
stVisu.stState.nMoverCount := MIN(nCount, GVL_VisuParam.nMaxMovers);
FOR nIndex := stVisu.stState.nMoverCount TO GVL_VisuParam.nMaxMovers - 1 DO
	stVisu.stState.aMovers[nIndex].bValid := FALSE;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetZone" Id="{eaa0a699-c44d-42dd-ad98-69862eabbe68}">
      <Declaration><![CDATA[(* Adds a pick or place zone, or updates the one for the same conveyor and kind.
   FALSE for nConveyorId = 0 or a full list. *)
METHOD SetZone : BOOL
VAR_INPUT
	nConveyorId : UDINT; // manifest id of the conveyor
	eKind : E_VisuZoneKind;
	fStart : LREAL; // mm along the conveyor from its start (belt coordinates, not MCS)
	fEnd : LREAL; // mm along the conveyor from its start
END_VAR
VAR
	stNew : ST_VisuXtsLoopConfig;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetZone := FALSE;
IF nConveyorId = 0 THEN
	RETURN;
END_IF
stNew := stVisu.stConfig;
nIndex := 0;
// ST evaluates both operands of AND: test the index before reading the array.
WHILE nIndex < stNew.nZoneCount DO
	IF stNew.aZones[nIndex].nConveyorId = nConveyorId AND stNew.aZones[nIndex].eKind = eKind THEN
		EXIT;
	END_IF
	nIndex := nIndex + 1;
END_WHILE
IF nIndex >= GVL_VisuParam.nMaxZones THEN
	RETURN;
END_IF
IF nIndex = stNew.nZoneCount THEN
	stNew.nZoneCount := stNew.nZoneCount + 1;
END_IF
stNew.aZones[nIndex].nConveyorId := nConveyorId;
stNew.aZones[nIndex].eKind := eKind;
stNew.aZones[nIndex].fStart := fStart;
stNew.aZones[nIndex].fEnd := fEnd;
ApplyConfig(stNew);
SetZone := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>