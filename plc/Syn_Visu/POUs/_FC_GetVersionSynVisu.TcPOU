<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="_FC_GetVersionSynVisu" Id="{b9c755e9-678d-4873-a9a4-f760cd7c0194}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Runtime-readable version of the Syn_Visu library.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Visu 3.0.0  ¦ 2026-10-31 ¦ J.Willner ¦ Naming and layout after the TCAT programming guideline<br>
Syn_Visu 3.1.0  ¦ 2026-10-31 ¦ J.Willner ¦ Faults of components and XTS movers (protocol 8)<br>
Syn_Visu 3.2.0  ¦ 2026-10-31 ¦ J.Willner ¦ _FB_VisuConveyor.m_MoveProduct<br>
Syn_Visu 3.3.0  ¦ 2026-10-31 ¦ J.Willner ¦ Zone CCS offset, origin shift per component (protocol 9)<br>
Syn_Visu 3.4.0  ¦ 2026-11-01 ¦ J.Willner ¦ m_LatchProduct: product state and robot (PLACED onto outfeeds)<br>
Syn_Visu 3.5.0  ¦ 2026-11-01 ¦ J.Willner ¦ Product shapes: box, cylinder, rounded box (protocol 10)<br>
Syn_Visu 4.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ Vision system, product sensor, zones without kind (protocol 11)<br>
Syn_Visu 5.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ XTS tracks of track modules, a fault per module (protocol 12)<br>
****************************************************************************************************)
FUNCTION _FC_GetVersionSynVisu : UINT
VAR_INPUT
	vi_n_VersionElement					: INT;	// [-] 1 = major, 2 = minor, 3 = revision
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE vi_n_VersionElement OF
	1: _FC_GetVersionSynVisu := 5;
	2: _FC_GetVersionSynVisu := 0;
	3: _FC_GetVersionSynVisu := 0;
ELSE
	_FC_GetVersionSynVisu := 16#FFFF;
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>