<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_VisuXtsGantry" Id="{cbc5d7d5-f717-41a5-b5eb-7240d64592ae}" SpecialFunc="None">
    <Declaration><![CDATA[(* One visualised XTS gantry (e.g. IDH): a straight XTS track on a common Z axis, each mover with an X axis and a
   rotating gripper. Typical cycle:
     fbIdh.Register(GVL_Visu.stManifest, 30, 'IDH', 'MAIN.fbIdh.stVisu');
     fbIdh.Configure(stPose, nModuleCount := 6, fModuleLength := 250, fXMin := 0, fXMax := 700, fZMin := -100,
         fZMax := 0, fCMin := -180, fCMax := 180, fToolOffsetX := 150, fToolOffsetZ := -400,
         fMoverLength := 155, fMoverWidth := 80);
     fbIdh.SetZone(nConveyorId := 3, eKind := E_VisuZoneKind.PICK, fStart := 1100, fEnd := 2600);
     fbIdh.SetZPosition(fZAxisActual);
     fbIdh.SetMoverCount(4);
     fbIdh.SetMover(nIndex := 0, nId := 1, fPosition := ..., fX := ..., fC := ..., bGripperActive := ...);
   Only actual values are reported. The config methods may be called every cycle; the config version only changes
   when a value does. The gateway reads stVisu at the path given to Register. *)
FUNCTION_BLOCK FB_VisuXtsGantry EXTENDS FB_VisuComponent
VAR
	stVisu : ST_VisuXtsGantry; // contract structure read by the gateway; do not write directly
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ApplyConfig" Id="{0d960d5b-dc1b-414d-932b-c3f84252a62b}">
      <Declaration><![CDATA[(* Takes over stNew and increments the config version if it differs from the current config. TRUE if changed. *)
METHOD PRIVATE ApplyConfig : BOOL
VAR_IN_OUT
	stNew : ST_VisuXtsGantryConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ApplyConfig := Tc2_System.MEMCMP(ADR(stNew), ADR(stVisu.stConfig), SIZEOF(stNew)) <> 0;
IF ApplyConfig THEN
	stVisu.stConfig := stNew;
	NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearZones" Id="{d03ce110-4fb5-45e1-b7c2-06b816354a86}">
      <Declaration><![CDATA[(* Removes all pick and place zones. TRUE if there were any. *)
METHOD ClearZones : BOOL
VAR
	stNew : ST_VisuXtsGantryConfig;
	stEmpty : ST_VisuZone;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stNew := stVisu.stConfig;
FOR nIndex := 0 TO GVL_VisuParam.nMaxZones - 1 DO
	stNew.aZones[nIndex] := stEmpty;
END_FOR
stNew.nZoneCount := 0;
ClearZones := ApplyConfig(stNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ComponentType" Id="{c3f8ceb9-4b60-46da-b663-f6415f498013}">
      <Declaration><![CDATA[METHOD PROTECTED ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComponentType := E_VisuComponentType.XTS_GANTRY;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{6fd3441b-a203-4747-ba6c-caa4f39037e8}">
      <Declaration><![CDATA[(* Sets pose, track, strokes, gripper offsets and mover size. TRUE if anything changed. *)
METHOD Configure : BOOL
VAR_INPUT
	stPose : ST_VisuPose; // MCS, track start on top of the movers with Z = 0
	nModuleCount : UINT; // track modules in a row
	fModuleLength : LREAL; // mm
	fXMin : LREAL; // mm
	fXMax : LREAL; // mm
	fZMin : LREAL; // mm
	fZMax : LREAL; // mm
	fCMin : LREAL; // degrees
	fCMax : LREAL; // degrees
	fToolOffsetX : LREAL; // mm, gripper tip ahead of the X axis zero
	fToolOffsetZ : LREAL; // mm, gripper tip relative to the mover top (below: negative)
	fMoverLength : LREAL; // mm, along the track
	fMoverWidth : LREAL; // mm
END_VAR
VAR
	stNew : ST_VisuXtsGantryConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stNew := stVisu.stConfig;
stNew.stPose := stPose;
stNew.nModuleCount := nModuleCount;
stNew.fModuleLength := fModuleLength;
stNew.fXMin := fXMin;
stNew.fXMax := fXMax;
stNew.fZMin := fZMin;
stNew.fZMax := fZMax;
stNew.fCMin := fCMin;
stNew.fCMax := fCMax;
stNew.fToolOffsetX := fToolOffsetX;
stNew.fToolOffsetZ := fToolOffsetZ;
stNew.fMoverLength := fMoverLength;
stNew.fMoverWidth := fMoverWidth;
Configure := ApplyConfig(stNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMover" Id="{836cee3d-a740-493b-ba48-ab27074bc414}">
      <Declaration><![CDATA[(* Reports one mover (actual values) at entry nIndex and marks it valid. Call once per cycle per mover.
   FALSE if nIndex is outside the mover count set by SetMoverCount. *)
METHOD SetMover : BOOL
VAR_INPUT
	nIndex : UINT; // 0..SetMoverCount - 1
	nId : UDINT; // unique within the gantry, > 0
	fPosition : LREAL; // mm along the track
	fX : LREAL; // mm, X axis
	fC : LREAL; // degrees, gripper rotation; 0 = along local +X
	bGripperActive : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMover := nIndex < stVisu.stState.nMoverCount;
IF SetMover THEN
	stVisu.stState.aMovers[nIndex].nId := nId;
	stVisu.stState.aMovers[nIndex].bValid := TRUE;
	stVisu.stState.aMovers[nIndex].fPosition := fPosition;
	stVisu.stState.aMovers[nIndex].fX := fX;
	stVisu.stState.aMovers[nIndex].fC := fC;
	stVisu.stState.aMovers[nIndex].bGripperActive := bGripperActive;
	stVisu.stState.nTimestamp := DcTime();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMoverCount" Id="{4572b63b-ec4b-486d-8c52-d5efaf72cb7a}">
      <Declaration><![CDATA[(* Sets how many mover entries are evaluated (limited to GVL_VisuParam.nMaxMovers); entries beyond are invalidated.
   TRUE if nCount fitted. *)
METHOD SetMoverCount : BOOL
VAR_INPUT
	nCount : UINT;
END_VAR
VAR
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMoverCount := nCount <= GVL_VisuParam.nMaxMovers;
stVisu.stState.nMoverCount := MIN(nCount, GVL_VisuParam.nMaxMovers);
FOR nIndex := stVisu.stState.nMoverCount TO GVL_VisuParam.nMaxMovers - 1 DO
	stVisu.stState.aMovers[nIndex].bValid := FALSE;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetZone" Id="{ea11b5bb-98ad-4158-a73d-2766183aafff}">
      <Declaration><![CDATA[(* Adds a pick or place zone, or updates the one for the same conveyor and kind.
   FALSE for nConveyorId = 0 or a full list. *)
METHOD SetZone : BOOL
VAR_INPUT
	nConveyorId : UDINT; // manifest id of the conveyor
	eKind : E_VisuZoneKind;
	fStart : LREAL; // mm along the conveyor from its start (belt coordinates, not MCS)
	fEnd : LREAL; // mm along the conveyor from its start
END_VAR
VAR
	stNew : ST_VisuXtsGantryConfig;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetZone := FALSE;
IF nConveyorId = 0 THEN
	RETURN;
END_IF
stNew := stVisu.stConfig;
nIndex := 0;
// ST evaluates both operands of AND: test the index before reading the array.
WHILE nIndex < stNew.nZoneCount DO
	IF stNew.aZones[nIndex].nConveyorId = nConveyorId AND stNew.aZones[nIndex].eKind = eKind THEN
		EXIT;
	END_IF
	nIndex := nIndex + 1;
END_WHILE
IF nIndex >= GVL_VisuParam.nMaxZones THEN
	RETURN;
END_IF
IF nIndex = stNew.nZoneCount THEN
	stNew.nZoneCount := stNew.nZoneCount + 1;
END_IF
stNew.aZones[nIndex].nConveyorId := nConveyorId;
stNew.aZones[nIndex].eKind := eKind;
stNew.aZones[nIndex].fStart := fStart;
stNew.aZones[nIndex].fEnd := fEnd;
ApplyConfig(stNew);
SetZone := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetZPosition" Id="{0aaac84c-8293-4e8a-9c63-4e9bfc97927a}">
      <Declaration><![CDATA[(* Reports the common Z axis (actual value). Call once per cycle; it also stamps the state with the cycle's DC time. *)
METHOD SetZPosition : BOOL
VAR_INPUT
	fZ : LREAL; // mm
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stVisu.stState.fZ := fZ;
stVisu.stState.nTimestamp := DcTime();
SetZPosition := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>