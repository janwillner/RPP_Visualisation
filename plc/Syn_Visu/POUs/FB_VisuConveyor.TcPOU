<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_VisuConveyor" Id="{df0fd64e-e630-4432-a80b-e37e7a2127fd}" SpecialFunc="None">
    <Declaration><![CDATA[(* One visualised conveyor. Typical cycle:
     fbInfeed.Register(GVL_Visu.stManifest, 1, 'Infeed', 'MAIN.fbInfeed.stVisu');
     fbInfeed.Configure(stPose, fLength := 5000, fWidth := 400);
     fbInfeed.SetProductType(nId := 1, fLength := 120, fWidth := 80, fHeight := 40);
     fbInfeed.SetBeltPosition(fAxisPosition);          // or SetModuloBeltPosition for a modulo axis
     IF bLatched THEN fbInfeed.LatchProduct(nNextId, stLatchPose, nProductType := 1); END_IF
   Configure and SetProductType may be called every cycle; the config version only changes when a value does.
   The gateway reads stVisu at the path given to Register. *)
FUNCTION_BLOCK FB_VisuConveyor EXTENDS FB_VisuComponent
VAR
	stVisu : ST_VisuConveyor; // contract structure read by the gateway; do not write directly
	fLastModuloPosition : LREAL;
	bModuloInitialised : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ApplyConfig" Id="{5ed88417-12f8-43f8-8bd2-fd54143c201b}">
      <Declaration><![CDATA[(* Takes over stNew and increments the config version if it differs from the current config. TRUE if changed. *)
METHOD PRIVATE ApplyConfig : BOOL
VAR_IN_OUT
	stNew : ST_VisuConveyorConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ApplyConfig := Tc2_System.MEMCMP(ADR(stNew), ADR(stVisu.stConfig), SIZEOF(stNew)) <> 0;
IF ApplyConfig THEN
	stVisu.stConfig := stNew;
	NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="BeltPosition" Id="{a9474132-4355-42b7-8b8a-f6a0d07f33f7}">
      <Declaration><![CDATA[(* Belt position last set, mm. *)
METHOD BeltPosition : LREAL]]></Declaration>
      <Implementation>
        <ST><![CDATA[BeltPosition := stVisu.stState.fBeltPosition;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ComponentType" Id="{7fffd466-f705-4090-93d1-33703f89d45d}">
      <Declaration><![CDATA[METHOD PROTECTED ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComponentType := E_VisuComponentType.CONVEYOR;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{384fa16c-3881-45d3-91b4-b959b18bb0fa}">
      <Declaration><![CDATA[(* Sets pose and size. TRUE if anything changed. *)
METHOD Configure : BOOL
VAR_INPUT
	stPose : ST_VisuPose; // MCS, belt start on the belt surface; local +X = conveying direction
	fLength : LREAL; // mm
	fWidth : LREAL; // mm
END_VAR
VAR
	stNew : ST_VisuConveyorConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stNew := stVisu.stConfig;
stNew.stPose := stPose;
stNew.fLength := fLength;
stNew.fWidth := fWidth;
Configure := ApplyConfig(stNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FindProduct" Id="{4aa77263-875a-4173-8f5c-bdad838911a2}">
      <Declaration><![CDATA[(* Register index of the product with nId, -1 if not found. *)
METHOD FindProduct : INT
VAR_INPUT
	nId : UDINT;
END_VAR
VAR
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FindProduct := -1;
nIndex := 0;
WHILE nIndex < stVisu.stState.nProductCount DO
	IF stVisu.stState.aProducts[nIndex].nId = nId THEN
		FindProduct := UINT_TO_INT(nIndex);
		RETURN;
	END_IF
	nIndex := nIndex + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetProduct" Id="{aca84e95-a5a5-44df-9922-30307a93d5d4}">
      <Declaration><![CDATA[(* Reads register entry nIndex and its current MCS pose (latch pose moved by the belt travel since).
   FALSE if nIndex is out of range. Indices shift when products are removed; use nId to follow a product. *)
METHOD GetProduct : BOOL
VAR_INPUT
	nIndex : UINT;
END_VAR
VAR_OUTPUT
	stProduct : ST_VisuProduct;
	stPose : ST_VisuPlanarPose; // MCS, current bottom centre
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetProduct := nIndex < stVisu.stState.nProductCount;
IF GetProduct THEN
	stProduct := stVisu.stState.aProducts[nIndex];
	stPose := ProductPose(stProduct);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="LatchProduct" Id="{3f858f34-48df-4798-a839-b1c6e0e2dead}">
      <Declaration><![CDATA[(* Adds a detected product at the current belt position. Call SetBeltPosition first in the cycle,
   or pass the belt position at the latch moment in fLatchBeltPosition.
   FALSE for nId = 0, an id already in the register, or a full register. *)
METHOD LatchProduct : BOOL
VAR_INPUT
	nId : UDINT; // unique on this conveyor, > 0
	stLatchPose : ST_VisuPlanarPose; // MCS, bottom centre of the product at the latch moment
	nProductType : UDINT; // id given to SetProductType
	fLatchBeltPosition : LREAL := 0; // mm; used only if bUseLatchBeltPosition
	bUseLatchBeltPosition : BOOL := FALSE; // FALSE: latch at the current belt position
END_VAR
VAR
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[LatchProduct := FALSE;
nIndex := stVisu.stState.nProductCount;
IF nId = 0 OR FindProduct(nId) >= 0 OR nIndex >= GVL_VisuParam.nMaxProducts THEN
	RETURN;
END_IF
stVisu.stState.aProducts[nIndex].nId := nId;
stVisu.stState.aProducts[nIndex].bValid := TRUE;
stVisu.stState.aProducts[nIndex].stLatchPose := stLatchPose;
IF bUseLatchBeltPosition THEN
	stVisu.stState.aProducts[nIndex].fLatchBeltPosition := fLatchBeltPosition;
ELSE
	stVisu.stState.aProducts[nIndex].fLatchBeltPosition := stVisu.stState.fBeltPosition;
END_IF
stVisu.stState.aProducts[nIndex].eState := E_VisuProductState.DETECTED;
stVisu.stState.aProducts[nIndex].nRobotId := 0;
stVisu.stState.aProducts[nIndex].nMoverId := 0;
stVisu.stState.aProducts[nIndex].nProductType := nProductType;
stVisu.stState.nProductCount := nIndex + 1;
stVisu.stState.nTimestamp := DcTime();
LatchProduct := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProductCount" Id="{cee0e139-fe59-4b22-b8cb-ec43b92b63f9}">
      <Declaration><![CDATA[(* Number of products in the register; valid indices for GetProduct are 0..ProductCount() - 1. *)
METHOD ProductCount : UINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[ProductCount := stVisu.stState.nProductCount;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProductPose" Id="{d201c571-8ab8-4791-985c-6517ab523334}">
      <Declaration><![CDATA[(* Current MCS pose of a product: latch pose moved along the conveying direction (local +X,
   rotation Rz * Ry of the conveyor pose) by the belt travel since the latch. *)
METHOD PRIVATE ProductPose : ST_VisuPlanarPose
VAR_IN_OUT CONSTANT
	stProduct : ST_VisuProduct;
END_VAR
VAR
	fTravel : LREAL;
	fRz : LREAL;
	fRy : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fTravel := stVisu.stState.fBeltPosition - stProduct.fLatchBeltPosition;
fRz := stVisu.stConfig.stPose.fRz * GVL_VisuConstants.fDegToRad;
fRy := stVisu.stConfig.stPose.fRy * GVL_VisuConstants.fDegToRad;
ProductPose := stProduct.stLatchPose;
ProductPose.fX := ProductPose.fX + fTravel * COS(fRz) * COS(fRy);
ProductPose.fY := ProductPose.fY + fTravel * SIN(fRz) * COS(fRy);
ProductPose.fZ := ProductPose.fZ - fTravel * SIN(fRy);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveProduct" Id="{74bfe229-686e-40e4-b091-b220e209c95d}">
      <Declaration><![CDATA[(* Removes a product from the register. FALSE if it is not in the register. *)
METHOD RemoveProduct : BOOL
VAR_INPUT
	nId : UDINT;
END_VAR
VAR
	nIndex : INT;
	nLast : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[nIndex := FindProduct(nId);
RemoveProduct := nIndex >= 0;
IF NOT RemoveProduct THEN
	RETURN;
END_IF
nLast := UINT_TO_INT(stVisu.stState.nProductCount) - 1;
WHILE nIndex < nLast DO
	stVisu.stState.aProducts[nIndex] := stVisu.stState.aProducts[nIndex + 1];
	nIndex := nIndex + 1;
END_WHILE
stVisu.stState.aProducts[nLast].bValid := FALSE;
stVisu.stState.nProductCount := INT_TO_UINT(nLast);
stVisu.stState.nTimestamp := DcTime();]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveProductsBeyond" Id="{b1d28b7d-067c-4e78-a58d-d7a9cedb8741}">
      <Declaration><![CDATA[(* Housekeeping: drops invalid entries and products that have travelled beyond fBeltX (mm along the
   conveyor from its start). Products a robot is working on (ASSIGNED or PICKED) are kept wherever they are.
   Returns the number of removed entries. *)
METHOD RemoveProductsBeyond : UINT
VAR_INPUT
	fBeltX : LREAL; // mm, e.g. belt length + some margin so missed products stay visible briefly
END_VAR
VAR
	nRead : UINT;
	nWrite : UINT;
	bInUse : BOOL;
	stPose : ST_VisuPlanarPose;
	fDx : LREAL;
	fDy : LREAL;
	fDz : LREAL;
	fRz : LREAL;
	fRy : LREAL;
	fX : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RemoveProductsBeyond := 0;
IF stVisu.stState.nProductCount = 0 THEN
	RETURN;
END_IF
fRz := stVisu.stConfig.stPose.fRz * GVL_VisuConstants.fDegToRad;
fRy := stVisu.stConfig.stPose.fRy * GVL_VisuConstants.fDegToRad;

nWrite := 0;
FOR nRead := 0 TO stVisu.stState.nProductCount - 1 DO
	// Belt X = current position projected onto the conveying direction, measured from the belt start.
	stPose := ProductPose(stVisu.stState.aProducts[nRead]);
	fDx := stPose.fX - stVisu.stConfig.stPose.fX;
	fDy := stPose.fY - stVisu.stConfig.stPose.fY;
	fDz := stPose.fZ - stVisu.stConfig.stPose.fZ;
	fX := (fDx * COS(fRz) + fDy * SIN(fRz)) * COS(fRy) - fDz * SIN(fRy);
	bInUse := stVisu.stState.aProducts[nRead].eState = E_VisuProductState.ASSIGNED
		OR stVisu.stState.aProducts[nRead].eState = E_VisuProductState.PICKED;
	IF stVisu.stState.aProducts[nRead].bValid AND (fX <= fBeltX OR bInUse) THEN
		IF nWrite <> nRead THEN
			stVisu.stState.aProducts[nWrite] := stVisu.stState.aProducts[nRead];
		END_IF
		nWrite := nWrite + 1;
	END_IF
END_FOR

RemoveProductsBeyond := stVisu.stState.nProductCount - nWrite;
IF nWrite < stVisu.stState.nProductCount THEN
	FOR nRead := nWrite TO stVisu.stState.nProductCount - 1 DO
		stVisu.stState.aProducts[nRead].bValid := FALSE;
	END_FOR
	stVisu.stState.nProductCount := nWrite;
	stVisu.stState.nTimestamp := DcTime();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetBeltPosition" Id="{5b54c4bc-508c-49cf-b448-746ae37d7948}">
      <Declaration><![CDATA[(* Sets the belt position: how far the belt surface has travelled, mm, continuous (no modulo).
   Call once per cycle; it also stamps the state with the cycle's DC time. *)
METHOD SetBeltPosition : BOOL
VAR_INPUT
	fPosition : LREAL; // mm
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stVisu.stState.fBeltPosition := fPosition;
stVisu.stState.nTimestamp := DcTime();
SetBeltPosition := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetModuloBeltPosition" Id="{9208e68c-edba-4727-b6a1-06546932c639}">
      <Declaration><![CDATA[(* Like SetBeltPosition, for a modulo axis: unwraps the position so the belt position stays continuous.
   Call once per cycle; the axis must move less than half a modulo period per cycle. *)
METHOD SetModuloBeltPosition : BOOL
VAR_INPUT
	fModuloPosition : LREAL; // mm, in [0, fModuloPeriod)
	fModuloPeriod : LREAL; // mm; <= 0 passes fModuloPosition through unchanged
	bReset : BOOL; // TRUE: restart the belt position at fModuloPosition
END_VAR
VAR
	fPosition : LREAL;
	fDelta : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bReset OR NOT bModuloInitialised OR fModuloPeriod <= 0 THEN
	fPosition := fModuloPosition;
	bModuloInitialised := TRUE;
ELSE
	fDelta := fModuloPosition - fLastModuloPosition;
	IF fDelta > fModuloPeriod / 2 THEN
		fDelta := fDelta - fModuloPeriod;
	ELSIF fDelta < -fModuloPeriod / 2 THEN
		fDelta := fDelta + fModuloPeriod;
	END_IF
	fPosition := stVisu.stState.fBeltPosition + fDelta;
END_IF
fLastModuloPosition := fModuloPosition;
SetModuloBeltPosition := SetBeltPosition(fPosition);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetProductState" Id="{d750e750-04ba-4690-b114-957e9051074a}">
      <Declaration><![CDATA[(* Changes a product's state and assigned robot. FALSE if the product is not in the register. *)
METHOD SetProductState : BOOL
VAR_INPUT
	nId : UDINT;
	eState : E_VisuProductState;
	nRobotId : UDINT; // manifest id of the robot, 0 = none
	nMoverId : UDINT := 0; // mover of an XTS gantry or loop carrying the product, 0 = none
	nFingerId : UDINT := 0; // gripper finger (1-based) the product hangs from while picked, 0 = the gripper flange
END_VAR
VAR
	nIndex : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[nIndex := FindProduct(nId);
SetProductState := nIndex >= 0;
IF SetProductState THEN
	stVisu.stState.aProducts[nIndex].eState := eState;
	stVisu.stState.aProducts[nIndex].nRobotId := nRobotId;
	stVisu.stState.aProducts[nIndex].nMoverId := nMoverId;
	stVisu.stState.aProducts[nIndex].nFingerId := nFingerId;
	stVisu.stState.nTimestamp := DcTime();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetProductType" Id="{384e1a50-75ce-481a-941e-2d2e78cfb2f1}">
      <Declaration><![CDATA[(* Adds a product type, or updates the one with the same nId. FALSE for nId = 0 or a full list. *)
METHOD SetProductType : BOOL
VAR_INPUT
	nId : UDINT; // referenced by LatchProduct's nProductType
	fLength : LREAL; // mm, along the conveying direction
	fWidth : LREAL; // mm
	fHeight : LREAL; // mm
END_VAR
VAR
	stNew : ST_VisuConveyorConfig;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetProductType := FALSE;
IF nId = 0 THEN
	RETURN;
END_IF
stNew := stVisu.stConfig;
nIndex := 0;
// ST evaluates both operands of AND: test the index before reading the array.
WHILE nIndex < stNew.nProductTypeCount DO
	IF stNew.aProductTypes[nIndex].nId = nId THEN
		EXIT;
	END_IF
	nIndex := nIndex + 1;
END_WHILE
IF nIndex >= GVL_VisuParam.nMaxProductTypes THEN
	RETURN;
END_IF
IF nIndex = stNew.nProductTypeCount THEN
	stNew.nProductTypeCount := stNew.nProductTypeCount + 1;
END_IF
stNew.aProductTypes[nIndex].nId := nId;
stNew.aProductTypes[nIndex].fLength := fLength;
stNew.aProductTypes[nIndex].fWidth := fWidth;
stNew.aProductTypes[nIndex].fHeight := fHeight;
ApplyConfig(stNew);
SetProductType := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>