<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="_FB_VisuConveyor" Id="{33885ff0-2e31-46e6-bbbe-aca5cea8a987}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
One visualised conveyor. Typical cycle:<br>
  fb_Infeed.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 1, vi_str_Name := 'Infeed');<br>
  fb_Infeed.m_Configure(vi_Pose := BeltPose, vi_lr_Length := 5000, vi_lr_Width := 400);<br>
  fb_Infeed.m_SetProductType(vi_udn_Id := 1, vi_lr_Length := 120, vi_lr_Width := 80, vi_lr_Height := 40,<br>
      vi_e_Shape := E_VisuProductShape.BOX, vi_lr_CornerRadius := 0);<br>
  fb_Infeed.m_SetBeltPosition(lr_AxisPosition);  // or m_SetModuloBeltPosition for a modulo axis<br>
  IF b_Latched THEN fb_Infeed.m_LatchProduct(vi_udn_Id := udn_NextId, vi_LatchPose := LatchPose, vi_udn_ProductType := 1,<br>
      vi_lr_LatchBeltPosition := 0, vi_b_UseLatchBeltPosition := FALSE, vi_e_State := E_VisuProductState.DETECTED,<br>
      vi_udn_ClientId := 0); END_IF<br>
m_Configure and m_SetProductType may be called every cycle; the config version only changes when a value does.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Visu is the contract structure the gateway reads at the path given to m_Register. Do not write it.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Visu 3.0.0  ¦ 2026-10-31 ¦ J.Willner ¦ Naming and layout after the TCAT programming guideline<br>
Syn_Visu 3.4.0  ¦ 2026-11-01 ¦ J.Willner ¦ m_LatchProduct: product state and robot (PLACED onto outfeeds)<br>
Syn_Visu 3.5.0  ¦ 2026-11-01 ¦ J.Willner ¦ m_SetProductType: shape and corner radius (protocol 10)<br>
Syn_Visu 4.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ m_LatchProduct: detector that latched the product (protocol 11)<br>
Syn_Visu 7.2.0  ¦ 2026-11-05 ¦ J.Willner ¦ Product index by id; registers rearranged with MEMMOVE<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_VisuConveyor EXTENDS _FB_VisuComponent
VAR_OUTPUT
	vo_Visu								: ST_VisuConveyor;	// contract structure read by the gateway
END_VAR
VAR
	lr_LastModuloPosition				: LREAL;	// [mm] modulo position of the previous cycle
	b_ModuloInitialised					: BOOL;
	(* Product index: per slot the register index + 1 of a product whose id hashes there, 0 = free. Rebuilt by
	   m_FindProduct after the register was rearranged; m_LatchProduct adds to it. *)
	un_IndexSlot						: ARRAY[0..VISU_GlobalConst_Param.VISU_un_PRODUCT_INDEX_SIZE - 1] OF UINT;
	un_IndexedCount						: UINT;	// [-] register entries the index holds
	b_IndexValid						: BOOL;	// the index matches the register
	b_IndexFailed						: BOOL;	// the index is too small for the register: search linearly
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_ApplyConfig" Id="{5ed88417-12f8-43f8-8bd2-fd54143c201b}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Takes over vio_New and increments the config version if it differs from the current config. TRUE if changed.<br>
****************************************************************************************************)
METHOD PRIVATE m_ApplyConfig : BOOL
VAR_IN_OUT
	vio_New								: ST_VisuConveyorConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ApplyConfig := Tc2_System.MEMCMP(ADR(vio_New), ADR(vo_Visu.stConfig), SIZEOF(vio_New)) <> 0;
IF m_ApplyConfig THEN
	vo_Visu.stConfig := vio_New;
	m_NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_BeltPosition" Id="{a9474132-4355-42b7-8b8a-f6a0d07f33f7}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Belt position last set, [mm].<br>
****************************************************************************************************)
METHOD m_BeltPosition : LREAL]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_BeltPosition := vo_Visu.stState.fBeltPosition;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ComponentType" Id="{7fffd466-f705-4090-93d1-33703f89d45d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Manifest type: conveyor.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := E_VisuComponentType.CONVEYOR;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Configure" Id="{384fa16c-3881-45d3-91b4-b959b18bb0fa}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets pose and size. TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_Configure : BOOL
VAR_INPUT
	vi_Pose								: ST_VisuPose;	// MCS, belt start on the belt surface; local +X = conveying direction
	vi_lr_Length						: LREAL;	// [mm]
	vi_lr_Width							: LREAL;	// [mm]
END_VAR
VAR
	TempNew								: ST_VisuConveyorConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.stPose := vi_Pose;
TempNew.fLength := vi_lr_Length;
TempNew.fWidth := vi_lr_Width;
m_Configure := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_FindProduct" Id="{4aa77263-875a-4173-8f5c-bdad838911a2}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Register index of the product with vi_udn_Id, -1 if not found. Looks it up in the product index by id, which it<br>
rebuilds first after the register was rearranged; searches linearly only if the index is too small.<br>
****************************************************************************************************)
METHOD m_FindProduct : INT
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] product id
END_VAR
VAR
	un_TempIndex						: UINT;
	un_TempSlot							: UINT;
	un_TempProbe						: UINT;
	un_TempEntry						: UINT;	// [-] register index + 1, 0 = free slot
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_FindProduct := -1;
IF NOT b_IndexFailed AND (NOT b_IndexValid OR un_IndexedCount <> vo_Visu.stState.nProductCount) THEN
	m_IndexRebuild();
END_IF

IF b_IndexValid THEN
	un_TempSlot := m_IndexSlotOf(vi_udn_Id);
	FOR un_TempProbe := 1 TO VISU_GlobalConst_Param.VISU_un_PRODUCT_INDEX_SIZE DO
		un_TempEntry := un_IndexSlot[un_TempSlot];
		IF un_TempEntry = 0 THEN
			RETURN;
		END_IF
		IF un_TempEntry <= vo_Visu.stState.nProductCount THEN
			IF vo_Visu.stState.aProducts[un_TempEntry - 1].nId = vi_udn_Id THEN
				m_FindProduct := UINT_TO_INT(un_TempEntry - 1);
				RETURN;
			END_IF
		END_IF
		un_TempSlot := (un_TempSlot + 1) AND (VISU_GlobalConst_Param.VISU_un_PRODUCT_INDEX_SIZE - 1);
	END_FOR
	RETURN;
END_IF

(* Index too small for the register: search linearly. *)
un_TempIndex := 0;
WHILE un_TempIndex < vo_Visu.stState.nProductCount DO
	IF vo_Visu.stState.aProducts[un_TempIndex].nId = vi_udn_Id THEN
		m_FindProduct := UINT_TO_INT(un_TempIndex);
		RETURN;
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_GetProduct" Id="{aca84e95-a5a5-44df-9922-30307a93d5d4}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reads register entry vi_un_Index and its current pose in the conveyor's coordinate system (latch pose moved<br>
along the belt by the belt travel since).<br>
Indices shift when products are removed; use the product id to follow a product.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE if vi_un_Index is out of range.<br>
****************************************************************************************************)
METHOD m_GetProduct : BOOL
VAR_INPUT
	vi_un_Index							: UINT;	// [-] 0..m_ProductCount() - 1
END_VAR
VAR_OUTPUT
	vo_Product							: ST_VisuProduct;
	vo_Pose								: ST_VisuPlanarPose;	// conveyor coordinate system, current bottom centre
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_GetProduct := vi_un_Index < vo_Visu.stState.nProductCount;
IF m_GetProduct THEN
	vo_Product := vo_Visu.stState.aProducts[vi_un_Index];
	vo_Pose := m_ProductPose(vo_Product);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_IndexInsert" Id="{e9b3ac8c-6ddb-4cab-8600-3efd307ba392}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Adds register entry vi_un_Index with product id vi_udn_Id to the product index, in the first free slot from<br>
its hash slot on.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE if the index has no free slot (VISU_un_PRODUCT_INDEX_SIZE too small for VISU_un_MAX_PRODUCTS).<br>
****************************************************************************************************)
METHOD PRIVATE m_IndexInsert : BOOL
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] product id
	vi_un_Index							: UINT;	// [-] register index
END_VAR
VAR
	un_TempSlot							: UINT;
	un_TempProbe						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_IndexInsert := FALSE;
un_TempSlot := m_IndexSlotOf(vi_udn_Id);
FOR un_TempProbe := 1 TO VISU_GlobalConst_Param.VISU_un_PRODUCT_INDEX_SIZE DO
	IF un_IndexSlot[un_TempSlot] = 0 THEN
		un_IndexSlot[un_TempSlot] := vi_un_Index + 1;
		m_IndexInsert := TRUE;
		RETURN;
	END_IF
	un_TempSlot := (un_TempSlot + 1) AND (VISU_GlobalConst_Param.VISU_un_PRODUCT_INDEX_SIZE - 1);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_IndexRebuild" Id="{2f2b2934-f082-4a27-8f7d-e105a3b0fe3b}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Builds the product index from the register anew, e.g. after products were removed and the register moved up.<br>
If the index is too small for the register, it gives up for good and m_FindProduct searches linearly.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE if the index matches the register.<br>
****************************************************************************************************)
METHOD PRIVATE m_IndexRebuild : BOOL
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Tc2_System.MEMSET(ADR(un_IndexSlot), 0, SIZEOF(un_IndexSlot));
b_IndexValid := TRUE;
un_TempIndex := 0;
WHILE un_TempIndex < vo_Visu.stState.nProductCount DO
	IF NOT m_IndexInsert(vo_Visu.stState.aProducts[un_TempIndex].nId, un_TempIndex) THEN
		b_IndexValid := FALSE;
		b_IndexFailed := TRUE;
		EXIT;
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE
un_IndexedCount := vo_Visu.stState.nProductCount;
m_IndexRebuild := b_IndexValid;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_IndexSlotOf" Id="{9b16adaf-1db5-42f4-9fab-db9715b3ac94}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
First slot of the product index to look at for a product id (multiplicative hash): consecutive ids land on<br>
different slots. The search goes on slot by slot from there.<br>
****************************************************************************************************)
METHOD PRIVATE m_IndexSlotOf : UINT
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] product id
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* The product wraps around in 32 bits on purpose. *)
m_IndexSlotOf := UDINT_TO_UINT((vi_udn_Id * UDINT#2654435761) AND UINT_TO_UDINT(VISU_GlobalConst_Param.VISU_un_PRODUCT_INDEX_SIZE - 1));]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_LatchProduct" Id="{3f858f34-48df-4798-a839-b1c6e0e2dead}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Adds a product at the current belt position. Call m_SetBeltPosition first in the cycle,<br>
or pass the belt position at the latch moment in vi_lr_LatchBeltPosition.<br>
A product arriving on the conveyor enters as DETECTED (default), naming the client that latched it (vision<br>
system, sensor, station). A product a robot puts down onto it (outfeed, tray, back onto the same belt)<br>
enters as PLACED with that robot as client: the visualisation shows a DETECTED or ASSIGNED product passing<br>
the belt end as missed. Its previous state is the state it enters in. It enters unmarked (m_SetProductMark).<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE for vi_udn_Id = 0, an id already in the register, or a full register.<br>
****************************************************************************************************)
METHOD m_LatchProduct : BOOL
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] unique on this conveyor, > 0
	vi_LatchPose						: ST_VisuPlanarPose;	// conveyor coordinate system (from its origin shift), bottom centre at the latch moment
	vi_udn_ProductType					: UDINT;	// [-] id given to m_SetProductType
	vi_lr_LatchBeltPosition				: LREAL;	// [mm] used only if vi_b_UseLatchBeltPosition, else 0
	vi_b_UseLatchBeltPosition			: BOOL;	// FALSE: latch at the current belt position
	vi_e_State							: E_VisuProductState;	// DETECTED for a product arriving, PLACED for a product put down by a robot
	vi_udn_ClientId						: UDINT;	// [-] manifest id of the client that latched it or put it down, 0 = none
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_LatchProduct := FALSE;
un_TempIndex := vo_Visu.stState.nProductCount;
IF vi_udn_Id = 0 OR m_FindProduct(vi_udn_Id) >= 0 OR un_TempIndex >= VISU_GlobalConst_Param.VISU_un_MAX_PRODUCTS THEN
	RETURN;
END_IF
vo_Visu.stState.aProducts[un_TempIndex].nId := vi_udn_Id;
vo_Visu.stState.aProducts[un_TempIndex].bValid := TRUE;
vo_Visu.stState.aProducts[un_TempIndex].stLatchPose := vi_LatchPose;
IF vi_b_UseLatchBeltPosition THEN
	vo_Visu.stState.aProducts[un_TempIndex].fLatchBeltPosition := vi_lr_LatchBeltPosition;
ELSE
	vo_Visu.stState.aProducts[un_TempIndex].fLatchBeltPosition := vo_Visu.stState.fBeltPosition;
END_IF
vo_Visu.stState.aProducts[un_TempIndex].eState := vi_e_State;
vo_Visu.stState.aProducts[un_TempIndex].ePreviousState := vi_e_State;
vo_Visu.stState.aProducts[un_TempIndex].nLastClientId := vi_udn_ClientId;
vo_Visu.stState.aProducts[un_TempIndex].nMoverId := 0;
vo_Visu.stState.aProducts[un_TempIndex].nFingerId := 0;
vo_Visu.stState.aProducts[un_TempIndex].nProductType := vi_udn_ProductType;
vo_Visu.stState.aProducts[un_TempIndex].nMark := 0;
vo_Visu.stState.nProductCount := un_TempIndex + 1;
(* m_FindProduct above brought the index up to the register; the new entry joins it. *)
IF b_IndexValid AND un_IndexedCount = un_TempIndex THEN
	IF m_IndexInsert(vi_udn_Id, un_TempIndex) THEN
		un_IndexedCount := un_TempIndex + 1;
	ELSE
		b_IndexValid := FALSE;
		b_IndexFailed := TRUE;
	END_IF
END_IF
vo_Visu.stState.nTimestamp := m_DcTime();
m_LatchProduct := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_MoveProduct" Id="{02f7a869-c82b-433e-ad49-b7303567daa7}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Puts a product of the register at a new pose (conveyor coordinate system) at the current belt position, e.g. while a mover pushes it<br>
along the belt faster than the belt runs. Call m_SetBeltPosition first in the cycle. Keeps its state and mark.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE if the product is not in the register.<br>
****************************************************************************************************)
METHOD m_MoveProduct : BOOL
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] product id
	vi_Pose								: ST_VisuPlanarPose;	// conveyor coordinate system, bottom centre of the product now
END_VAR
VAR
	n_TempIndex							: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[n_TempIndex := m_FindProduct(vi_udn_Id);
m_MoveProduct := n_TempIndex >= 0;
IF m_MoveProduct THEN
	vo_Visu.stState.aProducts[n_TempIndex].stLatchPose := vi_Pose;
	vo_Visu.stState.aProducts[n_TempIndex].fLatchBeltPosition := vo_Visu.stState.fBeltPosition;
	vo_Visu.stState.nTimestamp := m_DcTime();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ProductCount" Id="{cee0e139-fe59-4b22-b8cb-ec43b92b63f9}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Number of products in the register; valid indices for m_GetProduct are 0..m_ProductCount() - 1.<br>
****************************************************************************************************)
METHOD m_ProductCount : UINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ProductCount := vo_Visu.stState.nProductCount;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ProductPose" Id="{d201c571-8ab8-4791-985c-6517ab523334}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Current pose of a product in the conveyor's coordinate system: latch pose moved along the belt<br>
(local +X) by the belt travel since the latch.<br>
****************************************************************************************************)
METHOD PRIVATE m_ProductPose : ST_VisuPlanarPose
VAR_IN_OUT CONSTANT
	vio_Product							: ST_VisuProduct;
END_VAR
VAR
	lr_TempTravel						: LREAL;	// [mm]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[lr_TempTravel := vo_Visu.stState.fBeltPosition - vio_Product.fLatchBeltPosition;
m_ProductPose := vio_Product.stLatchPose;
m_ProductPose.fX := m_ProductPose.fX + lr_TempTravel;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_RemoveProduct" Id="{74bfe229-686e-40e4-b091-b220e209c95d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Removes a product from the register. FALSE if it is not in the register.<br>
****************************************************************************************************)
METHOD m_RemoveProduct : BOOL
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] product id
END_VAR
VAR
	n_TempIndex							: INT;
	n_TempLast							: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[n_TempIndex := m_FindProduct(vi_udn_Id);
m_RemoveProduct := n_TempIndex >= 0;
IF NOT m_RemoveProduct THEN
	RETURN;
END_IF
n_TempLast := UINT_TO_INT(vo_Visu.stState.nProductCount) - 1;
(* The entries behind it move up by one, in one go. *)
IF n_TempIndex < n_TempLast THEN
	Tc2_System.MEMMOVE(ADR(vo_Visu.stState.aProducts[n_TempIndex]), ADR(vo_Visu.stState.aProducts[n_TempIndex + 1]),
		INT_TO_UDINT(n_TempLast - n_TempIndex) * SIZEOF(ST_VisuProduct));
END_IF
vo_Visu.stState.aProducts[n_TempLast].bValid := FALSE;
vo_Visu.stState.nProductCount := INT_TO_UINT(n_TempLast);
b_IndexValid := FALSE;
vo_Visu.stState.nTimestamp := m_DcTime();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_RemoveProductsBeyond" Id="{b1d28b7d-067c-4e78-a58d-d7a9cedb8741}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Housekeeping: drops invalid entries and products that have travelled beyond vi_lr_BeltX (along the<br>
conveyor from its start). Products a robot is working on (ASSIGNED or PICKED) are kept wherever they are.<br>
The entries that stay move up in runs (usually one: the products leaving are the oldest, at the front).<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
Number of removed entries.<br>
****************************************************************************************************)
METHOD m_RemoveProductsBeyond : UINT
VAR_INPUT
	vi_lr_BeltX							: LREAL;	// [mm] e.g. belt length + some margin so missed products stay visible briefly
END_VAR
VAR
	un_TempCount						: UINT;	// [-] entries before
	un_TempRead							: UINT;
	un_TempWrite						: UINT;
	un_TempRunStart						: UINT;	// [-] first entry of a run of entries that stay
	b_TempStays							: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_RemoveProductsBeyond := 0;
un_TempCount := vo_Visu.stState.nProductCount;
IF un_TempCount = 0 THEN
	RETURN;
END_IF

(* Keep the entries that stay, in order, moving each run of them up in one go. *)
un_TempWrite := 0;
un_TempRead := 0;
WHILE un_TempRead < un_TempCount DO
	IF m_StaysInRegister(un_TempRead, vi_lr_BeltX) THEN
		un_TempRunStart := un_TempRead;
		b_TempStays := TRUE;
		WHILE b_TempStays DO
			un_TempRead := un_TempRead + 1;
			b_TempStays := FALSE;
			IF un_TempRead < un_TempCount THEN
				b_TempStays := m_StaysInRegister(un_TempRead, vi_lr_BeltX);
			END_IF
		END_WHILE
		IF un_TempWrite <> un_TempRunStart THEN
			Tc2_System.MEMMOVE(ADR(vo_Visu.stState.aProducts[un_TempWrite]), ADR(vo_Visu.stState.aProducts[un_TempRunStart]),
				UINT_TO_UDINT(un_TempRead - un_TempRunStart) * SIZEOF(ST_VisuProduct));
		END_IF
		un_TempWrite := un_TempWrite + (un_TempRead - un_TempRunStart);
	ELSE
		un_TempRead := un_TempRead + 1;
	END_IF
END_WHILE

(* Invalidate the freed tail. *)
m_RemoveProductsBeyond := un_TempCount - un_TempWrite;
IF un_TempWrite < un_TempCount THEN
	FOR un_TempRead := un_TempWrite TO un_TempCount - 1 DO
		vo_Visu.stState.aProducts[un_TempRead].bValid := FALSE;
	END_FOR
	vo_Visu.stState.nProductCount := un_TempWrite;
	vo_Visu.stState.nTimestamp := m_DcTime();
	b_IndexValid := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetBeltPosition" Id="{5b54c4bc-508c-49cf-b448-746ae37d7948}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets the belt position: how far the belt surface has travelled, continuous (no modulo).<br>
Call once per cycle; it also stamps the state with the cycle's DC time.<br>
****************************************************************************************************)
METHOD m_SetBeltPosition : BOOL
VAR_INPUT
	vi_lr_Position						: LREAL;	// [mm]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_Visu.stState.fBeltPosition := vi_lr_Position;
vo_Visu.stState.nTimestamp := m_DcTime();
m_SetBeltPosition := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetBodyVisible" Id="{7f943322-e68d-43e8-a478-a6b571d43ae7}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets whether the belt is drawn as a body. A conveyor without one (FALSE) shows only its products, zones and<br>
its axis from the origin to the conveying direction arrow. Default TRUE. TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_SetBodyVisible : BOOL
VAR_INPUT
	vi_b_Visible						: BOOL;	// TRUE = drawn as a body, FALSE = a conveyor without one
END_VAR
VAR
	TempNew								: ST_VisuConveyorConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.bBody := vi_b_Visible;
m_SetBodyVisible := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetFault" Id="{378826b6-c6cf-42e7-bcdd-b7aadad4d08e}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets or clears the fault of the conveyor: drawn red with the message while active. The fault stays until it<br>
is cleared with m_SetFault(vi_b_Active := FALSE, vi_str_Message := ''). TRUE.<br>
****************************************************************************************************)
METHOD m_SetFault : BOOL
VAR_INPUT
	vi_b_Active							: BOOL;	// TRUE: fault active
	vi_str_Message						: STRING(80);	// shown to the operator; empty shows 'Fault'
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_Visu.stState.stFault.bActive := vi_b_Active;
vo_Visu.stState.stFault.sMessage := vi_str_Message;
m_SetFault := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetModuloBeltPosition" Id="{9208e68c-edba-4727-b6a1-06546932c639}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Like m_SetBeltPosition, for a modulo axis: unwraps the position so the belt position stays continuous.<br>
Call once per cycle.<br>
*****************************************************************************************************<br>
LIMITS:<br>
The axis must move less than half a modulo period per cycle.<br>
****************************************************************************************************)
METHOD m_SetModuloBeltPosition : BOOL
VAR_INPUT
	vi_lr_ModuloPosition				: LREAL;	// [mm] in [0, vi_lr_ModuloPeriod)
	vi_lr_ModuloPeriod					: LREAL;	// [mm] <= 0 passes vi_lr_ModuloPosition through unchanged
	vi_b_Reset							: BOOL;	// TRUE: restart the belt position at vi_lr_ModuloPosition
END_VAR
VAR
	lr_TempPosition						: LREAL;	// [mm]
	lr_TempDelta						: LREAL;	// [mm]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF vi_b_Reset OR NOT b_ModuloInitialised OR vi_lr_ModuloPeriod <= 0 THEN
	lr_TempPosition := vi_lr_ModuloPosition;
	b_ModuloInitialised := TRUE;
ELSE
	lr_TempDelta := vi_lr_ModuloPosition - lr_LastModuloPosition;
	IF lr_TempDelta > vi_lr_ModuloPeriod / 2 THEN
		lr_TempDelta := lr_TempDelta - vi_lr_ModuloPeriod;
	ELSIF lr_TempDelta < -vi_lr_ModuloPeriod / 2 THEN
		lr_TempDelta := lr_TempDelta + vi_lr_ModuloPeriod;
	END_IF
	lr_TempPosition := vo_Visu.stState.fBeltPosition + lr_TempDelta;
END_IF
lr_LastModuloPosition := vi_lr_ModuloPosition;
m_SetModuloBeltPosition := m_SetBeltPosition(lr_TempPosition);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetOriginShift" Id="{cf660ade-3b6b-47d7-8a63-b69dcae1eff0}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves the conveyor's coordinate system away from the belt start (stPose), in the belt's local frame. Belt<br>
coordinates (zones' start, end and CCS offset) then count from the shifted origin. TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_SetOriginShift : BOOL
VAR_INPUT
	vi_lr_X								: LREAL;	// [mm] along the conveying direction
	vi_lr_Y								: LREAL;	// [mm] across the belt, 0 = none
	vi_lr_Z								: LREAL;	// [mm] along the belt surface normal, 0 = none
END_VAR
VAR
	TempNew								: ST_VisuConveyorConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.stOriginShift.fX := vi_lr_X;
TempNew.stOriginShift.fY := vi_lr_Y;
TempNew.stOriginShift.fZ := vi_lr_Z;
m_SetOriginShift := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetProductMark" Id="{30e3ac80-9193-4e05-84cb-a4b99dca557f}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Marks a product of the register to single it out, e.g. as a sample: the visualisation draws it in the mark's<br>
colour instead of its state colour. 0 removes the mark. The mark stays through m_SetProductState and<br>
m_MoveProduct; a product latched again (e.g. put down on another conveyor) enters unmarked, so mark it there<br>
again. Name the marks once with _FC_VisuSetMarkName.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE if the product is not in the register or vi_un_Mark is above VISU_un_MAX_MARKS.<br>
****************************************************************************************************)
METHOD m_SetProductMark : BOOL
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] product id
	vi_un_Mark							: UINT;	// [-] product mark 1..VISU_un_MAX_MARKS, 0 = none
END_VAR
VAR
	n_TempIndex							: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetProductMark := FALSE;
IF vi_un_Mark > VISU_GlobalConst.VISU_un_MAX_MARKS THEN
	RETURN;
END_IF
n_TempIndex := m_FindProduct(vi_udn_Id);
IF n_TempIndex < 0 THEN
	RETURN;
END_IF
IF vo_Visu.stState.aProducts[n_TempIndex].nMark <> vi_un_Mark THEN
	vo_Visu.stState.aProducts[n_TempIndex].nMark := vi_un_Mark;
	vo_Visu.stState.nTimestamp := m_DcTime();
END_IF
m_SetProductMark := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetProductState" Id="{d750e750-04ba-4690-b114-957e9051074a}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Changes a product's state and names the client that changed it: the robot that is assigned to, picks,<br>
places or releases it, the station that rejects it. The state before is kept as ePreviousState when the<br>
state changes; calling it again with the same state keeps it. The product keeps its mark.<br>
FALSE if the product is not in the register.<br>
****************************************************************************************************)
METHOD m_SetProductState : BOOL
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] product id
	vi_e_State							: E_VisuProductState;
	vi_udn_ClientId						: UDINT;	// [-] manifest id of the client making the change, 0 = none
	vi_udn_MoverId						: UDINT;	// [-] mover of an XTS gantry or loop carrying the product, 0 = none
	vi_udn_FingerId						: UDINT;	// [-] gripper finger (1-based) the product hangs from while picked, 0 = the flange
END_VAR
VAR
	n_TempIndex							: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[n_TempIndex := m_FindProduct(vi_udn_Id);
m_SetProductState := n_TempIndex >= 0;
IF m_SetProductState THEN
	IF vo_Visu.stState.aProducts[n_TempIndex].eState <> vi_e_State THEN
		vo_Visu.stState.aProducts[n_TempIndex].ePreviousState := vo_Visu.stState.aProducts[n_TempIndex].eState;
	END_IF
	vo_Visu.stState.aProducts[n_TempIndex].eState := vi_e_State;
	vo_Visu.stState.aProducts[n_TempIndex].nLastClientId := vi_udn_ClientId;
	vo_Visu.stState.aProducts[n_TempIndex].nMoverId := vi_udn_MoverId;
	vo_Visu.stState.aProducts[n_TempIndex].nFingerId := vi_udn_FingerId;
	vo_Visu.stState.nTimestamp := m_DcTime();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetProductType" Id="{384e1a50-75ce-481a-941e-2d2e78cfb2f1}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Adds a product type, or updates the one with the same id. FALSE for vi_udn_Id = 0 or a full list. A CYLINDER's<br>
length and width are its diameters (equal: round, different: oval).<br>
****************************************************************************************************)
METHOD m_SetProductType : BOOL
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] referenced by m_LatchProduct's vi_udn_ProductType
	vi_lr_Length						: LREAL;	// [mm] along the conveying direction
	vi_lr_Width							: LREAL;	// [mm]
	vi_lr_Height						: LREAL;	// [mm]
	vi_e_Shape							: E_VisuProductShape;	// [-] solid of the product, BOX for a plain box
	vi_lr_CornerRadius					: LREAL;	// [mm] rounded vertical edges of a ROUNDED_BOX, 0 for other shapes
END_VAR
VAR
	TempNew								: ST_VisuConveyorConfig;
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetProductType := FALSE;
IF vi_udn_Id = 0 THEN
	RETURN;
END_IF
TempNew := vo_Visu.stConfig;
un_TempIndex := 0;
(* ST evaluates both operands of AND: test the index before reading the array. *)
WHILE un_TempIndex < TempNew.nProductTypeCount DO
	IF TempNew.aProductTypes[un_TempIndex].nId = vi_udn_Id THEN
		EXIT;
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE
IF un_TempIndex >= VISU_GlobalConst_Param.VISU_un_MAX_PRODUCT_TYPES THEN
	RETURN;
END_IF
IF un_TempIndex = TempNew.nProductTypeCount THEN
	TempNew.nProductTypeCount := TempNew.nProductTypeCount + 1;
END_IF
TempNew.aProductTypes[un_TempIndex].nId := vi_udn_Id;
TempNew.aProductTypes[un_TempIndex].fLength := vi_lr_Length;
TempNew.aProductTypes[un_TempIndex].fWidth := vi_lr_Width;
TempNew.aProductTypes[un_TempIndex].fHeight := vi_lr_Height;
TempNew.aProductTypes[un_TempIndex].eShape := vi_e_Shape;
TempNew.aProductTypes[un_TempIndex].fCornerRadius := vi_lr_CornerRadius;
m_ApplyConfig(TempNew);
m_SetProductType := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StaysInRegister" Id="{d91631a4-d2c4-40b7-9f88-0693a66c2799}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Whether register entry vi_un_Index stays in the register for m_RemoveProductsBeyond: it is valid and has not<br>
travelled beyond vi_lr_BeltX, or a robot is working on it (ASSIGNED or PICKED).<br>
****************************************************************************************************)
METHOD PRIVATE m_StaysInRegister : BOOL
VAR_INPUT
	vi_un_Index							: UINT;	// [-] register index
	vi_lr_BeltX							: LREAL;	// [mm] along the conveyor from its start
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Belt X from the belt start: the latch pose counts from the origin shift and moves with the belt travel. *)
m_StaysInRegister := vo_Visu.stState.aProducts[vi_un_Index].bValid
	AND (vo_Visu.stConfig.stOriginShift.fX + vo_Visu.stState.aProducts[vi_un_Index].stLatchPose.fX
			+ vo_Visu.stState.fBeltPosition - vo_Visu.stState.aProducts[vi_un_Index].fLatchBeltPosition <= vi_lr_BeltX
		OR vo_Visu.stState.aProducts[vi_un_Index].eState = E_VisuProductState.ASSIGNED
		OR vo_Visu.stState.aProducts[vi_un_Index].eState = E_VisuProductState.PICKED);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>