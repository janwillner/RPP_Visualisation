<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="_FB_VisuXtsLoop" Id="{baa95484-bfa3-4284-9c35-795152919aee}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
One visualised XTS loop (e.g. Fxx): movers circulating on a closed track of two straights and two 180 deg curves.<br>
Typical cycle:<br>
  fb_Fxx.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 20, vi_str_Name := 'Fxx',<br>
      vi_str_Path := 'MAIN.fb_Fxx.vo_Visu');<br>
  fb_Fxx.m_Configure(vi_Pose := LoopPose, vi_lr_StraightLength := 2400, vi_lr_CurveRadius := 250,<br>
      vi_lr_ToolOffset := 120, vi_lr_MoverLength := 100, vi_lr_MoverWidth := 60);<br>
  fb_Fxx.m_SetFinger(vi_un_Finger := 1, vi_lr_Diameter := 40, vi_lr_Height := 50);<br>
  fb_Fxx.m_SetZone(vi_un_Zone := 1, vi_udn_ConveyorId := 2, vi_lr_Start := 2200, vi_lr_End := 2800);<br>
  fb_Fxx.m_SetMoverCount(12);<br>
  fb_Fxx.m_SetMover(vi_un_Index := 0, vi_udn_Id := 1, vi_lr_Position := ..., vi_FingerStates := Mover1Fingers);<br>
Positions run along the loop from the start of the lower straight in the conveying direction (0..m_Perimeter()).<br>
The config methods may be called every cycle; the config version only changes when a value does.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Visu is the contract structure the gateway reads at the path given to m_Register. Do not write it.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Visu 3.0.0  ¦ 2026-10-31 ¦ J.Willner ¦ Naming and layout after the TCAT programming guideline<br>
Syn_Visu 4.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ Zones and fingers from _FB_VisuRobot; m_SetZone by index, no kind<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_VisuXtsLoop EXTENDS _FB_VisuRobot
VAR_OUTPUT
	vo_Visu								: ST_VisuXtsLoop;	// contract structure read by the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_ApplyConfig" Id="{0eaf0fcc-18b0-450e-beb2-2866f78d070b}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Takes over vio_New and increments the config version if it differs from the current config. TRUE if changed.<br>
****************************************************************************************************)
METHOD PRIVATE m_ApplyConfig : BOOL
VAR_IN_OUT
	vio_New								: ST_VisuXtsLoopConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ApplyConfig := Tc2_System.MEMCMP(ADR(vio_New), ADR(vo_Visu.stConfig), SIZEOF(vio_New)) <> 0;
IF m_ApplyConfig THEN
	vo_Visu.stConfig := vio_New;
	m_NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ComponentType" Id="{93a82f2c-2c5f-4fac-95f8-4e7c57ac596a}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Manifest type: XTS loop.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := E_VisuComponentType.XTS_LOOP;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Configure" Id="{492b73d6-3330-4ccc-9ad1-ab0b078c4e12}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets pose, track geometry, tool offset and mover size. TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_Configure : BOOL
VAR_INPUT
	vi_Pose								: ST_VisuPose;	// MCS, start of the lower straight; the loop stands in the local X-Z plane
	vi_lr_StraightLength				: LREAL;	// [mm]
	vi_lr_CurveRadius					: LREAL;	// [mm]
	vi_lr_ToolOffset					: LREAL;	// [mm] tool point outwards from the track
	vi_lr_MoverLength					: LREAL;	// [mm] along the track
	vi_lr_MoverWidth					: LREAL;	// [mm]
END_VAR
VAR
	TempNew								: ST_VisuXtsLoopConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.stPose := vi_Pose;
TempNew.fStraightLength := vi_lr_StraightLength;
TempNew.fCurveRadius := vi_lr_CurveRadius;
TempNew.fToolOffset := vi_lr_ToolOffset;
TempNew.fMoverLength := vi_lr_MoverLength;
TempNew.fMoverWidth := vi_lr_MoverWidth;
m_Configure := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Fingers" Id="{5f6ec3ec-49cc-46db-b4ac-2b31110384b9}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The fingers of every mover's gripper for _FB_VisuRobot.m_SetFinger and m_ClearFingers.<br>
****************************************************************************************************)
METHOD PROTECTED m_Fingers : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Fingers						: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Count := ADR(vo_Visu.stConfig.nFingerCount);
vo_p_Fingers := ADR(vo_Visu.stConfig.aFingers);
m_Fingers := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Perimeter" Id="{3738bf5c-d889-4d83-85b1-93a2f8148d45}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Length of the loop as the visualisation computes it (curves as semicircles), [mm].<br>
****************************************************************************************************)
METHOD m_Perimeter : LREAL]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Perimeter := 2.0 * vo_Visu.stConfig.fStraightLength + 2.0 * 3.141592653589793 * vo_Visu.stConfig.fCurveRadius;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetFault" Id="{dfe3503c-b1b7-448b-9e2d-61007f8c2ff9}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets or clears the fault of the whole loop: drawn red with the message while active. Faults of single<br>
movers go through m_SetMover. The fault stays until it is cleared with m_SetFault(vi_b_Active := FALSE,<br>
vi_str_Message := ''). TRUE.<br>
****************************************************************************************************)
METHOD m_SetFault : BOOL
VAR_INPUT
	vi_b_Active							: BOOL;	// TRUE: fault active
	vi_str_Message						: STRING(80);	// shown to the operator; empty shows 'Fault'
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_Visu.stState.stFault.bActive := vi_b_Active;
vo_Visu.stState.stFault.sMessage := vi_str_Message;
m_SetFault := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetMover" Id="{ef974285-e6df-4745-8924-8568b5647a44}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reports one mover at entry vi_un_Index and marks it valid. Call once per cycle per mover.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE if vi_un_Index is outside the mover count set by m_SetMoverCount.<br>
****************************************************************************************************)
METHOD m_SetMover : BOOL
VAR_INPUT
	vi_un_Index							: UINT;	// [-] 0..m_SetMoverCount - 1
	vi_udn_Id							: UDINT;	// [-] unique within the loop, > 0
	vi_lr_Position						: LREAL;	// [mm] along the loop from the start of the lower straight (0..m_Perimeter())
	(* Finger poses absolute in the MCS and grip states, index 0 = finger 1; entries beyond the finger count are ignored. *)
	vi_FingerStates						: ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFingerState;
	vi_b_Fault							: BOOL := FALSE;	// TRUE: this mover is in a fault
	vi_str_FaultMessage					: STRING(80) := '';	// shown to the operator; empty shows 'Fault'
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetMover := vi_un_Index < vo_Visu.stState.nMoverCount;
IF m_SetMover THEN
	vo_Visu.stState.aMovers[vi_un_Index].nId := vi_udn_Id;
	vo_Visu.stState.aMovers[vi_un_Index].bValid := TRUE;
	vo_Visu.stState.aMovers[vi_un_Index].fPosition := vi_lr_Position;
	vo_Visu.stState.aMovers[vi_un_Index].aFingerStates := vi_FingerStates;
	vo_Visu.stState.aMovers[vi_un_Index].stFault.bActive := vi_b_Fault;
	vo_Visu.stState.aMovers[vi_un_Index].stFault.sMessage := vi_str_FaultMessage;
	vo_Visu.stState.nTimestamp := m_DcTime();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetMoverCount" Id="{8509edf4-e085-4c6d-b439-ba49ee0e47f9}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets how many mover entries are evaluated (limited to VISU_GlobalConst_Param.VISU_un_MAX_MOVERS); entries<br>
beyond are invalidated. TRUE if vi_un_Count fitted.<br>
****************************************************************************************************)
METHOD m_SetMoverCount : BOOL
VAR_INPUT
	vi_un_Count							: UINT;	// [-] movers
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetMoverCount := vi_un_Count <= VISU_GlobalConst_Param.VISU_un_MAX_MOVERS;
vo_Visu.stState.nMoverCount := MIN(vi_un_Count, VISU_GlobalConst_Param.VISU_un_MAX_MOVERS);
FOR un_TempIndex := vo_Visu.stState.nMoverCount TO VISU_GlobalConst_Param.VISU_un_MAX_MOVERS - 1 DO
	vo_Visu.stState.aMovers[un_TempIndex].bValid := FALSE;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetOriginShift" Id="{230ad245-1781-4fe8-a177-c8ef5e0afbf6}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves the loop's shown coordinate system (origin triad, local measuring coordinates) away from the start of<br>
the lower straight (stPose), in the loop's local frame. Geometry and mover positions stay relative to stPose.<br>
TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_SetOriginShift : BOOL
VAR_INPUT
	vi_lr_X								: LREAL;	// [mm] along the lower straight (local X)
	vi_lr_Y								: LREAL := 0;	// [mm] along the loop's local Y
	vi_lr_Z								: LREAL := 0;	// [mm] along the loop's local Z
END_VAR
VAR
	TempNew								: ST_VisuXtsLoopConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.stOriginShift.fX := vi_lr_X;
TempNew.stOriginShift.fY := vi_lr_Y;
TempNew.stOriginShift.fZ := vi_lr_Z;
m_SetOriginShift := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Zones" Id="{7f25d6d2-e594-41ae-b17d-c6689b491d73}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The loop's zones for _FB_VisuZoneComponent.m_SetZone and m_ClearZones.<br>
****************************************************************************************************)
METHOD PROTECTED m_Zones : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Zones							: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Count := ADR(vo_Visu.stConfig.nZoneCount);
vo_p_Zones := ADR(vo_Visu.stConfig.aZones);
m_Zones := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>