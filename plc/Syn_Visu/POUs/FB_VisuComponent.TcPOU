<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_VisuComponent" Id="{1bb2bb12-80df-431f-8484-be480e62919c}" SpecialFunc="None">
    <Declaration><![CDATA[(* Base of every visualised component (FB_VisuConveyor, FB_VisuDelta). Handles the manifest entry,
   the config version and the DC timestamps. Not used directly. *)
FUNCTION_BLOCK ABSTRACT FB_VisuComponent
VAR
	refManifest : REFERENCE TO ST_VisuManifest; // set by Register
	nComponentId : UDINT; // manifest id, 0 = not registered
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ComponentType" Id="{40e7fa5c-7bb7-42db-b8bf-1580e630ae2f}">
      <Declaration><![CDATA[(* Manifest type of the component. Overridden by every derived FB. *)
METHOD PROTECTED ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComponentType := E_VisuComponentType.NONE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="DcTime" Id="{a4316896-c21a-4592-b930-145869b82340}">
      <Declaration><![CDATA[(* Distributed-clock time of the calling task's current cycle in ns since 2000-01-01; 0 if unknown. *)
METHOD PROTECTED DcTime : ULINT
VAR
	nTaskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[nTaskIndex := Tc2_System.GETCURTASKINDEXEX();
IF nTaskIndex > 0 THEN
	DcTime := LINT_TO_ULINT(TwinCAT_SystemInfoVarList._TaskInfo[nTaskIndex].DcTaskTime);
ELSE
	DcTime := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Id" Id="{692a0329-f838-436a-bcd1-5379ec8af186}">
      <Declaration><![CDATA[(* Manifest id given to Register; 0 while not registered. *)
METHOD Id : UDINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[Id := nComponentId;]]></ST>
      </Implementation>
    </Method>
    <Method Name="NotifyConfigChanged" Id="{354c9cac-21e2-4858-989c-b1578155f413}">
      <Declaration><![CDATA[(* Increments the manifest's nConfigVersion so the gateway re-reads the config. No effect before Register. *)
METHOD PROTECTED NotifyConfigChanged : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[NotifyConfigChanged := __ISVALIDREF(refManifest);
IF NotifyConfigChanged THEN
	refManifest.nConfigVersion := refManifest.nConfigVersion + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Register" Id="{ccfae2cd-4aa7-41dd-b228-7906e447b2e6}">
      <Declaration><![CDATA[(* Adds this component to the manifest; increments nConfigVersion when the entry is new.
   Idempotent: call it every cycle, which also keeps the manifest reference valid after an online change.
   Returns FALSE for nId = 0, an id already used by a different entry, or a full manifest. *)
METHOD Register : BOOL
VAR_IN_OUT
	stManifest : ST_VisuManifest; // GVL_Visu.stManifest of the application
END_VAR
VAR_INPUT
	nId : UDINT; // unique, > 0
	sName : STRING(80); // display name
	sPath : STRING(255); // symbol path of this instance's stVisu, e.g. 'MAIN.fbInfeed.stVisu'
END_VAR
VAR
	eType : E_VisuComponentType;
	nIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Register := FALSE;
refManifest REF= stManifest;
// Always report the contract version of the library actually running, also after an online change.
stManifest.nProtocolVersion := GVL_VisuConstants.nProtocolVersion;
eType := ComponentType();
IF nId = 0 OR eType = E_VisuComponentType.NONE THEN
	RETURN;
END_IF

nIndex := 0;
WHILE nIndex < stManifest.nCount AND nIndex < GVL_VisuParam.nMaxManifestEntries DO
	IF stManifest.aEntries[nIndex].nId = nId THEN
		Register := stManifest.aEntries[nIndex].eType = eType
			AND stManifest.aEntries[nIndex].sName = sName
			AND stManifest.aEntries[nIndex].sPath = sPath;
		IF Register THEN
			nComponentId := nId;
		END_IF
		RETURN;
	END_IF
	nIndex := nIndex + 1;
END_WHILE

IF stManifest.nCount >= GVL_VisuParam.nMaxManifestEntries THEN
	RETURN;
END_IF

stManifest.aEntries[stManifest.nCount].nId := nId;
stManifest.aEntries[stManifest.nCount].eType := eType;
stManifest.aEntries[stManifest.nCount].sName := sName;
stManifest.aEntries[stManifest.nCount].sPath := sPath;
stManifest.nCount := stManifest.nCount + 1;
stManifest.nConfigVersion := stManifest.nConfigVersion + 1;
nComponentId := nId;
Register := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>