<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="F_VisuDemoCompact" Id="{c2d88068-5894-41dc-87fb-25e68f4266eb}" SpecialFunc="None">
    <Declaration><![CDATA[(* DEMO ONLY: drops register entries that are invalid or have travelled beyond fRemoveBeyond (belt X, mm).
   Entries a robot is working on (ASSIGNED or PICKED) are kept wherever they are. Assumes the belt starts at
   MCS X = 0 and conveys along MCS +X. *)
FUNCTION F_VisuDemoCompact : BOOL
VAR_IN_OUT
	stState : ST_VisuConveyorState;
END_VAR
VAR_INPUT
	fRemoveBeyond : LREAL;
END_VAR
VAR
	nRead : UINT;
	nWrite : UINT;
	fX : LREAL;
	bInUse : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_VisuDemoCompact := TRUE;
IF stState.nProductCount = 0 THEN
	RETURN;
END_IF

nWrite := 0;
FOR nRead := 0 TO stState.nProductCount - 1 DO
	fX := stState.aProducts[nRead].stLatchPose.fX + (stState.fEncoder - stState.aProducts[nRead].fLatchEncoder);
	bInUse := stState.aProducts[nRead].eState = E_VisuProductState.ASSIGNED
		OR stState.aProducts[nRead].eState = E_VisuProductState.PICKED;
	IF stState.aProducts[nRead].bValid AND (fX <= fRemoveBeyond OR bInUse) THEN
		IF nWrite <> nRead THEN
			stState.aProducts[nWrite] := stState.aProducts[nRead];
		END_IF
		nWrite := nWrite + 1;
	END_IF
END_FOR

IF nWrite < stState.nProductCount THEN
	FOR nRead := nWrite TO stState.nProductCount - 1 DO
		stState.aProducts[nRead].bValid := FALSE;
	END_FOR
END_IF
stState.nProductCount := nWrite;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>