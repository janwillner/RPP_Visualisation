<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="_FB_VisuXtsGantry" Id="{e258240d-815f-404f-8267-99bc35d2d4eb}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
One visualised XTS gantry (e.g. IDH): a straight track of XTS motor modules on a common Z axis, each mover<br>
with an X axis and a gripper flange at its end. Typical cycle:<br>
  fb_Idh.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 30, vi_str_Name := 'IDH',<br>
      vi_str_Path := 'MAIN.fb_Idh.vo_Visu');<br>
  fb_Idh.m_Configure(vi_Pose := TrackPose, vi_lr_XMin := 0, vi_lr_XMax := 700, vi_lr_ZMin := -100, vi_lr_ZMax := 0, vi_lr_ToolOffsetX := 150, vi_lr_ToolOffsetZ := -350,<br>
      vi_lr_MoverLength := 155, vi_lr_MoverWidth := 80);<br>
  FOR un_Module := 1 TO 6 DO<br>
      fb_Idh.m_SetModule(vi_un_Module := un_Module, vi_e_Kind := E_VisuModuleKind.STRAIGHT);<br>
  END_FOR<br>
  fb_Idh.m_SetFinger(vi_un_Finger := 1, vi_lr_Diameter := 40, vi_lr_Height := 50);<br>
  fb_Idh.m_SetZone(vi_un_Zone := 1, vi_udn_ConveyorId := 3, vi_lr_Start := 1100, vi_lr_End := 2600);<br>
  fb_Idh.m_SetZPosition(lr_ZAxisActual);<br>
  fb_Idh.m_SetMoverCount(4);<br>
  fb_Idh.m_SetMover(vi_un_Index := 0, vi_udn_Id := 1, vi_lr_Position := ..., vi_lr_X := ..., vi_FingerStates := Mover1Fingers);<br>
Only actual values are reported; tool rotations (e.g. C) show only through the finger poses, absolute in the MCS.<br>
The config methods may be called every cycle; the config version only changes when a value does.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Visu is the contract structure the gateway reads at the path given to m_Register. Do not write it.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Visu 3.0.0  ¦ 2026-10-31 ¦ J.Willner ¦ Naming and layout after the TCAT programming guideline<br>
Syn_Visu 4.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ Zones and fingers from _FB_VisuRobot; m_SetZone by index, no kind<br>
Syn_Visu 5.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ Track of modules from _FB_VisuXtsTrack (m_SetModule)<br>
****************************************************************************************************)
FUNCTION_BLOCK _FB_VisuXtsGantry EXTENDS _FB_VisuXtsTrack
VAR_OUTPUT
	vo_Visu								: ST_VisuXtsGantry;	// contract structure read by the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_ApplyConfig" Id="{0d960d5b-dc1b-414d-932b-c3f84252a62b}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Takes over vio_New and increments the config version if it differs from the current config. TRUE if changed.<br>
****************************************************************************************************)
METHOD PRIVATE m_ApplyConfig : BOOL
VAR_IN_OUT
	vio_New								: ST_VisuXtsGantryConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ApplyConfig := Tc2_System.MEMCMP(ADR(vio_New), ADR(vo_Visu.stConfig), SIZEOF(vio_New)) <> 0;
IF m_ApplyConfig THEN
	vo_Visu.stConfig := vio_New;
	m_NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ComponentType" Id="{c3f8ceb9-4b60-46da-b663-f6415f498013}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Manifest type: XTS gantry.<br>
****************************************************************************************************)
METHOD PROTECTED m_ComponentType : E_VisuComponentType]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ComponentType := E_VisuComponentType.XTS_GANTRY;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Configure" Id="{6fd3441b-a203-4747-ba6c-caa4f39037e8}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets pose, strokes, gripper offsets and mover size; the track comes from m_SetModule. TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_Configure : BOOL
VAR_INPUT
	vi_Pose								: ST_VisuPose;	// MCS, track start on top of the movers with Z = 0
	vi_lr_XMin							: LREAL;	// [mm]
	vi_lr_XMax							: LREAL;	// [mm]
	vi_lr_ZMin							: LREAL;	// [mm]
	vi_lr_ZMax							: LREAL;	// [mm]
	vi_lr_ToolOffsetX					: LREAL;	// [mm] gripper flange ahead of the X axis zero
	vi_lr_ToolOffsetZ					: LREAL;	// [mm] gripper flange relative to the mover top (below: negative)
	vi_lr_MoverLength					: LREAL;	// [mm] along the track
	vi_lr_MoverWidth					: LREAL;	// [mm]
END_VAR
VAR
	TempNew								: ST_VisuXtsGantryConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.stPose := vi_Pose;
TempNew.fXMin := vi_lr_XMin;
TempNew.fXMax := vi_lr_XMax;
TempNew.fZMin := vi_lr_ZMin;
TempNew.fZMax := vi_lr_ZMax;
TempNew.fToolOffsetX := vi_lr_ToolOffsetX;
TempNew.fToolOffsetZ := vi_lr_ToolOffsetZ;
TempNew.fMoverLength := vi_lr_MoverLength;
TempNew.fMoverWidth := vi_lr_MoverWidth;
m_Configure := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Fingers" Id="{4f939a57-d71f-49dc-b23d-3e76712448a0}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The fingers of every mover's gripper for _FB_VisuRobot.m_SetFinger and m_ClearFingers.<br>
****************************************************************************************************)
METHOD PROTECTED m_Fingers : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Fingers						: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Count := ADR(vo_Visu.stConfig.nFingerCount);
vo_p_Fingers := ADR(vo_Visu.stConfig.aFingers);
m_Fingers := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Modules" Id="{dd17074c-cb31-4c60-a29a-76adc2de14db}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The gantry's track modules for _FB_VisuXtsTrack.m_SetModule and m_ClearModules.<br>
****************************************************************************************************)
METHOD PROTECTED m_Modules : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Modules						: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_MODULES - 1] OF ST_VisuTrackModule;
	vo_p_States							: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_MODULES - 1] OF ST_VisuTrackModuleState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Count := ADR(vo_Visu.stConfig.nModuleCount);
vo_p_Modules := ADR(vo_Visu.stConfig.aModules);
vo_p_States := ADR(vo_Visu.stState.aModuleStates);
m_Modules := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetFault" Id="{a224315d-90cd-4fab-ba72-581b61a07fcb}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets or clears the fault of the whole gantry: drawn red with the message while active. Faults of single<br>
movers go through m_SetMover. The fault stays until it is cleared with m_SetFault(vi_b_Active := FALSE,<br>
vi_str_Message := ''). TRUE.<br>
****************************************************************************************************)
METHOD m_SetFault : BOOL
VAR_INPUT
	vi_b_Active							: BOOL;	// TRUE: fault active
	vi_str_Message						: STRING(80);	// shown to the operator; empty shows 'Fault'
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_Visu.stState.stFault.bActive := vi_b_Active;
vo_Visu.stState.stFault.sMessage := vi_str_Message;
m_SetFault := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetMover" Id="{836cee3d-a740-493b-ba48-ab27074bc414}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reports one mover (actual values) at entry vi_un_Index and marks it valid. Call once per cycle per mover.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE if vi_un_Index is outside the mover count set by m_SetMoverCount.<br>
****************************************************************************************************)
METHOD m_SetMover : BOOL
VAR_INPUT
	vi_un_Index							: UINT;	// [-] 0..m_SetMoverCount - 1
	vi_udn_Id							: UDINT;	// [-] unique within the gantry, > 0
	vi_lr_Position						: LREAL;	// [mm] along the track
	vi_lr_X								: LREAL;	// [mm] X axis
	vi_b_GripperActive					: BOOL;	// used only when no fingers are configured
	(* Finger poses absolute in the MCS and grip states, index 0 = finger 1; entries beyond the finger count are ignored. *)
	vi_FingerStates						: ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFingerState;
	vi_b_Fault							: BOOL := FALSE;	// TRUE: this mover is in a fault
	vi_str_FaultMessage					: STRING(80) := '';	// shown to the operator; empty shows 'Fault'
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetMover := vi_un_Index < vo_Visu.stState.nMoverCount;
IF m_SetMover THEN
	vo_Visu.stState.aMovers[vi_un_Index].nId := vi_udn_Id;
	vo_Visu.stState.aMovers[vi_un_Index].bValid := TRUE;
	vo_Visu.stState.aMovers[vi_un_Index].fPosition := vi_lr_Position;
	vo_Visu.stState.aMovers[vi_un_Index].fX := vi_lr_X;
	vo_Visu.stState.aMovers[vi_un_Index].bGripperActive := vi_b_GripperActive;
	vo_Visu.stState.aMovers[vi_un_Index].aFingerStates := vi_FingerStates;
	vo_Visu.stState.aMovers[vi_un_Index].stFault.bActive := vi_b_Fault;
	vo_Visu.stState.aMovers[vi_un_Index].stFault.sMessage := vi_str_FaultMessage;
	vo_Visu.stState.nTimestamp := m_DcTime();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetMoverCount" Id="{4572b63b-ec4b-486d-8c52-d5efaf72cb7a}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets how many mover entries are evaluated (limited to VISU_GlobalConst_Param.VISU_un_MAX_MOVERS); entries<br>
beyond are invalidated. TRUE if vi_un_Count fitted.<br>
****************************************************************************************************)
METHOD m_SetMoverCount : BOOL
VAR_INPUT
	vi_un_Count							: UINT;	// [-] movers
END_VAR
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetMoverCount := vi_un_Count <= VISU_GlobalConst_Param.VISU_un_MAX_MOVERS;
vo_Visu.stState.nMoverCount := MIN(vi_un_Count, VISU_GlobalConst_Param.VISU_un_MAX_MOVERS);
FOR un_TempIndex := vo_Visu.stState.nMoverCount TO VISU_GlobalConst_Param.VISU_un_MAX_MOVERS - 1 DO
	vo_Visu.stState.aMovers[un_TempIndex].bValid := FALSE;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetOriginShift" Id="{af2b6752-879c-4c46-9602-4687821fd73d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves the gantry's shown coordinate system (origin triad, local measuring coordinates) away from the track<br>
start (stPose), in the gantry's local frame. Geometry and mover positions stay relative to stPose.<br>
TRUE if anything changed.<br>
****************************************************************************************************)
METHOD m_SetOriginShift : BOOL
VAR_INPUT
	vi_lr_X								: LREAL;	// [mm] along the gantry's local X
	vi_lr_Y								: LREAL := 0;	// [mm] along the track (local Y)
	vi_lr_Z								: LREAL := 0;	// [mm] along the gantry's local Z
END_VAR
VAR
	TempNew								: ST_VisuXtsGantryConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TempNew := vo_Visu.stConfig;
TempNew.stOriginShift.fX := vi_lr_X;
TempNew.stOriginShift.fY := vi_lr_Y;
TempNew.stOriginShift.fZ := vi_lr_Z;
m_SetOriginShift := m_ApplyConfig(TempNew);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetZPosition" Id="{0aaac84c-8293-4e8a-9c63-4e9bfc97927a}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reports the common Z axis (actual value). Call once per cycle; it also stamps the state with the cycle's DC time.<br>
****************************************************************************************************)
METHOD m_SetZPosition : BOOL
VAR_INPUT
	vi_lr_Z								: LREAL;	// [mm]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_Visu.stState.fZ := vi_lr_Z;
vo_Visu.stState.nTimestamp := m_DcTime();
m_SetZPosition := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Zones" Id="{652e0996-d84b-47cb-b7f2-a52be6480cd0}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The gantry's zones for _FB_VisuZoneComponent.m_SetZone and m_ClearZones.<br>
****************************************************************************************************)
METHOD PROTECTED m_Zones : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Zones							: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Count := ADR(vo_Visu.stConfig.nZoneCount);
vo_p_Zones := ADR(vo_Visu.stConfig.aZones);
m_Zones := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>