<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="F_GetVersionSyn_Visu" Id="{20c4b6bb-e4a5-46a2-9927-891e013083e3}" SpecialFunc="None">
    <Declaration><![CDATA[(* Runtime-readable version of the Syn_Visu library. *)
FUNCTION F_GetVersionSyn_Visu : UINT
VAR_INPUT
	nVersionElement : INT; // 1 = major, 2 = minor, 3 = revision
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE nVersionElement OF
	1: F_GetVersionSyn_Visu := 2;
	2: F_GetVersionSyn_Visu := 0;
	3: F_GetVersionSyn_Visu := 0;
ELSE
	F_GetVersionSyn_Visu := 16#FFFF;
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>