<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="_FB_VisuRobot" Id="{5ceb582b-104f-47cb-91fd-61b1cc207460}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Base of every robot (Delta, XTS gantry, XTS loop, Cartesian): zones plus the gripper fingers,<br>
m_SetFinger and m_ClearFingers, and the limit area, m_SetLimitArea and m_ClearLimitArea. A derived FB tells<br>
where its fingers and its limit area lie through m_Fingers and m_LimitArea; an XTS loop has no limit area.<br>
Not used directly.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Visu 4.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ New: fingers shared by all robots<br>
Syn_Visu 9.3.0  ¦ 2026-11-07 ¦ J.Willner ¦ Limit area shared by Delta, XTS gantry and Cartesian (was Delta only)<br>
****************************************************************************************************)
FUNCTION_BLOCK ABSTRACT _FB_VisuRobot EXTENDS _FB_VisuZoneComponent
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_ClearFingers" Id="{c59c54bb-9b8a-4354-8e47-b266be81a7d2}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Removes the gripper definition. TRUE if there was one.<br>
****************************************************************************************************)
METHOD m_ClearFingers : BOOL
VAR
	p_TempCount							: POINTER TO UINT;
	p_TempFingers						: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
	TempEmpty							: ST_VisuFinger;
	un_TempIndex						: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ClearFingers := FALSE;
m_Fingers(vo_p_Count => p_TempCount, vo_p_Fingers => p_TempFingers);
IF p_TempCount = 0 OR p_TempFingers = 0 THEN
	RETURN;
END_IF
m_ClearFingers := p_TempCount^ > 0;
FOR un_TempIndex := 0 TO VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1 DO
	p_TempFingers^[un_TempIndex] := TempEmpty;
END_FOR
p_TempCount^ := 0;
IF m_ClearFingers THEN
	m_NotifyConfigChanged();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ClearLimitArea" Id="{860a5579-9f26-458c-b290-d105a32d5cba}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Removes the limit area. TRUE if there was one.<br>
****************************************************************************************************)
METHOD m_ClearLimitArea : BOOL
VAR
	p_TempLimitArea						: POINTER TO ST_VisuLimitArea;
	TempEmpty							: ST_VisuLimitArea;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_ClearLimitArea := FALSE;
m_LimitArea(vo_p_LimitArea => p_TempLimitArea);
IF p_TempLimitArea = 0 THEN
	RETURN;
END_IF
m_ClearLimitArea := p_TempLimitArea^.bActive;
IF Tc2_System.MEMCMP(ADR(TempEmpty), p_TempLimitArea, SIZEOF(TempEmpty)) <> 0 THEN
	p_TempLimitArea^ := TempEmpty;
	m_NotifyConfigChanged();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Fingers" Id="{a244e015-94d6-456e-b723-254a871e0b47}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Where the gripper fingers lie in the derived FB's contract structure: vo_p_Count points to its<br>
nFingerCount, vo_p_Fingers to its aFingers.<br>
****************************************************************************************************)
METHOD PROTECTED ABSTRACT m_Fingers : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Fingers						: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_LimitArea" Id="{422ae902-a026-4b53-81df-e5504829a257}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Where the limit area lies in the derived FB's contract structure: vo_p_LimitArea points to its stLimitArea,<br>
or is 0 for a robot without one (XTS loop: it has no working area of its own).<br>
****************************************************************************************************)
METHOD PROTECTED ABSTRACT m_LimitArea : BOOL
VAR_OUTPUT
	vo_p_LimitArea						: POINTER TO ST_VisuLimitArea;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetFinger" Id="{e7ffdbfc-b2ac-4437-abcd-43e830fe868a}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Defines gripper finger vi_un_Finger (1-based): a cylinder hanging from the finger's pose along its local -Z.<br>
For XTS kinematics it is a finger of every mover's gripper. The finger count grows to vi_un_Finger.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
FALSE outside 1..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS.<br>
****************************************************************************************************)
METHOD m_SetFinger : BOOL
VAR_INPUT
	vi_un_Finger						: UINT;	// [-] 1-based, as a product's nFingerId
	vi_lr_Diameter						: LREAL;	// [mm]
	vi_lr_Height						: LREAL;	// [mm] along the finger's local -Z
END_VAR
VAR
	p_TempCount							: POINTER TO UINT;
	p_TempFingers						: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
	TempFinger							: ST_VisuFinger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetFinger := FALSE;
IF vi_un_Finger = 0 OR vi_un_Finger > VISU_GlobalConst_Param.VISU_un_MAX_FINGERS THEN
	RETURN;
END_IF
m_Fingers(vo_p_Count => p_TempCount, vo_p_Fingers => p_TempFingers);
IF p_TempCount = 0 OR p_TempFingers = 0 THEN
	RETURN;
END_IF
TempFinger.fDiameter := vi_lr_Diameter;
TempFinger.fHeight := vi_lr_Height;
IF vi_un_Finger > p_TempCount^
OR Tc2_System.MEMCMP(ADR(TempFinger), ADR(p_TempFingers^[vi_un_Finger - 1]), SIZEOF(TempFinger)) <> 0
THEN
	p_TempFingers^[vi_un_Finger - 1] := TempFinger;
	p_TempCount^ := MAX(p_TempCount^, vi_un_Finger);
	m_NotifyConfigChanged();
END_IF
m_SetFinger := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetLimitArea" Id="{c83e3c90-d747-4568-a7bd-6b20d6038e33}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Sets and activates the limit area: an axis-aligned box in the robot frame (relative to its pose, the frame its<br>
working area is given in) that further restricts the working area. Delta, XTS gantry and Cartesian robot;<br>
an XTS loop has none. Equal bounds make a flat box. The config version only changes when a value does.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE if anything changed; FALSE for a robot without a limit area (XTS loop).<br>
****************************************************************************************************)
METHOD m_SetLimitArea : BOOL
VAR_INPUT
	vi_lr_XMin							: LREAL;	// [mm] in the robot frame
	vi_lr_XMax							: LREAL;	// [mm]
	vi_lr_YMin							: LREAL;	// [mm]
	vi_lr_YMax							: LREAL;	// [mm]
	vi_lr_ZMin							: LREAL;	// [mm] relative to the pose (below it: negative)
	vi_lr_ZMax							: LREAL;	// [mm]
END_VAR
VAR
	p_TempLimitArea						: POINTER TO ST_VisuLimitArea;
	TempLimitArea						: ST_VisuLimitArea;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_SetLimitArea := FALSE;
m_LimitArea(vo_p_LimitArea => p_TempLimitArea);
IF p_TempLimitArea = 0 THEN
	RETURN;
END_IF
TempLimitArea.fXMin := vi_lr_XMin;
TempLimitArea.fXMax := vi_lr_XMax;
TempLimitArea.fYMin := vi_lr_YMin;
TempLimitArea.fYMax := vi_lr_YMax;
TempLimitArea.fZMin := vi_lr_ZMin;
TempLimitArea.fZMax := vi_lr_ZMax;
TempLimitArea.bActive := TRUE;
IF Tc2_System.MEMCMP(ADR(TempLimitArea), p_TempLimitArea, SIZEOF(TempLimitArea)) <> 0 THEN
	p_TempLimitArea^ := TempLimitArea;
	m_NotifyConfigChanged();
	m_SetLimitArea := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>