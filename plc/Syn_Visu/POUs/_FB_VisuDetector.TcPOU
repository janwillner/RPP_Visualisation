<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="_FB_VisuDetector" Id="{58895edc-e638-472b-81d8-e4022f8d53c4}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Base of a detector (_FB_VisuVision, _FB_VisuSensor): a component that detects products in its zones<br>
and is drawn from the bodies it describes (m_SetBody of _FB_VisuBodyComponent), so the visualisation<br>
needs no code of its own for it. The application latches the products on the conveyor itself<br>
(_FB_VisuConveyor.m_LatchProduct with vi_udn_ClientId := this detector's id). m_Register, called every<br>
cycle, also stamps the state. Not used directly.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
vo_Visu is the contract structure the gateway reads at the path given to m_Register. Do not write it.<br>
*****************************************************************************************************<br>
VERSION         ¦ DATE       ¦ NAME      ¦ CHANGE<br>
Syn_Visu 4.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ New<br>
Syn_Visu 6.0.0  ¦ 2026-11-01 ¦ J.Willner ¦ Body handling moved to the base _FB_VisuBodyComponent<br>
****************************************************************************************************)
FUNCTION_BLOCK ABSTRACT _FB_VisuDetector EXTENDS _FB_VisuBodyComponent
VAR_OUTPUT
	vo_Visu								: ST_VisuDetector;	// contract structure read by the gateway
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="m_Parts" Id="{8d12bb70-188e-4b03-b6fa-77946935db72}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The detector's pose, origin shift, bodies, body states, timestamp and fault for _FB_VisuBodyComponent.<br>
****************************************************************************************************)
METHOD PROTECTED m_Parts : BOOL
VAR_OUTPUT
	vo_p_Pose							: POINTER TO ST_VisuPose;
	vo_p_OriginShift					: POINTER TO ST_VisuPosition;
	vo_p_BodyCount						: POINTER TO UINT;
	vo_p_Bodies							: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_BODIES - 1] OF ST_VisuBody;
	vo_p_BodyStates						: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_BODIES - 1] OF ST_VisuBodyState;
	vo_p_Timestamp						: POINTER TO ULINT;
	vo_p_Fault							: POINTER TO ST_VisuFault;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Pose := ADR(vo_Visu.stConfig.stPose);
vo_p_OriginShift := ADR(vo_Visu.stConfig.stOriginShift);
vo_p_BodyCount := ADR(vo_Visu.stConfig.nBodyCount);
vo_p_Bodies := ADR(vo_Visu.stConfig.aBodies);
vo_p_BodyStates := ADR(vo_Visu.stState.aBodyStates);
vo_p_Timestamp := ADR(vo_Visu.stState.nTimestamp);
vo_p_Fault := ADR(vo_Visu.stState.stFault);
m_Parts := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Zones" Id="{be8c390a-8b08-45c9-aa83-3cfba2221116}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The detector's zones for _FB_VisuZoneComponent.m_SetZone and m_ClearZones.<br>
****************************************************************************************************)
METHOD PROTECTED m_Zones : BOOL
VAR_OUTPUT
	vo_p_Count							: POINTER TO UINT;
	vo_p_Zones							: POINTER TO ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[vo_p_Count := ADR(vo_Visu.stConfig.nZoneCount);
vo_p_Zones := ADR(vo_Visu.stConfig.aZones);
m_Zones := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>