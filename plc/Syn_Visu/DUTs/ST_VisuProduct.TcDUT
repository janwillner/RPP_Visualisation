<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuProduct" Id="{e2da59ee-c73b-414a-81df-1b52d5414d95}">
    <Declaration><![CDATA[TYPE ST_VisuProduct :
STRUCT
	nId : UDINT;
	bValid : BOOL; // invalid entries are not shown
	stLatchPose : ST_VisuPlanarPose; // conveyor coordinate system (stPose + stOriginShift), bottom centre at latch time
	fLatchBeltPosition : LREAL; // conveyor fBeltPosition at latch time, mm
	eState : E_VisuProductState;
	ePreviousState : E_VisuProductState; // state before the last change; equals eState until the first change
	(* Manifest id of the client that made the last change: the detector or station that latched it, the robot it
	   is assigned to, picked by or placed by, the station that rejected it; 0 = none given. *)
	nLastClientId : UDINT;
	nMoverId : UDINT; // mover of an XTS gantry or loop carrying the product, 0 = none
	nFingerId : UDINT; // gripper finger (1-based) the product hangs from while picked, 0 = the gripper flange
	nProductType : UDINT; // id in the conveyor's aProductTypes
	nMark : UINT; // product mark 1..VISU_un_MAX_MARKS singling the product out, 0 = none (m_SetProductMark)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>