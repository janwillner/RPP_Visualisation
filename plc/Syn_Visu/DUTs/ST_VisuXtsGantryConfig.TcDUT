<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuXtsGantryConfig" Id="{c8acad2a-492e-4cce-85fd-045c31f861e2}">
    <Declaration><![CDATA[TYPE ST_VisuXtsGantryConfig :
STRUCT
	(* Straight XTS track of track modules, carried by a common Z axis; every mover carries an X axis with a
	   gripper flange at its end. Local frame: origin at the track start on top of the movers with Z = 0; the track runs
	   along local +Y, the X axes along local +X, the Z axis along local +Z (up). *)
	stPose : ST_VisuPose; // MCS
	nModuleCount : UINT; // entries [0..nModuleCount-1] are evaluated
	aModules : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_MODULES - 1] OF ST_VisuTrackModule; // from the track start along local +Y
	fXMin : LREAL; // mm, X stroke
	fXMax : LREAL; // mm
	fZMin : LREAL; // mm, Z stroke
	fZMax : LREAL; // mm
	fToolOffsetX : LREAL; // mm, gripper flange ahead of the X axis zero along local +X
	fToolOffsetZ : LREAL; // mm, gripper flange relative to the mover top (below: negative)
	fMoverLength : LREAL; // mm, along the track
	fMoverWidth : LREAL; // mm
	nZoneCount : UINT;
	aZones : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone; // pick and place zones
	nFingerCount : UINT; // fingers of every mover's gripper, 0 = no gripper definition
	aFingers : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
	(* mm in the local frame from stPose: origin of the gantry's coordinate system as shown (origin triad, local
	   measuring coordinates). The geometry and mover positions stay relative to stPose. *)
	stOriginShift : ST_VisuPosition;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>