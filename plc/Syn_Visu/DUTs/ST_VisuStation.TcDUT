	   eType := E_VisuComponentType.STATION. *)
	stConfig : ST_VisuStationConfig; // read at discovery and after nConfigVersion changes
	stState : ST_VisuStationState; // read every gateway cycle
END_STRUCT
END_TYPE]]></Declaration>
