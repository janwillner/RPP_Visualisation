<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuXtsLoopConfig" Id="{2c040c9d-8608-4a3d-a9ac-0693e5ee6642}">
    <Declaration><![CDATA[TYPE ST_VisuXtsLoopConfig :
STRUCT
	(* Closed XTS loop of track modules standing in the local X-Z plane, e.g. two straights joined at each end by two
	   CURVE_LEFT modules. Local frame: origin at the start of the first module, which runs along local +X in the
	   conveying direction; a left curve turns up towards +Z. *)
	stPose : ST_VisuPose; // MCS
	nModuleCount : UINT; // entries [0..nModuleCount-1] are evaluated
	aModules : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_MODULES - 1] OF ST_VisuTrackModule; // the chain should end where it starts
	fToolOffset : LREAL; // mm, gripper flange (tool point) of a mover outwards from the track
	fMoverLength : LREAL; // mm, along the track
	fMoverWidth : LREAL; // mm
	nZoneCount : UINT;
	aZones : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone; // pick and place zones
	nFingerCount : UINT; // fingers of every mover's gripper, 0 = no gripper definition
	aFingers : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
	(* mm in the local frame from stPose: origin of the loop's coordinate system as shown (origin triad, local
	   measuring coordinates). The geometry and mover positions stay relative to stPose. *)
	stOriginShift : ST_VisuPosition;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>