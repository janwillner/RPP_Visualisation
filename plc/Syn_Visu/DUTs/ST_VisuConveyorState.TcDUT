<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuConveyorState" Id="{8bcd356f-4d63-47a7-a327-a94cf9a0ff2e}">
    <Declaration><![CDATA[TYPE ST_VisuConveyorState :
STRUCT
	nTimestamp : ULINT; // DC time of the writing cycle, ns since 2000-01-01 (set by _FB_VisuConveyor)
	fBeltPosition : LREAL; // continuous belt surface position, mm, no modulo (see _FB_VisuConveyor.m_SetModuloBeltPosition)
	nProductCount : UINT; // entries [0..nProductCount-1] are evaluated
	aProducts : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_PRODUCTS - 1] OF ST_VisuProduct;
	stFault : ST_VisuFault; // fault of the conveyor (set by _FB_VisuConveyor.m_SetFault)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>