<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuCartesianState" Id="{3a3e1534-5861-4f26-8208-f4cbfa684132}">
    <Declaration><![CDATA[TYPE ST_VisuCartesianState :
STRUCT
	nTimestamp : ULINT; // DC time of the writing cycle, ns since 2000-01-01 (set by FB_VisuCartesian)
	fX : LREAL; // mm, actual value: the gripper flange
	fY : LREAL; // mm, actual value
	fZ : LREAL; // mm, actual value
	bGripperActive : BOOL; // used only when no fingers are configured
	aFingerStates : ARRAY[0..GVL_VisuParam.nMaxFingers - 1] OF ST_VisuFingerState; // one per configured finger
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>