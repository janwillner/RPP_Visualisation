<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuZone" Id="{0a88d6bc-bd16-493d-b476-096429b44384}">
    <Declaration><![CDATA[TYPE ST_VisuZone :
STRUCT
	nConveyorId : UDINT; // manifest id of the conveyor
	fStart : LREAL; // mm along the conveyor's local X (belt coordinates, not MCS)
	fEnd : LREAL; // mm along the conveyor's local X
	eKind : E_VisuZoneKind;
	(* mm before fEnd, against the conveying direction: the robot may allocate products in the zone only up to
	   fEnd - fAllocationOffset, so it does not move out of the zone while approaching. 0 = no allocation limit. *)
	fAllocationOffset : LREAL;
	(* mm along the conveyor's local X, like fStart / fEnd: position of the robot's conveyor coordinate system (CCS)
	   on this conveyor. Drawn as a dashed line across the zone. *)
	fCcsOffset : LREAL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>