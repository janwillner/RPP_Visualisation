<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuXtsGantryState" Id="{62cc2a4c-89f4-4659-8699-e54ffb3ac860}">
    <Declaration><![CDATA[TYPE ST_VisuXtsGantryState :
STRUCT
	nTimestamp : ULINT; // DC time of the writing cycle, ns since 2000-01-01 (set by FB_VisuXtsGantry)
	fZ : LREAL; // mm, common Z axis, actual value
	nMoverCount : UINT; // entries [0..nMoverCount-1] are evaluated
	aMovers : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_MOVERS - 1] OF ST_VisuGantryMover;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>