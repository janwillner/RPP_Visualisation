<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuFinger" Id="{105d6c3c-073d-47d8-b0c6-24cc6269dbd4}">
    <Declaration><![CDATA[TYPE ST_VisuFinger :
STRUCT
	(* One gripper finger, always drawn as a cylinder. Its frame's origin is the centre of its top face; it extends
	   along its local -Z. The grip point, where a carried product's top touches, is the centre of its bottom face. *)
	fDiameter : LREAL; // mm
	fHeight : LREAL; // mm
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>