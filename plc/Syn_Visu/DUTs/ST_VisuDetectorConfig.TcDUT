<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuDetectorConfig" Id="{5516b7a9-7aca-46bc-8552-e9b0d3a35e2f}">
    <Declaration><![CDATA[TYPE ST_VisuDetectorConfig :
STRUCT
	(* A detector (vision system, product sensor): its zones on the conveyors and the bodies it is drawn from. *)
	stPose : ST_VisuPose; // MCS; a vision system's lens looking along local -Z, a sensor's head
	nZoneCount : UINT;
	aZones : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone; // where it detects
	nBodyCount : UINT;
	aBodies : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_BODIES - 1] OF ST_VisuBody;
	(* mm in the local frame from stPose: origin of the detector's coordinate system as shown (origin triad, local
	   measuring coordinates). The bodies stay relative to stPose. *)
	stOriginShift : ST_VisuPosition;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>