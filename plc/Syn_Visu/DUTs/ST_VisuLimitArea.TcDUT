<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuLimitArea" Id="{2f71bba7-fc76-4d12-b7cf-6688fc968a22}">
    <Declaration><![CDATA[TYPE ST_VisuLimitArea :
STRUCT
	(* Axis-aligned box in the robot frame (relative to its stPose, turned with it: the frame its working area is
	   given in) that further restricts the working area, e.g. so that neighbouring robots cannot collide. Delta,
	   XTS gantry and Cartesian robot (_FB_VisuRobot.m_SetLimitArea); an XTS loop has none. *)
	fXMin : LREAL; // mm
	fXMax : LREAL; // mm
	fYMin : LREAL; // mm
	fYMax : LREAL; // mm
	fZMin : LREAL; // mm relative to the base (below the base: negative)
	fZMax : LREAL; // mm relative to the base
	bActive : BOOL; // FALSE: no limit area, the box is not drawn
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>