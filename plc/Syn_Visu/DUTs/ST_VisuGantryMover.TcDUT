<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuGantryMover" Id="{ec0d859f-034f-4815-a391-709c45b05754}">
    <Declaration><![CDATA[TYPE ST_VisuGantryMover :
STRUCT
	nId : UDINT; // unique within the gantry, > 0; referenced by a carried product's nMoverId
	bValid : BOOL; // invalid entries are not shown
	fPosition : LREAL; // mm along the track (local +Y), actual value
	fX : LREAL; // mm, X axis on the mover, actual value
	fC : LREAL; // degrees, gripper rotation about local +Z; 0 = along local +X, actual value
	bGripperActive : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>