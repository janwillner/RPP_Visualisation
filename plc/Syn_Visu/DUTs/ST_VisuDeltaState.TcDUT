<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuDeltaState" Id="{b9749b2c-cc76-421c-8b8d-a8b13fe1247b}">
    <Declaration><![CDATA[TYPE ST_VisuDeltaState :
STRUCT
	nTimestamp : ULINT; // DC time of the writing cycle, ns since 2000-01-01 (set by FB_VisuDelta.SetTcp)
	stActualTcp : ST_VisuPosition; // MCS, effector centre (the gripper flange); the visualisation derives the arms from it
	stSetpointTcp : ST_VisuPosition; // MCS
	aFingerStates : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFingerState; // one per configured finger
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>