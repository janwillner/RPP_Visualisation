<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuCartesianConfig" Id="{18b47416-e1a4-4b01-a968-98fa2be97861}">
    <Declaration><![CDATA[TYPE ST_VisuCartesianConfig :
STRUCT
	(* Cartesian robot: two fixed rails along local +Y, a bridge travelling in Y, a carriage on it travelling in X
	   and a vertical column (Z) ending at the gripper flange. Local frame: origin at axis X = Y = 0, Z up; the
	   flange is at (X, Y, Z). Without a Y axis (eAxes XZ) a fixed beam along X at fRailHeight replaces rails and
	   bridge and Y is 0; without a Z axis (XY) the column has a fixed length and the flange stays at fZMin. *)
	stPose : ST_VisuPose; // MCS
	eAxes : E_VisuCartesianAxes := E_VisuCartesianAxes.XYZ; // which axes the robot has (set by m_SetKinematics)
	fXMin : LREAL; // mm, X stroke
	fXMax : LREAL; // mm
	fYMin : LREAL; // mm, Y stroke
	fYMax : LREAL; // mm
	fZMin : LREAL; // mm, Z stroke
	fZMax : LREAL; // mm
	fRailHeight : LREAL; // mm, top of the rails above the local origin; the bridge sits on them
	stLimitArea : ST_VisuLimitArea; // optional box in the robot frame that further restricts the working area
	stTcpLimitArea : ST_VisuLimitArea; // optional box around the gripper flange, along the robot frame's axes
	nZoneCount : UINT;
	aZones : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone; // pick and place zones
	nFingerCount : UINT; // 0 = no gripper definition
	aFingers : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
	(* mm in the local frame from stPose: origin of the robot's coordinate system as shown (origin triad, local
	   measuring coordinates). The geometry and axis values stay relative to stPose. *)
	stOriginShift : ST_VisuPosition;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>