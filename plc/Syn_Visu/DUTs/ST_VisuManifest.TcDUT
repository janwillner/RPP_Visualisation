<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuManifest" Id="{f2970120-750e-4367-80cb-e76dd2e1d114}">
    <Declaration><![CDATA[TYPE ST_VisuManifest :
STRUCT
	(* Discovery entry point. The application declares one instance at the fixed symbol
	   GVL_Visu.stManifest; the gateway starts reading there. *)
	nProtocolVersion : UINT := VISU_GlobalConst.VISU_un_PROTOCOL_VERSION;
	(* Increment after any change to the manifest or to a component's stConfig. *)
	nConfigVersion : UDINT := 1;
	nCount : UINT; // entries [0..nCount-1] are evaluated
	aEntries : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_MANIFEST_ENTRIES - 1] OF ST_VisuManifestEntry;
	(* Version of the Syn_Visu library actually running, e.g. '5.1.0', shown by the visualisation. Since 5.1.0;
	   last, so the members before it keep their place. *)
	sLibraryVersion : STRING(15);
	(* What each product mark means for the whole PLC, e.g. 'Sample'; empty = unnamed. Set with _FC_VisuSetMarkName,
	   which bumps nConfigVersion on a change. Since protocol 21. *)
	aMarkNames : ARRAY[1..VISU_GlobalConst.VISU_un_MAX_MARKS] OF STRING(31);
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>