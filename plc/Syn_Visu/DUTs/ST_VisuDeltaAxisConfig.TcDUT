<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuDeltaAxisConfig" Id="{e103c9a2-73a8-443c-9be5-f156329f1521}">
    <Declaration><![CDATA[TYPE ST_VisuDeltaAxisConfig :
STRUCT
	(* Conventional angle = nDirection * raw position + fAngleOffset.
	   Convention: 0 deg = upper arm horizontal, positive = arm pointing downward. *)
	fAngleOffset : LREAL; // degrees
	nDirection : INT := 1; // +1 or -1
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>