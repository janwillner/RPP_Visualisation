  <DUT Name="E_VisuBodyShape" Id="{cef3152e-33d9-4752-a82d-81dbb85c25fd}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_VisuBodyShape :
(
	(* Values are part of the gateway contract: append, never renumber. *)
	BOX := 0,			// box: fLength x fWidth x fHeight
	CYLINDER := 1,		// cylinder: fLength and fWidth are its two diameters
	FRUSTUM := 2		// rectangular pyramid stump: bottom fLength x fWidth, top fTopLength x fTopWidth
) UINT;
END_TYPE]]></Declaration>
