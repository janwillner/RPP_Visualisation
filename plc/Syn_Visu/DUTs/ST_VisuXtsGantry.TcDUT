  <DUT Name="ST_VisuXtsGantry" Id="{4b6fcae5-7e81-4610-9da1-6ce7c703ab41}">
    <Declaration><![CDATA[TYPE ST_VisuXtsGantry :
STRUCT
	(* One visualised XTS gantry (e.g. IDH). Register the instance's symbol path in the manifest with
	   eType := E_VisuComponentType.XTS_GANTRY. *)
	stConfig : ST_VisuXtsGantryConfig; // read at discovery and after nConfigVersion changes
	stState : ST_VisuXtsGantryState; // read every gateway cycle
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>