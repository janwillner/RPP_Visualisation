<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_VisuDeltaConfig" Id="{8de7830b-8fd5-4591-9561-69e8da135fb8}">
    <Declaration><![CDATA[TYPE ST_VisuDeltaConfig :
STRUCT
	(* Geometry the visualisation uses to derive the arm posture from the TCP.
	   Arm 1 lies along the base's local +X; arms 2 and 3 follow counter-clockwise
	   (seen from above) at 120 deg each. *)
	stPose : ST_VisuPose; // base centre in the MCS
	fBaseRadius : LREAL; // mm, base centre to shoulder joint
	fEffectorRadius : LREAL; // mm, effector centre to lower-arm joint
	fUpperArmLength : LREAL; // mm
	fLowerArmLength : LREAL; // mm
	stWorkingArea : ST_VisuWorkingArea;
	stLimitArea : ST_VisuLimitArea; // optional box that further restricts the working area
	stTcpLimitArea : ST_VisuLimitArea; // optional box around the TCP, relative to it along the robot frame's axes
	nZoneCount : UINT;
	aZones : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_ZONES - 1] OF ST_VisuZone; // pick and place zones
	nFingerCount : UINT; // 0 = no gripper definition
	aFingers : ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFinger;
	(* mm in the local frame from stPose: origin of the robot's coordinate system as shown (origin triad, local
	   measuring coordinates). The geometry, working area and limit area stay relative to stPose. *)
	stOriginShift : ST_VisuPosition;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>