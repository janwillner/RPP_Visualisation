<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="VISU_GlobalConst" Id="{0de4c664-1612-4c48-b551-315b2ffe068d}">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Global constants of the Syn_Visu library.<br>
****************************************************************************************************)
{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	(* Version of the PLC <-> gateway contract. The gateway refuses to read a PLC whose manifest
	   reports a different value. Bump together with PROTOCOL_VERSION in the gateway.
	   2: the Delta reports only its TCP; the visualisation derives the arm posture.
	   3: work area renamed to working area, windows to zones.
	   4: XTS gantry and XTS loop, product nMoverId, fEncoder renamed to fBeltPosition.
	   5: Cartesian robot.
	   6: Delta limit area, zone allocation offset.
	   7: gripper fingers; tool rotations (Delta rz, IDH C, Cartesian C/A and tool length) removed.
	   8: faults of components and XTS movers (stFault).
	   9: zone fCcsOffset, stOriginShift in every config.
	   10: product type eShape and fCornerRadius.
	   11: zones without kind, product nDetectorId, vision system and product sensor (ST_VisuDetector).
	   12: XTS tracks as chains of track modules (straight, quarter curves) with a fault per module.
	   13: product nLastClientId and ePreviousState instead of nRobotId and nDetectorId; station (ST_VisuStation).
	   14: product stLatchPose in the conveyor's coordinate system instead of the MCS. *)
	VISU_un_PROTOCOL_VERSION			: UINT := 14;
	(* Version of this library as the visualisation shows it (manifest sLibraryVersion). Bump together with
	   _FC_GetVersionSynVisu and the project version. *)
	VISU_str_LIBRARY_VERSION			: STRING(15) := '7.1.0';
	VISU_lr_DEG_TO_RAD					: LREAL := 0.017453292519943295;	// [rad/deg] pi / 180
	VISU_lr_XTS_MODULE_LENGTH			: LREAL := 250;	// [mm] length of an XTS motor module along the track, straight or curve
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>