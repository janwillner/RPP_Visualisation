<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_FC_DemoBeltToMcs" Id="{7c8c1346-83e4-4147-baf6-ee983244aeca}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
DEMO ONLY: a product pose in a conveyor's coordinate system (as Syn_Visu reports and takes it) in the MCS.<br>
Every demo conveyor runs along MCS +X without rotation, so its coordinate system is the MCS moved to its pose<br>
plus its origin shift.<br>
****************************************************************************************************)
FUNCTION _FC_DemoBeltToMcs : ST_VisuPlanarPose
VAR_IN_OUT CONSTANT
	vio_Config							: ST_VisuConveyorConfig;	// the conveyor's vo_Visu.stConfig
END_VAR
VAR_INPUT
	vi_Pose								: ST_VisuPlanarPose;	// conveyor coordinate system
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_FC_DemoBeltToMcs := vi_Pose;
_FC_DemoBeltToMcs.fX := vio_Config.stPose.fX + vio_Config.stOriginShift.fX + vi_Pose.fX;
_FC_DemoBeltToMcs.fY := vio_Config.stPose.fY + vio_Config.stOriginShift.fY + vi_Pose.fY;
_FC_DemoBeltToMcs.fZ := vio_Config.stPose.fZ + vio_Config.stOriginShift.fZ + vi_Pose.fZ;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>