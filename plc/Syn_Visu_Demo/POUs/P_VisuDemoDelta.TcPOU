<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="P_VisuDemoDelta" Id="{21cf1241-3c2c-40ce-b945-4e94f30ecf5b}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
DEMO ONLY: Delta application (Y = 0..1000). Two infeed conveyors (Y = 0 and Y = 1000) and an outfeed between<br>
them (Y = 500), three Delta robots one after another (X = 1500, 2500, 3500) picking from the infeeds and placing<br>
onto the outfeed. Some products are deliberately missed. Each Delta has a different gripper:<br>
- Delta 1: two suction cups beside the flange that turn about Rz; it picks two products and places both at once.<br>
- Delta 2: one finger that turns about Rz and tilts about Rx while carrying.<br>
- Delta 3: five fingers around the flange that close when picking and open when placing.<br>
Products come in five types of different size and shape (boxes, a can, an oval, a pouch), mixed on both infeeds;<br>
Delta 1 picks a pair of one type, Delta 3 closes its fingers around the product's outline. A product put down<br>
on the outfeed leaves the infeed's register.<br>
A vision system over infeed 1 detects its products in the middle of its field of view and marks every tenth as a<br>
sample (product mark 1, 'Sample'), which stays marked on the outfeed; a light barrier on<br>
infeed 2 detects them at their front edge, its beam lighting up while a product interrupts it.<br>
A reject unit (station) at the outfeed rejects every fifth product passing it: its pusher lights up and the<br>
product is off the belt shortly after.<br>
Delta 1 is in a fault now and then. Called by P_VisuDemo.<br>
****************************************************************************************************)
PROGRAM P_VisuDemoDelta
VAR
	fb_Infeed1							: _FB_VisuConveyor;
	fb_Infeed2							: _FB_VisuConveyor;
	fb_Outfeed							: _FB_VisuConveyor;
	fb_Delta1							: _FB_VisuDelta;
	fb_Delta2							: _FB_VisuDelta;
	fb_Delta3							: _FB_VisuDelta;
	fb_Vision1							: _FB_VisuVision;	// over infeed 1
	fb_Barrier2							: _FB_VisuSensor;	// light barrier on infeed 2
	fb_RejectUnit						: _FB_VisuStation;	// at the outfeed

	(* Syn_Config (ADR 0017): Infeed 1, Delta 1 and Vision 1 run with the parameter sets the configurator writes,
	   else with their program values. The demo allows taking a set over at once; a machine would wait until it
	   stands. *)
	fb_Infeed1Param						: SynConfig._FB_ConfigConveyor;
	fb_Delta1Param						: SynConfig._FB_ConfigDelta;
	fb_Vision1Param						: SynConfig._FB_ConfigVision;
	Infeed1Default						: SynConfig.ST_ConfigConveyorParam;	// program values of Infeed 1
	Vision1Default						: SynConfig.ST_ConfigBodyComponentParam;	// program values of Vision 1
	RobotDefault						: SynConfig.ST_ConfigDeltaParam;	// program values of the Delta being configured
	Zone								: ST_VisuZone;	// Delta 1's pick zone on infeed 1, from its parameter set
	lr_AllocStart						: LREAL;	// [mm] MCS X where the current robot's allocation area on the current infeed starts
	lr_AllocEnd							: LREAL;	// [mm] MCS X where it ends
	n_Zone								: INT;

	(* Reject unit *)
	un_RejectPassed						: UINT;	// [-] products that passed the reject unit
	udn_RejectPushing					: UDINT;	// [-] product being pushed off, 0 = none
	lr_RejectLeft						: LREAL;	// [s] until the product being pushed is off the belt

	(* Conveyors *)
	lr_Dt								: LREAL;	// [s] cycle time
	udn_Seed							: UDINT := 12345;	// [-] pseudo random generator state
	lr_BeltPosition						: ARRAY[0..2] OF LREAL;	// [mm] infeed 1, infeed 2, outfeed
	lr_SinceSpawn						: ARRAY[0..1] OF LREAL := [0, 0.3];	// [s] since the last product per infeed
	un_Vision1Latches					: UINT;	// [-] products Vision 1 latched: every un_SAMPLE_EVERY-th is a sample
	fb_RefBelt							: REFERENCE TO _FB_VisuConveyor;
	BeltPose							: ST_VisuPose;
	LatchPose							: ST_VisuPlanarPose;
	n_Belt								: INT;
	lr_Random							: LREAL;	// [-] 0..1
	udn_Type							: UDINT;	// [-] product type, 1..udn_TYPE_COUNT
	DetectorPose						: ST_VisuPose;	// lens of the vision system, head of the light barrier
	b_BeamInterrupted					: BOOL;	// a product on infeed 2 covers the light barrier's beam

	(* Per Delta robot *)
	n_Phase								: ARRAY[0..2] OF INT;
	udn_TargetId						: ARRAY[0..2] OF UDINT;	// [-] product being approached, 0 = none
	n_TargetBelt						: ARRAY[0..2] OF INT;	// [-] 0 = infeed 1, 1 = infeed 2
	Tcp									: ARRAY[0..2] OF ST_VisuPosition;	// the gripper flange
	b_TcpInitialised					: ARRAY[0..2] OF BOOL;
	lr_ToolRz							: ARRAY[0..2] OF LREAL;	// [deg] tool rotation about MCS Z (4th axis)
	udn_Held							: ARRAY[0..2, 0..1] OF UDINT;	// [-] carried product ids per slot (Delta 1 carries two)
	n_HeldBelt							: ARRAY[0..2, 0..1] OF INT;	// [-] infeed of each carried product: 0 = infeed 1, 1 = infeed 2
	udn_HeldType						: ARRAY[0..2, 0..1] OF UDINT;	// [-] product type of each carried product
	un_HeldMark							: ARRAY[0..2, 0..1] OF UINT;	// [-] product mark of each carried product, 0 = none
	lr_HeldHeight						: LREAL;	// [mm] height of the product carried or approached
	n_HeldCount							: ARRAY[0..2] OF INT;
	lr_TiltRx							: LREAL;	// [deg] Delta 2: finger tilt about its X
	lr_Spread							: LREAL := 130;	// [mm] Delta 3: finger distance from the flange
	lr_SpreadClosed						: LREAL := 82;	// [mm] Delta 3: finger distance closed around the current product
	n_Finger							: INT;	// [-] finger used for the current pick, 0 = the flange
	n_FingerCount						: INT;
	n_Slot								: INT;
	lr_GripHeight						: LREAL;	// [mm] flange above the grip point of the finger used
	Grip								: ST_VisuPosition;	// MCS offset flange -> grip point of the finger used
	fb_RefRobot							: REFERENCE TO _FB_VisuDelta;
	BasePose							: ST_VisuPose;
	Product								: ST_VisuProduct;
	ProductPose							: ST_VisuPlanarPose;
	SetpointTcp							: ST_VisuPosition;
	b_Found								: BOOL;
	n_Robot								: INT;
	un_Index							: UINT;
	lr_BaseX							: LREAL;	// [mm]
	lr_Step								: LREAL;	// [mm] TCP travel per cycle
	lr_X								: LREAL;	// [mm] target
	lr_Y								: LREAL;	// [mm] target
	lr_TopZ								: LREAL;	// [mm] top of the target product
	lr_TargetRz							: LREAL;	// [deg]
	un_Placed							: ARRAY[0..2] OF UINT;	// [-] times each robot has put its products down
	lr_PlaceWait						: ARRAY[0..2] OF LREAL;	// [s] waited above the place position
	b_FarPlace							: BOOL;	// the current robot places far downstream this time

	(* Sequence control (P_VisuDemoMachine, recipe): Infeed 1 at its ramped speed, Delta 1 as fast as its belt and its
	   recipe allow, the product generator before Vision 1. *)
	lr_Delta1Speed						: LREAL;	// [mm/s] Delta 1's TCP speed now, ramped
	udn_GenRandom						: UDINT;	// [-] the generator's pseudo-random numbers, started from the recipe's seed
	dn_GenSeed							: DINT;	// [-] the seed they started from; another seed or a reset starts them again
	lr_GenTravel						: LREAL;	// [mm] Infeed 1's travel since the generator's last place
	lr_MissedLeft						: LREAL;	// [s] the missed-product message stays this long
END_VAR
VAR PERSISTENT
	Infeed1Set							: SynConfig.ST_ConfigConveyorSet;	// active parameter set of Infeed 1, kept over a restart
	Delta1Set							: SynConfig.ST_ConfigDeltaSet;	// active parameter set of Delta 1
	Vision1Set							: SynConfig.ST_ConfigBodyComponentSet;	// active parameter set of Vision 1
END_VAR
VAR CONSTANT
	lr_BELT_LENGTH						: LREAL := 5000;	// [mm]
	lr_INFEED_SPEED						: LREAL := 150;	// [mm/s]
	lr_OUTFEED_SPEED					: LREAL := 300;	// [mm/s] two infeeds' products, 150 mm apart
	lr_SPAWN_INTERVAL					: LREAL := 1.0;	// [s] per infeed: 150 mm apart, the longest product type
	(* Product types, the same on every belt; type 1 is the standard product of the other demo applications. *)
	(* 1, 2: boxes; 3: a round can; 4: an oval; 5: a pouch with rounded edges. *)
	udn_TYPE_COUNT						: UDINT := 5;
	e_TYPE_SHAPE						: ARRAY[1..5] OF E_VisuProductShape := [E_VisuProductShape.BOX, E_VisuProductShape.BOX,
											E_VisuProductShape.CYLINDER, E_VisuProductShape.CYLINDER,
											E_VisuProductShape.ROUNDED_BOX];
	lr_TYPE_LENGTH						: ARRAY[1..5] OF LREAL := [120, 150, 90, 110, 140];	// [mm] along the conveying direction (a cylinder: diameter)
	lr_TYPE_WIDTH						: ARRAY[1..5] OF LREAL := [80, 100, 90, 70, 90];	// [mm] across (a cylinder: diameter)
	lr_TYPE_HEIGHT						: ARRAY[1..5] OF LREAL := [40, 45, 60, 45, 40];	// [mm] at least lr_RING_HEIGHT
	lr_TYPE_CORNER_RADIUS				: ARRAY[1..5] OF LREAL := [0, 0, 0, 0, 20];	// [mm] rounded edges of a rounded box
	lr_INFEED1_Y						: LREAL := 0;	// [mm]
	lr_INFEED2_Y						: LREAL := 1000;	// [mm]
	lr_OUTFEED_Y						: LREAL := 500;	// [mm]
	(* Each belt's coordinate system: infeed 1 at its start, infeed 2 at its end, the outfeed under Delta 1.
	   Zones on a belt are given from its origin. *)
	lr_INFEED2_ORIGIN_X					: LREAL := 5000;	// [mm] from the belt start
	lr_OUTFEED_ORIGIN_X					: LREAL := 1500;	// [mm] from the belt start
	(* Detectors *)
	lr_VISION_X							: LREAL := 300;	// [mm] lens over infeed 1, middle of the field of view
	lr_VISION_FIELD						: LREAL := 400;	// [mm] field of view on the belt, along and across
	lr_VISION_DISTANCE					: LREAL := 800;	// [mm] lens above the belt
	lr_BARRIER_X						: LREAL := 300;	// [mm] beam across infeed 2
	lr_BARRIER_HEIGHT					: LREAL := 20;	// [mm] beam above the belt
	lr_BARRIER_BEAM						: LREAL := 500;	// [mm] from the head at the belt edge across the belt
	un_SAMPLE_EVERY						: UINT := 10;	// [-] Vision 1 marks every n-th product as a sample
	un_SAMPLE_MARK						: UINT := 1;	// [-] product mark of a sample, named 'Sample'
	(* Reject unit, behind the last robot *)
	lr_REJECT_X							: LREAL := 4500;	// [mm] MCS X of its pusher
	un_REJECT_EVERY						: UINT := 5;	// [-] every n-th product is rejected
	lr_REJECT_PUSH_TIME					: LREAL := 0.3;	// [s] the pusher pushes a product off the belt
	lr_ROBOT1_X							: LREAL := 1500;	// [mm]
	lr_ROBOT_PITCH						: LREAL := 1000;	// [mm] distance between robots along X
	lr_ROBOT_Y							: LREAL := 500;	// [mm]
	lr_ROBOT_Z							: LREAL := 1900;	// [mm]
	lr_TCP_SPEED						: LREAL := 2500;	// [mm/s]
	lr_HOVER							: LREAL := 120;	// [mm]
	lr_PICK_HALF_ZONE					: LREAL := 400;	// [mm]
	lr_PICK_HALF_LANE					: LREAL := 130;	// [mm] pick zones only cover the lane the products come in on
	lr_PLACE_HALF_ZONE					: LREAL := 300;	// [mm]
	lr_ALLOCATION_OFFSET				: LREAL := 300;	// [mm] products are allocated only up to this distance before the pick zone end
	lr_LEAD								: LREAL := 7.5;	// [mm] the robot leads the moving product
	(* Demo limit violation: Delta 2 puts every sixth time down far downstream and waits there for a gap on the
	   outfeed. Its TCP limit area then reaches into Delta 3's limit area and out of its own. *)
	un_FAR_PLACE_EVERY					: UINT := 6;	// [-]
	lr_FAR_PLACE_OFFSET					: LREAL := 480;	// [mm] downstream of its base
	lr_FAR_PLACE_WAIT					: LREAL := 0.8;	// [s]
	lr_FAULT_START						: LREAL := 4;	// [s] start of the Delta 1 fault in the fault period
	(* Grippers *)
	lr_PAIR_OFFSET						: LREAL := 70;	// [mm] Delta 1: cups on either side of the flange along the tool's X
	lr_TILT_DIAMETER					: LREAL := 30;	// [mm] Delta 2
	lr_TILT_HEIGHT						: LREAL := 90;	// [mm]
	lr_TILT_ANGLE						: LREAL := 25;	// [deg] about Rx while carrying
	lr_TILT_SPEED						: LREAL := 60;	// [deg/s]
	n_RING_FINGERS						: INT := 5;	// [-] Delta 3
	lr_RING_DIAMETER					: LREAL := 16;	// [mm]
	lr_RING_HEIGHT						: LREAL := 40;	// [mm] reaching down to the belt beside a carried product
	lr_SPREAD_OPEN						: LREAL := 130;	// [mm]
	lr_RING_CLEARANCE					: LREAL := 10;	// [mm] closed fingers: finger radius plus a gap beyond the product's corners
	lr_SPREAD_SPEED						: LREAL := 200;	// [mm/s]
	(* Sequence *)
	n_PHASE_IDLE						: INT := 0;
	n_PHASE_APPROACH					: INT := 1;
	n_PHASE_DESCEND						: INT := 2;
	n_PHASE_LIFT						: INT := 3;
	n_PHASE_TRANSFER					: INT := 4;
	n_PHASE_LOWER						: INT := 5;
	n_PHASE_RELEASE						: INT := 6;
	(* Sequence control *)
	lr_TCP_ACCEL						: LREAL := 20000;	// [mm/s2] Delta 1's TCP acceleration at 100 %
	lr_MISSED_HOLD						: LREAL := 3;	// [s] the missed-product message stays after the last missed product
	udn_RANDOM_A						: UDINT := 1664525;	// [-] the generator's linear congruential pseudo-random numbers
	udn_RANDOM_C						: UDINT := 1013904223;	// [-]
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[lr_Dt := DEMO_GlobalVar.DEMO_lr_Dt;
lr_Step := lr_TCP_SPEED * lr_Dt;


(****************************************************************************************************)
(* REGISTRATION (idempotent, every cycle)                                                           *)
(****************************************************************************************************)
fb_Infeed1.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 1, vi_str_Name := 'Infeed 1');
fb_Infeed2.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 2, vi_str_Name := 'Infeed 2');
fb_Outfeed.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 3, vi_str_Name := 'Outfeed');
fb_Delta1.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 10, vi_str_Name := 'Delta 1');
fb_Delta2.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 11, vi_str_Name := 'Delta 2');
fb_Delta3.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 12, vi_str_Name := 'Delta 3');
fb_Vision1.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 50, vi_str_Name := 'Vision 1');
fb_Barrier2.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 51, vi_str_Name := 'Light barrier 2');
fb_RejectUnit.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 60, vi_str_Name := 'Reject unit');
(* What the product mark of a sample means, for the whole PLC. *)
_FC_VisuSetMarkName(vio_Manifest := GVL_Visu.stManifest, vi_un_Mark := un_SAMPLE_MARK, vi_str_Name := 'Sample');


(****************************************************************************************************)
(* CONVEYORS (configuration idempotent, every cycle)                                                *)
(****************************************************************************************************)
(* Infeed 1's program values; its parameter set (Syn_Config) replaces them once the configurator wrote one. *)
Infeed1Default.stPose.fX := 0;
Infeed1Default.stPose.fY := lr_INFEED1_Y;
Infeed1Default.stPose.fZ := DEMO_GlobalConst.DEMO_lr_BELT_Z;
Infeed1Default.nProductTypeCount := UDINT_TO_UINT(udn_TYPE_COUNT);
FOR udn_Type := 1 TO udn_TYPE_COUNT DO
	Infeed1Default.aProductTypes[udn_Type - 1].nId := udn_Type;
	Infeed1Default.aProductTypes[udn_Type - 1].fLength := lr_TYPE_LENGTH[udn_Type];
	Infeed1Default.aProductTypes[udn_Type - 1].fWidth := lr_TYPE_WIDTH[udn_Type];
	Infeed1Default.aProductTypes[udn_Type - 1].fHeight := lr_TYPE_HEIGHT[udn_Type];
	Infeed1Default.aProductTypes[udn_Type - 1].eShape := e_TYPE_SHAPE[udn_Type];
	Infeed1Default.aProductTypes[udn_Type - 1].fCornerRadius := lr_TYPE_CORNER_RADIUS[udn_Type];
END_FOR
fb_Infeed1Param.m_Register(vio_Manifest := GVL_Config.stManifest, vi_udn_Id := fb_Infeed1.m_Id());
fb_Infeed1Param.m_Cycle(vio_Default := Infeed1Default, vio_Set := Infeed1Set, vi_b_ApplyAllowed := TRUE);

FOR n_Belt := 0 TO 2 DO
	CASE n_Belt OF
		0: fb_RefBelt REF= fb_Infeed1; BeltPose := fb_Infeed1Param.m_Pose();
		1: fb_RefBelt REF= fb_Infeed2; BeltPose := Infeed1Default.stPose; BeltPose.fY := lr_INFEED2_Y;
	ELSE
		fb_RefBelt REF= fb_Outfeed; BeltPose := Infeed1Default.stPose; BeltPose.fY := lr_OUTFEED_Y;
	END_CASE
	fb_RefBelt.m_Configure(vi_Pose := BeltPose, vi_lr_Length := lr_BELT_LENGTH,
		vi_lr_Width := DEMO_GlobalConst.DEMO_lr_BELT_WIDTH);
	(* Infeed 1's product types come with its parameter set (m_PassOn below). *)
	IF n_Belt <> 0 THEN
		FOR udn_Type := 1 TO udn_TYPE_COUNT DO
			fb_RefBelt.m_SetProductType(vi_udn_Id := udn_Type, vi_lr_Length := lr_TYPE_LENGTH[udn_Type],
				vi_lr_Width := lr_TYPE_WIDTH[udn_Type], vi_lr_Height := lr_TYPE_HEIGHT[udn_Type],
				vi_e_Shape := e_TYPE_SHAPE[udn_Type], vi_lr_CornerRadius := lr_TYPE_CORNER_RADIUS[udn_Type]);
		END_FOR
	END_IF
END_FOR
fb_Infeed1Param.m_PassOn(vio_Visu := fb_Infeed1);
fb_Infeed2.m_SetOriginShift(vi_lr_X := lr_INFEED2_ORIGIN_X, vi_lr_Y := 0, vi_lr_Z := 0);
fb_Outfeed.m_SetOriginShift(vi_lr_X := lr_OUTFEED_ORIGIN_X, vi_lr_Y := 0, vi_lr_Z := 0);

(* Belt travel *)
lr_BeltPosition[0] := lr_BeltPosition[0] + DEMO_GlobalVar.DEMO_lr_Infeed1Speed * lr_Dt;	// ramped by the sequence control
lr_BeltPosition[1] := lr_BeltPosition[1] + lr_INFEED_SPEED * lr_Dt;
lr_BeltPosition[2] := lr_BeltPosition[2] + lr_OUTFEED_SPEED * lr_Dt;
fb_Infeed1.m_SetBeltPosition(lr_BeltPosition[0]);
fb_Infeed2.m_SetBeltPosition(lr_BeltPosition[1]);
fb_Outfeed.m_SetBeltPosition(lr_BeltPosition[2]);


(****************************************************************************************************)
(* DETECTORS (configuration idempotent, every cycle)                                                *)
(****************************************************************************************************)
(* Vision 1's program values; its parameter set (Syn_Config) replaces them once the configurator wrote one. The
   field of view is hardware and stays the program's. *)
Vision1Default.stPose.fX := lr_VISION_X;
Vision1Default.stPose.fY := lr_INFEED1_Y;
Vision1Default.stPose.fZ := DEMO_GlobalConst.DEMO_lr_BELT_Z + lr_VISION_DISTANCE;
Vision1Default.nZoneCount := 1;
Vision1Default.aZones[0].nConveyorId := fb_Infeed1.m_Id();
Vision1Default.aZones[0].fStart := lr_VISION_X - lr_VISION_FIELD / 2;
Vision1Default.aZones[0].fEnd := lr_VISION_X + lr_VISION_FIELD / 2;
Vision1Default.aZones[0].fCcsOffset := lr_VISION_X;
fb_Vision1Param.m_Register(vio_Manifest := GVL_Config.stManifest, vi_udn_Id := fb_Vision1.m_Id());
fb_Vision1Param.m_Cycle(vio_Default := Vision1Default, vio_Set := Vision1Set, vi_b_ApplyAllowed := TRUE);
fb_Vision1.m_Configure(vi_Pose := fb_Vision1Param.m_Pose(), vi_lr_FieldLength := lr_VISION_FIELD,
	vi_lr_FieldWidth := lr_VISION_FIELD, vi_lr_WorkingDistance := lr_VISION_DISTANCE);
fb_Vision1Param.m_PassOn(vio_Visu := fb_Vision1);
(* The head at the right belt edge, its beam across the belt towards +Y. Infeed 2 counts from its end. *)
DetectorPose.fX := lr_BARRIER_X;
DetectorPose.fY := lr_INFEED2_Y - lr_BARRIER_BEAM / 2;
DetectorPose.fZ := DEMO_GlobalConst.DEMO_lr_BELT_Z + lr_BARRIER_HEIGHT;
fb_Barrier2.m_Configure(vi_Pose := DetectorPose, vi_lr_BeamLength := lr_BARRIER_BEAM);
fb_Barrier2.m_SetZone(vi_un_Zone := 1, vi_udn_ConveyorId := fb_Infeed2.m_Id(), vi_lr_Start := lr_BARRIER_X - lr_INFEED2_ORIGIN_X,
	vi_lr_End := lr_BARRIER_X - lr_INFEED2_ORIGIN_X, vi_lr_AllocationOffset := 0,
	vi_lr_CcsOffset := lr_BARRIER_X - lr_INFEED2_ORIGIN_X, vi_lr_StartY := 0, vi_lr_EndY := 0);


(****************************************************************************************************)
(* PRODUCT INFEED: Infeed 1 from the product generator, Infeed 2 every lr_SPAWN_INTERVAL             *)
(****************************************************************************************************)
(* Reset accepted by the sequence control: Infeed 1 and Delta 1 start empty, the generator from its seed. *)
IF DEMO_GlobalVar.DEMO_b_Reset THEN
	m_Reset();
END_IF
m_Generate();
(* Infeed 2: products slightly offset across the belt and turned, latched where the light barrier sees their front
   edge. *)
lr_SinceSpawn[1] := lr_SinceSpawn[1] + lr_Dt;
IF lr_SinceSpawn[1] >= lr_SPAWN_INTERVAL THEN
	lr_SinceSpawn[1] := 0;
	udn_Seed := udn_Seed * 1103515245 + 12345;
	lr_Random := UDINT_TO_LREAL(udn_Seed MOD 1000) / 1000.0;
	LatchPose.fY := lr_INFEED2_Y + (lr_Random - 0.5) * 160.0;
	LatchPose.fZ := DEMO_GlobalConst.DEMO_lr_BELT_Z;
	LatchPose.fRz := (UDINT_TO_LREAL((udn_Seed / 1000) MOD 1000) / 1000.0 - 0.5) * 60.0;
	udn_Type := (udn_Seed / 1000000) MOD udn_TYPE_COUNT + 1;
	LatchPose.fX := lr_BARRIER_X - lr_TYPE_LENGTH[udn_Type] / 2;
	IF fb_Infeed2.m_LatchProduct(vi_udn_Id := DEMO_GlobalVar.DEMO_udn_NextId,
		vi_LatchPose := _FC_DemoMcsToBelt(vio_Config := fb_Infeed2.vo_Visu.stConfig, vi_Pose := LatchPose),
		vi_udn_ProductType := udn_Type, vi_lr_LatchBeltPosition := 0, vi_b_UseLatchBeltPosition := FALSE,
		vi_e_State := E_VisuProductState.DETECTED, vi_udn_ClientId := fb_Barrier2.m_Id())
	THEN
		DEMO_GlobalVar.DEMO_udn_NextId := DEMO_GlobalVar.DEMO_udn_NextId + 1;
	END_IF
END_IF


(****************************************************************************************************)
(* ROBOTS: per robot configure it, follow its target, run its sequence and report it                *)
(****************************************************************************************************)
FOR n_Robot := 0 TO 2 DO
	(* Delta 1 runs with the recipe and as fast as its belt, so it halts with it; the others at full speed. *)
	IF n_Robot = 0 THEN
		lr_Step := m_Delta1Step();
	ELSE
		lr_Step := lr_TCP_SPEED * lr_Dt;
	END_IF
	m_Configure();
	m_Target();
	m_Sequence();
	m_Report();
END_FOR


(* The light barrier's beam is interrupted while a product not yet picked covers it. *)
b_BeamInterrupted := FALSE;
un_Index := 0;
WHILE un_Index < fb_Infeed2.m_ProductCount() DO
	fb_Infeed2.m_GetProduct(vi_un_Index := un_Index, vo_Product => Product, vo_Pose => ProductPose);
	ProductPose := _FC_DemoBeltToMcs(vio_Config := fb_Infeed2.vo_Visu.stConfig, vi_Pose := ProductPose);
	IF Product.eState <> E_VisuProductState.PICKED AND Product.nProductType >= 1 AND Product.nProductType <= udn_TYPE_COUNT
		AND_THEN ABS(ProductPose.fX - lr_BARRIER_X) <= lr_TYPE_LENGTH[Product.nProductType] / 2
	THEN
		b_BeamInterrupted := TRUE;
	END_IF
	un_Index := un_Index + 1;
END_WHILE
fb_Barrier2.m_SetSignal(vi_b_Signal := b_BeamInterrupted);
m_RejectUnit();


(****************************************************************************************************)
(* HOUSEKEEPING                                                                                     *)
(****************************************************************************************************)
m_Missed();
(* Drop register entries some distance beyond the belt end, so "missed" stays visible briefly. *)
fb_Infeed1.m_RemoveProductsBeyond(lr_BELT_LENGTH + DEMO_GlobalConst.DEMO_lr_REMOVE_BEYOND_END);
fb_Infeed2.m_RemoveProductsBeyond(lr_BELT_LENGTH + DEMO_GlobalConst.DEMO_lr_REMOVE_BEYOND_END);
fb_Outfeed.m_RemoveProductsBeyond(lr_BELT_LENGTH + DEMO_GlobalConst.DEMO_lr_REMOVE_BEYOND_END);]]></ST>
    </Implementation>
    <Method Name="m_Allocate" Id="{3a082196-fd0d-4197-9d73-9cbe82dfe88d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Looks for a detected product in the allocation area of Delta n_Robot and assigns it. Delta 1 serves infeed 1,<br>
Delta 2 infeed 2, Delta 3 takes what both leave. TRUE if a product was assigned.<br>
****************************************************************************************************)
METHOD PRIVATE m_Allocate : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR n_Belt := 0 TO 1 DO
	IF n_Belt = 0 THEN
		fb_RefBelt REF= fb_Infeed1;
	ELSE
		fb_RefBelt REF= fb_Infeed2;
	END_IF
	(* Where the robot allocates on this infeed: around its base, Delta 1 on infeed 1 in the pick zone of its parameter
	   set (belt coordinates to MCS X: infeed 1 runs along +X). *)
	lr_AllocStart := lr_BaseX - lr_PICK_HALF_ZONE;
	lr_AllocEnd := lr_BaseX + lr_PICK_HALF_ZONE - lr_ALLOCATION_OFFSET;
	IF n_Robot = 0 AND n_Belt = 0 AND fb_Delta1Param.m_ZoneCount() >= 1 THEN
		Zone := fb_Delta1Param.m_Zone(vi_un_Zone := 1);
		lr_AllocStart := fb_Infeed1.vo_Visu.stConfig.stPose.fX + fb_Infeed1.vo_Visu.stConfig.stOriginShift.fX
						+ MIN(Zone.fStart, Zone.fEnd);
		lr_AllocEnd := fb_Infeed1.vo_Visu.stConfig.stPose.fX + fb_Infeed1.vo_Visu.stConfig.stOriginShift.fX
						+ MAX(Zone.fStart, Zone.fEnd) - Zone.fAllocationOffset;
	END_IF
	un_Index := 0;
	IF (n_Robot = 0 AND n_Belt = 1) OR (n_Robot = 1 AND n_Belt = 0) THEN
		un_Index := fb_RefBelt.m_ProductCount();
	END_IF
	WHILE udn_TargetId[n_Robot] = 0 AND un_Index < fb_RefBelt.m_ProductCount() DO
		fb_RefBelt.m_GetProduct(vi_un_Index := un_Index, vo_Product => Product, vo_Pose => ProductPose);
		ProductPose := _FC_DemoBeltToMcs(vio_Config := fb_RefBelt.vo_Visu.stConfig, vi_Pose := ProductPose);
		(* Delta 1 adds only a product of the type it already carries: both cups hang at the same height. *)
		IF Product.eState = E_VisuProductState.DETECTED
		AND (n_Robot <> 0 OR n_HeldCount[n_Robot] = 0 OR Product.nProductType = udn_HeldType[n_Robot, 0])
		AND ProductPose.fX >= lr_AllocStart
		AND ProductPose.fX <= lr_AllocEnd
		THEN
			fb_RefBelt.m_SetProductState(vi_udn_Id := Product.nId, vi_e_State := E_VisuProductState.ASSIGNED,
				vi_udn_ClientId := fb_RefRobot.m_Id(), vi_udn_MoverId := 0, vi_udn_FingerId := 0);
			udn_TargetId[n_Robot] := Product.nId;
			n_TargetBelt[n_Robot] := n_Belt;
			n_Phase[n_Robot] := n_PHASE_APPROACH;
		END_IF
		un_Index := un_Index + 1;
	END_WHILE
END_FOR
m_Allocate := udn_TargetId[n_Robot] <> 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Configure" Id="{0f461dbf-8805-4bc7-9c3d-d3aed319e063}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Selects Delta n_Robot into fb_RefRobot and configures it (idempotent): base, gripper with the fingers' places<br>
on the flange, working area, limit area, TCP limit area and zones. Initialises its TCP once.<br>
****************************************************************************************************)
METHOD PRIVATE m_Configure : BOOL
VAR
	lr_TempAngle						: LREAL;	// [deg] a ring finger's place around the flange
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE n_Robot OF
	0: fb_RefRobot REF= fb_Delta1;
	1: fb_RefRobot REF= fb_Delta2;
ELSE
	fb_RefRobot REF= fb_Delta3;
END_CASE
lr_BaseX := lr_ROBOT1_X + INT_TO_LREAL(n_Robot) * lr_ROBOT_PITCH;


(****************************************************************************************************
PROGRAM VALUES: base, areas and zones
****************************************************************************************************)
RobotDefault.stPose.fX := lr_BaseX;
RobotDefault.stPose.fY := lr_ROBOT_Y;
RobotDefault.stPose.fZ := lr_ROBOT_Z;
(* The robot's coordinate system sits in its working plane, 900 mm below the base. *)
RobotDefault.stOriginShift.fX := 0;
RobotDefault.stOriginShift.fY := 0;
RobotDefault.stOriginShift.fZ := -900;
RobotDefault.stWorkingArea.fRadius := 750;
RobotDefault.stWorkingArea.fZMin := -1300;
RobotDefault.stWorkingArea.fZMax := -700;
RobotDefault.stWorkingArea.fConeHeight := 200;
RobotDefault.stWorkingArea.fConeBottomRadius := 450;
(* Neighbouring robots share the space between them: each one is limited to half the robot pitch. *)
RobotDefault.stLimitArea.fXMin := -lr_ROBOT_PITCH / 2;
RobotDefault.stLimitArea.fXMax := lr_ROBOT_PITCH / 2;
RobotDefault.stLimitArea.fYMin := -750;
RobotDefault.stLimitArea.fYMax := 750;
RobotDefault.stLimitArea.fZMin := -1500;
RobotDefault.stLimitArea.fZMax := -700;
RobotDefault.stLimitArea.bActive := TRUE;
(* Around the TCP: gripper and product below the flange. It lights up when it reaches into a neighbour's limit
   area or out of the robot's own. *)
RobotDefault.stTcpLimitArea.fXMin := -80;
RobotDefault.stTcpLimitArea.fXMax := 80;
RobotDefault.stTcpLimitArea.fYMin := -80;
RobotDefault.stTcpLimitArea.fYMax := 80;
RobotDefault.stTcpLimitArea.fZMin := -100;
RobotDefault.stTcpLimitArea.fZMax := 20;
RobotDefault.stTcpLimitArea.bActive := TRUE;
(* The robot's conveyor coordinate system lies under its base on every belt. *)
RobotDefault.nZoneCount := 3;
RobotDefault.aZones[0].nConveyorId := fb_Infeed1.m_Id();
RobotDefault.aZones[0].fStart := lr_BaseX - lr_PICK_HALF_ZONE;
RobotDefault.aZones[0].fEnd := lr_BaseX + lr_PICK_HALF_ZONE;
RobotDefault.aZones[0].fAllocationOffset := lr_ALLOCATION_OFFSET;
RobotDefault.aZones[0].fCcsOffset := lr_BaseX;
RobotDefault.aZones[0].fStartY := -lr_PICK_HALF_LANE;
RobotDefault.aZones[0].fEndY := lr_PICK_HALF_LANE;
RobotDefault.aZones[1].nConveyorId := fb_Infeed2.m_Id();
RobotDefault.aZones[1].fStart := lr_BaseX - lr_PICK_HALF_ZONE - lr_INFEED2_ORIGIN_X;
RobotDefault.aZones[1].fEnd := lr_BaseX + lr_PICK_HALF_ZONE - lr_INFEED2_ORIGIN_X;
RobotDefault.aZones[1].fAllocationOffset := lr_ALLOCATION_OFFSET;
RobotDefault.aZones[1].fCcsOffset := lr_BaseX - lr_INFEED2_ORIGIN_X;
RobotDefault.aZones[1].fStartY := -lr_PICK_HALF_LANE;
RobotDefault.aZones[1].fEndY := lr_PICK_HALF_LANE;
RobotDefault.aZones[2].nConveyorId := fb_Outfeed.m_Id();
RobotDefault.aZones[2].fStart := lr_BaseX - lr_PLACE_HALF_ZONE - lr_OUTFEED_ORIGIN_X;
RobotDefault.aZones[2].fEnd := lr_BaseX + lr_PLACE_HALF_ZONE - lr_OUTFEED_ORIGIN_X;
RobotDefault.aZones[2].fAllocationOffset := 0;
RobotDefault.aZones[2].fCcsOffset := lr_BaseX - lr_OUTFEED_ORIGIN_X;
RobotDefault.aZones[2].fStartY := 0;
RobotDefault.aZones[2].fEndY := 0;


(****************************************************************************************************
GRIPPER: the fingers and their places on the flange at rest (ADR 0018); the demo reports their live poses
****************************************************************************************************)
CASE n_Robot OF
	0:
		(* Two suction cups on either side of the flange along its X. *)
		n_FingerCount := 2;
		FOR n_Finger := 1 TO 2 DO
			RobotDefault.aFingers[n_Finger - 1].fDiameter := DEMO_GlobalConst.DEMO_lr_CUP_DIAMETER;
			RobotDefault.aFingers[n_Finger - 1].fHeight := DEMO_GlobalConst.DEMO_lr_CUP_HEIGHT;
			RobotDefault.aFingers[n_Finger - 1].stOffset.fX := SEL(n_Finger = 1, -lr_PAIR_OFFSET, lr_PAIR_OFFSET);
			RobotDefault.aFingers[n_Finger - 1].stOffset.fY := 0;
			RobotDefault.aFingers[n_Finger - 1].stOffset.fRz := 0;
		END_FOR
	1:
		(* One finger at the flange centre. *)
		n_FingerCount := 1;
		RobotDefault.aFingers[0].fDiameter := lr_TILT_DIAMETER;
		RobotDefault.aFingers[0].fHeight := lr_TILT_HEIGHT;
		RobotDefault.aFingers[0].stOffset.fX := 0;
		RobotDefault.aFingers[0].stOffset.fY := 0;
		RobotDefault.aFingers[0].stOffset.fRz := 0;
ELSE
	(* A ring of fingers around the flange, open, each turned to face the centre. *)
	n_FingerCount := n_RING_FINGERS;
	FOR n_Finger := 1 TO n_RING_FINGERS DO
		lr_TempAngle := 360.0 * INT_TO_LREAL(n_Finger - 1) / INT_TO_LREAL(n_RING_FINGERS);
		RobotDefault.aFingers[n_Finger - 1].fDiameter := lr_RING_DIAMETER;
		RobotDefault.aFingers[n_Finger - 1].fHeight := lr_RING_HEIGHT;
		RobotDefault.aFingers[n_Finger - 1].stOffset.fX := lr_SPREAD_OPEN * COS(lr_TempAngle * VISU_GlobalConst.VISU_lr_DEG_TO_RAD);
		RobotDefault.aFingers[n_Finger - 1].stOffset.fY := lr_SPREAD_OPEN * SIN(lr_TempAngle * VISU_GlobalConst.VISU_lr_DEG_TO_RAD);
		RobotDefault.aFingers[n_Finger - 1].stOffset.fRz := lr_TempAngle;
	END_FOR
END_CASE
RobotDefault.nFingerCount := INT_TO_UINT(n_FingerCount);

(* Delta 1 runs with its parameter set (Syn_Config) once the configurator wrote one, also its pick logic. The
   program values are complete only here: RobotDefault serves all three robots. *)
IF n_Robot = 0 THEN
	fb_Delta1Param.m_Register(vio_Manifest := GVL_Config.stManifest, vi_udn_Id := fb_Delta1.m_Id());
	fb_Delta1Param.m_Cycle(vio_Default := RobotDefault, vio_Set := Delta1Set, vi_b_ApplyAllowed := TRUE);
	BasePose := fb_Delta1Param.m_Pose();
	lr_BaseX := BasePose.fX;
ELSE
	BasePose := RobotDefault.stPose;
END_IF
fb_RefRobot.m_Configure(vi_Pose := BasePose, vi_lr_BaseRadius := 200, vi_lr_EffectorRadius := 50,
	vi_lr_UpperArmLength := 400, vi_lr_LowerArmLength := 1000);

(* Delta 1 gets its fingers with its parameter set (m_PassOn below), the others here. *)
IF n_Robot <> 0 THEN
	FOR n_Finger := 1 TO n_FingerCount DO
		fb_RefRobot.m_SetFinger(vi_un_Finger := INT_TO_UINT(n_Finger), vi_lr_Diameter := RobotDefault.aFingers[n_Finger - 1].fDiameter,
			vi_lr_Height := RobotDefault.aFingers[n_Finger - 1].fHeight);
		fb_RefRobot.m_SetFingerOffset(vi_un_Finger := INT_TO_UINT(n_Finger),
			vi_lr_X := RobotDefault.aFingers[n_Finger - 1].stOffset.fX, vi_lr_Y := RobotDefault.aFingers[n_Finger - 1].stOffset.fY,
			vi_lr_Z := RobotDefault.aFingers[n_Finger - 1].stOffset.fZ, vi_lr_Rz := RobotDefault.aFingers[n_Finger - 1].stOffset.fRz);
	END_FOR
END_IF


(****************************************************************************************************
AREAS AND ZONES: Delta 1's from its parameter set, the others' program values
****************************************************************************************************)
IF n_Robot = 0 THEN
	fb_Delta1Param.m_PassOn(vio_Visu := fb_RefRobot);
ELSE
	fb_RefRobot.m_SetWorkingArea(vi_lr_Radius := RobotDefault.stWorkingArea.fRadius,
		vi_lr_ZMin := RobotDefault.stWorkingArea.fZMin, vi_lr_ZMax := RobotDefault.stWorkingArea.fZMax,
		vi_lr_ConeHeight := RobotDefault.stWorkingArea.fConeHeight,
		vi_lr_ConeBottomRadius := RobotDefault.stWorkingArea.fConeBottomRadius);
	fb_RefRobot.m_SetLimitArea(vi_lr_XMin := RobotDefault.stLimitArea.fXMin, vi_lr_XMax := RobotDefault.stLimitArea.fXMax,
		vi_lr_YMin := RobotDefault.stLimitArea.fYMin, vi_lr_YMax := RobotDefault.stLimitArea.fYMax,
		vi_lr_ZMin := RobotDefault.stLimitArea.fZMin, vi_lr_ZMax := RobotDefault.stLimitArea.fZMax);
	fb_RefRobot.m_SetTcpLimitArea(vi_lr_XMin := RobotDefault.stTcpLimitArea.fXMin,
		vi_lr_XMax := RobotDefault.stTcpLimitArea.fXMax, vi_lr_YMin := RobotDefault.stTcpLimitArea.fYMin,
		vi_lr_YMax := RobotDefault.stTcpLimitArea.fYMax, vi_lr_ZMin := RobotDefault.stTcpLimitArea.fZMin,
		vi_lr_ZMax := RobotDefault.stTcpLimitArea.fZMax);
	FOR n_Zone := 1 TO UINT_TO_INT(RobotDefault.nZoneCount) DO
		fb_RefRobot.m_SetZone(vi_un_Zone := INT_TO_UINT(n_Zone), vi_udn_ConveyorId := RobotDefault.aZones[n_Zone - 1].nConveyorId,
			vi_lr_Start := RobotDefault.aZones[n_Zone - 1].fStart, vi_lr_End := RobotDefault.aZones[n_Zone - 1].fEnd,
			vi_lr_AllocationOffset := RobotDefault.aZones[n_Zone - 1].fAllocationOffset,
			vi_lr_CcsOffset := RobotDefault.aZones[n_Zone - 1].fCcsOffset,
			vi_lr_StartY := RobotDefault.aZones[n_Zone - 1].fStartY, vi_lr_EndY := RobotDefault.aZones[n_Zone - 1].fEndY);
	END_FOR
	fb_RefRobot.m_SetOriginShift(vi_lr_X := RobotDefault.stOriginShift.fX, vi_lr_Y := RobotDefault.stOriginShift.fY,
		vi_lr_Z := RobotDefault.stOriginShift.fZ);
END_IF

(* Start position of the TCP *)
IF NOT b_TcpInitialised[n_Robot] THEN
	Tcp[n_Robot].fX := lr_BaseX;
	Tcp[n_Robot].fY := lr_ROBOT_Y;
	Tcp[n_Robot].fZ := lr_ROBOT_Z - 900;
	b_TcpInitialised[n_Robot] := TRUE;
END_IF
m_Configure := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Delta1Step" Id="{53a32b8b-4167-4083-8af1-317b2e881104}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Delta 1's TCP travel this cycle: its speed ramps with the recipe's acceleration (% of lr_TCP_ACCEL) towards the<br>
recipe's speed (% of lr_TCP_SPEED), scaled by how far Infeed 1 is at its recipe speed, so the robot slows down and<br>
halts with its belt when the machine stops.<br>
****************************************************************************************************)
METHOD PRIVATE m_Delta1Step : LREAL
VAR
	lr_TempBeltShare					: LREAL;	// [-] Infeed 1's speed of its recipe speed, 0..1
	lr_TempTarget						: LREAL;	// [mm/s]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[lr_TempBeltShare := LIMIT(0.0, DEMO_GlobalVar.DEMO_lr_Infeed1Speed / MAX(DEMO_GlobalVar.DEMO_Recipe.lr_BeltSpeed, 1.0), 1.0);
lr_TempTarget := lr_TCP_SPEED * DEMO_GlobalVar.DEMO_Recipe.lr_RobotSpeed / 100.0 * lr_TempBeltShare;
lr_Delta1Speed := _FC_DemoApproach(lr_Delta1Speed, lr_TempTarget,
	lr_TCP_ACCEL * DEMO_GlobalVar.DEMO_Recipe.lr_RobotAccel / 100.0 * lr_Dt);
m_Delta1Step := lr_Delta1Speed * lr_Dt;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_FingerPose" Id="{5d17ab15-cc0a-4d43-ad44-94110b303ed7}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Pose of a Delta's finger frame (centre of its top face), absolute in the MCS, from the robot's TCP (the flange)<br>
and its tool state:<br>
- Delta 1: two cups on either side of the flange at lr_PAIR_OFFSET along the tool's X, turned by lr_ToolRz.<br>
- Delta 2: one finger at the flange, turned by lr_ToolRz and tilted about its own X by lr_TiltRx.<br>
- Delta 3: n_RING_FINGERS fingers on a circle of radius lr_Spread around the flange, each facing outwards.<br>
****************************************************************************************************)
METHOD PRIVATE m_FingerPose : ST_VisuPose
VAR_INPUT
	vi_n_Robot							: INT;	// [-] 0..2
	vi_n_Finger							: INT;	// [-] 1-based
END_VAR
VAR
	lr_TempRz							: LREAL;	// [deg]
	lr_TempRadius						: LREAL;	// [mm] finger distance from the flange
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_FingerPose.fX := Tcp[vi_n_Robot].fX;
m_FingerPose.fY := Tcp[vi_n_Robot].fY;
m_FingerPose.fZ := Tcp[vi_n_Robot].fZ;
m_FingerPose.fRx := 0;
m_FingerPose.fRy := 0;
lr_TempRz := lr_ToolRz[vi_n_Robot];
lr_TempRadius := 0;
CASE vi_n_Robot OF
	0:
		(* Finger 1 along the tool's +X, finger 2 along its -X. *)
		lr_TempRadius := SEL(vi_n_Finger = 1, -lr_PAIR_OFFSET, lr_PAIR_OFFSET);
	1:
		m_FingerPose.fRx := lr_TiltRx;
	2:
		lr_TempRz := lr_ToolRz[vi_n_Robot] + 360.0 / INT_TO_LREAL(n_RING_FINGERS) * INT_TO_LREAL(vi_n_Finger - 1);
		lr_TempRadius := lr_Spread;
END_CASE
m_FingerPose.fX := m_FingerPose.fX + lr_TempRadius * COS(lr_TempRz * VISU_GlobalConst.VISU_lr_DEG_TO_RAD);
m_FingerPose.fY := m_FingerPose.fY + lr_TempRadius * SIN(lr_TempRz * VISU_GlobalConst.VISU_lr_DEG_TO_RAD);
m_FingerPose.fRz := lr_TempRz;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Generate" Id="{2f044e52-b683-47d0-993c-b94d873f037d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The product generator on Infeed 1 before Vision 1, from the recipe's product pattern: a place every so many mm of<br>
belt travel (the rate at the recipe's belt speed, so the pattern keeps its spacing while the belt ramps or stands),<br>
a share of the places left empty, each product in one of the lanes at random, of a type of the type mix, scattered<br>
along and across the belt and turned. It makes up a detection (its pose, the belt position at that moment, its type)<br>
and latches it as Vision 1's, which marks every tenth as a sample. A new seed, or a reset, starts the numbers again:<br>
the same seed gives the same products.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE in the cycle a product was latched.<br>
****************************************************************************************************)
METHOD PRIVATE m_Generate : BOOL
VAR
	lr_TempSpacing						: LREAL;	// [mm] belt travel between the generator's places
	dn_TempLanes						: DINT;	// [-]
	lr_TempLaneY						: LREAL;	// [mm] the lane's middle from the belt's middle
	udn_TempType						: UDINT;	// [-] product type
	Detection							: ST_VisuPlanarPose;	// MCS pose of the made-up detection
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Generate := FALSE;
IF DEMO_GlobalVar.DEMO_Recipe.dn_Seed <> dn_GenSeed THEN
	dn_GenSeed := DEMO_GlobalVar.DEMO_Recipe.dn_Seed;
	udn_GenRandom := DINT_TO_UDINT(dn_GenSeed);
	lr_GenTravel := 0;
	un_Vision1Latches := 0;
END_IF
IF NOT DEMO_GlobalVar.DEMO_Recipe.b_Feed OR DEMO_GlobalVar.DEMO_Recipe.lr_Rate <= 0 THEN
	RETURN;
END_IF

(* A place every lr_TempSpacing of belt travel. *)
lr_TempSpacing := MAX(DEMO_GlobalVar.DEMO_Recipe.lr_BeltSpeed, 1) * 60.0 / DEMO_GlobalVar.DEMO_Recipe.lr_Rate;
lr_GenTravel := lr_GenTravel + DEMO_GlobalVar.DEMO_lr_Infeed1Speed * lr_Dt;
IF lr_GenTravel < lr_TempSpacing THEN
	RETURN;
END_IF
lr_GenTravel := lr_GenTravel - lr_TempSpacing;
IF m_Random() * 100.0 < DEMO_GlobalVar.DEMO_Recipe.lr_GapShare THEN
	RETURN;	// a gap
END_IF

(* Its lane, type and scatter. *)
dn_TempLanes := LIMIT(1, DEMO_GlobalVar.DEMO_Recipe.dn_Lanes, 4);
lr_TempLaneY := (DINT_TO_LREAL(m_RandomIndex(vi_dn_Count := dn_TempLanes)) - DINT_TO_LREAL(dn_TempLanes - 1) / 2.0)
	* DEMO_GlobalVar.DEMO_Recipe.lr_LanePitch;
CASE DEMO_GlobalVar.DEMO_Recipe.dn_TypeMix OF
	1: udn_TempType := 1 + DINT_TO_UDINT(m_RandomIndex(vi_dn_Count := 2));	// boxes: 1, 2
	2: udn_TempType := 3 + DINT_TO_UDINT(m_RandomIndex(vi_dn_Count := 2));	// round: the can and the oval, 3, 4
ELSE
	udn_TempType := 1 + DINT_TO_UDINT(m_RandomIndex(vi_dn_Count := UDINT_TO_DINT(udn_TYPE_COUNT)));
END_CASE
Detection.fX := fb_Vision1Param.vo_Config.stActive.stPose.fX + (m_Random() * 2.0 - 1.0) * DEMO_GlobalVar.DEMO_Recipe.lr_ScatterX;
Detection.fY := fb_Infeed1.vo_Visu.stConfig.stPose.fY + lr_TempLaneY
	+ (m_Random() * 2.0 - 1.0) * DEMO_GlobalVar.DEMO_Recipe.lr_ScatterY;
Detection.fZ := DEMO_GlobalConst.DEMO_lr_BELT_Z;
Detection.fRz := (m_Random() * 2.0 - 1.0) * DEMO_GlobalVar.DEMO_Recipe.lr_ScatterRz;

(* Vision 1's detection: latched at the belt position of this moment; every tenth is a sample. *)
IF fb_Infeed1.m_LatchProduct(vi_udn_Id := DEMO_GlobalVar.DEMO_udn_NextId,
	vi_LatchPose := _FC_DemoMcsToBelt(vio_Config := fb_Infeed1.vo_Visu.stConfig, vi_Pose := Detection),
	vi_udn_ProductType := udn_TempType, vi_lr_LatchBeltPosition := 0, vi_b_UseLatchBeltPosition := FALSE,
	vi_e_State := E_VisuProductState.DETECTED, vi_udn_ClientId := fb_Vision1.m_Id())
THEN
	un_Vision1Latches := un_Vision1Latches + 1;
	IF un_Vision1Latches MOD un_SAMPLE_EVERY = 0 THEN
		fb_Infeed1.m_SetProductMark(vi_udn_Id := DEMO_GlobalVar.DEMO_udn_NextId, vi_un_Mark := un_SAMPLE_MARK);
	END_IF
	DEMO_GlobalVar.DEMO_udn_NextId := DEMO_GlobalVar.DEMO_udn_NextId + 1;
	m_Generate := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_GripOffset" Id="{17c91ded-f2c7-4097-a75c-f658d8a501b8}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
MCS offset from a Delta's TCP (the flange) to the grip point of one of its fingers, the centre of the finger's<br>
bottom face: where a carried product's top touches. vi_n_Finger = 0 is the flange itself.<br>
****************************************************************************************************)
METHOD PRIVATE m_GripOffset : ST_VisuPosition
VAR_INPUT
	vi_n_Robot							: INT;	// [-] 0..2
	vi_n_Finger							: INT;	// [-] 1-based, 0 = flange
END_VAR
VAR
	TempTop								: ST_VisuPose;
	lr_TempHeight						: LREAL;	// [mm]
	lr_TempRx							: LREAL;	// [rad]
	lr_TempRz							: LREAL;	// [rad]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF vi_n_Finger = 0 THEN
	RETURN;
END_IF
CASE vi_n_Robot OF
	0: lr_TempHeight := DEMO_GlobalConst.DEMO_lr_CUP_HEIGHT;
	1: lr_TempHeight := lr_TILT_HEIGHT;
ELSE
	lr_TempHeight := lr_RING_HEIGHT;
END_CASE
TempTop := m_FingerPose(vi_n_Robot := vi_n_Robot, vi_n_Finger := vi_n_Finger);
lr_TempRx := TempTop.fRx * VISU_GlobalConst.VISU_lr_DEG_TO_RAD;
lr_TempRz := TempTop.fRz * VISU_GlobalConst.VISU_lr_DEG_TO_RAD;
(* Rz(rz) * Rx(rx) * (0, 0, -height): the finger's local -Z in the MCS. *)
m_GripOffset.fX := TempTop.fX - Tcp[vi_n_Robot].fX - lr_TempHeight * SIN(lr_TempRx) * SIN(lr_TempRz);
m_GripOffset.fY := TempTop.fY - Tcp[vi_n_Robot].fY + lr_TempHeight * SIN(lr_TempRx) * COS(lr_TempRz);
m_GripOffset.fZ := TempTop.fZ - Tcp[vi_n_Robot].fZ - lr_TempHeight * COS(lr_TempRx);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Missed" Id="{42a41e1d-3d75-4a8f-a4a2-fbbe13e08d2b}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Whether a product passed Infeed 1's end unpicked (still DETECTED or ASSIGNED): it raises the machine message<br>
'Product missed' (P_VisuDemoMachine), which stays lr_MISSED_HOLD after the last one.<br>
*****************************************************************************************************<br>
OUTPUT VALUES:<br>
TRUE while a missed product is beyond the belt end.<br>
****************************************************************************************************)
METHOD PRIVATE m_Missed : BOOL
VAR
	un_TempIndex						: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Missed := FALSE;
un_TempIndex := 0;
WHILE un_TempIndex < fb_Infeed1.m_ProductCount() DO
	fb_Infeed1.m_GetProduct(vi_un_Index := un_TempIndex, vo_Product => Product, vo_Pose => ProductPose);
	ProductPose := _FC_DemoBeltToMcs(vio_Config := fb_Infeed1.vo_Visu.stConfig, vi_Pose := ProductPose);
	IF (Product.eState = E_VisuProductState.DETECTED OR Product.eState = E_VisuProductState.ASSIGNED)
		AND ProductPose.fX > fb_Infeed1.vo_Visu.stConfig.stPose.fX + lr_BELT_LENGTH
	THEN
		m_Missed := TRUE;
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE
IF m_Missed THEN
	lr_MissedLeft := lr_MISSED_HOLD;
ELSE
	lr_MissedLeft := MAX(0.0, lr_MissedLeft - lr_Dt);
END_IF
DEMO_GlobalVar.DEMO_b_Infeed1Missed := lr_MissedLeft > 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_MoveToward" Id="{bd7e26dd-c6e5-4891-85ce-b9f758a69322}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves a TCP towards a target by at most vi_lr_MaxStep. TRUE once the target is reached.<br>
****************************************************************************************************)
METHOD PRIVATE m_MoveToward : BOOL
VAR_IN_OUT
	vio_Tcp								: ST_VisuPosition;
END_VAR
VAR_INPUT
	vi_lr_TargetX						: LREAL;	// [mm]
	vi_lr_TargetY						: LREAL;	// [mm]
	vi_lr_TargetZ						: LREAL;	// [mm]
	vi_lr_MaxStep						: LREAL;	// [mm]
END_VAR
VAR
	lr_TempDx							: LREAL;	// [mm]
	lr_TempDy							: LREAL;	// [mm]
	lr_TempDz							: LREAL;	// [mm]
	lr_TempDist							: LREAL;	// [mm]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[lr_TempDx := vi_lr_TargetX - vio_Tcp.fX;
lr_TempDy := vi_lr_TargetY - vio_Tcp.fY;
lr_TempDz := vi_lr_TargetZ - vio_Tcp.fZ;
lr_TempDist := SQRT(lr_TempDx * lr_TempDx + lr_TempDy * lr_TempDy + lr_TempDz * lr_TempDz);
IF lr_TempDist <= vi_lr_MaxStep THEN
	vio_Tcp.fX := vi_lr_TargetX;
	vio_Tcp.fY := vi_lr_TargetY;
	vio_Tcp.fZ := vi_lr_TargetZ;
	m_MoveToward := TRUE;
ELSE
	vio_Tcp.fX := vio_Tcp.fX + lr_TempDx / lr_TempDist * vi_lr_MaxStep;
	vio_Tcp.fY := vio_Tcp.fY + lr_TempDy / lr_TempDist * vi_lr_MaxStep;
	vio_Tcp.fZ := vio_Tcp.fZ + lr_TempDz / lr_TempDist * vi_lr_MaxStep;
	m_MoveToward := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Random" Id="{2e4634d7-0d76-4117-a776-894b6f18927d}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
The product generator's next pseudo-random number in 0..1 (below 1): a linear congruential generator, so the same<br>
seed always gives the same numbers.<br>
****************************************************************************************************)
METHOD PRIVATE m_Random : LREAL]]></Declaration>
      <Implementation>
        <ST><![CDATA[udn_GenRandom := udn_GenRandom * udn_RANDOM_A + udn_RANDOM_C;
(* The upper 24 bits: the lower ones of such a generator repeat soon. *)
m_Random := UDINT_TO_LREAL(SHR(udn_GenRandom, 8)) / 16777216.0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_RandomIndex" Id="{46333092-dc15-4193-b964-3c123d928fe9}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
One of vi_dn_Count values 0..vi_dn_Count-1, each as likely, from the generator's next pseudo-random number.<br>
****************************************************************************************************)
METHOD PRIVATE m_RandomIndex : DINT
VAR_INPUT
	vi_dn_Count							: DINT;	// [-] at least 1
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_RandomIndex := LIMIT(0, LREAL_TO_DINT(m_Random() * DINT_TO_LREAL(vi_dn_Count) - 0.5), MAX(vi_dn_Count, 1) - 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_RejectUnit" Id="{8dedf384-7c94-4843-81de-1a1bdc2e33c2}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reject unit at the right edge of the outfeed: describes its housing and pusher and its zone, a line across<br>
the belt at lr_REJECT_X. Every un_REJECT_EVERY-th product passing it is set REJECTED by the reject unit;<br>
the pusher lights up and the product leaves the register after lr_REJECT_PUSH_TIME.<br>
****************************************************************************************************)
METHOD PRIVATE m_RejectUnit : BOOL
VAR
	TempPose							: ST_VisuPose;
	TempProduct							: ST_VisuProduct;
	TempProductPose						: ST_VisuPlanarPose;
	un_TempIndex						: UINT;
END_VAR
VAR CONSTANT
	lr_GAP								: LREAL := 30;	// [mm] between the belt edge and the pusher's back
	lr_HOUSING_LENGTH					: LREAL := 160;	// [mm] along the belt
	lr_HOUSING_WIDTH					: LREAL := 140;	// [mm]
	lr_HOUSING_ABOVE_BELT				: LREAL := 120;	// [mm] its top above the belt surface
	lr_PUSHER_LENGTH					: LREAL := 120;	// [mm] along the belt
	lr_PUSHER_WIDTH						: LREAL := 30;	// [mm]
	lr_PUSHER_HEIGHT					: LREAL := 50;	// [mm]
	lr_PUSHER_ABOVE_BELT				: LREAL := 10;	// [mm] its bottom above the belt surface
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(****************************************************************************************************)
(* CONFIGURATION: origin on the floor at the right belt edge, local +Y across the belt               *)
(****************************************************************************************************)
TempPose.fX := lr_REJECT_X;
TempPose.fY := lr_OUTFEED_Y - DEMO_GlobalConst.DEMO_lr_BELT_WIDTH / 2 - lr_GAP;
TempPose.fZ := 0;
fb_RejectUnit.m_Configure(vi_Pose := TempPose);
TempPose.fX := 0;
TempPose.fY := -lr_HOUSING_WIDTH / 2;
TempPose.fZ := 0;
fb_RejectUnit.m_SetBody(vi_un_Body := 1, vi_e_Shape := E_VisuBodyShape.BOX, vi_e_Role := E_VisuBodyRole.STRUCTURE,
	vi_Pose := TempPose, vi_lr_Length := lr_HOUSING_LENGTH, vi_lr_Width := lr_HOUSING_WIDTH,
	vi_lr_Height := DEMO_GlobalConst.DEMO_lr_BELT_Z + lr_HOUSING_ABOVE_BELT, vi_lr_TopLength := 0, vi_lr_TopWidth := 0);
TempPose.fY := lr_PUSHER_WIDTH / 2;
TempPose.fZ := DEMO_GlobalConst.DEMO_lr_BELT_Z + lr_PUSHER_ABOVE_BELT;
fb_RejectUnit.m_SetBody(vi_un_Body := 2, vi_e_Shape := E_VisuBodyShape.BOX, vi_e_Role := E_VisuBodyRole.STRUCTURE,
	vi_Pose := TempPose, vi_lr_Length := lr_PUSHER_LENGTH, vi_lr_Width := lr_PUSHER_WIDTH, vi_lr_Height := lr_PUSHER_HEIGHT,
	vi_lr_TopLength := 0, vi_lr_TopWidth := 0);
(* The outfeed counts from its shifted origin. *)
fb_RejectUnit.m_SetZone(vi_un_Zone := 1, vi_udn_ConveyorId := fb_Outfeed.m_Id(), vi_lr_Start := lr_REJECT_X - lr_OUTFEED_ORIGIN_X,
	vi_lr_End := lr_REJECT_X - lr_OUTFEED_ORIGIN_X, vi_lr_AllocationOffset := 0,
	vi_lr_CcsOffset := lr_REJECT_X - lr_OUTFEED_ORIGIN_X, vi_lr_StartY := 0, vi_lr_EndY := 0);


(****************************************************************************************************)
(* PUSHING                                                                                          *)
(****************************************************************************************************)
IF udn_RejectPushing <> 0 THEN
	lr_RejectLeft := lr_RejectLeft - lr_Dt;
	IF lr_RejectLeft <= 0 THEN
		fb_Outfeed.m_RemoveProduct(udn_RejectPushing);
		udn_RejectPushing := 0;
	END_IF
END_IF

(* A product passes the pusher in the cycle its centre crosses lr_REJECT_X. *)
un_TempIndex := 0;
WHILE un_TempIndex < fb_Outfeed.m_ProductCount() DO
	fb_Outfeed.m_GetProduct(vi_un_Index := un_TempIndex, vo_Product => TempProduct, vo_Pose => TempProductPose);
	TempProductPose := _FC_DemoBeltToMcs(vio_Config := fb_Outfeed.vo_Visu.stConfig, vi_Pose := TempProductPose);
	IF TempProduct.eState = E_VisuProductState.PLACED AND TempProductPose.fX >= lr_REJECT_X
		AND TempProductPose.fX - lr_OUTFEED_SPEED * lr_Dt < lr_REJECT_X
	THEN
		un_RejectPassed := un_RejectPassed + 1;
		IF un_RejectPassed MOD un_REJECT_EVERY = 0 AND udn_RejectPushing = 0 THEN
			fb_Outfeed.m_SetProductState(vi_udn_Id := TempProduct.nId, vi_e_State := E_VisuProductState.REJECTED,
				vi_udn_ClientId := fb_RejectUnit.m_Id(), vi_udn_MoverId := 0, vi_udn_FingerId := 0);
			udn_RejectPushing := TempProduct.nId;
			lr_RejectLeft := lr_REJECT_PUSH_TIME;
		END_IF
	END_IF
	un_TempIndex := un_TempIndex + 1;
END_WHILE
fb_RejectUnit.m_SetBodyActive(vi_un_Body := 2, vi_b_Active := udn_RejectPushing <> 0);
m_RejectUnit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Report" Id="{ed987379-5fc1-4418-9fdd-db3d344b67b8}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves the Delta 3 fingers and reports the TCP, the fault and the finger states of Delta n_Robot.<br>
****************************************************************************************************)
METHOD PRIVATE m_Report : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Delta 3 closes its fingers while it descends onto a product and keeps them closed while it carries one. *)
IF n_Robot = 2 THEN
	IF n_Phase[n_Robot] = n_PHASE_DESCEND OR n_HeldCount[n_Robot] > 0 THEN
		lr_Spread := _FC_DemoApproach(lr_Spread, lr_SpreadClosed, lr_SPREAD_SPEED * lr_Dt);
	ELSE
		lr_Spread := _FC_DemoApproach(lr_Spread, lr_SPREAD_OPEN, lr_SPREAD_SPEED * lr_Dt);
	END_IF
END_IF

(* Only the TCP (the flange) is reported; the visualisation derives the arms. A small offset shows the setpoint
   marker. Tool rotations show only through the finger poses. *)
SetpointTcp := Tcp[n_Robot];
SetpointTcp.fX := SetpointTcp.fX + 2;
SetpointTcp.fZ := SetpointTcp.fZ - 1;
fb_RefRobot.m_SetTcp(vi_ActualTcp := Tcp[n_Robot], vi_SetpointTcp := SetpointTcp);

(* Demo fault: Delta 1 overheats now and then. *)
fb_RefRobot.m_SetFault(vi_b_Active := n_Robot = 0 AND DEMO_GlobalVar.DEMO_lr_FaultPhase >= lr_FAULT_START
										AND DEMO_GlobalVar.DEMO_lr_FaultPhase
											< lr_FAULT_START + DEMO_GlobalConst.DEMO_lr_FAULT_DURATION,
	vi_str_Message := 'Drive 2: overtemperature');
FOR n_Finger := 1 TO n_FingerCount DO
	(* Delta 1: a cup grips while its slot holds a product; the others grip while anything is carried. *)
	fb_RefRobot.m_SetFingerState(vi_un_Finger := INT_TO_UINT(n_Finger),
		vi_Pose := m_FingerPose(vi_n_Robot := n_Robot, vi_n_Finger := n_Finger),
		vi_b_Active := n_HeldCount[n_Robot] >= SEL(n_Robot = 0, 1, n_Finger));
END_FOR
m_Report := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Reset" Id="{43492bae-a9a2-44c7-aa03-d96c00773bfd}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Reset of the machine (accepted while stopped): every product leaves Infeed 1's register, Delta 1 holds and<br>
approaches nothing (nor does a robot approach a product of Infeed 1), the generator starts again from its seed and<br>
the missed-product message is acknowledged.<br>
****************************************************************************************************)
METHOD PRIVATE m_Reset : BOOL
VAR
	n_TempRobot							: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WHILE fb_Infeed1.m_ProductCount() > 0 DO
	fb_Infeed1.m_GetProduct(vi_un_Index := 0, vo_Product => Product, vo_Pose => ProductPose);
	IF NOT fb_Infeed1.m_RemoveProduct(Product.nId) THEN
		EXIT;	// never: the first entry is always there
	END_IF
END_WHILE
FOR n_TempRobot := 0 TO 2 DO
	IF n_TempRobot = 0 OR (udn_TargetId[n_TempRobot] <> 0 AND n_TargetBelt[n_TempRobot] = 0) THEN
		udn_TargetId[n_TempRobot] := 0;
		IF n_HeldCount[n_TempRobot] = 0 OR n_TempRobot = 0 THEN
			n_Phase[n_TempRobot] := n_PHASE_IDLE;
		END_IF
	END_IF
END_FOR
n_HeldCount[0] := 0;
udn_Held[0, 0] := 0;
udn_Held[0, 1] := 0;
dn_GenSeed := 0;	// the generator starts again from the recipe's seed
lr_MissedLeft := 0;
DEMO_GlobalVar.DEMO_b_Infeed1Missed := FALSE;
m_Reset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Sequence" Id="{6f116a11-a958-4cf7-80a0-01f0179b7ab9}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Pick and place sequence of Delta n_Robot: allocate, approach, descend and pick, lift (Delta 1 picks twice),<br>
transfer to the outfeed, lower and release every carried product.<br>
****************************************************************************************************)
METHOD PRIVATE m_Sequence : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE n_Phase[n_Robot] OF
	n_PHASE_IDLE:
		IF NOT m_Allocate() THEN
			m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := lr_BaseX, vi_lr_TargetY := lr_ROBOT_Y,
				vi_lr_TargetZ := lr_ROBOT_Z - 900, vi_lr_MaxStep := lr_Step);
		END_IF

	n_PHASE_APPROACH:
		IF lr_X - lr_LEAD > lr_BaseX + lr_PICK_HALF_ZONE THEN
			(* Product left the zone: hand it back, a downstream robot may still catch it. *)
			fb_RefBelt.m_SetProductState(vi_udn_Id := udn_TargetId[n_Robot], vi_e_State := E_VisuProductState.DETECTED,
				vi_udn_ClientId := fb_RefRobot.m_Id(), vi_udn_MoverId := 0, vi_udn_FingerId := 0);
			udn_TargetId[n_Robot] := 0;
			n_Phase[n_Robot] := n_PHASE_IDLE;
		ELSE
			lr_ToolRz[n_Robot] := lr_ToolRz[n_Robot] + (lr_TargetRz - lr_ToolRz[n_Robot]) * MIN(1.0, lr_Dt * 10.0);
			IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := lr_X - Grip.fX, vi_lr_TargetY := lr_Y - Grip.fY,
				vi_lr_TargetZ := lr_TopZ - Grip.fZ + lr_HOVER, vi_lr_MaxStep := lr_Step)
			THEN
				n_Phase[n_Robot] := n_PHASE_DESCEND;
			END_IF
		END_IF

	n_PHASE_DESCEND:
		lr_ToolRz[n_Robot] := lr_ToolRz[n_Robot] + (lr_TargetRz - lr_ToolRz[n_Robot]) * MIN(1.0, lr_Dt * 10.0);
		(* Delta 3 grips only once its fingers have closed around the product (both operands are evaluated). *)
		IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := lr_X - Grip.fX, vi_lr_TargetY := lr_Y - Grip.fY,
			vi_lr_TargetZ := lr_TopZ - Grip.fZ, vi_lr_MaxStep := lr_Step)
		AND (n_Robot <> 2 OR lr_Spread = lr_SpreadClosed)
		THEN
			n_Slot := n_HeldCount[n_Robot];
			fb_RefBelt.m_SetProductState(vi_udn_Id := udn_TargetId[n_Robot], vi_e_State := E_VisuProductState.PICKED,
				vi_udn_ClientId := fb_RefRobot.m_Id(), vi_udn_MoverId := 0, vi_udn_FingerId := INT_TO_UDINT(n_Finger));
			udn_Held[n_Robot, n_Slot] := udn_TargetId[n_Robot];
			n_HeldBelt[n_Robot, n_Slot] := n_TargetBelt[n_Robot];
			udn_HeldType[n_Robot, n_Slot] := Product.nProductType;
			un_HeldMark[n_Robot, n_Slot] := Product.nMark;
			n_HeldCount[n_Robot] := n_Slot + 1;
			udn_TargetId[n_Robot] := 0;
			n_Phase[n_Robot] := n_PHASE_LIFT;
		END_IF

	n_PHASE_LIFT:
		IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := Tcp[n_Robot].fX, vi_lr_TargetY := Tcp[n_Robot].fY,
			vi_lr_TargetZ := DEMO_GlobalConst.DEMO_lr_BELT_Z + lr_HeldHeight + lr_GripHeight
							+ lr_HOVER,
			vi_lr_MaxStep := lr_Step)
		THEN
			(* Delta 1 picks as many products as its recipe says (1 or 2, one per cup) before it places them. *)
			IF n_Robot = 0 AND n_HeldCount[n_Robot] < LIMIT(1, DEMO_GlobalVar.DEMO_Recipe.dn_PicksPerCycle, 2) THEN
				n_Phase[n_Robot] := n_PHASE_IDLE;
			ELSE
				n_Phase[n_Robot] := n_PHASE_TRANSFER;
			END_IF
		END_IF

	n_PHASE_TRANSFER:
		lr_ToolRz[n_Robot] := lr_ToolRz[n_Robot] * (1.0 - MIN(1.0, lr_Dt * 5.0));
		IF n_Robot = 1 THEN
			lr_TiltRx := _FC_DemoApproach(lr_TiltRx, lr_TILT_ANGLE, lr_TILT_SPEED * lr_Dt);
		END_IF
		(* Now and then Delta 2 places far downstream and waits there for a gap on the outfeed: a real limit
		   violation for the visualisation, its TCP limit area in Delta 3's limit area meanwhile. *)
		b_FarPlace := n_Robot = 1 AND un_Placed[n_Robot] MOD un_FAR_PLACE_EVERY = un_FAR_PLACE_EVERY - 1;
		IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := lr_BaseX + SEL(b_FarPlace, 0, lr_FAR_PLACE_OFFSET),
			vi_lr_TargetY := lr_OUTFEED_Y,
			vi_lr_TargetZ := DEMO_GlobalConst.DEMO_lr_BELT_Z + lr_HeldHeight + lr_GripHeight
							+ lr_HOVER,
			vi_lr_MaxStep := lr_Step)
		THEN
			lr_PlaceWait[n_Robot] := lr_PlaceWait[n_Robot] + lr_Dt;
			IF NOT b_FarPlace OR lr_PlaceWait[n_Robot] >= lr_FAR_PLACE_WAIT THEN
				lr_PlaceWait[n_Robot] := 0;
				n_Phase[n_Robot] := n_PHASE_LOWER;
			END_IF
		END_IF

	n_PHASE_LOWER:
		lr_ToolRz[n_Robot] := lr_ToolRz[n_Robot] * (1.0 - MIN(1.0, lr_Dt * 5.0));
		IF n_Robot = 1 THEN
			lr_TiltRx := _FC_DemoApproach(lr_TiltRx, 0, lr_TILT_SPEED * lr_Dt);
		END_IF
		(* Delta 2 puts the product down straight (both operands are evaluated). *)
		IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := Tcp[n_Robot].fX, vi_lr_TargetY := Tcp[n_Robot].fY,
			vi_lr_TargetZ := DEMO_GlobalConst.DEMO_lr_BELT_Z + lr_HeldHeight + lr_GripHeight,
			vi_lr_MaxStep := lr_Step)
		AND (n_Robot <> 1 OR lr_TiltRx = 0)
		THEN
			n_Phase[n_Robot] := n_PHASE_RELEASE;
		END_IF

	n_PHASE_RELEASE:
		(* Every carried product is put down where its finger (Delta 3: the flange) holds it. *)
		FOR n_Slot := 0 TO n_HeldCount[n_Robot] - 1 DO
			IF n_HeldBelt[n_Robot, n_Slot] = 0 THEN
				fb_RefBelt REF= fb_Infeed1;
			ELSE
				fb_RefBelt REF= fb_Infeed2;
			END_IF
			(* Put down on the outfeed: it no longer lies on the infeed. *)
			fb_RefBelt.m_RemoveProduct(udn_Held[n_Robot, n_Slot]);
			n_Finger := SEL(n_Robot = 2, n_Slot + 1, 0);
			Grip := m_GripOffset(vi_n_Robot := n_Robot, vi_n_Finger := n_Finger);
			LatchPose.fX := Tcp[n_Robot].fX + Grip.fX;
			LatchPose.fY := Tcp[n_Robot].fY + Grip.fY;
			LatchPose.fZ := DEMO_GlobalConst.DEMO_lr_BELT_Z;
			(* A product carried at a finger keeps the finger's turn; one at the flange is turned with the base. *)
			LatchPose.fRz := SEL(n_Robot = 2, lr_ToolRz[n_Robot], 0);
			IF fb_Outfeed.m_LatchProduct(vi_udn_Id := DEMO_GlobalVar.DEMO_udn_NextId,
				vi_LatchPose := _FC_DemoMcsToBelt(vio_Config := fb_Outfeed.vo_Visu.stConfig, vi_Pose := LatchPose),
				vi_udn_ProductType := udn_HeldType[n_Robot, n_Slot], vi_lr_LatchBeltPosition := 0,
				vi_b_UseLatchBeltPosition := FALSE, vi_e_State := E_VisuProductState.PLACED,
				vi_udn_ClientId := fb_RefRobot.m_Id())
			THEN
				(* A sample stays marked on the outfeed. *)
				fb_Outfeed.m_SetProductMark(vi_udn_Id := DEMO_GlobalVar.DEMO_udn_NextId, vi_un_Mark := un_HeldMark[n_Robot, n_Slot]);
				DEMO_GlobalVar.DEMO_udn_NextId := DEMO_GlobalVar.DEMO_udn_NextId + 1;
			END_IF
			udn_Held[n_Robot, n_Slot] := 0;
		END_FOR
		n_HeldCount[n_Robot] := 0;
		un_Placed[n_Robot] := un_Placed[n_Robot] + 1;
		n_Phase[n_Robot] := n_PHASE_IDLE;
END_CASE
m_Sequence := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Target" Id="{6161eb3a-1934-4629-b021-a8d81b0ccb5c}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Follows the current target of Delta n_Robot by its id (register indices shift when entries are removed),<br>
selects its infeed into fb_RefBelt and the finger used for the current pick into n_Finger and Grip. Sets the height<br>
of the product carried or approached and the Delta 3 finger distance closed around it.<br>
****************************************************************************************************)
METHOD PRIVATE m_Target : BOOL
VAR
	lr_TempHalfLength					: LREAL;	// [mm]
	lr_TempHalfWidth					: LREAL;	// [mm]
	lr_TempRadius						: LREAL;	// [mm] corner radius of a rounded box
	lr_TempOuter						: LREAL;	// [mm] radius of the circle around the product's outline
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Current target *)
b_Found := FALSE;
IF udn_TargetId[n_Robot] <> 0 THEN
	IF n_TargetBelt[n_Robot] = 0 THEN
		fb_RefBelt REF= fb_Infeed1;
	ELSE
		fb_RefBelt REF= fb_Infeed2;
	END_IF
	IF fb_RefBelt.m_FindProduct(udn_TargetId[n_Robot]) >= 0 THEN
		b_Found := fb_RefBelt.m_GetProduct(vi_un_Index := INT_TO_UINT(fb_RefBelt.m_FindProduct(udn_TargetId[n_Robot])),
			vo_Product => Product, vo_Pose => ProductPose);
	END_IF
END_IF

(* Only approaching and descending follow a target; carried products are tracked in udn_Held. *)
IF (n_Phase[n_Robot] = n_PHASE_APPROACH OR n_Phase[n_Robot] = n_PHASE_DESCEND) AND NOT b_Found THEN
	n_Phase[n_Robot] := n_PHASE_IDLE;
	udn_TargetId[n_Robot] := 0;
END_IF
IF b_Found THEN
	ProductPose := _FC_DemoBeltToMcs(vio_Config := fb_RefBelt.vo_Visu.stConfig, vi_Pose := ProductPose);
	lr_X := ProductPose.fX + lr_LEAD;
	lr_Y := ProductPose.fY;
	lr_TopZ := ProductPose.fZ + lr_TYPE_HEIGHT[LIMIT(1, Product.nProductType, udn_TYPE_COUNT)];
	lr_TargetRz := ProductPose.fRz;
END_IF

(* Size of the product carried, else of the one approached: Delta 1 carries a pair of one type, so its first slot
   stands for both. *)
IF n_HeldCount[n_Robot] > 0 THEN
	udn_Type := LIMIT(1, udn_HeldType[n_Robot, 0], udn_TYPE_COUNT);
ELSIF b_Found THEN
	udn_Type := LIMIT(1, Product.nProductType, udn_TYPE_COUNT);
ELSE
	udn_Type := 1;
END_IF
lr_HeldHeight := lr_TYPE_HEIGHT[udn_Type];
(* Delta 3 closes its fingers on a circle just around the product's outline: around a box's corners, a cylinder's
   larger radius, or a rounded box's corner arcs. *)
lr_TempHalfLength := lr_TYPE_LENGTH[udn_Type] / 2.0;
lr_TempHalfWidth := lr_TYPE_WIDTH[udn_Type] / 2.0;
CASE e_TYPE_SHAPE[udn_Type] OF
	E_VisuProductShape.CYLINDER:
		lr_TempOuter := MAX(lr_TempHalfLength, lr_TempHalfWidth);
	E_VisuProductShape.ROUNDED_BOX:
		lr_TempRadius := MIN(lr_TYPE_CORNER_RADIUS[udn_Type], MIN(lr_TempHalfLength, lr_TempHalfWidth));
		lr_TempOuter := SQRT((lr_TempHalfLength - lr_TempRadius) * (lr_TempHalfLength - lr_TempRadius)
							+ (lr_TempHalfWidth - lr_TempRadius) * (lr_TempHalfWidth - lr_TempRadius)) + lr_TempRadius;
ELSE
	lr_TempOuter := SQRT(lr_TempHalfLength * lr_TempHalfLength + lr_TempHalfWidth * lr_TempHalfWidth);
END_CASE
lr_SpreadClosed := lr_TempOuter + lr_RING_CLEARANCE;

(* Finger used for the current pick: Delta 1 fills its cups one after the other, Delta 3 carries at the flange
   between its fingers. *)
CASE n_Robot OF
	0:
		n_Finger := MIN(n_HeldCount[n_Robot] + 1, 2);
		lr_GripHeight := DEMO_GlobalConst.DEMO_lr_CUP_HEIGHT;
	1:
		n_Finger := 1;
		lr_GripHeight := lr_TILT_HEIGHT;
ELSE
	n_Finger := 0;
	lr_GripHeight := 0;
END_CASE
Grip := m_GripOffset(vi_n_Robot := n_Robot, vi_n_Finger := n_Finger);
m_Target := b_Found;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>