<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="P_VisuDemo" Id="{49b73753-a79a-401f-84bc-fc7827b66eb0}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
DEMO ONLY: independent sample applications side by side, for testing the gateway over ADS. All lines<br>
start at X = 0 and convey along +X. Each application is its own program:<br>
- P_VisuDemoDelta (Y = 0..1000): two infeeds, one outfeed, three Delta robots with different grippers.<br>
- P_VisuDemoFxx (Y = 2500): an XTS loop above two belts evens out irregular gaps.<br>
- P_VisuDemoIdh (Y = 4100..4850): an XTS gantry picks in batches onto a tray belt.<br>
- P_VisuDemoCartesian (Y = 6500..7300): a Cartesian robot turns and tilts the products it places.<br>
- P_VisuDemoCartesianAxes (X = 4000, Y = 6500..7800): Cartesian robots without Y or without Z axis.<br>
- P_VisuDemoSpacing (Y = 9000): an XTS loop under one belt hands products back with a constant pitch.<br>
- P_VisuDemoStress (Y = 11000): load test with thousands of products, off unless DEMO_un_StressProducts is set.<br>
This program, called by PlcTask, sets the shared cycle time and fault phase (DEMO_GlobalVar) and calls them.<br>
It reports the machine (GVL_Visu.stMachine, protocol 22): running, in simulation mode, and the machine message<br>
'Reject bin almost full' about the reject unit for lr_MSG_DURATION at the start of every fault period.<br>
Part of the demo application Syn_Visu_Demo, which uses the Syn_Visu library like any machine project.<br>
****************************************************************************************************)
PROGRAM P_VisuDemo
VAR
	dn_TaskIndex						: DINT;
	fb_Machine							: _FB_VisuMachine;	// run state, simulation mode, machine messages
END_VAR
VAR CONSTANT
	udn_MSG_REJECT_BIN					: UDINT := 1;	// [-] machine message: the reject bin is almost full
	udn_REJECT_UNIT_ID					: UDINT := 60;	// [-] manifest id of the reject unit (P_VisuDemoDelta)
	lr_MSG_DURATION						: LREAL := 4;	// [s] the message is active from the start of every fault period
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(****************************************************************************************************)
(* CYCLE TIME AND FAULT PHASE                                                                       *)
(****************************************************************************************************)
dn_TaskIndex := Tc2_System.GETCURTASKINDEXEX();
IF dn_TaskIndex > 0 THEN
	DEMO_GlobalVar.DEMO_lr_Dt := UDINT_TO_LREAL(TwinCAT_SystemInfoVarList._TaskInfo[dn_TaskIndex].CycleTime) * 1.0E-7;
ELSE
	DEMO_GlobalVar.DEMO_lr_Dt := 0.01;
END_IF
DEMO_GlobalVar.DEMO_lr_FaultPhase := DEMO_GlobalVar.DEMO_lr_FaultPhase + DEMO_GlobalVar.DEMO_lr_Dt;
IF DEMO_GlobalVar.DEMO_lr_FaultPhase >= DEMO_GlobalConst.DEMO_lr_FAULT_PERIOD THEN
	DEMO_GlobalVar.DEMO_lr_FaultPhase := DEMO_GlobalVar.DEMO_lr_FaultPhase - DEMO_GlobalConst.DEMO_lr_FAULT_PERIOD;
END_IF


(****************************************************************************************************)
(* APPLICATIONS                                                                                     *)
(****************************************************************************************************)
P_VisuDemoDelta();
P_VisuDemoFxx();
P_VisuDemoIdh();
P_VisuDemoCartesian();
P_VisuDemoCartesianAxes();
P_VisuDemoSpacing();
P_VisuDemoStress();


(****************************************************************************************************)
(* MACHINE                                                                                          *)
(****************************************************************************************************)
fb_Machine.m_Register(vio_Machine := GVL_Visu.stMachine);
fb_Machine.m_SetRunState(vi_e_RunState := E_VisuRunState.RUNNING, vi_str_Text := '');
fb_Machine.m_SetSimulation(vi_b_Simulation := TRUE);
fb_Machine.m_SetMessage(vi_udn_Id := udn_MSG_REJECT_BIN,
	vi_b_Active := DEMO_GlobalVar.DEMO_lr_FaultPhase < lr_MSG_DURATION, vi_e_Severity := E_VisuMessageSeverity.WARNING,
	vi_str_Text := 'Reject bin almost full', vi_udn_ComponentId := udn_REJECT_UNIT_ID);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>