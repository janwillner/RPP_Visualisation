<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="P_VisuDemo" Id="{9c322b9e-43d2-4df2-a828-473efb6d02d1}" SpecialFunc="None">
    <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
DEMO ONLY: five independent sample applications side by side, for testing the gateway over ADS. All lines<br>
start at X = 0 and convey along +X.<br>
- Delta application (Y = 0..1000): two infeed conveyors (Y = 0 and Y = 1000) and an outfeed between them<br>
  (Y = 500), three Delta robots one after another (X = 1500, 2500, 3500) picking from the infeeds and placing<br>
  onto the outfeed. Some products are deliberately missed. Each Delta has a different gripper:<br>
  Delta 1 two suction cups beside the flange that turn about Rz; it picks two products and places both at once.<br>
  Delta 2 one finger that turns about Rz and tilts about Rx while carrying.<br>
  Delta 3 five fingers around the flange that close when picking and open when placing.<br>
- Fxx application (Y = 2500): products arrive irregularly on the Fxx infeed; an XTS loop takes them over and<br>
  puts them onto the Fxx outfeed with an even spacing.<br>
- IDH application (Y = 4100..4850): an XTS gantry with four movers picks products from the IDH infeed in<br>
  batches and places them onto the tray belt.<br>
- Cartesian application (Y = 6500..7300): a Cartesian robot picks products from the Cartesian infeed, turns<br>
  them by C = -90 deg, tilts them by A while lowering and places them onto the Cartesian outfeed.<br>
- Spacing application (Y = 9000): an XTS loop under one belt takes over products arriving with random gaps and<br>
  hands them back to the belt with a constant pitch.<br>
Part of the demo application Syn_Visu_Demo, which uses the Syn_Visu library like any machine project.<br>
****************************************************************************************************)
PROGRAM P_VisuDemo
VAR
	(* Delta application *)
	fb_Infeed1							: _FB_VisuConveyor;
	fb_Infeed2							: _FB_VisuConveyor;
	fb_Outfeed							: _FB_VisuConveyor;
	fb_Delta1							: _FB_VisuDelta;
	fb_Delta2							: _FB_VisuDelta;
	fb_Delta3							: _FB_VisuDelta;
	(* Fxx application *)
	fb_FxxInfeed						: _FB_VisuConveyor;
	fb_FxxOutfeed						: _FB_VisuConveyor;
	fb_Fxx								: _FB_VisuXtsLoop;
	(* IDH application *)
	fb_IdhInfeed						: _FB_VisuConveyor;
	fb_IdhTray							: _FB_VisuConveyor;
	fb_Idh								: _FB_VisuXtsGantry;
	(* Cartesian application *)
	fb_CartInfeed						: _FB_VisuConveyor;
	fb_CartOutfeed						: _FB_VisuConveyor;
	fb_Cartesian						: _FB_VisuCartesian;

	(* Common *)
	dn_TaskIndex						: DINT;
	lr_Dt								: LREAL;	// [s] cycle time
	udn_NextId							: UDINT := 1;	// [-] next product id
	udn_Seed							: UDINT := 12345;	// [-] pseudo random generator state
	(* [mm] infeed 1, infeed 2, outfeed, Fxx infeed, Fxx outfeed, IDH infeed, tray belt, Cartesian infeed and outfeed *)
	lr_BeltPosition						: ARRAY[0..8] OF LREAL;
	(* [s] since the last product per spawning belt: infeed 1, infeed 2, Fxx infeed, IDH infeed, Cartesian infeed *)
	lr_SinceSpawn						: ARRAY[0..4] OF LREAL := [0, 0.3, 0, 0, 0];
	lr_SpawnInterval					: ARRAY[0..4] OF LREAL := [0.6, 0.6, 0.6, 0.8, 2.5];	// [s]
	fb_RefBelt							: REFERENCE TO _FB_VisuConveyor;
	BeltPose							: ST_VisuPose;
	LatchPose							: ST_VisuPlanarPose;
	n_Belt								: INT;
	lr_Length							: LREAL;	// [mm]
	lr_Random							: LREAL;	// [-] 0..1
	lr_FaultPhase						: LREAL;	// [s] 0..lr_FAULT_PERIOD, drives the demo faults

	(* Per Delta robot *)
	n_Phase								: ARRAY[0..2] OF INT;
	udn_TargetId						: ARRAY[0..2] OF UDINT;	// [-] product being approached, 0 = none
	n_TargetBelt						: ARRAY[0..2] OF INT;	// [-] 0 = infeed 1, 1 = infeed 2
	Tcp									: ARRAY[0..2] OF ST_VisuPosition;	// the gripper flange
	b_TcpInitialised					: ARRAY[0..2] OF BOOL;
	lr_ToolRz							: ARRAY[0..2] OF LREAL;	// [deg] tool rotation about MCS Z (4th axis)
	udn_Held							: ARRAY[0..2, 0..1] OF UDINT;	// [-] carried product ids per slot (Delta 1 carries two)
	n_HeldBelt							: ARRAY[0..2, 0..1] OF INT;	// [-] infeed of each carried product: 0 = infeed 1, 1 = infeed 2
	n_HeldCount							: ARRAY[0..2] OF INT;
	lr_TiltRx							: LREAL;	// [deg] Delta 2: finger tilt about its X
	lr_Spread							: LREAL := 130;	// [mm] Delta 3: finger distance from the flange
	n_Finger							: INT;	// [-] finger used for the current pick, 0 = the flange
	n_FingerCount						: INT;
	n_Slot								: INT;
	lr_GripHeight						: LREAL;	// [mm] flange above the grip point of the finger used
	Grip								: ST_VisuPosition;	// MCS offset flange -> grip point of the finger used
	fb_RefRobot							: REFERENCE TO _FB_VisuDelta;
	BasePose							: ST_VisuPose;
	Product								: ST_VisuProduct;
	ProductPose							: ST_VisuPlanarPose;
	SetpointTcp							: ST_VisuPosition;
	b_Found								: BOOL;
	n_Robot								: INT;
	un_Index							: UINT;
	lr_BaseX							: LREAL;	// [mm]
	lr_Step								: LREAL;	// [mm] TCP travel per cycle
	lr_X								: LREAL;	// [mm] target
	lr_Y								: LREAL;	// [mm] target
	lr_TopZ								: LREAL;	// [mm] top of the target product
	lr_TargetRz							: LREAL;	// [deg]

	(* XTS loop (Fxx): unwrapped track position per mover; queued movers wait just before the perimeter (= 0). *)
	b_LoopInitialised					: BOOL;
	lr_LoopS							: ARRAY[0..11] OF LREAL;	// [mm]
	n_LoopMode							: ARRAY[0..11] OF INT;
	udn_LoopProduct						: ARRAY[0..11] OF UDINT;	// [-] product id on the Fxx infeed
	MoverFingers						: ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFingerState;	// XTS mover finger states

	(* XTS gantry (IDH) *)
	n_GantryPhase						: INT;
	lr_GantryZ							: LREAL;	// [mm]
	lr_GantryWait						: ARRAY[0..3] OF LREAL := [100, 300, 500, 700];	// [mm]
	lr_GantryPos						: ARRAY[0..3] OF LREAL := [100, 300, 500, 700];	// [mm]
	lr_GantryX							: ARRAY[0..3] OF LREAL := [200, 200, 200, 200];	// [mm]
	lr_GantryC							: ARRAY[0..3] OF LREAL;	// [deg]
	b_GantryGrip						: ARRAY[0..3] OF BOOL;
	udn_GantryProduct					: ARRAY[0..3] OF UDINT;	// [-] product id on the IDH infeed
	XtsPose								: ST_VisuPose;

	(* Cartesian robot: axis actual values, start above the infeed *)
	n_CartPhase							: INT;
	lr_CartX							: LREAL := 900;	// [mm]
	lr_CartY							: LREAL := 200;	// [mm]
	lr_CartZ							: LREAL := -200;	// [mm]
	lr_CartC							: LREAL;	// [deg]
	lr_CartA							: LREAL;	// [deg]
	lr_CartPickC						: LREAL;	// [deg] C that turns the gripper onto the current product
	lr_CartJaw							: LREAL := 120;	// [mm] jaw distance from the cup along the gripper's X
	b_CartGrip							: BOOL;
	udn_CartProduct						: UDINT;	// [-] product id on the Cartesian infeed
	CartPose							: ST_VisuPose;

	(* Spacing application: XTS loop under one belt *)
	fb_SpcBelt							: _FB_VisuConveyor;
	fb_Spc								: _FB_VisuXtsLoop;
	lr_SpcBeltPosition					: LREAL;	// [mm]
	lr_SpcSinceSpawn					: LREAL;	// [s]
	lr_SpcSpawnInterval					: LREAL := 1;	// [s]
	b_SpcInitialised					: BOOL;
	lr_SpcS								: ARRAY[0..7] OF LREAL;	// [mm] track position per mover (n_SPC_MOVERS)
	n_SpcMode							: ARRAY[0..7] OF INT;
	udn_SpcProduct						: ARRAY[0..7] OF UDINT;	// [-] product pushed by the mover, 0 = none
	udn_SpcLastReleased					: UDINT;	// [-] product last handed back to the belt
	NoFingers							: ARRAY[0..VISU_GlobalConst_Param.VISU_un_MAX_FINGERS - 1] OF ST_VisuFingerState;
END_VAR
VAR CONSTANT
	(* Common *)
	lr_BELT_Z							: LREAL := 800;	// [mm]
	lr_BELT_WIDTH						: LREAL := 400;	// [mm]
	lr_PRODUCT_HEIGHT					: LREAL := 40;	// [mm]
	lr_REMOVE_BEYOND_END				: LREAL := 300;	// [mm]
	(* Demo faults: every lr_FAULT_PERIOD one component or mover is in a fault for lr_FAULT_DURATION. *)
	lr_FAULT_PERIOD						: LREAL := 20;	// [s]
	lr_FAULT_DURATION					: LREAL := 5;	// [s]
	lr_FAULT_DELTA_START				: LREAL := 4;	// [s] start of the Delta 1 fault in the period
	lr_FAULT_LOOP_START					: LREAL := 10;	// [s] start of the Fxx mover 3 fault
	lr_FAULT_GANTRY_START				: LREAL := 12;	// [s] start of the IDH mover 2 fault

	(* Delta application *)
	lr_BELT_LENGTH						: LREAL := 5000;	// [mm]
	lr_INFEED_SPEED						: LREAL := 150;	// [mm/s]
	lr_OUTFEED_SPEED					: LREAL := 120;	// [mm/s]
	lr_INFEED1_Y						: LREAL := 0;	// [mm]
	lr_INFEED2_Y						: LREAL := 1000;	// [mm]
	lr_OUTFEED_Y						: LREAL := 500;	// [mm]
	lr_ROBOT1_X							: LREAL := 1500;	// [mm]
	lr_ROBOT_PITCH						: LREAL := 1000;	// [mm] distance between robots along X
	lr_ROBOT_Y							: LREAL := 500;	// [mm]
	lr_ROBOT_Z							: LREAL := 1900;	// [mm]
	lr_TCP_SPEED						: LREAL := 2500;	// [mm/s]
	lr_HOVER							: LREAL := 120;	// [mm]
	lr_PICK_HALF_ZONE					: LREAL := 400;	// [mm]
	lr_PLACE_HALF_ZONE					: LREAL := 300;	// [mm]
	lr_ALLOCATION_OFFSET				: LREAL := 300;	// [mm] products are allocated only up to this distance before the pick zone end
	lr_LEAD								: LREAL := 7.5;	// [mm] the robot leads the moving product
	(* Grippers. Suction cups (Delta 1, IDH and Fxx movers): the cup's grip point is where the products' tops touch. *)
	lr_CUP_DIAMETER						: LREAL := 40;	// [mm]
	lr_CUP_HEIGHT						: LREAL := 50;	// [mm]
	lr_PAIR_OFFSET						: LREAL := 70;	// [mm] Delta 1: cups on either side of the flange along the tool's X
	lr_TILT_DIAMETER					: LREAL := 30;	// [mm] Delta 2
	lr_TILT_HEIGHT						: LREAL := 90;	// [mm]
	lr_TILT_ANGLE						: LREAL := 25;	// [deg] about Rx while carrying
	lr_TILT_SPEED						: LREAL := 60;	// [deg/s]
	n_RING_FINGERS						: INT := 5;	// [-] Delta 3
	lr_RING_DIAMETER					: LREAL := 16;	// [mm]
	lr_RING_HEIGHT						: LREAL := 40;	// [mm] reaching down to the belt beside a carried product
	lr_SPREAD_OPEN						: LREAL := 130;	// [mm]
	lr_SPREAD_CLOSED					: LREAL := 82;	// [mm] around a 120 x 80 mm product in any orientation
	lr_SPREAD_SPEED						: LREAL := 200;	// [mm/s]
	n_PHASE_IDLE						: INT := 0;
	n_PHASE_APPROACH					: INT := 1;
	n_PHASE_DESCEND						: INT := 2;
	n_PHASE_LIFT						: INT := 3;
	n_PHASE_TRANSFER					: INT := 4;
	n_PHASE_LOWER						: INT := 5;
	n_PHASE_RELEASE						: INT := 6;

	(* Fxx application *)
	lr_FXX_Y							: LREAL := 2500;	// [mm]
	lr_FXX_INFEED_LENGTH				: LREAL := 2000;	// [mm]
	lr_FXX_INFEED_SPEED					: LREAL := 150;	// [mm/s]
	lr_FXX_OUTFEED_X					: LREAL := 2400;	// [mm]
	lr_FXX_OUTFEED_LENGTH				: LREAL := 3000;	// [mm]
	lr_FXX_OUTFEED_SPEED				: LREAL := 300;	// [mm/s]
	lr_LOOP_X							: LREAL := 1000;	// [mm] start of the lower straight above the Fxx infeed
	lr_LOOP_STRAIGHT					: LREAL := 2400;	// [mm]
	lr_LOOP_RADIUS						: LREAL := 250;	// [mm]
	lr_LOOP_TOOL_OFFSET					: LREAL := 120;	// [mm]
	n_LOOP_MOVERS						: INT := 12;	// [-]
	lr_LOOP_SLOT						: LREAL := 130;	// [mm] queue spacing
	lr_LOOP_GRIP						: LREAL := 300;	// [mm] track position where the product is gripped
	lr_LOOP_RELEASE						: LREAL := 600;	// [mm] track position where the mover stops following the infeed
	lr_LOOP_PLACE						: LREAL := 2000;	// [mm] track position of the hand-over to the Fxx outfeed
	lr_LOOP_DELIVER_SPEED				: LREAL := 700;	// [mm/s]
	lr_LOOP_RETURN_SPEED				: LREAL := 900;	// [mm/s]
	n_LOOP_QUEUE						: INT := 0;
	n_LOOP_TRACK						: INT := 1;
	n_LOOP_DELIVER						: INT := 2;
	n_LOOP_RETURN						: INT := 3;

	(* IDH application. Gantry turned by -90 deg: track along MCS +X, X axes towards MCS -Y
	   (IDH infeed under X = 200, tray belt under X = 600). *)
	lr_IDH_INFEED_Y						: LREAL := 4500;	// [mm]
	lr_IDH_INFEED_LENGTH				: LREAL := 4000;	// [mm]
	lr_IDH_INFEED_SPEED					: LREAL := 200;	// [mm/s]
	lr_TRAY_X							: LREAL := 1300;	// [mm]
	lr_TRAY_Y							: LREAL := 4100;	// [mm]
	lr_TRAY_LENGTH						: LREAL := 2000;	// [mm]
	lr_TRAY_SPEED						: LREAL := 80;	// [mm/s]
	lr_GANTRY_X							: LREAL := 1500;	// [mm]
	lr_GANTRY_Y							: LREAL := 4850;	// [mm]
	lr_GANTRY_Z							: LREAL := 1340;	// [mm]
	un_GANTRY_MODULES					: UINT := 6;	// [-]
	lr_GANTRY_MODULE_LENGTH				: LREAL := 250;	// [mm]
	lr_GANTRY_TOOL_X					: LREAL := 150;	// [mm]
	lr_GANTRY_TOOL_Z					: LREAL := -400;	// [mm]
	lr_GANTRY_MOVER_LENGTH				: LREAL := 155;	// [mm]
	lr_GANTRY_GAP						: LREAL := 180;	// [mm] minimum distance between movers
	lr_GANTRY_X_BELT					: LREAL := 200;	// [mm]
	lr_GANTRY_X_TRAY					: LREAL := 600;	// [mm]
	lr_GANTRY_Z_DOWN					: LREAL := -100;	// [mm]
	lr_GANTRY_Z_SPEED					: LREAL := 500;	// [mm/s]
	lr_GANTRY_X_SPEED					: LREAL := 1000;	// [mm/s]
	lr_GANTRY_TRACK_SPEED				: LREAL := 1500;	// [mm/s]
	n_GANTRY_COLLECT					: INT := 0;
	n_GANTRY_PICK_DOWN					: INT := 1;
	n_GANTRY_PICK_UP					: INT := 2;
	n_GANTRY_TO_TRAY					: INT := 3;
	n_GANTRY_PLACE_DOWN					: INT := 4;
	n_GANTRY_PLACE_UP					: INT := 5;
	n_GANTRY_RETURN						: INT := 6;

	(* Cartesian application. Robot turned by -90 deg: X axis across the belts towards MCS -Y (outfeed under
	   X = 100, infeed under X = 900), Y axis along MCS +X from X = 1000. *)
	lr_CART_INFEED_Y					: LREAL := 6500;	// [mm]
	lr_CART_OUTFEED_Y					: LREAL := 7300;	// [mm]
	lr_CART_BELT_LENGTH					: LREAL := 3000;	// [mm]
	lr_CART_BELT_SPEED					: LREAL := 150;	// [mm/s]
	lr_CART_X							: LREAL := 1000;	// [mm]
	lr_CART_Y							: LREAL := 7400;	// [mm]
	lr_CART_Z							: LREAL := 1540;	// [mm] Z = -550 puts the cup's grip point (A = 0) on the product top
	lr_CART_TOOL_LENGTH					: LREAL := 150;	// [mm] flange to the cup's grip point
	lr_CART_CUP_HEIGHT					: LREAL := 40;	// [mm]
	lr_CART_JAW_DIAMETER				: LREAL := 20;	// [mm]
	lr_CART_JAW_HEIGHT					: LREAL := 120;	// [mm]
	lr_CART_JAW_TOP						: LREAL := 60;	// [mm] jaw tops below the flange
	lr_CART_JAW_OPEN					: LREAL := 120;	// [mm]
	lr_CART_JAW_CLOSED					: LREAL := 70;	// [mm] closed on a 120 mm product
	lr_CART_JAW_SPEED					: LREAL := 300;	// [mm/s]
	lr_CART_RAIL_HEIGHT					: LREAL := 1200;	// [mm]
	lr_CART_X_OUTFEED					: LREAL := 100;	// [mm]
	lr_CART_X_INFEED					: LREAL := 900;	// [mm]
	lr_CART_Y_HOME						: LREAL := 200;	// [mm]
	lr_CART_Y_PLACE						: LREAL := 500;	// [mm]
	lr_CART_Z_PICK						: LREAL := -550;	// [mm]
	lr_CART_Z_TRAVEL					: LREAL := -200;	// [mm]
	lr_CART_TILT						: LREAL := 20;	// [deg] A while lowering
	lr_CART_TURN						: LREAL := -90;	// [deg] C between pick and place
	lr_CART_XY_SPEED					: LREAL := 1500;	// [mm/s]
	lr_CART_Z_SPEED						: LREAL := 800;	// [mm/s]
	lr_CART_C_SPEED						: LREAL := 180;	// [deg/s]
	lr_CART_A_SPEED						: LREAL := 60;	// [deg/s]
	n_CART_IDLE							: INT := 0;
	n_CART_DESCEND						: INT := 1;
	n_CART_LIFT							: INT := 2;
	n_CART_TRANSFER						: INT := 3;
	n_CART_LOWER						: INT := 4;
	n_CART_STRAIGHTEN					: INT := 5;
	n_CART_RELEASE						: INT := 6;
	n_CART_RISE							: INT := 7;

	(* Spacing application. Loop turned by 180 deg under the belt: its upper straight runs along MCS +X from
	   X = 1000 to X = 4000, the movers' tool points at the belt surface. *)
	lr_SPC_Y							: LREAL := 9000;	// [mm]
	lr_SPC_BELT_LENGTH					: LREAL := 5000;	// [mm]
	lr_SPC_BELT_SPEED					: LREAL := 150;	// [mm/s]
	lr_SPC_LOOP_END_X					: LREAL := 4000;	// [mm] MCS x of the loop origin, the downstream end
	lr_SPC_STRAIGHT						: LREAL := 3000;	// [mm]
	lr_SPC_RADIUS						: LREAL := 150;	// [mm]
	lr_SPC_TOOL_OFFSET					: LREAL := 110;	// [mm] tool point outwards from the track: the belt surface
	n_SPC_MOVERS						: INT := 8;	// [-] size of the lr_SpcS, n_SpcMode and udn_SpcProduct arrays
	lr_SPC_SLOT							: LREAL := 130;	// [mm] queue spacing and minimum mover distance
	lr_SPC_TAKE_WINDOW					: LREAL := 40;	// [mm] take-over window from the start of the upper straight
	lr_SPC_PITCH						: LREAL := 200;	// [mm] constant product pitch on the outfeed
	lr_SPC_PUSH_SPEED					: LREAL := 450;	// [mm/s] maximum speed of a pushing mover
	lr_SPC_RETURN_SPEED					: LREAL := 900;	// [mm/s]
	lr_SPC_RELEASE_MIN_X				: LREAL := 2000;	// [mm] products are handed back to the belt from here...
	lr_SPC_RELEASE_MAX_X				: LREAL := 3800;	// [mm] ...up to here at the latest
	n_SPC_QUEUE							: INT := 0;
	n_SPC_PUSH							: INT := 1;
	n_SPC_RETURN						: INT := 2;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(****************************************************************************************************)
(* CYCLE TIME                                                                                       *)
(****************************************************************************************************)
dn_TaskIndex := Tc2_System.GETCURTASKINDEXEX();
IF dn_TaskIndex > 0 THEN
	lr_Dt := UDINT_TO_LREAL(TwinCAT_SystemInfoVarList._TaskInfo[dn_TaskIndex].CycleTime) * 1.0E-7;
ELSE
	lr_Dt := 0.01;
END_IF
lr_Step := lr_TCP_SPEED * lr_Dt;
lr_FaultPhase := lr_FaultPhase + lr_Dt;
IF lr_FaultPhase >= lr_FAULT_PERIOD THEN
	lr_FaultPhase := lr_FaultPhase - lr_FAULT_PERIOD;
END_IF


(****************************************************************************************************)
(* REGISTRATION (idempotent, every cycle)                                                           *)
(****************************************************************************************************)
fb_Infeed1.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 1, vi_str_Name := 'Infeed 1',
	vi_str_Path := 'P_VisuDemo.fb_Infeed1.vo_Visu');
fb_Infeed2.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 2, vi_str_Name := 'Infeed 2',
	vi_str_Path := 'P_VisuDemo.fb_Infeed2.vo_Visu');
fb_Outfeed.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 3, vi_str_Name := 'Outfeed',
	vi_str_Path := 'P_VisuDemo.fb_Outfeed.vo_Visu');
fb_Delta1.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 10, vi_str_Name := 'Delta 1',
	vi_str_Path := 'P_VisuDemo.fb_Delta1.vo_Visu');
fb_Delta2.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 11, vi_str_Name := 'Delta 2',
	vi_str_Path := 'P_VisuDemo.fb_Delta2.vo_Visu');
fb_Delta3.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 12, vi_str_Name := 'Delta 3',
	vi_str_Path := 'P_VisuDemo.fb_Delta3.vo_Visu');
fb_FxxInfeed.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 4, vi_str_Name := 'Fxx infeed',
	vi_str_Path := 'P_VisuDemo.fb_FxxInfeed.vo_Visu');
fb_FxxOutfeed.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 5, vi_str_Name := 'Fxx outfeed',
	vi_str_Path := 'P_VisuDemo.fb_FxxOutfeed.vo_Visu');
fb_Fxx.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 20, vi_str_Name := 'Fxx',
	vi_str_Path := 'P_VisuDemo.fb_Fxx.vo_Visu');
fb_IdhInfeed.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 6, vi_str_Name := 'IDH infeed',
	vi_str_Path := 'P_VisuDemo.fb_IdhInfeed.vo_Visu');
fb_IdhTray.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 7, vi_str_Name := 'Tray belt',
	vi_str_Path := 'P_VisuDemo.fb_IdhTray.vo_Visu');
fb_Idh.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 30, vi_str_Name := 'IDH',
	vi_str_Path := 'P_VisuDemo.fb_Idh.vo_Visu');
fb_CartInfeed.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 8, vi_str_Name := 'Cartesian infeed',
	vi_str_Path := 'P_VisuDemo.fb_CartInfeed.vo_Visu');
fb_CartOutfeed.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 9, vi_str_Name := 'Cartesian outfeed',
	vi_str_Path := 'P_VisuDemo.fb_CartOutfeed.vo_Visu');
fb_Cartesian.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 40, vi_str_Name := 'Cartesian',
	vi_str_Path := 'P_VisuDemo.fb_Cartesian.vo_Visu');
fb_SpcBelt.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 13, vi_str_Name := 'Spacing belt',
	vi_str_Path := 'P_VisuDemo.fb_SpcBelt.vo_Visu');
fb_Spc.m_Register(vio_Manifest := GVL_Visu.stManifest, vi_udn_Id := 21, vi_str_Name := 'Spacer',
	vi_str_Path := 'P_VisuDemo.fb_Spc.vo_Visu');


(****************************************************************************************************)
(* CONVEYORS (configuration idempotent, every cycle)                                                *)
(****************************************************************************************************)
BeltPose.fZ := lr_BELT_Z;
FOR n_Belt := 0 TO 8 DO
	BeltPose.fX := 0;
	lr_Length := lr_BELT_LENGTH;
	CASE n_Belt OF
		0: fb_RefBelt REF= fb_Infeed1; BeltPose.fY := lr_INFEED1_Y;
		1: fb_RefBelt REF= fb_Infeed2; BeltPose.fY := lr_INFEED2_Y;
		2: fb_RefBelt REF= fb_Outfeed; BeltPose.fY := lr_OUTFEED_Y;
		3: fb_RefBelt REF= fb_FxxInfeed; BeltPose.fY := lr_FXX_Y; lr_Length := lr_FXX_INFEED_LENGTH;
		4: fb_RefBelt REF= fb_FxxOutfeed; BeltPose.fX := lr_FXX_OUTFEED_X; BeltPose.fY := lr_FXX_Y; lr_Length := lr_FXX_OUTFEED_LENGTH;
		5: fb_RefBelt REF= fb_IdhInfeed; BeltPose.fY := lr_IDH_INFEED_Y; lr_Length := lr_IDH_INFEED_LENGTH;
		6: fb_RefBelt REF= fb_IdhTray; BeltPose.fX := lr_TRAY_X; BeltPose.fY := lr_TRAY_Y; lr_Length := lr_TRAY_LENGTH;
		7: fb_RefBelt REF= fb_CartInfeed; BeltPose.fY := lr_CART_INFEED_Y; lr_Length := lr_CART_BELT_LENGTH;
	ELSE
		fb_RefBelt REF= fb_CartOutfeed; BeltPose.fY := lr_CART_OUTFEED_Y; lr_Length := lr_CART_BELT_LENGTH;
	END_CASE
	fb_RefBelt.m_Configure(vi_Pose := BeltPose, vi_lr_Length := lr_Length, vi_lr_Width := lr_BELT_WIDTH);
	fb_RefBelt.m_SetProductType(vi_udn_Id := 1, vi_lr_Length := 120, vi_lr_Width := 80, vi_lr_Height := lr_PRODUCT_HEIGHT);
END_FOR

(* Belt travel *)
lr_BeltPosition[0] := lr_BeltPosition[0] + lr_INFEED_SPEED * lr_Dt;
lr_BeltPosition[1] := lr_BeltPosition[1] + lr_INFEED_SPEED * lr_Dt;
lr_BeltPosition[2] := lr_BeltPosition[2] + lr_OUTFEED_SPEED * lr_Dt;
lr_BeltPosition[3] := lr_BeltPosition[3] + lr_FXX_INFEED_SPEED * lr_Dt;
lr_BeltPosition[4] := lr_BeltPosition[4] + lr_FXX_OUTFEED_SPEED * lr_Dt;
lr_BeltPosition[5] := lr_BeltPosition[5] + lr_IDH_INFEED_SPEED * lr_Dt;
lr_BeltPosition[6] := lr_BeltPosition[6] + lr_TRAY_SPEED * lr_Dt;
lr_BeltPosition[7] := lr_BeltPosition[7] + lr_CART_BELT_SPEED * lr_Dt;
lr_BeltPosition[8] := lr_BeltPosition[8] + lr_CART_BELT_SPEED * lr_Dt;
fb_Infeed1.m_SetBeltPosition(lr_BeltPosition[0]);
fb_Infeed2.m_SetBeltPosition(lr_BeltPosition[1]);
fb_Outfeed.m_SetBeltPosition(lr_BeltPosition[2]);
fb_FxxInfeed.m_SetBeltPosition(lr_BeltPosition[3]);
fb_FxxOutfeed.m_SetBeltPosition(lr_BeltPosition[4]);
fb_IdhInfeed.m_SetBeltPosition(lr_BeltPosition[5]);
fb_IdhTray.m_SetBeltPosition(lr_BeltPosition[6]);
fb_CartInfeed.m_SetBeltPosition(lr_BeltPosition[7]);
fb_CartOutfeed.m_SetBeltPosition(lr_BeltPosition[8]);


(****************************************************************************************************)
(* PRODUCT INFEED: infeed 1 and 2 (Delta), Fxx infeed (irregular), IDH infeed, Cartesian infeed     *)
(****************************************************************************************************)
FOR n_Belt := 0 TO 4 DO
	lr_SinceSpawn[n_Belt] := lr_SinceSpawn[n_Belt] + lr_Dt;
	IF lr_SinceSpawn[n_Belt] >= lr_SpawnInterval[n_Belt] THEN
		lr_SinceSpawn[n_Belt] := 0;
		udn_Seed := udn_Seed * 1103515245 + 12345;
		lr_Random := UDINT_TO_LREAL(udn_Seed MOD 1000) / 1000.0;
		LatchPose.fX := 100;
		LatchPose.fZ := lr_BELT_Z;
		LatchPose.fRz := (UDINT_TO_LREAL((udn_Seed / 1000) MOD 1000) / 1000.0 - 0.5) * 60.0;
		CASE n_Belt OF
			0: fb_RefBelt REF= fb_Infeed1; LatchPose.fY := lr_INFEED1_Y + (lr_Random - 0.5) * 160.0;
			1: fb_RefBelt REF= fb_Infeed2; LatchPose.fY := lr_INFEED2_Y + (lr_Random - 0.5) * 160.0;
			2:
				(* Irregular gaps: the Fxx evens them out. *)
				fb_RefBelt REF= fb_FxxInfeed;
				LatchPose.fY := lr_FXX_Y;
				LatchPose.fRz := 0;
				lr_SpawnInterval[2] := 0.4 + lr_Random * 1.2;
			3:
				fb_RefBelt REF= fb_IdhInfeed;
				LatchPose.fY := lr_IDH_INFEED_Y;
				lr_SpawnInterval[3] := 0.6 + lr_Random * 0.6;
		ELSE
			fb_RefBelt REF= fb_CartInfeed;
			LatchPose.fY := lr_CART_INFEED_Y;
		END_CASE
		IF fb_RefBelt.m_LatchProduct(vi_udn_Id := udn_NextId, vi_LatchPose := LatchPose, vi_udn_ProductType := 1) THEN
			udn_NextId := udn_NextId + 1;
		END_IF
	END_IF
END_FOR


(****************************************************************************************************)
(* DELTA APPLICATION                                                                                *)
(****************************************************************************************************)
m_StepDelta();


(****************************************************************************************************)
(* FXX APPLICATION                                                                                  *)
(****************************************************************************************************)
XtsPose.fX := lr_LOOP_X;
XtsPose.fY := lr_FXX_Y;
XtsPose.fZ := lr_BELT_Z + lr_PRODUCT_HEIGHT + lr_LOOP_TOOL_OFFSET;
XtsPose.fRz := 0;
(* The flange sits one cup height closer to the track, so the cup's grip point is at the products' tops. *)
fb_Fxx.m_Configure(vi_Pose := XtsPose, vi_lr_StraightLength := lr_LOOP_STRAIGHT, vi_lr_CurveRadius := lr_LOOP_RADIUS,
	vi_lr_ToolOffset := lr_LOOP_TOOL_OFFSET - lr_CUP_HEIGHT, vi_lr_MoverLength := 100, vi_lr_MoverWidth := 60);
fb_Fxx.m_SetFinger(vi_un_Finger := 1, vi_lr_Diameter := lr_CUP_DIAMETER, vi_lr_Height := lr_CUP_HEIGHT);
fb_Fxx.m_SetZone(vi_udn_ConveyorId := fb_FxxInfeed.m_Id(), vi_e_Kind := E_VisuZoneKind.PICK, vi_lr_Start := lr_LOOP_X,
	vi_lr_End := lr_LOOP_X + lr_LOOP_RELEASE);
fb_Fxx.m_SetZone(vi_udn_ConveyorId := fb_FxxOutfeed.m_Id(), vi_e_Kind := E_VisuZoneKind.PLACE,
	vi_lr_Start := lr_LOOP_X + lr_LOOP_PLACE - lr_FXX_OUTFEED_X - 300,
	vi_lr_End := lr_LOOP_X + lr_LOOP_PLACE - lr_FXX_OUTFEED_X + 100);
m_StepLoop();


(****************************************************************************************************)
(* IDH APPLICATION                                                                                  *)
(****************************************************************************************************)
XtsPose.fX := lr_GANTRY_X;
XtsPose.fY := lr_GANTRY_Y;
XtsPose.fZ := lr_GANTRY_Z;
XtsPose.fRz := -90;
fb_Idh.m_Configure(vi_Pose := XtsPose, vi_un_ModuleCount := un_GANTRY_MODULES, vi_lr_ModuleLength := lr_GANTRY_MODULE_LENGTH,
	vi_lr_XMin := 0, vi_lr_XMax := 700, vi_lr_ZMin := lr_GANTRY_Z_DOWN, vi_lr_ZMax := 0,
	vi_lr_ToolOffsetX := lr_GANTRY_TOOL_X, vi_lr_ToolOffsetZ := lr_GANTRY_TOOL_Z + lr_CUP_HEIGHT,
	vi_lr_MoverLength := lr_GANTRY_MOVER_LENGTH, vi_lr_MoverWidth := 80);
fb_Idh.m_SetFinger(vi_un_Finger := 1, vi_lr_Diameter := lr_CUP_DIAMETER, vi_lr_Height := lr_CUP_HEIGHT);
fb_Idh.m_SetZone(vi_udn_ConveyorId := fb_IdhInfeed.m_Id(), vi_e_Kind := E_VisuZoneKind.PICK, vi_lr_Start := lr_GANTRY_X,
	vi_lr_End := lr_GANTRY_X + UINT_TO_LREAL(un_GANTRY_MODULES) * lr_GANTRY_MODULE_LENGTH);
fb_Idh.m_SetZone(vi_udn_ConveyorId := fb_IdhTray.m_Id(), vi_e_Kind := E_VisuZoneKind.PLACE,
	vi_lr_Start := lr_GANTRY_X - lr_TRAY_X,
	vi_lr_End := lr_GANTRY_X - lr_TRAY_X + UINT_TO_LREAL(un_GANTRY_MODULES) * lr_GANTRY_MODULE_LENGTH);
m_StepGantry();


(****************************************************************************************************)
(* CARTESIAN APPLICATION                                                                            *)
(****************************************************************************************************)
CartPose.fX := lr_CART_X;
CartPose.fY := lr_CART_Y;
CartPose.fZ := lr_CART_Z;
CartPose.fRz := -90;
fb_Cartesian.m_Configure(vi_Pose := CartPose, vi_lr_XMin := 0, vi_lr_XMax := 1200, vi_lr_YMin := 0, vi_lr_YMax := 1000,
	vi_lr_ZMin := -600, vi_lr_ZMax := 0, vi_lr_RailHeight := lr_CART_RAIL_HEIGHT);
(* A cup in the middle carries the product, two jaws close beside it. *)
fb_Cartesian.m_SetFinger(vi_un_Finger := 1, vi_lr_Diameter := lr_CUP_DIAMETER, vi_lr_Height := lr_CART_CUP_HEIGHT);
fb_Cartesian.m_SetFinger(vi_un_Finger := 2, vi_lr_Diameter := lr_CART_JAW_DIAMETER, vi_lr_Height := lr_CART_JAW_HEIGHT);
fb_Cartesian.m_SetFinger(vi_un_Finger := 3, vi_lr_Diameter := lr_CART_JAW_DIAMETER, vi_lr_Height := lr_CART_JAW_HEIGHT);
fb_Cartesian.m_SetZone(vi_udn_ConveyorId := fb_CartInfeed.m_Id(), vi_e_Kind := E_VisuZoneKind.PICK,
	vi_lr_Start := lr_CART_X, vi_lr_End := lr_CART_X + 1000);
fb_Cartesian.m_SetZone(vi_udn_ConveyorId := fb_CartOutfeed.m_Id(), vi_e_Kind := E_VisuZoneKind.PLACE,
	vi_lr_Start := lr_CART_X + lr_CART_Y_PLACE - 200, vi_lr_End := lr_CART_X + lr_CART_Y_PLACE + 200);
m_StepCartesian();
fb_Cartesian.m_SetAxes(vi_lr_X := lr_CartX, vi_lr_Y := lr_CartY, vi_lr_Z := lr_CartZ, vi_b_GripperActive := b_CartGrip);

(* C and A turn and tilt the gripper below the flange; they show only through the finger poses. *)
lr_CartJaw := m_Approach(lr_CartJaw, SEL(b_CartGrip, lr_CART_JAW_OPEN, lr_CART_JAW_CLOSED), lr_CART_JAW_SPEED * lr_Dt);
fb_Cartesian.m_SetFingerState(vi_un_Finger := 1,
	vi_Pose := m_CartFinger(vi_lr_OffsetX := 0, vi_lr_OffsetZ := -(lr_CART_TOOL_LENGTH - lr_CART_CUP_HEIGHT)),
	vi_b_Active := b_CartGrip);
fb_Cartesian.m_SetFingerState(vi_un_Finger := 2,
	vi_Pose := m_CartFinger(vi_lr_OffsetX := lr_CartJaw, vi_lr_OffsetZ := -lr_CART_JAW_TOP),
	vi_b_Active := b_CartGrip);
fb_Cartesian.m_SetFingerState(vi_un_Finger := 3,
	vi_Pose := m_CartFinger(vi_lr_OffsetX := -lr_CartJaw, vi_lr_OffsetZ := -lr_CART_JAW_TOP),
	vi_b_Active := b_CartGrip);


(****************************************************************************************************)
(* SPACING APPLICATION                                                                              *)
(****************************************************************************************************)
m_StepSpacing();


(****************************************************************************************************)
(* HOUSEKEEPING                                                                                     *)
(****************************************************************************************************)
(* Drop register entries some distance beyond the belt end, so "missed" stays visible briefly. *)
fb_Infeed1.m_RemoveProductsBeyond(lr_BELT_LENGTH + lr_REMOVE_BEYOND_END);
fb_Infeed2.m_RemoveProductsBeyond(lr_BELT_LENGTH + lr_REMOVE_BEYOND_END);
fb_Outfeed.m_RemoveProductsBeyond(lr_BELT_LENGTH + lr_REMOVE_BEYOND_END);
fb_FxxInfeed.m_RemoveProductsBeyond(lr_FXX_INFEED_LENGTH + lr_REMOVE_BEYOND_END);
fb_FxxOutfeed.m_RemoveProductsBeyond(lr_FXX_OUTFEED_LENGTH + lr_REMOVE_BEYOND_END);
fb_IdhInfeed.m_RemoveProductsBeyond(lr_IDH_INFEED_LENGTH + lr_REMOVE_BEYOND_END);
fb_IdhTray.m_RemoveProductsBeyond(lr_TRAY_LENGTH + lr_REMOVE_BEYOND_END);
fb_CartInfeed.m_RemoveProductsBeyond(lr_CART_BELT_LENGTH + lr_REMOVE_BEYOND_END);
fb_CartOutfeed.m_RemoveProductsBeyond(lr_CART_BELT_LENGTH + lr_REMOVE_BEYOND_END);]]></ST>
    </Implementation>
    <Method Name="m_Approach" Id="{dba73632-578c-4a71-b044-3b619fedb3c2}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves vi_lr_Value towards vi_lr_Goal by at most vi_lr_Step. Lands exactly on the goal.<br>
****************************************************************************************************)
METHOD PRIVATE m_Approach : LREAL
VAR_INPUT
	vi_lr_Value							: LREAL;
	vi_lr_Goal							: LREAL;
	vi_lr_Step							: LREAL;	// >= 0
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ABS(vi_lr_Goal - vi_lr_Value) <= vi_lr_Step THEN
	m_Approach := vi_lr_Goal;
ELSIF vi_lr_Goal > vi_lr_Value THEN
	m_Approach := vi_lr_Value + vi_lr_Step;
ELSE
	m_Approach := vi_lr_Value - vi_lr_Step;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_CartFinger" Id="{1ad8a077-a686-4815-916c-7f6c6302919c}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Pose of a Cartesian gripper finger, absolute in the MCS: the finger sits at (vi_lr_OffsetX, 0, vi_lr_OffsetZ) in<br>
the gripper, which is turned by C about Z and tilted by A about its own X below the flange. The robot is<br>
turned by -90 deg: local (x, y, z) is MCS (lr_CART_X + y, lr_CART_Y - x, lr_CART_Z + z).<br>
****************************************************************************************************)
METHOD PRIVATE m_CartFinger : ST_VisuPose
VAR_INPUT
	vi_lr_OffsetX						: LREAL;	// [mm] along the gripper's X
	vi_lr_OffsetZ						: LREAL;	// [mm] below the flange: negative
END_VAR
VAR
	lr_TempA							: LREAL;	// [rad]
	lr_TempC							: LREAL;	// [rad]
	lr_TempVx							: LREAL;	// [mm] offset in the robot frame
	lr_TempVy							: LREAL;	// [mm]
	lr_TempVz							: LREAL;	// [mm]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[lr_TempA := lr_CartA * VISU_GlobalConst.VISU_lr_DEG_TO_RAD;
lr_TempC := lr_CartC * VISU_GlobalConst.VISU_lr_DEG_TO_RAD;
(* Rz(C) * Rx(A) * (x, 0, z) *)
lr_TempVx := vi_lr_OffsetX * COS(lr_TempC) + vi_lr_OffsetZ * SIN(lr_TempA) * SIN(lr_TempC);
lr_TempVy := vi_lr_OffsetX * SIN(lr_TempC) - vi_lr_OffsetZ * SIN(lr_TempA) * COS(lr_TempC);
lr_TempVz := vi_lr_OffsetZ * COS(lr_TempA);
m_CartFinger.fX := lr_CART_X + (lr_CartY + lr_TempVy);
m_CartFinger.fY := lr_CART_Y - (lr_CartX + lr_TempVx);
m_CartFinger.fZ := lr_CART_Z + (lr_CartZ + lr_TempVz);
m_CartFinger.fRx := lr_CartA;
m_CartFinger.fRy := 0;
m_CartFinger.fRz := -90 + lr_CartC;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_CartMove" Id="{ef5871f2-570b-495c-a1e9-e15fe0ec6747}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves the Cartesian robot's axes one cycle towards the goal, each with its own speed. TRUE once all are there.<br>
****************************************************************************************************)
METHOD PRIVATE m_CartMove : BOOL
VAR_INPUT
	vi_lr_X								: LREAL;	// [mm]
	vi_lr_Y								: LREAL;	// [mm]
	vi_lr_Z								: LREAL;	// [mm]
	vi_lr_C								: LREAL;	// [deg]
	vi_lr_A								: LREAL;	// [deg]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[lr_CartX := m_Approach(lr_CartX, vi_lr_X, lr_CART_XY_SPEED * lr_Dt);
lr_CartY := m_Approach(lr_CartY, vi_lr_Y, lr_CART_XY_SPEED * lr_Dt);
lr_CartZ := m_Approach(lr_CartZ, vi_lr_Z, lr_CART_Z_SPEED * lr_Dt);
lr_CartC := m_Approach(lr_CartC, vi_lr_C, lr_CART_C_SPEED * lr_Dt);
lr_CartA := m_Approach(lr_CartA, vi_lr_A, lr_CART_A_SPEED * lr_Dt);
(* m_Approach lands exactly on the goal, so equality is safe. *)
m_CartMove := lr_CartX = vi_lr_X AND lr_CartY = vi_lr_Y AND lr_CartZ = vi_lr_Z AND lr_CartC = vi_lr_C
			AND lr_CartA = vi_lr_A;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DeltaAllocate" Id="{05460b48-dfab-46d6-8319-d3903c257c94}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Looks for a detected product in the allocation area of Delta n_Robot and assigns it. Delta 1 serves infeed 1,<br>
Delta 2 infeed 2, Delta 3 takes what both leave. TRUE if a product was assigned.<br>
****************************************************************************************************)
METHOD PRIVATE m_DeltaAllocate : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR n_Belt := 0 TO 1 DO
	IF n_Belt = 0 THEN
		fb_RefBelt REF= fb_Infeed1;
	ELSE
		fb_RefBelt REF= fb_Infeed2;
	END_IF
	un_Index := 0;
	IF (n_Robot = 0 AND n_Belt = 1) OR (n_Robot = 1 AND n_Belt = 0) THEN
		un_Index := fb_RefBelt.m_ProductCount();
	END_IF
	WHILE udn_TargetId[n_Robot] = 0 AND un_Index < fb_RefBelt.m_ProductCount() DO
		fb_RefBelt.m_GetProduct(vi_un_Index := un_Index, vo_Product => Product, vo_Pose => ProductPose);
		IF Product.eState = E_VisuProductState.DETECTED
		AND ProductPose.fX >= lr_BaseX - lr_PICK_HALF_ZONE
		AND ProductPose.fX <= lr_BaseX + lr_PICK_HALF_ZONE - lr_ALLOCATION_OFFSET
		THEN
			fb_RefBelt.m_SetProductState(vi_udn_Id := Product.nId, vi_e_State := E_VisuProductState.ASSIGNED,
				vi_udn_RobotId := fb_RefRobot.m_Id());
			udn_TargetId[n_Robot] := Product.nId;
			n_TargetBelt[n_Robot] := n_Belt;
			n_Phase[n_Robot] := n_PHASE_APPROACH;
		END_IF
		un_Index := un_Index + 1;
	END_WHILE
END_FOR
m_DeltaAllocate := udn_TargetId[n_Robot] <> 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DeltaConfigure" Id="{7e2e5cc8-b306-46ca-97ad-42dd39877674}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Selects Delta n_Robot into fb_RefRobot and configures it (idempotent): base, gripper, working area,<br>
limit area and zones. Initialises its TCP once.<br>
****************************************************************************************************)
METHOD PRIVATE m_DeltaConfigure : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE n_Robot OF
	0: fb_RefRobot REF= fb_Delta1;
	1: fb_RefRobot REF= fb_Delta2;
ELSE
	fb_RefRobot REF= fb_Delta3;
END_CASE
lr_BaseX := lr_ROBOT1_X + INT_TO_LREAL(n_Robot) * lr_ROBOT_PITCH;
BasePose.fX := lr_BaseX;
BasePose.fY := lr_ROBOT_Y;
BasePose.fZ := lr_ROBOT_Z;
fb_RefRobot.m_Configure(vi_Pose := BasePose, vi_lr_BaseRadius := 200, vi_lr_EffectorRadius := 50,
	vi_lr_UpperArmLength := 400, vi_lr_LowerArmLength := 1000);

(* Gripper *)
CASE n_Robot OF
	0:
		n_FingerCount := 2;
		fb_RefRobot.m_SetFinger(vi_un_Finger := 1, vi_lr_Diameter := lr_CUP_DIAMETER, vi_lr_Height := lr_CUP_HEIGHT);
		fb_RefRobot.m_SetFinger(vi_un_Finger := 2, vi_lr_Diameter := lr_CUP_DIAMETER, vi_lr_Height := lr_CUP_HEIGHT);
	1:
		n_FingerCount := 1;
		fb_RefRobot.m_SetFinger(vi_un_Finger := 1, vi_lr_Diameter := lr_TILT_DIAMETER, vi_lr_Height := lr_TILT_HEIGHT);
ELSE
	n_FingerCount := n_RING_FINGERS;
	FOR n_Finger := 1 TO n_RING_FINGERS DO
		fb_RefRobot.m_SetFinger(vi_un_Finger := INT_TO_UINT(n_Finger), vi_lr_Diameter := lr_RING_DIAMETER,
			vi_lr_Height := lr_RING_HEIGHT);
	END_FOR
END_CASE

(* Areas and zones *)
fb_RefRobot.m_SetWorkingArea(vi_lr_Radius := 750, vi_lr_ZMin := -1300, vi_lr_ZMax := -700, vi_lr_ConeHeight := 200,
	vi_lr_ConeBottomRadius := 450);
(* Neighbouring robots share the space between them: each one is limited to half the robot pitch. *)
fb_RefRobot.m_SetLimitArea(vi_lr_XMin := -lr_ROBOT_PITCH / 2, vi_lr_XMax := lr_ROBOT_PITCH / 2, vi_lr_YMin := -750,
	vi_lr_YMax := 750, vi_lr_ZMin := -1500, vi_lr_ZMax := -700);
fb_RefRobot.m_SetZone(vi_udn_ConveyorId := fb_Infeed1.m_Id(), vi_e_Kind := E_VisuZoneKind.PICK,
	vi_lr_Start := lr_BaseX - lr_PICK_HALF_ZONE, vi_lr_End := lr_BaseX + lr_PICK_HALF_ZONE,
	vi_lr_AllocationOffset := lr_ALLOCATION_OFFSET);
fb_RefRobot.m_SetZone(vi_udn_ConveyorId := fb_Infeed2.m_Id(), vi_e_Kind := E_VisuZoneKind.PICK,
	vi_lr_Start := lr_BaseX - lr_PICK_HALF_ZONE, vi_lr_End := lr_BaseX + lr_PICK_HALF_ZONE,
	vi_lr_AllocationOffset := lr_ALLOCATION_OFFSET);
fb_RefRobot.m_SetZone(vi_udn_ConveyorId := fb_Outfeed.m_Id(), vi_e_Kind := E_VisuZoneKind.PLACE,
	vi_lr_Start := lr_BaseX - lr_PLACE_HALF_ZONE, vi_lr_End := lr_BaseX + lr_PLACE_HALF_ZONE);

(* Start position of the TCP *)
IF NOT b_TcpInitialised[n_Robot] THEN
	Tcp[n_Robot].fX := lr_BaseX;
	Tcp[n_Robot].fY := lr_ROBOT_Y;
	Tcp[n_Robot].fZ := lr_ROBOT_Z - 900;
	b_TcpInitialised[n_Robot] := TRUE;
END_IF
m_DeltaConfigure := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DeltaReport" Id="{04851ae7-8172-46aa-ab57-f818078e1d55}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves the Delta 3 fingers and reports the TCP and the finger states of Delta n_Robot.<br>
****************************************************************************************************)
METHOD PRIVATE m_DeltaReport : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Delta 3 closes its fingers while it descends onto a product and keeps them closed while it carries one. *)
IF n_Robot = 2 THEN
	IF n_Phase[n_Robot] = n_PHASE_DESCEND OR n_HeldCount[n_Robot] > 0 THEN
		lr_Spread := m_Approach(lr_Spread, lr_SPREAD_CLOSED, lr_SPREAD_SPEED * lr_Dt);
	ELSE
		lr_Spread := m_Approach(lr_Spread, lr_SPREAD_OPEN, lr_SPREAD_SPEED * lr_Dt);
	END_IF
END_IF

(* Only the TCP (the flange) is reported; the visualisation derives the arms. A small offset shows the setpoint
   marker. Tool rotations show only through the finger poses. *)
SetpointTcp := Tcp[n_Robot];
SetpointTcp.fX := SetpointTcp.fX + 2;
SetpointTcp.fZ := SetpointTcp.fZ - 1;
fb_RefRobot.m_SetTcp(vi_ActualTcp := Tcp[n_Robot], vi_SetpointTcp := SetpointTcp);

(* Demo fault: Delta 1 overheats now and then. *)
fb_RefRobot.m_SetFault(vi_b_Active := n_Robot = 0 AND lr_FaultPhase >= lr_FAULT_DELTA_START
										AND lr_FaultPhase < lr_FAULT_DELTA_START + lr_FAULT_DURATION,
	vi_str_Message := 'Drive 2: overtemperature');
FOR n_Finger := 1 TO n_FingerCount DO
	(* Delta 1: a cup grips while its slot holds a product; the others grip while anything is carried. *)
	fb_RefRobot.m_SetFingerState(vi_un_Finger := INT_TO_UINT(n_Finger),
		vi_Pose := m_FingerPose(vi_n_Robot := n_Robot, vi_n_Finger := n_Finger),
		vi_b_Active := n_HeldCount[n_Robot] >= SEL(n_Robot = 0, 1, n_Finger));
END_FOR
m_DeltaReport := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DeltaSequence" Id="{ea8642a3-d87c-448e-aa23-5c6c8acf8183}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Pick and place sequence of Delta n_Robot: allocate, approach, descend and pick, lift (Delta 1 picks twice),<br>
transfer to the outfeed, lower and release every carried product.<br>
****************************************************************************************************)
METHOD PRIVATE m_DeltaSequence : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE n_Phase[n_Robot] OF
	n_PHASE_IDLE:
		IF NOT m_DeltaAllocate() THEN
			m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := lr_BaseX, vi_lr_TargetY := lr_ROBOT_Y,
				vi_lr_TargetZ := lr_ROBOT_Z - 900, vi_lr_MaxStep := lr_Step);
		END_IF

	n_PHASE_APPROACH:
		IF lr_X - lr_LEAD > lr_BaseX + lr_PICK_HALF_ZONE THEN
			(* Product left the zone: hand it back, a downstream robot may still catch it. *)
			fb_RefBelt.m_SetProductState(vi_udn_Id := udn_TargetId[n_Robot], vi_e_State := E_VisuProductState.DETECTED,
				vi_udn_RobotId := 0);
			udn_TargetId[n_Robot] := 0;
			n_Phase[n_Robot] := n_PHASE_IDLE;
		ELSE
			lr_ToolRz[n_Robot] := lr_ToolRz[n_Robot] + (lr_TargetRz - lr_ToolRz[n_Robot]) * MIN(1.0, lr_Dt * 10.0);
			IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := lr_X - Grip.fX, vi_lr_TargetY := lr_Y - Grip.fY,
				vi_lr_TargetZ := lr_TopZ - Grip.fZ + lr_HOVER, vi_lr_MaxStep := lr_Step)
			THEN
				n_Phase[n_Robot] := n_PHASE_DESCEND;
			END_IF
		END_IF

	n_PHASE_DESCEND:
		lr_ToolRz[n_Robot] := lr_ToolRz[n_Robot] + (lr_TargetRz - lr_ToolRz[n_Robot]) * MIN(1.0, lr_Dt * 10.0);
		(* Delta 3 grips only once its fingers have closed around the product (both operands are evaluated). *)
		IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := lr_X - Grip.fX, vi_lr_TargetY := lr_Y - Grip.fY,
			vi_lr_TargetZ := lr_TopZ - Grip.fZ, vi_lr_MaxStep := lr_Step)
		AND (n_Robot <> 2 OR lr_Spread = lr_SPREAD_CLOSED)
		THEN
			n_Slot := n_HeldCount[n_Robot];
			fb_RefBelt.m_SetProductState(vi_udn_Id := udn_TargetId[n_Robot], vi_e_State := E_VisuProductState.PICKED,
				vi_udn_RobotId := fb_RefRobot.m_Id(), vi_udn_FingerId := INT_TO_UDINT(n_Finger));
			udn_Held[n_Robot, n_Slot] := udn_TargetId[n_Robot];
			n_HeldBelt[n_Robot, n_Slot] := n_TargetBelt[n_Robot];
			n_HeldCount[n_Robot] := n_Slot + 1;
			udn_TargetId[n_Robot] := 0;
			n_Phase[n_Robot] := n_PHASE_LIFT;
		END_IF

	n_PHASE_LIFT:
		IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := Tcp[n_Robot].fX, vi_lr_TargetY := Tcp[n_Robot].fY,
			vi_lr_TargetZ := lr_BELT_Z + lr_PRODUCT_HEIGHT + lr_GripHeight + lr_HOVER, vi_lr_MaxStep := lr_Step)
		THEN
			(* Delta 1 picks a second product before it places both. *)
			IF n_Robot = 0 AND n_HeldCount[n_Robot] < 2 THEN
				n_Phase[n_Robot] := n_PHASE_IDLE;
			ELSE
				n_Phase[n_Robot] := n_PHASE_TRANSFER;
			END_IF
		END_IF

	n_PHASE_TRANSFER:
		lr_ToolRz[n_Robot] := lr_ToolRz[n_Robot] * (1.0 - MIN(1.0, lr_Dt * 5.0));
		IF n_Robot = 1 THEN
			lr_TiltRx := m_Approach(lr_TiltRx, lr_TILT_ANGLE, lr_TILT_SPEED * lr_Dt);
		END_IF
		IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := lr_BaseX, vi_lr_TargetY := lr_OUTFEED_Y,
			vi_lr_TargetZ := lr_BELT_Z + lr_PRODUCT_HEIGHT + lr_GripHeight + lr_HOVER, vi_lr_MaxStep := lr_Step)
		THEN
			n_Phase[n_Robot] := n_PHASE_LOWER;
		END_IF

	n_PHASE_LOWER:
		lr_ToolRz[n_Robot] := lr_ToolRz[n_Robot] * (1.0 - MIN(1.0, lr_Dt * 5.0));
		IF n_Robot = 1 THEN
			lr_TiltRx := m_Approach(lr_TiltRx, 0, lr_TILT_SPEED * lr_Dt);
		END_IF
		(* Delta 2 puts the product down straight (both operands are evaluated). *)
		IF m_MoveToward(vio_Tcp := Tcp[n_Robot], vi_lr_TargetX := Tcp[n_Robot].fX, vi_lr_TargetY := Tcp[n_Robot].fY,
			vi_lr_TargetZ := lr_BELT_Z + lr_PRODUCT_HEIGHT + lr_GripHeight, vi_lr_MaxStep := lr_Step)
		AND (n_Robot <> 1 OR lr_TiltRx = 0)
		THEN
			n_Phase[n_Robot] := n_PHASE_RELEASE;
		END_IF

	n_PHASE_RELEASE:
		(* Every carried product is put down where its finger (Delta 3: the flange) holds it. *)
		FOR n_Slot := 0 TO n_HeldCount[n_Robot] - 1 DO
			IF n_HeldBelt[n_Robot, n_Slot] = 0 THEN
				fb_RefBelt REF= fb_Infeed1;
			ELSE
				fb_RefBelt REF= fb_Infeed2;
			END_IF
			fb_RefBelt.m_SetProductState(vi_udn_Id := udn_Held[n_Robot, n_Slot], vi_e_State := E_VisuProductState.PLACED,
				vi_udn_RobotId := fb_RefRobot.m_Id());
			n_Finger := SEL(n_Robot = 2, n_Slot + 1, 0);
			Grip := m_GripOffset(vi_n_Robot := n_Robot, vi_n_Finger := n_Finger);
			LatchPose.fX := Tcp[n_Robot].fX + Grip.fX;
			LatchPose.fY := Tcp[n_Robot].fY + Grip.fY;
			LatchPose.fZ := lr_BELT_Z;
			(* A product carried at a finger keeps the finger's turn; one at the flange is turned with the base. *)
			LatchPose.fRz := SEL(n_Robot = 2, lr_ToolRz[n_Robot], 0);
			IF fb_Outfeed.m_LatchProduct(vi_udn_Id := udn_NextId, vi_LatchPose := LatchPose, vi_udn_ProductType := 1) THEN
				udn_NextId := udn_NextId + 1;
			END_IF
			udn_Held[n_Robot, n_Slot] := 0;
		END_FOR
		n_HeldCount[n_Robot] := 0;
		n_Phase[n_Robot] := n_PHASE_IDLE;
END_CASE
m_DeltaSequence := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DeltaTarget" Id="{60d188c5-69c3-4194-98b0-5ba95131c2bd}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Follows the current target of Delta n_Robot by its id (register indices shift when entries are removed),<br>
selects its infeed into fb_RefBelt and the finger used for the current pick into n_Finger and Grip.<br>
****************************************************************************************************)
METHOD PRIVATE m_DeltaTarget : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Current target *)
b_Found := FALSE;
IF udn_TargetId[n_Robot] <> 0 THEN
	IF n_TargetBelt[n_Robot] = 0 THEN
		fb_RefBelt REF= fb_Infeed1;
	ELSE
		fb_RefBelt REF= fb_Infeed2;
	END_IF
	IF fb_RefBelt.m_FindProduct(udn_TargetId[n_Robot]) >= 0 THEN
		b_Found := fb_RefBelt.m_GetProduct(vi_un_Index := INT_TO_UINT(fb_RefBelt.m_FindProduct(udn_TargetId[n_Robot])),
			vo_Product => Product, vo_Pose => ProductPose);
	END_IF
END_IF

(* Only approaching and descending follow a target; carried products are tracked in udn_Held. *)
IF (n_Phase[n_Robot] = n_PHASE_APPROACH OR n_Phase[n_Robot] = n_PHASE_DESCEND) AND NOT b_Found THEN
	n_Phase[n_Robot] := n_PHASE_IDLE;
	udn_TargetId[n_Robot] := 0;
END_IF
IF b_Found THEN
	lr_X := ProductPose.fX + lr_LEAD;
	lr_Y := ProductPose.fY;
	lr_TopZ := ProductPose.fZ + lr_PRODUCT_HEIGHT;
	lr_TargetRz := ProductPose.fRz;
END_IF

(* Finger used for the current pick: Delta 1 fills its cups one after the other, Delta 3 carries at the flange
   between its fingers. *)
CASE n_Robot OF
	0:
		n_Finger := MIN(n_HeldCount[n_Robot] + 1, 2);
		lr_GripHeight := lr_CUP_HEIGHT;
	1:
		n_Finger := 1;
		lr_GripHeight := lr_TILT_HEIGHT;
ELSE
	n_Finger := 0;
	lr_GripHeight := 0;
END_CASE
Grip := m_GripOffset(vi_n_Robot := n_Robot, vi_n_Finger := n_Finger);
m_DeltaTarget := b_Found;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_FingerPose" Id="{c4b6811c-d027-48de-bf43-a01a0da76aab}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Pose of a Delta's finger frame (centre of its top face), absolute in the MCS, from the robot's TCP (the flange)<br>
and its tool state:<br>
- Delta 1: two cups on either side of the flange at lr_PAIR_OFFSET along the tool's X, turned by lr_ToolRz.<br>
- Delta 2: one finger at the flange, turned by lr_ToolRz and tilted about its own X by lr_TiltRx.<br>
- Delta 3: n_RING_FINGERS fingers on a circle of radius lr_Spread around the flange, each facing outwards.<br>
****************************************************************************************************)
METHOD PRIVATE m_FingerPose : ST_VisuPose
VAR_INPUT
	vi_n_Robot							: INT;	// [-] 0..2
	vi_n_Finger							: INT;	// [-] 1-based
END_VAR
VAR
	lr_TempRz							: LREAL;	// [deg]
	lr_TempRadius						: LREAL;	// [mm] finger distance from the flange
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_FingerPose.fX := Tcp[vi_n_Robot].fX;
m_FingerPose.fY := Tcp[vi_n_Robot].fY;
m_FingerPose.fZ := Tcp[vi_n_Robot].fZ;
m_FingerPose.fRx := 0;
m_FingerPose.fRy := 0;
lr_TempRz := lr_ToolRz[vi_n_Robot];
lr_TempRadius := 0;
CASE vi_n_Robot OF
	0:
		(* Finger 1 along the tool's +X, finger 2 along its -X. *)
		lr_TempRadius := SEL(vi_n_Finger = 1, -lr_PAIR_OFFSET, lr_PAIR_OFFSET);
	1:
		m_FingerPose.fRx := lr_TiltRx;
	2:
		lr_TempRz := lr_ToolRz[vi_n_Robot] + 360.0 / INT_TO_LREAL(n_RING_FINGERS) * INT_TO_LREAL(vi_n_Finger - 1);
		lr_TempRadius := lr_Spread;
END_CASE
m_FingerPose.fX := m_FingerPose.fX + lr_TempRadius * COS(lr_TempRz * VISU_GlobalConst.VISU_lr_DEG_TO_RAD);
m_FingerPose.fY := m_FingerPose.fY + lr_TempRadius * SIN(lr_TempRz * VISU_GlobalConst.VISU_lr_DEG_TO_RAD);
m_FingerPose.fRz := lr_TempRz;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_GantryFollow" Id="{2e1ef7a1-ce0f-4340-9f28-d2efb767c779}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves the gantry movers along the track: a mover with a product waits at its waiting position until the<br>
product passes underneath and then follows it; a mover without one returns to its waiting position.<br>
Downstream first, so each mover keeps its distance to the one ahead.<br>
****************************************************************************************************)
METHOD PRIVATE m_GantryFollow : BOOL
VAR
	n_TempI								: INT;
	lr_TempGoal							: LREAL;	// [mm]
	lr_TempLimit						: LREAL;	// [mm]
	lr_TempPos							: LREAL;	// [mm]
	lr_TempRz							: LREAL;	// [deg]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR n_TempI := 3 TO 0 BY -1 DO
	IF n_TempI = 3 THEN
		lr_TempLimit := UINT_TO_LREAL(un_GANTRY_MODULES) * lr_GANTRY_MODULE_LENGTH - lr_GANTRY_MOVER_LENGTH / 2;
	ELSE
		lr_TempLimit := lr_GantryPos[n_TempI + 1] - lr_GANTRY_GAP;
	END_IF
	lr_TempGoal := lr_GantryWait[n_TempI];
	IF udn_GantryProduct[n_TempI] <> 0 THEN
		IF m_IdhTrackPos(vi_udn_Id := udn_GantryProduct[n_TempI], vo_lr_TrackPos => lr_TempPos, vo_lr_Rz => lr_TempRz) THEN
			lr_TempGoal := MAX(lr_TempPos, lr_GantryWait[n_TempI]);
			lr_GantryC[n_TempI] := m_Approach(lr_GantryC[n_TempI], lr_TempRz, 180.0 * lr_Dt);
		END_IF
	END_IF
	lr_GantryPos[n_TempI] := MIN(m_Approach(lr_GantryPos[n_TempI], lr_TempGoal, lr_GANTRY_TRACK_SPEED * lr_Dt), lr_TempLimit);
END_FOR
m_GantryFollow := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_GripOffset" Id="{fa8edc23-347f-4c28-89c7-fcbddaededcb}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
MCS offset from a Delta's TCP (the flange) to the grip point of one of its fingers, the centre of the finger's<br>
bottom face: where a carried product's top touches. vi_n_Finger = 0 is the flange itself.<br>
****************************************************************************************************)
METHOD PRIVATE m_GripOffset : ST_VisuPosition
VAR_INPUT
	vi_n_Robot							: INT;	// [-] 0..2
	vi_n_Finger							: INT;	// [-] 1-based, 0 = flange
END_VAR
VAR
	TempTop								: ST_VisuPose;
	lr_TempHeight						: LREAL;	// [mm]
	lr_TempRx							: LREAL;	// [rad]
	lr_TempRz							: LREAL;	// [rad]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF vi_n_Finger = 0 THEN
	RETURN;
END_IF
CASE vi_n_Robot OF
	0: lr_TempHeight := lr_CUP_HEIGHT;
	1: lr_TempHeight := lr_TILT_HEIGHT;
ELSE
	lr_TempHeight := lr_RING_HEIGHT;
END_CASE
TempTop := m_FingerPose(vi_n_Robot := vi_n_Robot, vi_n_Finger := vi_n_Finger);
lr_TempRx := TempTop.fRx * VISU_GlobalConst.VISU_lr_DEG_TO_RAD;
lr_TempRz := TempTop.fRz * VISU_GlobalConst.VISU_lr_DEG_TO_RAD;
(* Rz(rz) * Rx(rx) * (0, 0, -height): the finger's local -Z in the MCS. *)
m_GripOffset.fX := TempTop.fX - Tcp[vi_n_Robot].fX - lr_TempHeight * SIN(lr_TempRx) * SIN(lr_TempRz);
m_GripOffset.fY := TempTop.fY - Tcp[vi_n_Robot].fY + lr_TempHeight * SIN(lr_TempRx) * COS(lr_TempRz);
m_GripOffset.fZ := TempTop.fZ - Tcp[vi_n_Robot].fZ - lr_TempHeight * COS(lr_TempRx);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_IdhTrackPos" Id="{a868d0a2-576d-4490-bfed-cf1f163961e7}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Position of a product on the IDH infeed along the gantry track (MCS x - gantry x) and its rotation.<br>
FALSE if the product is no longer in the register.<br>
****************************************************************************************************)
METHOD PRIVATE m_IdhTrackPos : BOOL
VAR_INPUT
	vi_udn_Id							: UDINT;	// [-] product id
END_VAR
VAR_OUTPUT
	vo_lr_TrackPos						: LREAL;	// [mm]
	vo_lr_Rz							: LREAL;	// [deg]
END_VAR
VAR
	n_TempIndex							: INT;
	TempProduct							: ST_VisuProduct;
	TempPose							: ST_VisuPlanarPose;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[n_TempIndex := fb_IdhInfeed.m_FindProduct(vi_udn_Id);
m_IdhTrackPos := n_TempIndex >= 0;
IF m_IdhTrackPos THEN
	fb_IdhInfeed.m_GetProduct(vi_un_Index := INT_TO_UINT(n_TempIndex), vo_Product => TempProduct, vo_Pose => TempPose);
	vo_lr_TrackPos := TempPose.fX - lr_GANTRY_X;
	vo_lr_Rz := TempPose.fRz;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_LoopFlange" Id="{e2c3875b-3b93-43f1-a5e3-73692bb64328}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Pose of the gripper flange of a Fxx mover at track position vi_lr_S, absolute in the MCS: outwards from the<br>
track by the configured tool offset, turned about the loop's Y axis with the track tangent.<br>
****************************************************************************************************)
METHOD PRIVATE m_LoopFlange : ST_VisuPose
VAR_INPUT
	vi_lr_S								: LREAL;	// [mm] 0..perimeter
END_VAR
VAR
	lr_TempArc							: LREAL;	// [mm] length of one curve
	lr_TempA							: LREAL;	// [rad]
	lr_TempX							: LREAL;	// [mm] local track point
	lr_TempZ							: LREAL;	// [mm]
	lr_TempAngle						: LREAL;	// [deg] mover rotation about local Y
	lr_TempOut							: LREAL;	// [mm] flange distance from the track
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[lr_TempArc := 3.141592653589793 * lr_LOOP_RADIUS;
IF vi_lr_S <= lr_LOOP_STRAIGHT THEN
	lr_TempX := vi_lr_S;
	lr_TempZ := 0;
	lr_TempAngle := 0;
ELSIF vi_lr_S <= lr_LOOP_STRAIGHT + lr_TempArc THEN
	lr_TempA := (vi_lr_S - lr_LOOP_STRAIGHT) / lr_LOOP_RADIUS;
	lr_TempX := lr_LOOP_STRAIGHT + lr_LOOP_RADIUS * SIN(lr_TempA);
	lr_TempZ := lr_LOOP_RADIUS - lr_LOOP_RADIUS * COS(lr_TempA);
	lr_TempAngle := -lr_TempA / VISU_GlobalConst.VISU_lr_DEG_TO_RAD;
ELSIF vi_lr_S <= 2 * lr_LOOP_STRAIGHT + lr_TempArc THEN
	lr_TempX := lr_LOOP_STRAIGHT - (vi_lr_S - lr_LOOP_STRAIGHT - lr_TempArc);
	lr_TempZ := 2 * lr_LOOP_RADIUS;
	lr_TempAngle := 180;
ELSE
	lr_TempA := (vi_lr_S - 2 * lr_LOOP_STRAIGHT - lr_TempArc) / lr_LOOP_RADIUS;
	lr_TempX := -lr_LOOP_RADIUS * SIN(lr_TempA);
	lr_TempZ := lr_LOOP_RADIUS + lr_LOOP_RADIUS * COS(lr_TempA);
	lr_TempAngle := 180 - lr_TempA / VISU_GlobalConst.VISU_lr_DEG_TO_RAD;
END_IF

(* The mover's -Z, turned about Y by the angle, points outwards: Ry(angle) * (0, 0, -out). *)
lr_TempOut := lr_LOOP_TOOL_OFFSET - lr_CUP_HEIGHT;
m_LoopFlange.fX := lr_LOOP_X + lr_TempX - lr_TempOut * SIN(lr_TempAngle * VISU_GlobalConst.VISU_lr_DEG_TO_RAD);
m_LoopFlange.fY := lr_FXX_Y;
m_LoopFlange.fZ := lr_BELT_Z + lr_PRODUCT_HEIGHT + lr_LOOP_TOOL_OFFSET + lr_TempZ
				- lr_TempOut * COS(lr_TempAngle * VISU_GlobalConst.VISU_lr_DEG_TO_RAD);
m_LoopFlange.fRx := 0;
m_LoopFlange.fRy := lr_TempAngle;
m_LoopFlange.fRz := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_MoveToward" Id="{2c849231-a488-444f-a618-fffe48cd6793}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Moves a TCP towards a target by at most vi_lr_MaxStep. TRUE once the target is reached.<br>
****************************************************************************************************)
METHOD PRIVATE m_MoveToward : BOOL
VAR_IN_OUT
	vio_Tcp								: ST_VisuPosition;
END_VAR
VAR_INPUT
	vi_lr_TargetX						: LREAL;	// [mm]
	vi_lr_TargetY						: LREAL;	// [mm]
	vi_lr_TargetZ						: LREAL;	// [mm]
	vi_lr_MaxStep						: LREAL;	// [mm]
END_VAR
VAR
	lr_TempDx							: LREAL;	// [mm]
	lr_TempDy							: LREAL;	// [mm]
	lr_TempDz							: LREAL;	// [mm]
	lr_TempDist							: LREAL;	// [mm]
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[lr_TempDx := vi_lr_TargetX - vio_Tcp.fX;
lr_TempDy := vi_lr_TargetY - vio_Tcp.fY;
lr_TempDz := vi_lr_TargetZ - vio_Tcp.fZ;
lr_TempDist := SQRT(lr_TempDx * lr_TempDx + lr_TempDy * lr_TempDy + lr_TempDz * lr_TempDz);
IF lr_TempDist <= vi_lr_MaxStep THEN
	vio_Tcp.fX := vi_lr_TargetX;
	vio_Tcp.fY := vi_lr_TargetY;
	vio_Tcp.fZ := vi_lr_TargetZ;
	m_MoveToward := TRUE;
ELSE
	vio_Tcp.fX := vio_Tcp.fX + lr_TempDx / lr_TempDist * vi_lr_MaxStep;
	vio_Tcp.fY := vio_Tcp.fY + lr_TempDy / lr_TempDist * vi_lr_MaxStep;
	vio_Tcp.fZ := vio_Tcp.fZ + lr_TempDz / lr_TempDist * vi_lr_MaxStep;
	m_MoveToward := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StepCartesian" Id="{759c04cf-e850-4883-96e3-346411354a33}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Cartesian robot: follows a product on the Cartesian infeed in Y with the gripper turned onto it (C), picks<br>
it, carries it across to the outfeed while turning it by a further -90 deg, tilts it by A while lowering,<br>
straightens it and places it.<br>
****************************************************************************************************)
METHOD PRIVATE m_StepCartesian : BOOL
VAR
	n_TempFound							: INT;
	un_TempScan							: UINT;
	b_TempHave							: BOOL;
	lr_TempProductY						: LREAL;	// [mm] robot Y of the current product: its MCS x relative to the robot origin
	TempProduct							: ST_VisuProduct;
	TempProductPose						: ST_VisuPlanarPose;
	TempPlacePose						: ST_VisuPlanarPose;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Current product *)
b_TempHave := FALSE;
IF udn_CartProduct <> 0 THEN
	n_TempFound := fb_CartInfeed.m_FindProduct(udn_CartProduct);
	IF n_TempFound >= 0 THEN
		b_TempHave := fb_CartInfeed.m_GetProduct(vi_un_Index := INT_TO_UINT(n_TempFound), vo_Product => TempProduct,
			vo_Pose => TempProductPose);
		lr_TempProductY := TempProductPose.fX - lr_CART_X;
	END_IF
END_IF

(* Sequence *)
CASE n_CartPhase OF
	n_CART_IDLE:
		un_TempScan := 0;
		WHILE udn_CartProduct = 0 AND un_TempScan < fb_CartInfeed.m_ProductCount() DO
			fb_CartInfeed.m_GetProduct(vi_un_Index := un_TempScan, vo_Product => TempProduct, vo_Pose => TempProductPose);
			IF TempProduct.eState = E_VisuProductState.DETECTED
			AND TempProductPose.fX - lr_CART_X >= 100
			AND TempProductPose.fX - lr_CART_X <= 600
			THEN
				fb_CartInfeed.m_SetProductState(vi_udn_Id := TempProduct.nId, vi_e_State := E_VisuProductState.ASSIGNED,
					vi_udn_RobotId := fb_Cartesian.m_Id());
				udn_CartProduct := TempProduct.nId;
				(* The gripper's +X in the MCS is pose rz (-90 deg) + C. *)
				lr_CartPickC := TempProductPose.fRz + 90;
				n_CartPhase := n_CART_DESCEND;
			END_IF
			un_TempScan := un_TempScan + 1;
		END_WHILE
		IF udn_CartProduct = 0 THEN
			m_CartMove(vi_lr_X := lr_CART_X_INFEED, vi_lr_Y := lr_CART_Y_HOME, vi_lr_Z := lr_CART_Z_TRAVEL, vi_lr_C := 0,
				vi_lr_A := 0);
		END_IF

	n_CART_DESCEND:
		IF NOT b_TempHave THEN
			udn_CartProduct := 0;
			n_CartPhase := n_CART_RISE;
		ELSIF lr_TempProductY > 1000 THEN
			(* Out of reach: hand it back, it will be missed. *)
			fb_CartInfeed.m_SetProductState(vi_udn_Id := udn_CartProduct, vi_e_State := E_VisuProductState.DETECTED,
				vi_udn_RobotId := 0);
			udn_CartProduct := 0;
			n_CartPhase := n_CART_RISE;
		ELSIF m_CartMove(vi_lr_X := lr_CART_X_INFEED, vi_lr_Y := lr_TempProductY, vi_lr_Z := lr_CartZ,
			vi_lr_C := lr_CartPickC, vi_lr_A := 0)
		THEN
			(* Lowers only once above the product with the gripper turned onto it. *)
			IF m_CartMove(vi_lr_X := lr_CART_X_INFEED, vi_lr_Y := lr_TempProductY, vi_lr_Z := lr_CART_Z_PICK,
				vi_lr_C := lr_CartPickC, vi_lr_A := 0)
			THEN
				fb_CartInfeed.m_SetProductState(vi_udn_Id := udn_CartProduct, vi_e_State := E_VisuProductState.PICKED,
					vi_udn_RobotId := fb_Cartesian.m_Id(), vi_udn_FingerId := 1);
				b_CartGrip := TRUE;
				n_CartPhase := n_CART_LIFT;
			END_IF
		END_IF

	n_CART_LIFT:
		IF m_CartMove(vi_lr_X := lr_CartX, vi_lr_Y := lr_CartY, vi_lr_Z := lr_CART_Z_TRAVEL, vi_lr_C := lr_CartC,
			vi_lr_A := lr_CartA)
		THEN
			n_CartPhase := n_CART_TRANSFER;
		END_IF

	n_CART_TRANSFER:
		IF m_CartMove(vi_lr_X := lr_CART_X_OUTFEED, vi_lr_Y := lr_CART_Y_PLACE, vi_lr_Z := lr_CART_Z_TRAVEL,
			vi_lr_C := lr_CartPickC + lr_CART_TURN, vi_lr_A := 0)
		THEN
			n_CartPhase := n_CART_LOWER;
		END_IF

	n_CART_LOWER:
		IF m_CartMove(vi_lr_X := lr_CartX, vi_lr_Y := lr_CartY, vi_lr_Z := lr_CART_Z_PICK, vi_lr_C := lr_CartC,
			vi_lr_A := lr_CART_TILT)
		THEN
			n_CartPhase := n_CART_STRAIGHTEN;
		END_IF

	n_CART_STRAIGHTEN:
		IF m_CartMove(vi_lr_X := lr_CartX, vi_lr_Y := lr_CartY, vi_lr_Z := lr_CartZ, vi_lr_C := lr_CartC, vi_lr_A := 0) THEN
			n_CartPhase := n_CART_RELEASE;
		END_IF

	n_CART_RELEASE:
		fb_CartInfeed.m_SetProductState(vi_udn_Id := udn_CartProduct, vi_e_State := E_VisuProductState.PLACED,
			vi_udn_RobotId := fb_Cartesian.m_Id());
		(* Turned by -90 deg: the cup (A = 0) is at MCS x = origin + Y, y = origin - X; the product keeps the turn. *)
		TempPlacePose.fX := lr_CART_X + lr_CartY;
		TempPlacePose.fY := lr_CART_Y - lr_CartX;
		TempPlacePose.fZ := lr_BELT_Z;
		TempPlacePose.fRz := -90 + lr_CartC;
		IF fb_CartOutfeed.m_LatchProduct(vi_udn_Id := udn_NextId, vi_LatchPose := TempPlacePose, vi_udn_ProductType := 1) THEN
			udn_NextId := udn_NextId + 1;
		END_IF
		udn_CartProduct := 0;
		b_CartGrip := FALSE;
		n_CartPhase := n_CART_RISE;

	n_CART_RISE:
		IF m_CartMove(vi_lr_X := lr_CartX, vi_lr_Y := lr_CartY, vi_lr_Z := lr_CART_Z_TRAVEL, vi_lr_C := lr_CartC,
			vi_lr_A := lr_CartA)
		THEN
			n_CartPhase := n_CART_IDLE;
		END_IF
END_CASE
m_StepCartesian := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StepDelta" Id="{217cad33-9629-4082-80d0-53ca10cbf423}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Delta application: per robot configure it, follow its target, run its pick and place sequence and report<br>
its TCP and fingers.<br>
****************************************************************************************************)
METHOD PRIVATE m_StepDelta : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR n_Robot := 0 TO 2 DO
	m_DeltaConfigure();
	m_DeltaTarget();
	m_DeltaSequence();
	m_DeltaReport();
END_FOR
m_StepDelta := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StepGantry" Id="{5216f4a6-5b6c-44a6-898b-843263ca5299}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
XTS gantry: the movers follow up to four products on the IDH infeed (the most downstream mover takes the<br>
first product), then the Z axis lowers all grippers together, the X axes carry the products over the tray<br>
belt, they are put down together and the movers return to their waiting positions.<br>
****************************************************************************************************)
METHOD PRIVATE m_StepGantry : BOOL
VAR
	n_TempI								: INT;
	un_TempIndex						: UINT;
	udn_TempBest						: UDINT;	// [-] product id
	lr_TempBest							: LREAL;	// [mm]
	lr_TempPos							: LREAL;	// [mm]
	lr_TempRz							: LREAL;	// [deg]
	n_TempAssigned						: INT;
	b_TempAllSynced						: BOOL;
	b_TempAnySynced						: BOOL;
	b_TempDone							: BOOL;
	b_TempSynced						: ARRAY[0..3] OF BOOL;
	TempProduct							: ST_VisuProduct;
	TempPose							: ST_VisuPlanarPose;
	TempLatch							: ST_VisuPlanarPose;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(****************************************************************************************************)
(* SEQUENCE                                                                                         *)
(****************************************************************************************************)
CASE n_GantryPhase OF
	n_GANTRY_COLLECT:
		(* Downstream mover first: it takes the most downstream product not yet assigned. *)
		FOR n_TempI := 3 TO 0 BY -1 DO
			IF udn_GantryProduct[n_TempI] = 0 THEN
				udn_TempBest := 0;
				lr_TempBest := -1.0E9;
				FOR un_TempIndex := 1 TO fb_IdhInfeed.m_ProductCount() DO
					fb_IdhInfeed.m_GetProduct(vi_un_Index := un_TempIndex - 1, vo_Product => TempProduct, vo_Pose => TempPose);
					lr_TempPos := TempPose.fX - lr_GANTRY_X;
					IF TempProduct.eState = E_VisuProductState.DETECTED AND lr_TempPos < lr_GantryPos[n_TempI]
					AND lr_TempPos > -500 AND lr_TempPos > lr_TempBest
					THEN
						udn_TempBest := TempProduct.nId;
						lr_TempBest := lr_TempPos;
					END_IF
				END_FOR
				IF udn_TempBest = 0 THEN
					EXIT;
				END_IF
				fb_IdhInfeed.m_SetProductState(vi_udn_Id := udn_TempBest, vi_e_State := E_VisuProductState.ASSIGNED,
					vi_udn_RobotId := fb_Idh.m_Id(), vi_udn_MoverId := INT_TO_UDINT(n_TempI + 1));
				udn_GantryProduct[n_TempI] := udn_TempBest;
			END_IF
		END_FOR
		m_GantryFollow();

		(* Pick once all four are above their products, or at the track end with any of them. *)
		n_TempAssigned := 0;
		b_TempAllSynced := TRUE;
		b_TempAnySynced := FALSE;
		FOR n_TempI := 0 TO 3 DO
			b_TempSynced[n_TempI] := FALSE;
			IF udn_GantryProduct[n_TempI] <> 0 THEN
				n_TempAssigned := n_TempAssigned + 1;
				b_TempSynced[n_TempI] := m_IdhTrackPos(vi_udn_Id := udn_GantryProduct[n_TempI], vo_lr_TrackPos => lr_TempPos,
											vo_lr_Rz => lr_TempRz)
										AND ABS(lr_GantryPos[n_TempI] - lr_TempPos) < 2;
				b_TempAllSynced := b_TempAllSynced AND b_TempSynced[n_TempI];
				b_TempAnySynced := b_TempAnySynced OR b_TempSynced[n_TempI];
			END_IF
		END_FOR
		IF (n_TempAssigned = 4 AND b_TempAllSynced)
		OR (lr_GantryPos[3] >= UINT_TO_LREAL(un_GANTRY_MODULES) * lr_GANTRY_MODULE_LENGTH - 300 AND b_TempAnySynced)
		THEN
			(* Movers not yet above their product give it back. *)
			FOR n_TempI := 0 TO 3 DO
				IF udn_GantryProduct[n_TempI] <> 0 AND NOT b_TempSynced[n_TempI] THEN
					fb_IdhInfeed.m_SetProductState(vi_udn_Id := udn_GantryProduct[n_TempI],
						vi_e_State := E_VisuProductState.DETECTED, vi_udn_RobotId := 0);
					udn_GantryProduct[n_TempI] := 0;
				END_IF
			END_FOR
			n_GantryPhase := n_GANTRY_PICK_DOWN;
		END_IF

	n_GANTRY_PICK_DOWN:
		m_GantryFollow();
		lr_GantryZ := m_Approach(lr_GantryZ, lr_GANTRY_Z_DOWN, lr_GANTRY_Z_SPEED * lr_Dt);
		IF lr_GantryZ = lr_GANTRY_Z_DOWN THEN
			FOR n_TempI := 0 TO 3 DO
				IF udn_GantryProduct[n_TempI] <> 0 THEN
					b_GantryGrip[n_TempI] := TRUE;
					fb_IdhInfeed.m_SetProductState(vi_udn_Id := udn_GantryProduct[n_TempI], vi_e_State := E_VisuProductState.PICKED,
						vi_udn_RobotId := fb_Idh.m_Id(), vi_udn_MoverId := INT_TO_UDINT(n_TempI + 1), vi_udn_FingerId := 1);
				END_IF
			END_FOR
			n_GantryPhase := n_GANTRY_PICK_UP;
		END_IF

	n_GANTRY_PICK_UP:
		lr_GantryZ := m_Approach(lr_GantryZ, 0, lr_GANTRY_Z_SPEED * lr_Dt);
		IF lr_GantryZ = 0 THEN
			n_GantryPhase := n_GANTRY_TO_TRAY;
		END_IF

	n_GANTRY_TO_TRAY:
		b_TempDone := TRUE;
		FOR n_TempI := 0 TO 3 DO
			lr_GantryX[n_TempI] := m_Approach(lr_GantryX[n_TempI], lr_GANTRY_X_TRAY, lr_GANTRY_X_SPEED * lr_Dt);
			lr_GantryC[n_TempI] := m_Approach(lr_GantryC[n_TempI], 0, 180.0 * lr_Dt);
			b_TempDone := b_TempDone AND lr_GantryX[n_TempI] = lr_GANTRY_X_TRAY AND lr_GantryC[n_TempI] = 0;
		END_FOR
		IF b_TempDone THEN
			n_GantryPhase := n_GANTRY_PLACE_DOWN;
		END_IF

	n_GANTRY_PLACE_DOWN:
		lr_GantryZ := m_Approach(lr_GantryZ, lr_GANTRY_Z_DOWN, lr_GANTRY_Z_SPEED * lr_Dt);
		IF lr_GantryZ = lr_GANTRY_Z_DOWN THEN
			FOR n_TempI := 0 TO 3 DO
				IF udn_GantryProduct[n_TempI] <> 0 THEN
					fb_IdhInfeed.m_SetProductState(vi_udn_Id := udn_GantryProduct[n_TempI], vi_e_State := E_VisuProductState.PLACED,
						vi_udn_RobotId := fb_Idh.m_Id(), vi_udn_MoverId := 0);
					(* Turned by -90 deg: gripper at MCS x = track start + position, y = pose y - (X + tool offset). *)
					TempLatch.fX := lr_GANTRY_X + lr_GantryPos[n_TempI];
					TempLatch.fY := lr_GANTRY_Y - (lr_GantryX[n_TempI] + lr_GANTRY_TOOL_X);
					TempLatch.fZ := lr_BELT_Z;
					TempLatch.fRz := 0;
					IF fb_IdhTray.m_LatchProduct(vi_udn_Id := udn_NextId, vi_LatchPose := TempLatch, vi_udn_ProductType := 1) THEN
						udn_NextId := udn_NextId + 1;
					END_IF
					udn_GantryProduct[n_TempI] := 0;
				END_IF
				b_GantryGrip[n_TempI] := FALSE;
			END_FOR
			n_GantryPhase := n_GANTRY_PLACE_UP;
		END_IF

	n_GANTRY_PLACE_UP:
		lr_GantryZ := m_Approach(lr_GantryZ, 0, lr_GANTRY_Z_SPEED * lr_Dt);
		IF lr_GantryZ = 0 THEN
			n_GantryPhase := n_GANTRY_RETURN;
		END_IF

	n_GANTRY_RETURN:
		m_GantryFollow();
		b_TempDone := TRUE;
		FOR n_TempI := 0 TO 3 DO
			lr_GantryX[n_TempI] := m_Approach(lr_GantryX[n_TempI], lr_GANTRY_X_BELT, lr_GANTRY_X_SPEED * lr_Dt);
			b_TempDone := b_TempDone AND lr_GantryX[n_TempI] = lr_GANTRY_X_BELT AND lr_GantryPos[n_TempI] = lr_GantryWait[n_TempI];
		END_FOR
		IF b_TempDone THEN
			n_GantryPhase := n_GANTRY_COLLECT;
		END_IF
END_CASE


(****************************************************************************************************)
(* REPORT                                                                                           *)
(****************************************************************************************************)
fb_Idh.m_SetZPosition(lr_GantryZ);
fb_Idh.m_SetMoverCount(4);
FOR n_TempI := 0 TO 3 DO
	(* The cup hangs from the flange, turned by the gripper's C. Turned by -90 deg: local (x, y, z) is
	   MCS (gantry x + y, gantry y - x, gantry z + z). *)
	MoverFingers[0].stPose.fX := lr_GANTRY_X + lr_GantryPos[n_TempI];
	MoverFingers[0].stPose.fY := lr_GANTRY_Y - (lr_GantryX[n_TempI] + lr_GANTRY_TOOL_X);
	MoverFingers[0].stPose.fZ := lr_GANTRY_Z + lr_GantryZ + lr_GANTRY_TOOL_Z + lr_CUP_HEIGHT;
	(* The cup only turns about Rz; the Fxx loop leaves its tilt about Y in the shared array. *)
	MoverFingers[0].stPose.fRx := 0;
	MoverFingers[0].stPose.fRy := 0;
	MoverFingers[0].stPose.fRz := -90 + lr_GantryC[n_TempI];
	MoverFingers[0].bActive := b_GantryGrip[n_TempI];
	fb_Idh.m_SetMover(vi_un_Index := INT_TO_UINT(n_TempI), vi_udn_Id := INT_TO_UDINT(n_TempI + 1),
		vi_lr_Position := lr_GantryPos[n_TempI], vi_lr_X := lr_GantryX[n_TempI], vi_b_GripperActive := b_GantryGrip[n_TempI],
		vi_FingerStates := MoverFingers,
		vi_b_Fault := n_TempI = 1 AND lr_FaultPhase >= lr_FAULT_GANTRY_START
					AND lr_FaultPhase < lr_FAULT_GANTRY_START + lr_FAULT_DURATION,
		vi_str_FaultMessage := 'Vacuum not reached');
END_FOR
m_StepGantry := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StepLoop" Id="{78edaaaf-250a-4c1a-b75c-51b965562399}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
XTS loop: the queue head takes over the next product arriving on the Fxx infeed under the start of the lower<br>
straight, follows it, grips it, carries it faster to the Fxx outfeed and releases it there; the mover then<br>
runs round to the queue.<br>
****************************************************************************************************)
METHOD PRIVATE m_StepLoop : BOOL
VAR
	lr_TempPerimeter					: LREAL;	// [mm]
	lr_TempS							: LREAL;	// [mm]
	lr_TempX							: LREAL;	// [mm]
	lr_TempRz							: LREAL;	// [deg]
	n_TempI								: INT;
	n_TempJ								: INT;
	n_TempRank							: INT;
	n_TempHead							: INT;
	b_TempHeadReady						: BOOL;
	lr_TempMinTrack						: LREAL;	// [mm]
	n_TempIdx							: INT;
	un_TempIndex						: UINT;
	TempProduct							: ST_VisuProduct;
	TempPose							: ST_VisuPlanarPose;
	TempLatch							: ST_VisuPlanarPose;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(****************************************************************************************************)
(* QUEUE AND TAKE-OVER                                                                              *)
(****************************************************************************************************)
lr_TempPerimeter := fb_Fxx.m_Perimeter();
IF NOT b_LoopInitialised THEN
	FOR n_TempI := 0 TO n_LOOP_MOVERS - 1 DO
		lr_LoopS[n_TempI] := lr_TempPerimeter - INT_TO_LREAL(n_TempI) * lr_LOOP_SLOT;
		n_LoopMode[n_TempI] := n_LOOP_QUEUE;
	END_FOR
	b_LoopInitialised := TRUE;
END_IF

(* Queued movers close up towards their slots before the start of the lower straight. *)
n_TempHead := -1;
FOR n_TempI := 0 TO n_LOOP_MOVERS - 1 DO
	IF n_LoopMode[n_TempI] = n_LOOP_QUEUE THEN
		n_TempRank := 0;
		FOR n_TempJ := 0 TO n_LOOP_MOVERS - 1 DO
			IF n_LoopMode[n_TempJ] = n_LOOP_QUEUE
			AND (lr_LoopS[n_TempJ] > lr_LoopS[n_TempI] OR (lr_LoopS[n_TempJ] = lr_LoopS[n_TempI] AND n_TempJ < n_TempI))
			THEN
				n_TempRank := n_TempRank + 1;
			END_IF
		END_FOR
		lr_LoopS[n_TempI] := MIN(lr_LoopS[n_TempI] + lr_LOOP_RETURN_SPEED * lr_Dt,
								lr_TempPerimeter - INT_TO_LREAL(n_TempRank) * lr_LOOP_SLOT);
		IF n_TempRank = 0 THEN
			n_TempHead := n_TempI;
		END_IF
	END_IF
END_FOR

(* The queue head takes over the next product arriving under the start of the lower straight.
   ST evaluates both operands of AND, so the index check must be a separate IF (head = -1: queue empty). *)
IF n_TempHead >= 0 THEN
	b_TempHeadReady := lr_LoopS[n_TempHead] >= lr_TempPerimeter - 1;
END_IF
(* Movers cannot overlap: the next product must be at least one slot behind the last mover following one. *)
lr_TempMinTrack := 1.0E9;
FOR n_TempI := 0 TO n_LOOP_MOVERS - 1 DO
	IF n_LoopMode[n_TempI] = n_LOOP_TRACK THEN
		lr_TempMinTrack := MIN(lr_TempMinTrack, lr_LoopS[n_TempI]);
	END_IF
END_FOR
IF b_TempHeadReady THEN
	un_TempIndex := 0;
	WHILE n_LoopMode[n_TempHead] = n_LOOP_QUEUE AND un_TempIndex < fb_FxxInfeed.m_ProductCount() DO
		fb_FxxInfeed.m_GetProduct(vi_un_Index := un_TempIndex, vo_Product => TempProduct, vo_Pose => TempPose);
		lr_TempX := TempPose.fX - lr_LOOP_X;
		IF TempProduct.eState = E_VisuProductState.DETECTED AND lr_TempX >= 0 AND lr_TempX < lr_LOOP_GRIP
		AND lr_TempMinTrack - lr_TempX >= lr_LOOP_SLOT
		THEN
			fb_FxxInfeed.m_SetProductState(vi_udn_Id := TempProduct.nId, vi_e_State := E_VisuProductState.ASSIGNED,
				vi_udn_RobotId := fb_Fxx.m_Id(), vi_udn_MoverId := INT_TO_UDINT(n_TempHead + 1));
			udn_LoopProduct[n_TempHead] := TempProduct.nId;
			n_LoopMode[n_TempHead] := n_LOOP_TRACK;
		END_IF
		un_TempIndex := un_TempIndex + 1;
	END_WHILE
END_IF


(****************************************************************************************************)
(* MOVERS                                                                                           *)
(****************************************************************************************************)
fb_Fxx.m_SetMoverCount(INT_TO_UINT(n_LOOP_MOVERS));
FOR n_TempI := 0 TO n_LOOP_MOVERS - 1 DO
	CASE n_LoopMode[n_TempI] OF
		n_LOOP_TRACK:
			n_TempIdx := fb_FxxInfeed.m_FindProduct(udn_LoopProduct[n_TempI]);
			IF n_TempIdx < 0 THEN
				udn_LoopProduct[n_TempI] := 0;
				n_LoopMode[n_TempI] := n_LOOP_RETURN;
			ELSE
				fb_FxxInfeed.m_GetProduct(vi_un_Index := INT_TO_UINT(n_TempIdx), vo_Product => TempProduct, vo_Pose => TempPose);
				lr_LoopS[n_TempI] := TempPose.fX - lr_LOOP_X;
				IF lr_LoopS[n_TempI] >= lr_LOOP_GRIP AND TempProduct.eState = E_VisuProductState.ASSIGNED THEN
					fb_FxxInfeed.m_SetProductState(vi_udn_Id := TempProduct.nId, vi_e_State := E_VisuProductState.PICKED,
						vi_udn_RobotId := fb_Fxx.m_Id(), vi_udn_MoverId := INT_TO_UDINT(n_TempI + 1), vi_udn_FingerId := 1);
				END_IF
				IF lr_LoopS[n_TempI] >= lr_LOOP_RELEASE THEN
					n_LoopMode[n_TempI] := n_LOOP_DELIVER;
				END_IF
			END_IF

		n_LOOP_DELIVER:
			lr_LoopS[n_TempI] := MIN(lr_LoopS[n_TempI] + lr_LOOP_DELIVER_SPEED * lr_Dt, lr_LOOP_PLACE);
			IF lr_LoopS[n_TempI] >= lr_LOOP_PLACE THEN
				lr_TempRz := 0;
				n_TempIdx := fb_FxxInfeed.m_FindProduct(udn_LoopProduct[n_TempI]);
				IF n_TempIdx >= 0 THEN
					fb_FxxInfeed.m_GetProduct(vi_un_Index := INT_TO_UINT(n_TempIdx), vo_Product => TempProduct, vo_Pose => TempPose);
					lr_TempRz := TempProduct.stLatchPose.fRz;
					fb_FxxInfeed.m_SetProductState(vi_udn_Id := TempProduct.nId, vi_e_State := E_VisuProductState.PLACED,
						vi_udn_RobotId := fb_Fxx.m_Id(), vi_udn_MoverId := 0);
				END_IF
				TempLatch.fX := lr_LOOP_X + lr_LoopS[n_TempI];
				TempLatch.fY := lr_FXX_Y;
				TempLatch.fZ := lr_BELT_Z;
				TempLatch.fRz := lr_TempRz;
				IF fb_FxxOutfeed.m_LatchProduct(vi_udn_Id := udn_NextId, vi_LatchPose := TempLatch, vi_udn_ProductType := 1) THEN
					udn_NextId := udn_NextId + 1;
				END_IF
				udn_LoopProduct[n_TempI] := 0;
				n_LoopMode[n_TempI] := n_LOOP_RETURN;
			END_IF

		n_LOOP_RETURN:
			lr_LoopS[n_TempI] := lr_LoopS[n_TempI] + lr_LOOP_RETURN_SPEED * lr_Dt;
			IF lr_LoopS[n_TempI] >= lr_TempPerimeter - INT_TO_LREAL(n_LOOP_MOVERS) * lr_LOOP_SLOT THEN
				n_LoopMode[n_TempI] := n_LOOP_QUEUE;
			END_IF
	END_CASE

	(* Report the mover with its cup *)
	lr_TempS := lr_LoopS[n_TempI];
	IF lr_TempS >= lr_TempPerimeter THEN
		lr_TempS := lr_TempS - lr_TempPerimeter;
	END_IF
	MoverFingers[0].stPose := m_LoopFlange(lr_TempS);
	MoverFingers[0].bActive := n_LoopMode[n_TempI] = n_LOOP_DELIVER
							OR (n_LoopMode[n_TempI] = n_LOOP_TRACK AND lr_LoopS[n_TempI] >= lr_LOOP_GRIP);

	(* Demo fault: mover 3 now and then. *)
	fb_Fxx.m_SetMover(vi_un_Index := INT_TO_UINT(n_TempI), vi_udn_Id := INT_TO_UDINT(n_TempI + 1), vi_lr_Position := lr_TempS,
		vi_FingerStates := MoverFingers,
		vi_b_Fault := n_TempI = 2 AND lr_FaultPhase >= lr_FAULT_LOOP_START
					AND lr_FaultPhase < lr_FAULT_LOOP_START + lr_FAULT_DURATION,
		vi_str_FaultMessage := 'Following error');
END_FOR
m_StepLoop := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StepSpacing" Id="{311d5754-d8e0-4be2-ae6f-2f82b9238f52}">
      <Declaration><![CDATA[(****************************************************************************************************<br>
© Syntegon Group.<br>
All rights reserved, also regarding any disposal, exploitation, reproduction, editing, distribution,<br>
as well as in the event of applications for industrial property rights.<br>
*****************************************************************************************************<br>
DESCRIPTION:<br>
Spacing application: an XTS loop under one belt. Products arrive on the belt with random gaps; the queue head<br>
takes over the next one passing above the start of the upper straight and pushes it along the belt until it is<br>
lr_SPC_PITCH behind the product ahead, then lets the belt take it on and runs round to the queue. The pushed<br>
product stays on the belt (moved with m_MoveProduct), so no placeholder appears.<br>
****************************************************************************************************)
METHOD PRIVATE m_StepSpacing : BOOL
VAR
	lr_TempPerimeter					: LREAL;	// [mm]
	lr_TempWait							: LREAL;	// [mm] track position of the start of the upper straight
	lr_TempStartX						: LREAL;	// [mm] MCS x of the start of the upper straight
	lr_TempX							: LREAL;	// [mm] MCS x
	lr_TempTarget						: LREAL;	// [mm] MCS x a pushing mover heads for
	lr_TempRef							: LREAL;	// [mm] MCS x of the product ahead
	lr_TempMinPush						: LREAL;	// [mm] track position of the last pushing mover
	n_TempI								: INT;
	n_TempJ								: INT;
	n_TempK								: INT;
	n_TempRank							: INT;
	n_TempHead							: INT;
	n_TempNext							: INT;
	n_TempIdx							: INT;
	un_TempIndex						: UINT;
	b_TempReady							: BOOL;
	b_TempDone							: ARRAY[0..7] OF BOOL;	// per mover (n_SPC_MOVERS)
	TempProduct							: ST_VisuProduct;
	TempPose							: ST_VisuPlanarPose;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(****************************************************************************************************)
(* CONFIGURATION (idempotent, every cycle)                                                          *)
(****************************************************************************************************)
BeltPose.fX := 0;
BeltPose.fY := lr_SPC_Y;
BeltPose.fZ := lr_BELT_Z;
fb_SpcBelt.m_Configure(vi_Pose := BeltPose, vi_lr_Length := lr_SPC_BELT_LENGTH, vi_lr_Width := lr_BELT_WIDTH);
fb_SpcBelt.m_SetProductType(vi_udn_Id := 1, vi_lr_Length := 120, vi_lr_Width := 80, vi_lr_Height := lr_PRODUCT_HEIGHT);

(* Turned by 180 deg: the upper straight runs along MCS +X just below the belt, the tool points reach its surface. *)
XtsPose.fX := lr_SPC_LOOP_END_X;
XtsPose.fY := lr_SPC_Y;
XtsPose.fZ := lr_BELT_Z - 2 * lr_SPC_RADIUS - lr_SPC_TOOL_OFFSET;
XtsPose.fRz := 180;
fb_Spc.m_Configure(vi_Pose := XtsPose, vi_lr_StraightLength := lr_SPC_STRAIGHT, vi_lr_CurveRadius := lr_SPC_RADIUS,
	vi_lr_ToolOffset := lr_SPC_TOOL_OFFSET, vi_lr_MoverLength := 100, vi_lr_MoverWidth := 60);
lr_TempStartX := lr_SPC_LOOP_END_X - lr_SPC_STRAIGHT;
fb_Spc.m_SetZone(vi_udn_ConveyorId := fb_SpcBelt.m_Id(), vi_e_Kind := E_VisuZoneKind.PICK, vi_lr_Start := lr_TempStartX,
	vi_lr_End := lr_TempStartX + lr_SPC_TAKE_WINDOW);
fb_Spc.m_SetZone(vi_udn_ConveyorId := fb_SpcBelt.m_Id(), vi_e_Kind := E_VisuZoneKind.PLACE,
	vi_lr_Start := lr_SPC_RELEASE_MIN_X, vi_lr_End := lr_SPC_RELEASE_MAX_X);


(****************************************************************************************************)
(* BELT AND INFEED                                                                                  *)
(****************************************************************************************************)
lr_SpcBeltPosition := lr_SpcBeltPosition + lr_SPC_BELT_SPEED * lr_Dt;
fb_SpcBelt.m_SetBeltPosition(lr_SpcBeltPosition);
lr_SpcSinceSpawn := lr_SpcSinceSpawn + lr_Dt;
IF lr_SpcSinceSpawn >= lr_SpcSpawnInterval THEN
	lr_SpcSinceSpawn := 0;
	udn_Seed := udn_Seed * 1103515245 + 12345;
	(* Random gaps: the loop puts the products at an even pitch. *)
	lr_SpcSpawnInterval := 0.6 + UDINT_TO_LREAL(udn_Seed MOD 1000) / 1000.0 * 1.6;
	LatchPose.fX := 100;
	LatchPose.fY := lr_SPC_Y;
	LatchPose.fZ := lr_BELT_Z;
	LatchPose.fRz := 0;
	IF fb_SpcBelt.m_LatchProduct(vi_udn_Id := udn_NextId, vi_LatchPose := LatchPose, vi_udn_ProductType := 1) THEN
		udn_NextId := udn_NextId + 1;
	END_IF
END_IF


(****************************************************************************************************)
(* QUEUE AND TAKE-OVER                                                                              *)
(****************************************************************************************************)
lr_TempPerimeter := fb_Spc.m_Perimeter();
lr_TempWait := lr_SPC_STRAIGHT + 3.141592653589793 * lr_SPC_RADIUS;
IF NOT b_SpcInitialised THEN
	FOR n_TempI := 0 TO n_SPC_MOVERS - 1 DO
		lr_SpcS[n_TempI] := lr_TempWait - INT_TO_LREAL(n_TempI) * lr_SPC_SLOT;
		n_SpcMode[n_TempI] := n_SPC_QUEUE;
	END_FOR
	b_SpcInitialised := TRUE;
END_IF

(* Queued movers close up towards their slots before the start of the upper straight. *)
n_TempHead := -1;
FOR n_TempI := 0 TO n_SPC_MOVERS - 1 DO
	IF n_SpcMode[n_TempI] = n_SPC_QUEUE THEN
		n_TempRank := 0;
		FOR n_TempJ := 0 TO n_SPC_MOVERS - 1 DO
			IF n_SpcMode[n_TempJ] = n_SPC_QUEUE
			AND (lr_SpcS[n_TempJ] > lr_SpcS[n_TempI] OR (lr_SpcS[n_TempJ] = lr_SpcS[n_TempI] AND n_TempJ < n_TempI))
			THEN
				n_TempRank := n_TempRank + 1;
			END_IF
		END_FOR
		lr_SpcS[n_TempI] := MIN(lr_SpcS[n_TempI] + lr_SPC_RETURN_SPEED * lr_Dt,
								lr_TempWait - INT_TO_LREAL(n_TempRank) * lr_SPC_SLOT);
		IF n_TempRank = 0 THEN
			n_TempHead := n_TempI;
		END_IF
	END_IF
END_FOR

(* The ready queue head takes over the next product passing above the start of the upper straight, if the last
   pushing mover is at least one slot ahead. ST evaluates both operands of AND: test the head separately. *)
lr_TempMinPush := 1.0E9;
FOR n_TempI := 0 TO n_SPC_MOVERS - 1 DO
	IF n_SpcMode[n_TempI] = n_SPC_PUSH THEN
		lr_TempMinPush := MIN(lr_TempMinPush, lr_SpcS[n_TempI]);
	END_IF
END_FOR
b_TempReady := FALSE;
IF n_TempHead >= 0 THEN
	b_TempReady := lr_SpcS[n_TempHead] >= lr_TempWait - 1;
END_IF
IF b_TempReady THEN
	un_TempIndex := 0;
	WHILE n_SpcMode[n_TempHead] = n_SPC_QUEUE AND un_TempIndex < fb_SpcBelt.m_ProductCount() DO
		fb_SpcBelt.m_GetProduct(vi_un_Index := un_TempIndex, vo_Product => TempProduct, vo_Pose => TempPose);
		lr_TempX := TempPose.fX - lr_TempStartX;
		IF TempProduct.eState = E_VisuProductState.DETECTED AND lr_TempX >= 0 AND lr_TempX < lr_SPC_TAKE_WINDOW
		AND lr_TempMinPush - lr_TempWait - lr_TempX >= lr_SPC_SLOT
		THEN
			fb_SpcBelt.m_SetProductState(vi_udn_Id := TempProduct.nId, vi_e_State := E_VisuProductState.ASSIGNED,
				vi_udn_RobotId := fb_Spc.m_Id(), vi_udn_MoverId := INT_TO_UDINT(n_TempHead + 1));
			udn_SpcProduct[n_TempHead] := TempProduct.nId;
			lr_SpcS[n_TempHead] := lr_TempWait + lr_TempX;
			n_SpcMode[n_TempHead] := n_SPC_PUSH;
		END_IF
		un_TempIndex := un_TempIndex + 1;
	END_WHILE
END_IF


(****************************************************************************************************)
(* PUSHING: the front mover first, so each one keeps the pitch to the product ahead of it            *)
(****************************************************************************************************)
lr_TempRef := 1.0E9;
IF udn_SpcLastReleased <> 0 THEN
	n_TempIdx := fb_SpcBelt.m_FindProduct(udn_SpcLastReleased);
	IF n_TempIdx >= 0 THEN
		fb_SpcBelt.m_GetProduct(vi_un_Index := INT_TO_UINT(n_TempIdx), vo_Product => TempProduct, vo_Pose => TempPose);
		lr_TempRef := TempPose.fX;
	END_IF
END_IF
FOR n_TempI := 0 TO n_SPC_MOVERS - 1 DO
	b_TempDone[n_TempI] := n_SpcMode[n_TempI] <> n_SPC_PUSH;
END_FOR
FOR n_TempK := 1 TO n_SPC_MOVERS DO
	(* Next pushing mover: the one furthest along. *)
	n_TempNext := -1;
	FOR n_TempI := 0 TO n_SPC_MOVERS - 1 DO
		IF NOT b_TempDone[n_TempI] THEN
			IF n_TempNext < 0 THEN
				n_TempNext := n_TempI;
			ELSIF lr_SpcS[n_TempI] > lr_SpcS[n_TempNext] THEN
				n_TempNext := n_TempI;
			END_IF
		END_IF
	END_FOR
	IF n_TempNext < 0 THEN
		EXIT;
	END_IF
	b_TempDone[n_TempNext] := TRUE;

	n_TempIdx := fb_SpcBelt.m_FindProduct(udn_SpcProduct[n_TempNext]);
	IF n_TempIdx < 0 THEN
		(* The product is gone: run round to the queue. *)
		udn_SpcProduct[n_TempNext] := 0;
		n_SpcMode[n_TempNext] := n_SPC_RETURN;
	ELSE
		lr_TempX := lr_TempStartX + lr_SpcS[n_TempNext] - lr_TempWait;
		lr_TempTarget := MIN(lr_SPC_RELEASE_MAX_X, lr_TempRef - lr_SPC_PITCH);
		lr_TempX := lr_TempX + LIMIT(0, lr_TempTarget - lr_TempX, lr_SPC_PUSH_SPEED * lr_Dt);
		lr_SpcS[n_TempNext] := lr_TempWait + lr_TempX - lr_TempStartX;
		LatchPose.fX := lr_TempX;
		LatchPose.fY := lr_SPC_Y;
		LatchPose.fZ := lr_BELT_Z;
		LatchPose.fRz := 0;
		fb_SpcBelt.m_MoveProduct(vi_udn_Id := udn_SpcProduct[n_TempNext], vi_Pose := LatchPose);
		lr_TempRef := lr_TempX;

		(* At the pitch behind the product ahead (or at the end of the release area): the belt takes it on. Only the
		   front mover lets go, so a returning mover never overtakes one that still pushes. *)
		IF n_TempK = 1 AND lr_TempX >= lr_SPC_RELEASE_MIN_X AND ABS(lr_TempTarget - lr_TempX) < 0.5 THEN
			fb_SpcBelt.m_SetProductState(vi_udn_Id := udn_SpcProduct[n_TempNext], vi_e_State := E_VisuProductState.DETECTED,
				vi_udn_RobotId := 0);
			udn_SpcLastReleased := udn_SpcProduct[n_TempNext];
			udn_SpcProduct[n_TempNext] := 0;
			n_SpcMode[n_TempNext] := n_SPC_RETURN;
		END_IF
	END_IF
END_FOR


(****************************************************************************************************)
(* RETURN AND REPORT                                                                                *)
(****************************************************************************************************)
fb_Spc.m_SetMoverCount(INT_TO_UINT(n_SPC_MOVERS));
FOR n_TempI := 0 TO n_SPC_MOVERS - 1 DO
	(* Back along the lower straight; past the perimeter the mover joins the queue. *)
	IF n_SpcMode[n_TempI] = n_SPC_RETURN THEN
		lr_SpcS[n_TempI] := lr_SpcS[n_TempI] + lr_SPC_RETURN_SPEED * lr_Dt;
		IF lr_SpcS[n_TempI] >= lr_TempPerimeter THEN
			lr_SpcS[n_TempI] := lr_SpcS[n_TempI] - lr_TempPerimeter;
			n_SpcMode[n_TempI] := n_SPC_QUEUE;
		END_IF
	END_IF
	fb_Spc.m_SetMover(vi_un_Index := INT_TO_UINT(n_TempI), vi_udn_Id := INT_TO_UDINT(n_TempI + 1),
		vi_lr_Position := lr_SpcS[n_TempI], vi_FingerStates := NoFingers);
END_FOR
fb_SpcBelt.m_RemoveProductsBeyond(lr_SPC_BELT_LENGTH + lr_REMOVE_BEYOND_END);
m_StepSpacing := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>